  },
  "WebSite": {
    "eSignature": "https://tiplifeintranetuat.dhipayalife.co.th/eSignature"
  },
  "WebInfo": {
    "label": "(UAT)",
    "version": "20250224.1.0.0"
  },
  "Client": {
    "ClientId": "EmpHubUAT",
    "ClientSecret": "secret",
    "Authority": "https://tiplifeintranetuat.dhipayalife.co.th/ID4"
  },
