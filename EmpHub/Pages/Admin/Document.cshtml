@page
@model EmpHub.Pages.Admin.DocumentModel
@{
    ViewData["Title"] = "ดูแลระบบ";
}
<style>
</style>
<div ng-controller="ManageCtrl" class="p-2">
    <div class="mb-3">
        <div class="fs-4"><i class="bi bi-question-lg"></i> คำถามที่พบบ่อย</div>
    </div>
    <div class="rounded-4 border shadow-sm p-2 bg-white">
        <div class="row">
            <div class="col-sm-6">
                <div class="d-flex">
                    <button class="btn btn-circle me-2" ng-click="ShowCreate()">
                        <i class="fas fa-plus"></i>
                    </button>
                </div>
            </div>
        </div>
        <hr class="m-1" />
        <div style="min-height: 460px;" class="position-relative">
            <div class="overflow-auto">
                <table class="table table-tip mb-0">
                    <thead>
                        <tr>
                            <th>คำถาม</th>
                            <th>รายละเอียด</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="x in lData">
                            <td>
                                {{ x.title }}
                            </td>
                            <td>
                                {{ x.detail }}
                            </td>
                            <td class="text-end p-0">
                                <button class="btn btn-circle" ng-click="ShowEdit(x)">
                                    <i class="fas fa-pen"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <div ng-show="lData.length == 0">
                    <div class="text-gray fs-4 position-absolute top-50 start-50 translate-middle">
                        ไม่พบข้อมูล
                    </div>
                </div>
            </div>
        </div>
    </div>
    @* Modify Modal *@
    <div id="UpdateModal" class="modal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">ข้อมูล</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <div>คำถาม</div>
                        <input ng-model="iData.title" class="form-control" maxlength="200" />
                    </div>
                    <div class="mb-3">
                        <div>รายละเอียด</div>
                        <textarea ng-model="iData.detail" class="form-control" maxlength="400" rows="4"></textarea>
                    </div>
                    <div ng-show="iData.docId != ''">
                        <div>เอกสารประกอบ</div>
                        <div class="list-group">
                            <div class="list-group-item d-flex" ng-repeat="a in iData.lAttach">
                                <div class="flex-fill text-truncate">
                                    {{ a.filename }}
                                </div>
                                <div>
                                    <div class="select text-danger" ng-click="DeleteFile(a, iData)">
                                        ลบ
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div ng-show="iData.lAttach.length == 0">
                            <label for="lFile" class="btn btn-link">
                                <i class="bi bi-plus"></i> เพิ่มเอกสาร
                            </label>
                            <input class="d-none" base-sixty-four-input id="lFile" type="file" ng-model="lFile" accept="application/pdf" ng-change="AddAttach()">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-danger-invert" ng-click="Delete()" ng-show="iData.docId != ''">ลบข้อมูล</button>
                    <button type="button" class="btn btn-primary" ng-click="Update()" ng-disabled="iData.title == ''">บันทึกรายการ</button>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    app.controller('ManageCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.page = 1
        $scope.row = 10;

        $scope.LoadData = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Document/DataList'
                , headers: { 'authorization': 'Bearer @User.AccessToken()' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    create_by: ''
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lData = result;
                    }, 0);
                }
                , error: AjaxError
            });
        }
        $scope.LoadData();

        $scope.ShowCreate = function () {
            $scope.iData = { docId: '', title: '', detail: '', create_by: '@User.UserId()' };
            $("#UpdateModal").modal('show');
        }

        $scope.ShowEdit = function (x) {
            $scope.iData = x;
            $scope.LoadAttach($scope.iData);

            $("#UpdateModal").modal('show');
        }

        $scope.Update = function () {
            var url = '@webAPI.CurrentValue.APIEmpHub/api/Document/Create';
            $("#UpdateModal").modal('hide');

            if ($scope.iData.docId != '') {
                var url = '@webAPI.CurrentValue.APIEmpHub/api/Document/Update';
            }

            $.ajax({
                url: url
                , headers: { 'authorization': 'Bearer @User.AccessToken()' }
                , type: 'post'
                , contentType: 'application/json'
                , cache: false
                , data: JSON.stringify($scope.iData)
                , success: function () {
                    $timeout(function () {
                        $scope.LoadData();
                    }, 0);
                }
                , error: AjaxError
            });
        }

        $scope.Delete = function () {
            $("#UpdateModal").modal('hide');

            $("#btnOK_warning").unbind().click(function () {
                $scope.iData.update_by = '@User.UserId()';

                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/Document/Delete'
                    , headers: { 'authorization': 'Bearer @User.AccessToken()' }
                    , type: 'post'
                    , contentType: 'application/json'
                    , cache: false
                    , data: JSON.stringify($scope.iData)
                    , success: function () {
                        $timeout(function () {
                            $scope.LoadData();
                        }, 0);
                    }
                    , error: AjaxError
                });
            });
            dlgWarning("ลบข้อมูล", "ต้องการยืนยันการทำรายการ");
        }

        /* Attach */

        $scope.LoadAttach = function (x) {
            $scope.lFile = [];
            x.lAttach = [];

            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/File/DataList',
                headers: { 'authorization': 'Bearer @User.AccessToken()' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    refId: x.docId
                }),
                success: function (result) {
                    $timeout(function () {
                        x.lAttach = result;
                    }, 0);
                }
            });
        }

        $scope.AddAttach = async function () {
            for (var i = 0; i < $scope.lFile.length; i++) {
                $scope.lFile[i].refId = $scope.iData.docId;
                $scope.lFile[i].create_by = '@User.UserId()';

                await $scope.CreateFile($scope.lFile[i]);
            }

            $scope.LoadAttach($scope.iData);
        }

        $scope.CreateFile = function (iAttach) {
            return new Promise((resolve) => {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/File/Create',
                    headers: { 'authorization': 'Bearer @User.AccessToken()' },
                    type: "POST",
                    contentType: 'application/json',
                    dataType: 'json',
                    cache: false,
                    data: JSON.stringify(iAttach),
                    success: function (result) {
                        $timeout(function () {
                            resolve(true);
                        }, 0);
                    },
                    error: function () {
                        resolve(false);
                    }
                });
            });
        }

        $scope.DeleteFile = function (a, x) {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/File/Delete',
                headers: { 'authorization': 'Bearer @User.AccessToken()' },
                type: "POST",
                contentType: 'application/json',
                cache: false,
                data: JSON.stringify(a),
                success: function (result) {
                    $timeout(function () {
                        $scope.LoadAttach(x);
                    }, 0);
                },
                error: AjaxError
            });
        }
    });
</script>