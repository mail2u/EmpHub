@page
@model EmpHub.Pages.Admin.InRoleModel
@{
    ViewData["Title"] = "ดูแลระบบ";
    var token = User.AccessToken(HttpContext);
}
<style>
</style>
<div ng-controller="ManageCtrl" class="p-2">
    <div class="rounded-4 p-3 bg-white shadow-sm border border-secondary">
        <div class="row">
            <div class="col-sm-3">
                <div class="d-flex">
                    <button class="btn btn-circle me-2" ng-click="ShowCreate()" ng-disabled="roleId == ''">
                        <i class="fas fa-plus"></i>
                    </button>
                    <select ng-model="roleId" ng-options="x.roleId as x.title for x in lRole | orderBy : 'title'" class="form-select" ng-change="LoadData()"></select>

                </div>
            </div>
            <div class="col-sm-3 d-flex">
                <div class="position-relative">
                    <input class="form-control me-2" ng-model="name" placeholder="ค้นหา" ng-change="Paging()" />
                    <div class="position-absolute top-50 end-0 translate-middle-y me-2">
                        <i class="fas fa-search"></i>
                    </div>
                </div>
                <button class="btn btn-circle" ng-click="Download()">
                    <i class="fas fa-arrow-down"></i>
                </button>
            </div>
            <div class="col-sm-6 text-end">
                <span>
                    {{ total > 0 ? ((page - 1) * row) + 1 : 0 }} - {{ page * row < total ? page * row : total }} of {{ total }}
                </span>
                <button class="btn btn-circle" ng-click="SetPage(page - 1)" ng-disabled="page <= 1">
                    <i class="fas fa-chevron-left"></i>
                </button>
                <button class="btn btn-circle" ng-click="SetPage(page + 1)" ng-disabled="page * row > total">
                    <i class="fas fa-chevron-right"></i>
                </button>
            </div>
        </div>
        <div style="height: calc(100vh - 200px);" class="position-relative">
            <div class="overflow-auto">
                <table class="table table-tip mb-0">
                    <thead>
                        <tr>
                            <th>กลุ่มสิทธิ์</th>
                            <th>ชื่อ - สกุล</th>
                            <th>ตำแหน่ง</th>
                            <th>ฝ่ายงาน</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="x in lData.slice(((page-1)*row), (page*row))">
                            <td>
                                {{ x.roleName }}
                            </td>
                            <td>
                                {{ x.fullname }}
                            </td>
                            <td>
                                {{ x.position }}
                            </td>
                            <td>
                                {{ x.department }}
                            </td>
                            <td class="text-end">
                                <button class="btn btn-circle" ng-click="Delete(x)">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <div ng-show="lData.length == 0">
                    <div class="text-gray fs-4 position-absolute top-50 start-50 translate-middle">
                        ไม่พบข้อมูล
                    </div>
                </div>
            </div>
        </div>
    </div>
    @* Modify Modal *@
    <div id="CreateModal" class="modal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">ข้อมูลผู้ใช้งาน</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        <div class="position-relative">
                            <input ng-model="filter_name" class="form-control mb-2" placeholder="ค้นหา" />
                            <span class="position-absolute top-50 end-0 me-2 translate-middle-y">
                                <i class="fas fa-search"></i>
                            </span>
                        </div>
                        <div class="list-group list-group-flush overflow-auto" style="max-height: 400px;">
                            <div class="list-group-item d-flex align-items-center justify-content-between" ng-repeat="x in lUser | filter : filter_name">
                                <div>
                                    {{ x.firstname_th + ' ' + x.lastname_th }} <span ng-show="x.nickname != ''">(คุณ{{ x.nickname }})</span>
                                </div>
                                <div>
                                    <button ng-click="Create(x)" class="btn btn-circle">
                                        <i class="fas fa-plus"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="text-end">
                        <button class="btn btn-light" data-bs-dismiss="modal" aria-label="Close">
                            ปิด
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    app.controller('ManageCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.page = 1
        $scope.row = 10;
        $scope.roleId = '';

        $scope.LoadUser = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/DataList'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    page: 1
                    , row: 2000
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lUser = result.data;
                    }, 0);
                }
                , error: AjaxError
            });
        }
        $scope.LoadUser();

        $scope.LoadRole = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Role/DataList'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    roleType: 'Function'
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lRole = result;
                        $scope.lRole.splice(0, 0, { roleId: '', title: '--- ทั้งหมด ---' });

                        $scope.LoadData();
                    }, 0);
                }
                , error: AjaxError
            });
        }
        $scope.LoadRole();

        $scope.LoadData = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/UserInRole/DataList'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    roleType: 'Function'
                    , roleId: $scope.roleId
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.tempData = result;
                        $scope.Paging();
                    }, 0);
                }
                , error: AjaxError
            });
        }

        $scope.Paging = function () {
            $scope.lData = $filter('filter')($scope.tempData, $scope.name);
            $scope.total = $scope.lData.length;
        }

        $scope.SetPage = function (p) {
            $scope.page = p;
        }

        $scope.ShowCreate = function () {
            $scope.iData = { rn: 0 };
            $("#CreateModal").modal('show');
        }

        $scope.Create = function (x) {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/UserInRole/Create'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , cache: false
                , data: JSON.stringify({
                    roleId: $scope.roleId
                    , userId: x.userId
                    , fullname: x.firstname_th + ' ' + x.lastname_th
                })
                , success: function () {
                    $timeout(function () {
                        alertSuccess("บันทึกรายการสำเร็จ", "");
                        $scope.LoadData();
                    }, 0);
                }
                , error: AjaxError
            });
        }

        $scope.Delete = function (x) {
            alertConfirm("ลบสิทธิ์", "ต้องการยืนยันการทำรายการ", () => {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/UserInRole/Delete'
                    , headers: { 'authorization': 'Bearer @token' }
                    , type: 'post'
                    , contentType: 'application/json'
                    , cache: false
                    , data: JSON.stringify({
                        roleId: x.roleId
                        , userId: x.userId
                    })
                    , success: function () {
                        $timeout(function () {
                            $scope.LoadData();
                        }, 0);
                    }
                    , error: AjaxError
                });
            });
        }

        $scope.Download = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/UserInRole/DataList'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    roleType: 'Function'
                    , roleId: $scope.roleId
                })
                , success: function (result) {
                    $timeout(function () {
                        var data = result;

                        if (data.length > 0) {
                            var JSData = [[
                                { 'text': 'กลุ่มสิทธิ์' }
                                , { 'text': 'ชื่อ - สกุล' }
                                , { 'text': 'ตำแหน่ง' }
                                , { 'text': 'ฝ่ายงาน' }
                            ]];

                            for (var i = 0; i < data.length; i++) {
                                var iData = data[i];

                                JSData.splice(JSData.length, 0, [
                                    { 'text': iData.roleName }
                                    , { 'text': iData.fullname }
                                    , { 'text': iData.position }
                                    , { 'text': iData.department }
                                ]);
                            }

                            var dt = new Date().toISOString().slice(0, 10).replace(/-/g, "");
                            ExportFile(JSData, 'รายงานสิทธิ์การใช้งาน_' + dt);
                        }
                    }, 0);
                }
                , error: AjaxError
            });
        }

    });
</script>