@page
@model EmpHub.Pages.Admin.UserModel
@{
    ViewData["Title"] = "ดูแลระบบ";
}
<style>
</style>
<div ng-controller="ManageCtrl" class="p-2">
    <div class="d-md-flex justify-content-between">
        <div class="mb-3 me-2">
            <div class="fs-4"><i class="bi bi-people"></i> ผู้ใช้งาน</div>
        </div>
        <div class="d-none d-sm-block">
            <div class="btn btn-secondary" ng-click="Download()">
                <i class="bi bi-download"></i> Download
            </div>
        </div>
    </div>
    <div class="rounded-4 border shadow-sm p-3 bg-white">
        <div class="row">
            <div class="col-sm-5">
                <div class="d-flex">
                    <input class="form-control me-1" ng-model="subject" my-enter="LoadData()" />
                    <button class="btn btn-circle" ng-click="LoadData()">
                        <i class="fas fa-search"></i>
                    </button>
                    <button class="btn btn-circle" ng-click="New()" title="create user vender">
                        <i class="bi bi-person-plus-fill"></i>
                    </button>
                    <button class="btn btn-circle" ng-click="Sync()" title="sync data user">
                        <i class="bi bi-arrow-repeat"></i>
                    </button>
                </div>
            </div>
            <div class="col-sm-7 text-end">
                <span>
                    {{ total > 0 ? ((page - 1) * row) + 1 : 0 }} - {{ page * row < total ? page * row : total }} of {{ total }}
                </span>
                <button class="btn btn-circle" ng-click="LoadData(page - 1)" ng-disabled="page <= 1">
                    <i class="fas fa-chevron-left"></i>
                </button>
                <button class="btn btn-circle" ng-click="LoadData(page + 1)" ng-disabled="page * row > total">
                    <i class="fas fa-chevron-right"></i>
                </button>
            </div>
        </div>
        <hr class="m-1" />
        <div style="min-height: 460px;" class="position-relative">
            <div class="overflow-auto">
                <table class="table table-tip mb-0">
                    <thead>
                        <tr>
                            <th class="text-nowrap">Username</th>
                            <th class="text-nowrap">Fullname</th>
                            <th class="text-nowrap">ชื่อ - สกุล</th>
                            <th class="text-nowrap">E-mail</th>
                            <th class="text-nowrap">ประเภท</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="x in lData">
                            <td>
                                {{ x.username }}
                            </td>
                            <td>
                                {{ x.firstname }} {{ x.lastname }}
                            </td>
                            <td>
                                {{ x.firstname_th }} {{ x.lastname_th }}
                            </td>
                            <td>
                                {{ x.email }}
                            </td>
                            <td>
                                {{ x.userType }}
                            </td>
                            <td class="p-0">
                                <button class="btn btn-circle p-0 text-secondary" ng-click="ShowEdit(x)">
                                    <i class="fas fa-pen"></i>
                                </button>
                                <button class="btn btn-circle p-0 text-danger" ng-click="Delete(x)">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                                <button class="btn btn-circle p-0 text-orange" ng-click="ShowChangePass(x)" ng-show="x.can_changepassword == 1">
                                    <i class="bi bi-key"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <div ng-show="lSignature.length == 0">
                    <div class="text-gray fs-4 position-absolute top-50 start-50 translate-middle">
                        ไม่พบข้อมูล
                    </div>
                </div>
            </div>
        </div>
    </div>
    @* Create Modal *@
    <div id="CreateModal" class="modal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-secondary text-white">
                    <div class="modal-title ">เพิ่มผู้้ใช้งาน (Vendor) </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-sm-6 mb-3">
                            <div class="fw-bolder">Username</div>
                            <input ng-model="iData.username" class="form-control" maxlength="50" />
                        </div>
                        <div class="col-sm-6 mb-3">
                            <div class="fw-bolder">Password</div>
                            <input ng-model="iData.password" class="form-control" maxlength="50" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-6 mb-3">
                            <div class="fw-bolder">firstname</div>
                            <input ng-model="iData.firstname" class="form-control" maxlength="50" />
                        </div>
                        <div class="col-sm-6 mb-3">
                            <div class="fw-bolder">lastname</div>
                            <input ng-model="iData.lastname" class="form-control" maxlength="50" />
                        </div>
                    </div>
                    <div class="text-end mt-2">
                        <button class="btn btn-secondary" ng-click="Create()" ng-disabled="iData.username == '' || iData.password == '' ">
                            <i class="bi bi-floppy"></i> บันทึกการเปลี่ยนแปลง
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    @* Modify Modal *@
    <div id="DetailModal" class="modal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-secondary text-white">
                    <div class="modal-title ">รายละเอียดผู้้ใช้งาน </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <div class="fw-bolder">Username</div>
                        {{ iData.username }}
                    </div>
                    <div class="row">
                        <div class="col-sm-6 mb-3">
                            <div class="fw-bolder">firstname</div>
                            <input ng-model="iData.firstname" class="form-control" maxlength="50" />
                        </div>
                        <div class="col-sm-6 mb-3">
                            <div class="fw-bolder">lastname</div>
                            <input ng-model="iData.lastname" class="form-control" maxlength="50" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-6 mb-3">
                            <div class="fw-bolder">firstname (TH)</div>
                            <input ng-model="iData.firstname_th" class="form-control" maxlength="50" />
                        </div>
                        <div class="col-sm-6 mb-3">
                            <div class="fw-bolder">lastname (TH)</div>
                            <input ng-model="iData.lastname_th" class="form-control" maxlength="50" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-6 mb-3">
                            <div class="fw-bolder">Nickname</div>
                            <input ng-model="iData.nickname" class="form-control" maxlength="50" />
                        </div>
                        <div class="col-sm-6 mb-3">
                            <div class="fw-bolder">E-mail</div>
                            <input ng-model="iData.email" class="form-control" maxlength="50" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-6 mb-3">
                            <div class="fw-bolder">Position</div>
                            <select ng-model="iData.positionCode" class="form-select" ng-options="x.code as x.desc_th for x in lPosition"></select>
                        </div>
                        <div class="col-sm-6 mb-3">
                            <div class="fw-bolder">Department</div>
                            <select ng-model="iData.departmentCode" class="form-select" ng-options="x.code as x.desc_th for x in lDepartment"></select>
                        </div>
                    </div>
                    <div class="text-end mt-2">
                        <button class="btn btn-secondary" ng-click="Update()">
                            <i class="bi bi-floppy"></i> บันทึกการเปลี่ยนแปลง
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    @* ChangePass *@
    <div id="ChangePassModal" class="modal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-secondary text-white">
                    <div class="modal-title ">รายละเอียดผู้้ใช้งาน </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <div class="fw-bolder">Username</div>
                        {{ iData.username }}
                    </div>
                    <div class="mb-3">
                        <div class="fw-bolder">Password</div>
                        <input ng-model="iData.password" class="form-control" maxlength="50" />
                    </div>
                    <div class="text-end mt-2">
                        <button class="btn btn-secondary" ng-click="ChangePass()">
                            <i class="bi bi-floppy"></i> บันทึกการเปลี่ยนแปลง
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    app.controller('ManageCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.page = 1
        $scope.row = 10;

        $scope.LoadInit = function(){
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/MasterCode/DataList'
                , headers: { 'authorization': 'Bearer @User.AccessToken()' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    groupName: 'departmentCode'
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lDepartment = result;
                    }, 0);
                }
                , error: AjaxError
            });
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/MasterCode/DataList'
                , headers: { 'authorization': 'Bearer @User.AccessToken()' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    groupName: 'positionCode'
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lPosition = result;
                    }, 0);
                }
                , error: AjaxError
            });
        }
        $scope.LoadInit();

        $scope.LoadData = function (page = 1) {
            $scope.page = page;

            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/FullList'
                , headers: { 'authorization': 'Bearer @User.AccessToken()' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    page: $scope.page
                    , row: $scope.row
                    , firstname: $scope.subject
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lData = result.data;
                        $scope.total = result.total;
                    }, 0);
                }
                , error: AjaxError
            });
        }
        $scope.LoadData();

        $scope.New = function (x) {
            $scope.iData = { username: '', password: '', firstname: '', lastname: '' };
            $("#CreateModal").modal('show');
        }

        $scope.Create = function () {
            $scope.iData.create_by = '@User.UserId()';
            $("#CreateModal").modal('hide');

            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/Create'
                , headers: { 'authorization': 'Bearer @User.AccessToken()' }
                , type: 'post'
                , contentType: 'application/json'
                , cache: false
                , data: JSON.stringify($scope.iData)
                , success: function () {
                    $timeout(function () {
                        $scope.LoadData($scope.page);
                    }, 0);
                }
                , error: AjaxError
            });
        }

        $scope.ShowEdit = function (x) {
            $scope.iData = x;
            $("#DetailModal").modal('show');
        }

        $scope.Update = function () {
            $scope.iData.update_by = '@User.UserId()';
            $("#DetailModal").modal('hide');

            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/Update'
                , headers: { 'authorization': 'Bearer @User.AccessToken()' }
                , type: 'post'
                , contentType: 'application/json'
                , cache: false
                , data: JSON.stringify($scope.iData)
                , success: function () {
                    $timeout(function () {
                        $scope.LoadData($scope.page);
                    }, 0);
                }
                , error: AjaxError
            });
        }

        $scope.Delete = function(x){
            alertConfirm('ยืนยันการทำรายการ', 'ท่านต้องการลบข้อมูลผู้ใช้งานนี้', function () {
                x.update_by = '@User.UserId()';
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/User/Delete'
                    , headers: { 'authorization': 'Bearer @User.AccessToken()' }
                    , type: 'post'
                    , contentType: 'application/json'
                    , cache: false
                    , data: JSON.stringify(x)
                    , success: function () {
                        $timeout(function () {
                            $scope.LoadData($scope.page);
                        }, 0);
                    }
                    , error: AjaxError
                });
            });
        }

        $scope.ShowChangePass = function (x) {
            $scope.iData = x;
            $("#ChangePassModal").modal('show');
        }

        $scope.ChangePass = function () {
            $scope.iData.update_by = '@User.UserId()';
            $("#ChangePassModal").modal('hide');

            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/ChangePassword'
                , headers: { 'authorization': 'Bearer @User.AccessToken()' }
                , type: 'post'
                , contentType: 'application/json'
                , cache: false
                , data: JSON.stringify($scope.iData)
                , success: function () {
                    $timeout(function () {
                        $scope.LoadData($scope.page);
                    }, 0);
                }
                , error: AjaxError
            });
        }

        $scope.Resend = function (x) {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Mail/Resend'
                , headers: { 'authorization': 'Bearer @User.AccessToken()' }
                , type: 'post'
                , contentType: 'application/json'
                , cache: false
                , data: JSON.stringify({
                    id: x.id
                })
                , success: function () {
                    $timeout(function () {
                        alertSuccess("ส่งเมล์สำเร็จ", "ดำเนินการส่งเมล์เรียบร้อยแล้ว");
                        $scope.LoadData($scope.page);
                    }, 0);
                }
                , error: AjaxError
            });
        }

        $scope.UpdateSync = function (x) {
            return new Promise((resolve) => {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/User/SyncData'
                    , headers: { 'authorization': 'Bearer @User.AccessToken()' }
                    , type: 'post'
                    , contentType: 'application/json'
                    , cache: false
                    , data: JSON.stringify(x)
                    , success: function (data) {
                        resolve(true);
                    }
                    , error: function(){
                        resolve(false);
                    }
                });
            });
        }

        $scope.Download = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/FullList',
                headers: { 'authorization': 'Bearer @User.AccessToken()' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    page: $scope.page
                    , row: 2000
                    , firstname: $scope.subject
                }),
                success: function (result) {
                    $timeout(function () {
                        var lData = result.data;

                        if (lData.length > 0) {
                            var JSData = [[
                                { 'text': 'Username' }
                                , { 'text': 'Fullname' }
                                , { 'text': 'ชื่อ - สกุล' }
                                , { 'text': 'E-mail' }
                                , { 'text': 'ประเภท' }
                                , { 'text': 'วันที่สร้าง' }
                            ]];

                            for (var i = 0; i < lData.length; i++) {
                                var iData = lData[i];

                                JSData.splice(JSData.length, 0, [
                                    { 'text': iData.serviceNo }
                                    , { 'text': iData.categoryDesc }
                                    , { 'text': iData.subCategoryDesc }
                                    , { 'text': iData.title }
                                    , { 'text': iData.status }
                                    , { 'text': iData.createName }
                                    , { 'text': iData.createDate }
                                ]);
                            }

                            var dt = new Date().toISOString().slice(0, 10).replace(/-/g, "");
                            ExportFile(JSData, 'รายงานฝ่าย_' + dt);
                        }
                    }, 0);
                },
                error: AjaxError
            });
        }
    });
</script>