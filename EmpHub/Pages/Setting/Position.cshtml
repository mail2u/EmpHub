@page
@model EmpHub.Pages.Setting.PositionModel
@{
    ViewData["Title"] = "Setting";
    var token = User.AccessToken(HttpContext);
}

@section PageHeader {
    <!-- [ page-header ] start -->
    <div class="page-header">
        <div class="page-header-left d-flex align-items-center">
            <div class="page-header-title">
                <h5 class="m-b-10">Setting</h5>
            </div>
            <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Page("/Index")">Home</a></li>
                <li class="breadcrumb-item">Position</li>
            </ul>
        </div>
    </div>
}

<div ng-controller="PositionCtrl">
    <div class="mb-2">
        <div class="fs-4">Position</div>
    </div>
    <div class="rounded-4 p-3 bg-white shadow-sm border position-relative">
        <div class="d-flex align-items-center">
            <div class="me-2">
                <button class="btn btn-light" ng-click="ShowCreate()" ng-disabled="roleId == ''">
                    <i class="fas fa-plus me-2"></i> Create
                </button>
            </div>
            <div>
                <div class="position-relative me-2">
                    <input class="form-control form-control-sm me-2" ng-model="search" />
                    <span class="position-absolute top-50 end-0 translate-middle-y me-3">
                        <i class="fas fa-search"></i>
                    </span>
                </div>
            </div>
            <div>
                <button class="btn btn-circle me-2" ng-click="Download()" ng-disabled="total == 0">
                    <i class="fas fa-arrow-down"></i>
                </button>
            </div>
            <div class="flex-fill">
            </div>
           @*  <div class="d-flex align-items-center">
                <div class='me-2'>
                    {{ (total > 0 ? ((page - 1) * row) + 1 : 0) | number }} - {{ (page * row < total ? page * row : total) | number }} of {{ total | number }}
                </div>
                <button class="btn btn-circle" ng-click="LoadData(page - 1)" ng-disabled="page <= 1">
                    <i class="fas fa-chevron-left"></i>
                </button>
                <button class="btn btn-circle" ng-click="LoadData(page + 1)" ng-disabled="page * row > total">
                    <i class="fas fa-chevron-right"></i>
                </button>
            </div> *@
        </div>
        <hr class="m-1" />
        <div class="overflow-auto" style="height: calc(100vh - 200px);">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>
                            Code
                        </th>
                        <th>
                            Name (TH)
                        </th>
                        <th>
                            Name (EN)
                        </th>
                        <th>
                            Level
                        </th>
                        <th width="50"></th>
                        <th width="50"></th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="x in lData | filter : search | orderBy : sortBy">
                        <td>
                            {{ x.code }}
                        </td>
                        <td>
                            {{ x.desc_th }}
                        </td>
                        <td>
                            {{ x.desc_en }}
                        </td>
                        <td>
                            {{ x.levelName }}
                        </td>
                        <td>
                            <button class="btn btn-circle" ng-click="ShowEdit(x)">
                                <i class="bi bi-pen-fill"></i>
                            </button>
                        </td>
                        <td>
                            <button class="btn btn-circle" ng-click="Delete(x)">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
            <div ng-show="lData.length == 0">
                <div class="text-gray fs-4 position-absolute top-50 start-50 translate-middle">
                    ไม่พบข้อมูล
                </div>
            </div>
        </div>
    </div>
    @* Modify Modal *@
    <div id="CreateModal" class="modal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Position Info</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        Code
                        <input ng-model="iData.code" class="form-control" maxlength="50" />
                    </div>
                    <div class="mb-3">
                        Name (TH)
                        <input ng-model="iData.desc_th" class="form-control" maxlength="50" />
                    </div>
                    <div class="mb-3">
                        Name (EN)
                        <input ng-model="iData.desc_en" class="form-control" maxlength="50" />
                    </div>
                    <div class="mb-3">
                        Level
                        <select ng-model="iData.levelCode" class="form-select" ng-options="x.levelCode as x.levelName for x in lLevel | orderBy : 'levelCode'"></select>
                    </div>
                    <div class="text-end">
                        <button class="btn btn-primary" ng-click="SaveChange()">
                            Save Change
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    app.controller('PositionCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.page = 1
        $scope.row = 10;
        $scope.search = '';

        $scope.lLevel = [
            { shortCode: 'Director', levelCode: '00', levelName: 'Director' }
            , { shortCode: 'CEO', levelCode: '01', levelName: 'Chief Executive Officer' }
            , { shortCode: 'SEVP', levelCode: '02', levelName: 'Senior Executive Vice President' }
            , { shortCode: 'EVP', levelCode: '03', levelName: 'Executive Vice President' }
            , { shortCode: 'VP', levelCode: '04', levelName: 'Vice President' }
            , { shortCode: 'AVP', levelCode: '05', levelName: 'Assistant Vice President' }
            , { shortCode: 'MGR', levelCode: '06', levelName: 'Manager' }
            , { shortCode: 'SUP', levelCode: '07', levelName: 'Supervisor' }
            , { shortCode: 'OFF', levelCode: '08', levelName: 'Officer' }
            , { shortCode: 'STAFF', levelCode: '09', levelName: 'Staff' }
        ];

        $scope.LoadData = function (page = 1) {
            $scope.page = page;

            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Position/DataList'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    page: $scope.page
                    , row: $scope.row
                    , sortBy: $scope.sortBy
                    , search: $scope.search_Position
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.total = result.length
                        $scope.lData = result;

                        $scope.lData = $scope.lData.map(item => {

                            var find = $scope.lLevel.find(d => d.levelCode == item.levelCode);

                            if (find) {
                                item.levelName = find.levelName;
                            }

                            return item;
                        });
                    }, 0);
                }
                , error: AjaxError
            });
        }
        $scope.LoadData();

        $scope.ShowCreate = function () {
            $scope.iData = { rn: 0, create_by: '@User.UserId()' };
            $("#CreateModal").modal('show');
        }

        $scope.ShowEdit = function (x) {
            $scope.iData = angular.copy(x);
            $scope.iData.create_by = '@User.UserId()';
            $("#CreateModal").modal('show');
        }

        $scope.SaveChange = function () {
            var url = '@webAPI.CurrentValue.APIEmpHub/api/Position/Create';

            if ($scope.iData.rn > 0) {
                url = '@webAPI.CurrentValue.APIEmpHub/api/Position/Update';
            }

            $("#CreateModal").modal('hide');

            var find = $scope.lLevel.find(item => item.levelCode == $scope.iData.levelCode);

            $scope.iData.shortCode = '';

            if (find) {
                $scope.iData.shortCode = find.shortCode;
            }

            $.ajax({
                url: url
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , cache: false
                , data: JSON.stringify($scope.iData)
                , success: function () {
                    $timeout(function () {
                        alertSuccess("บันทึกรายการสำเร็จ", "");
                        $scope.LoadData($scope.page);
                    }, 0);
                }
                , error: AjaxError
            });
        }

        $scope.Delete = function (x) {
            alertConfirm("Delete Position", "ต้องการยืนยันการทำรายการ", () => {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/Position/Delete'
                    , headers: { 'authorization': 'Bearer @token' }
                    , type: 'post'
                    , contentType: 'application/json'
                    , cache: false
                    , data: JSON.stringify({
                        rn: x.rn
                        , update_by: '@User.UserId()'
                    })
                    , success: function () {
                        $timeout(function () {
                            $scope.LoadData();
                        }, 0);
                    }
                    , error: AjaxError
                });
            });
        }

        $scope.SelectPosition = function (x) {
            $scope.iPosition = x;
            $scope.LoadUserInPosition();
        }

        $scope.Download = function () {
            var lData = $filter('filter')($scope.lData, $scope.search);
            lData = $filter('orderBy')($scope.lData, $scope.sortBy);

            var JSData = [[
                { 'text': 'Code' }
                , { 'text': 'Name (TH)' }
                , { 'text': 'Name (EN)' }
                , { 'text': 'levelName' }
            ]];

            if (lData.length > 0) {
                for (var i = 0; i < lData.length; i++) {
                    var iData = lData[i];

                    JSData.splice(JSData.length, 0, [
                        { 'text': iData.code }
                        , { 'text': iData.desc_th }
                        , { 'text': iData.desc_en }
                        , { 'text': iData.levelName }
                    ]);
                }

                ExportFile(JSData, 'PositionList');
            }
        }

    });
</script>