@{
    var token = User.AccessToken(Context);
}
<style>
    .circle-1{
        background-color: #17c666;
        color: white;
        border: 2px solid white;
    }

    .circle-2 {
        background-color: var(--bs-blue);
        color: white;
        border: 2px solid white;
    }

    .circle-3 {
        background-color: var(--bs-gray-200);
        color: white;
        border: 2px solid white;
    }

    .circle-4 {
        background-color: var(--bs-red);
        color: white;
        border: 2px solid white;
    }

    .circle-0 {
        background-color: var(--bs-gray-200);
        color: var(--bs-gray-500);
        border: 2px solid white;
    }

</style>
<div ng-controller="TrackCtrl">

    <div class="bg-white rounded-4 border mb-4 p-4 pb-0">
        <div class="fw-bolder text-gray mb-4">ติดตามสถานะ</div>
        <div ng-repeat="x in lTrack" class="d-flex">
            <div class="d-flex justify-content-center position-relative me-2" style="width:25px; min-width:25px;">
                <div class="vr" ng-show="$index != lTrack.length - 1"></div>
                <div class="position-absolute start-50 translate-middle-x" style="top:-2px;">
                    <div class="d-flex justify-content-center align-items-center rounded-circle circle-{{ x.is_action }}" style="width: 25px; height: 25px;">
                        <span ng-show="x.is_action == 1"><i class="bi bi-check-lg"></i></span>
                        <span ng-show="x.is_action == 3 || x.is_action == 4"><i class="bi bi-x"></i></span>
                        <span ng-show="x.is_action == 0 || x.is_action == 2">{{ $index + 1 }}</span>
                    </div>
                </div>
            </div>
            <div class="flex-fill mb-4">
                <div class="text-dark fw-bolder">{{ x.statusDesc }}</div>
                <div ng-show="x.actionName != ''">
                    <div class="text-dark">{{ x.actionName }}</div>
                    <div class="text-gray">{{ x.position }} {{ x.department }}</div>
                    <div class="text-gray" ng-show="x.actionDate != ''">{{ x.actionDate }}</div>
                    <div class="text-gray" ng-show="x.description != ''">{{ x.description }}</div>
                </div>
                <div ng-show="x.actionName == ''">
                    <div ng-repeat="u in x.lUser" class="mb-2">
                        <div class="text-dark">{{ u.actionName }}</div>
                        <div class="text-gray">{{ u.position }} {{ u.department }}</div>
                    </div>
                </div>
            </div>
            
            @*  <span class="position-absolute stage" style="left:-9px; top:-20px;">
                <i class="bi bi-circle" ng-show="x.is_action == 3"></i>
                <i class="bi bi-record-circle" ng-show="x.is_action == 2"></i>
                <i class="bi bi-check2-circle text-green" ng-show="x.is_action == 1"></i>
                <i class="bi bi-circle" ng-show="x.is_action == 0"></i>
                <i class="bi bi-x-circle" ng-show="x.is_action == -2"></i>
            </span>
            <div class="">
                <div class="fw-bolder">{{ x.statusDesc }}</div>
                <div ng-show="x.actionName != ''" class=" small p-2">
                    <div class="d-flex">
                        <i class="bi bi-person-circle me-1"></i>
                        <div>
                            
                            <div>{{ x.position }} {{ x.department }}</div>
                        </div>
                    </div>
                    <div ng-show="x.actionDate != ''">
                        <i class="bi bi-clock"></i> {{ x.actionDate }}
                    </div>
                    <div ng-show="x.description != ''">
                        <i class="bi bi-pen"></i> {{ x.description }}
                    </div>
                </div>
                <div ng-show="x.actionName == ''" class=" small p-2">
                    <div ng-repeat="u in x.lUser" class="d-flex mb-2">
                        <i class="bi bi-person-circle me-1"></i>
                        <div>
                            <div>{{ u.actionName }}</div>
                            <div>{{ u.position }} {{ u.department }}</div>
                        </div>
                    </div>
                </div>
            </div> *@
        </div>
    </div>
</div>
<script>
    app.controller('TrackCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.$parent.LoadTrack = function (refId) {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/ServiceStep/DataList',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                data: JSON.stringify({
                    refId: refId
                }),
                cache: false,
                success: function (result) {
                    $timeout(function () {
                        $scope.lTrack = result;

                        for (var i = 0; i < $scope.lTrack.length; i++){
                            var iData = $scope.lTrack[i];
                            iData.lUser = [];

                            if (iData.actionName == '') {
                                $scope.LoadUser(iData);
                            }
                        }
                    }, 0);
                }
            });
        }

        $scope.LoadUser = function(x){
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/ServiceStep/ActionList',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                data: JSON.stringify({
                    refId: x.refId
                    , status: x.status
                }),
                cache: false,
                success: function (result) {
                    $timeout(function () {
                        x.lUser = result;
                    }, 0);
                }
            });
        }
    });
</script>