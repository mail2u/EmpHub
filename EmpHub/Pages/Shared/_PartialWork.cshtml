@{
    var token = User.AccessToken(Context);
}
<div ng-controller="WorkCtrl">
    @* Work Modal *@
    <div id="workModal" class="modal fade dialog-info" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-secondary text-white">
                    <div class="modal-title ">ปิดใบงาน</div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-3">
                    <div class="mb-2">
                        <div>รายละเอียด</div>
                        <div class="d-flex">
                            <div class="flex-fill dropdown me-1">
                                <textarea ng-model="iData.workDesc" class="form-control me-1" data-bs-toggle="dropdown" rows="4" maxlength="400"></textarea>
                                <div class="dropdown-menu w-100">
                                    <div class="dropdown-item d-flex" ng-repeat="t in lWorkTemplate">
                                        <div class="flex-fill" ng-click="SelectWorkTemplate(t)">
                                            {{ t.detail }}
                                        </div>
                                        <div ng-click="DeleteWorkTemplate(t)">
                                            <i class="bi bi-x"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div>
                                <div class="btn btn-light border" title="เพิ่มเข้า Template" ng-disabled="iData.workDesc == ''" ng-click="CreateWorkTemplate()">
                                    <span ng-show="save_template == 0">
                                        <i class="bi bi-journal-plus"></i>
                                    </span>
                                    <span ng-show="save_template == 1" class="text-green">
                                        <i class="bi bi-journal-check"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="text-end">
                        <button class="btn btn-secondary" ng-click="Save()" ng-disabled="iData.workDesc == ''">
                            บันทึกการดำเนินการ
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    app.controller('WorkCtrl', function ($scope, $http, $timeout, $filter) {

        $scope.$parent.ShowWork = function (x) {
            $scope.iData = x;
            $("#workModal").modal('show');
            $scope.iData.workDesc = '';
            $scope.LoadWorkTemplate();
        }

        $scope.LoadWorkTemplate = function () {
            $scope.save_template = 0;
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Template/DataList',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                cache: false,
                data: JSON.stringify({
                    templateCode: 'CloseTheWork'
                    , userId: '@User.UserId()'
                }),
                success: function (result) {
                    $timeout(function () {
                        $scope.lWorkTemplate = result.data;
                    }, 0);
                },
                error: AjaxError
            });
        }

        $scope.SelectWorkTemplate = function (x) {
            $scope.iData.workDesc = x.detail;
        }

        $scope.DeleteWorkTemplate = function (x) {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Template/Delete',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                cache: false,
                data: JSON.stringify({
                    rn: x.rn
                    , templateCode: 'CloseTheWork'
                    , update_by: '@User.UserId()'
                }),
                success: function (result) {
                    $timeout(function () {
                        $scope.LoadWorkTemplate();
                    }, 0);
                },
                error: AjaxError
            });
        }

        $scope.CreateWorkTemplate = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Template/Create',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                cache: false,
                data: JSON.stringify({
                    templateCode: 'CloseTheWork'
                    , detail: $scope.iData.workDesc
                    , create_by: '@User.UserId()'
                }),
                success: function (result) {
                    $timeout(function () {
                        $scope.save_template = 1;

                        $timeout(function () {
                            $scope.LoadWorkTemplate();
                        }, 1500);
                    }, 0);
                },
                error: AjaxError
            });
        }

        $scope.Save = function () {
            $("#workModal").modal('hide');
            showPreloader();
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Service/Work',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                cache: false,
                data: JSON.stringify({
                    id: '@Model.id'
                    , userBy: '@User.UserId()'
                    , description: $scope.iData.workDesc
                }),
                success: function (result) {
                    $timeout(function () {
                        hidePreloader();
                        $scope.$parent.LoadData();

                        alertSuccess("ดำเนินรายการสำเร็จ", "บันทึกการทำรายการเรียบร้อยแล้ว", () => {
                            window.opener.ReloadWork();
                            window.close();
                        });
                    }, 0);
                },
                error: AjaxError
            });
        }

    });
</script>