@{
    String refId = Model as String;
    var token = User.AccessToken(Context);
}
<div ng-controller="TagCtrl">
    <div class="rounded-5 border shadow-sm p-2 bg-white mb-3" ng-show="lData.length > 0 || iData.can_tag == 1">
        <div class="fw-bolder rounded-4 p-2 bg-secondary text-white ps-3"><i class="bi bi-tag"></i> การติดป้าย</div>
        <div class="p-2 pe-0 bg-white rounded-4">
            <div ng-repeat="x in lData" ng-mouseover="x.is_focus = 1" ng-mouseleave="x.is_focus = 0">
                <div class="bg-light-hover bg-light rounded p-2 mb-1" ng-click="OpenDetail(x)">
                    <div class="d-flex justify-content-between">
                        <div class="text-secondary mb-1">
                            <b>{{ x.title }}</b>
                            <div>
                                {{ x.detail }}
                            </div>
                        </div>
                        <div ng-show="x.is_focus == 1 && iData.can_tag == 1">
                            <button class="btn p-0 text-secondary me-2" title="แก้ไข" ng-click="ShowEdit(x)">
                                <i class="bi bi-pen"></i>
                            </button>
                            <button class="btn p-0 text-danger" title="ลบ" ng-click="Delete(x)">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                    <div class="">
                        {{ x.description }}
                    </div>
                </div>
            </div>
            <div class="btn btn-link" ng-click="ShowCreate()" ng-show="iData.can_link == 1">
                เพิ่มรายการ
            </div>
        </div>
    </div>
    @* Modal *@
    <div id="CreateTag" class="modal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-secondary text-white">
                    <h1 class="modal-title fs-5" id="staticBackdropLabel">ติดป้าย</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        ชื่อป้าย
                        <input ng-model="iTag.title" class="form-control" maxlength="50" />
                        {{ iTag.title.length }}/50
                    </div>
                    <div class="mb-3">
                        รายละเอียด
                        <textarea ng-model="iTag.detail" class="form-control" rows="4" maxlength="1000"></textarea>
                        {{ iTag.detail.length }}/1000
                    </div>
                    <div class="text-end">
                        <button ng-click="Save()" ng-disabled="iTag.title == ''" class="btn btn-secondary" data-bs-dismiss="modal">บันทึก</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    app.controller('TagCtrl', function ($scope, $http, $timeout, $filter, $interval) {
        $scope.tag = '';

        $scope.$parent.LoadTag = function (x) {
            $scope.iData = x;
            $scope.refId = $scope.iData.id;
            $scope.LoadData();
        }

        $scope.LoadData = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/ServiceTag/DataList',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    refId: $scope.refId
                }),
                success: function (result) {
                    $timeout(function () {
                        $scope.lData = result;
                    }, 0);
                }
            });
        }

        $scope.ShowCreate =function(){
            $scope.iTag = { rn: 0, refId: $scope.iData.id, title: '', detail: '', create_by: '@User.UserId()' };
            $("#CreateTag").modal('show');
        }

        $scope.ShowEdit = function(x){
            $scope.iTag = x;
            $("#CreateTag").modal('show');
        }

        $scope.Save = function () {
            var url = '@webAPI.CurrentValue.APIEmpHub/api/ServiceTag/Create';

            if($scope.iTag.rn > 0){
                url = '@webAPI.CurrentValue.APIEmpHub/api/ServiceTag/Update';
            }

            $.ajax({
                url: url,
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                cache: false,
                data: JSON.stringify($scope.iTag),
                success: function (result) {
                    $timeout(function () {
                        $scope.LoadData();
                    }, 0);
                }
            });
        }

        $scope.Delete = function (x) {
            alertConfirm("คุณต้องการลบการติดป้าย", "ยืนยันการทำรายการ", function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/ServiceTag/Delete',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                cache: false,
                data: JSON.stringify({
                    rn: x.rn
                    , refId: x.refId
                    , update_by: '@User.UserId()'
                }),
                success: function (result) {
                    $timeout(function () {
                        $scope.LoadData();
                    }, 0);
                }
            });
            });
        }
    });
</script>