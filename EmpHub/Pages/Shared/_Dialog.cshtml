<!-- Preloader -->
<div id="preloader">
    <div id="status"></div>
</div>

<!-- Dialog -->
<div id="dialog-info" class="modal fade dialog-info" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="border-bottom:3px solid var(--tip-yellow); background-color: var(--tip-blue); color: var(--light-gray)">
                <div class="modal-title dialog-info-title"></div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body dialog-info-body" style="border-top:2px solid var(--tip-blue);"></div>
            <div class="modal-body">
                <div id="btnOK_info" class="btn btn-light select" data-bs-dismiss="modal" aria-label="Close">ตกลง</div>
            </div>
        </div>
    </div>
</div>

<div id="dialog-warning" class="modal fade dialog-warning" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="border-bottom:3px solid var(--tip-blue); background-color: var(--tip-yellow); color: var(--tip-blue)">
                <div class="modal-title dialog-warning-title"></div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body dialog-warning-body" style="border-top:4px solid var(--tip-yellow);"></div>
            <div class="modal-body">
                <div id="btnOK_warning" class="btn btn-default select" data-bs-dismiss="modal" aria-label="Close">ตกลง</div>
            </div>
        </div>
    </div>
</div>