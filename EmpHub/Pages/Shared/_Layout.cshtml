    <script>

        app.controller('myCtrl', function ($scope, $http, $timeout, $filter, $interval) {
            $scope.today = new Date();
            $scope.viewMode = '';

            // var timer = $interval(function () {
            //     $scope.today = new Date();
            // }, 1000);

            //$scope.lMonthShort = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'June', 'July', 'Aug', 'Sept', 'Oct', 'Nov', 'Dec'];
            $scope.lMonthShort = ['ม.ค.', 'ก.พ.', 'มี.ค.', 'เม.ย.', 'พ.ค.', 'มิ.ย.', 'ก.ค.', 'ส.ค.', 'ก.ย.', 'ต.ค.', 'พ.ย.', 'ธ.ค.'];

            $scope.ShortDT = function (dt) {
                var temp = ConvertToDate(dt);

                if ($scope.today.getFullYear() == temp.getFullYear()) {
                    if ($scope.today.getMonth() == temp.getMonth()) {
                        if ($scope.today.getDate() == temp.getDate()) {
                            return dt.split(' ')[1].substring(0, 5);
                        } else {
                            return temp.getDate() + ' ' + $scope.lMonthShort[temp.getMonth()];
                        }
                    } else {
                        return temp.getDate() + ' ' + $scope.lMonthShort[temp.getMonth()];
                    }
                } else {
                    return temp.getFullYear();
                }
            }

            $scope.LoadAlert = function () {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/Service/Alert'
                    , type: 'post'
                    , contentType: 'application/json'
                    , dataType: 'json'
                    , cache: false
                    , data: JSON.stringify({
                        userBy: '@User.UserId()'
                    })
                    , success: function (result) {
                        $timeout(function () {
                            $scope.iRequest = result.find(x => x.status == 'Request');
                            $scope.iApprove = result.find(x => x.status == 'Approve');
                            $scope.iWork = result.find(x => x.status == 'Work');
                            $scope.iShare = result.find(x => x.status == 'Share');
                        }, 0);
                    }
                    , error: AjaxError
                });
            }
        }).directive('formatToCurrency', function ($filter) {
            return {
                scope: {
                    amount: '='
                },
                link: function (scope, el, attrs) {

                    //el.val($filter('currency')(scope.amount, ''));

                    el.bind('focus', function () {
                        if (scope.amount != 0) {
                            el.val(scope.amount);
                        } else {
                            el.val('');
                        }
                    });

                    el.bind('keydown', function (e) {
                        if (e.keyCode == 190 && el.val().indexOf(".") >= 0) {
                            e.preventDefault();
                        }
                        //allow '-'
                        // if (e.keyCode == 189 && el.val() != '') {
                        //     e.preventDefault();
                        // }
                        //block '-'
                        if (e.keyCode == 189) {
                            e.preventDefault();
                        }
                        // Allow: backspace, delete, tab, escape, enter and .
                        if ($.inArray(e.keyCode, [46, 8, 9, 27, 13, 110, 190, 189]) !== -1 ||
                            // Allow: Ctrl+A
                            (e.keyCode == 65 && e.ctrlKey === true) ||
                            // Allow: Ctrl+C
                            (e.keyCode == 67 && e.ctrlKey === true) ||
                            // Allow: Ctrl+V
                            (e.keyCode == 86 && e.ctrlKey === true) ||
                            // Allow: Ctrl+X
                            (e.keyCode == 88 && e.ctrlKey === true) ||
                            // Allow: home, end, left, right
                            (e.keyCode >= 35 && e.keyCode <= 39)) {
                            // let it happen, don't do anything
                            return;
                        }

                        // Ensure that it is a number and stop the keypress
                        if ((e.shiftKey || (e.keyCode < 48 || e.keyCode > 57)) && (e.keyCode < 96 || e.keyCode > 105)) {
                            e.preventDefault();
                        }
                        if ($.isNumeric(e.key) == false) {
                            e.preventDefault();
                        }
                    });

                    el.bind('blur', function () {
                        el.val($filter('currency')(scope.amount, ''));

                        if (el.val() == 0 || el.val() == '' || el.val() == NaN) {
                            scope.amount = 0;
                        }
                    });
                }
            }
        }).directive('myEnter', function () {
            return function (scope, element, attrs) {
                element.bind("keydown keypress", function (event) {
                    if (event.which === 13) {
                        scope.$apply(function () {
                            scope.$eval(attrs.myEnter);
                        });

                        event.preventDefault();
                    }
                });
            };
        });
    </script>
