                        $timeout(function () {
                            $scope.PR_PO_Request = result.find(x => x.status == 'PR-PO-Request');
                            $scope.PR_NON_PO_ADV_Request = result.find(x => x.status == 'PR-NON-PO-ADV-Request');
                            $scope.PR_Review = result.find(x => x.status == 'PR-Review');
                            $scope.PR_Approve = result.find(x => x.status == 'PR-Approve');
                            $scope.PO_New = result.find(x => x.status == 'PO-New');
                            $scope.PO_Review = result.find(x => x.status == 'PO-Review');
                            $scope.PO_Approve = result.find(x => x.status == 'PO-Approve');
                            $scope.GR_New = result.find(x => x.status == 'GR-New');
                            $scope.GR_Request = result.find(x => x.status == 'GR-Request');
                            $scope.PI_Request = result.find(x => x.status == 'PI-Request');
                            $scope.PV_New = result.find(x => x.status == 'PV-New');
                            $scope.PV_Approve = result.find(x => x.status == 'PV-Approve');
                            $scope.PV_Review = result.find(x => x.status == 'PV-Review');
                        }, 0);
                    }
                    , error: AjaxError
                });
