    <script>

        app.controller('myCtrl', function ($scope, $http, $timeout, $filter) {
            $scope.today = new Date();
            $scope.viewMode = '';

            //$scope.lMonthShort = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'June', 'July', 'Aug', 'Sept', 'Oct', 'Nov', 'Dec'];
            $scope.lMonthShort = ['ม.ค.', 'ก.พ.', 'มี.ค.', 'เม.ย.', 'พ.ค.', 'มิ.ย.', 'ก.ค.', 'ส.ค.', 'ก.ย.', 'ต.ค.', 'พ.ย.', 'ธ.ค.'];

            $scope.ShortDT = function (dt) {
                var temp = ConvertToDate(dt);

                if ($scope.today.getFullYear() == temp.getFullYear()) {
                    if ($scope.today.getMonth() == temp.getMonth()) {
                        if ($scope.today.getDate() == temp.getDate()) {
                            return dt.split(' ')[1].substring(0, 5);
                        } else {
                            return temp.getDate() + ' ' + $scope.lMonthShort[temp.getMonth()];
                        }
                    } else {
                        return temp.getDate() + ' ' + $scope.lMonthShort[temp.getMonth()];
                    }
                } else {
                    return temp.getFullYear();
                }
            }

            $scope.LoadAlert = function () {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/Service/Alert'
                    , type: 'post'
                    , contentType: 'application/json'
                    , dataType: 'json'
                    , cache: false
                    , data: JSON.stringify({
