            //$scope.LoadAlert();
        }).directive('formatToCurrency', function ($filter) {
            return {
                scope: {
                    amount: '='
                },
                link: function (scope, el, attrs) {
                    scope.$watch('amount', function (newVal) {
                        if (el[0] !== document.activeElement) { // ไม่เปลี่ยนค่าตอนที่โฟกัสอยู่
                            el.val($filter('currency')(newVal || 0, '', 2));//.replace('.00', '')); // ตัด .00 ถ้าต้องการ
                        }
                    });

                    el.bind('focus', function () {
                        if (scope.amount != 0) {
                            el.val(parseFloat(scope.amount).toFixed(2));
                        } else {
                            el.val('');
                        }
                    });

                    el.bind('keydown', function (e) {
                        let val = el.val();
                        let key = e.key;
                        let keyCode = e.keyCode;

                        // Block multiple '.' (dot)
                        if ((keyCode === 190 || key === '.') && val.indexOf('.') !== -1) {
                            e.preventDefault();
                            return;
                        }

                        //block '-'
                        if (keyCode === 189 || key === '-') {
                            e.preventDefault();
                            return;
                        }

                        // Allow: backspace, delete, tab, escape, enter, arrows, Ctrl+A/C/V/X
                        if (
                            [8, 9, 13, 27, 46, 110, 190].includes(keyCode) ||
                            (keyCode >= 35 && keyCode <= 39) || // home, end, left, right
                            (keyCode === 65 && e.ctrlKey) || // Ctrl+A
                            (keyCode === 67 && e.ctrlKey) || // Ctrl+C
                            (keyCode === 86 && e.ctrlKey) || // Ctrl+V
                            (keyCode === 88 && e.ctrlKey)    // Ctrl+X
                        ) {
                            return;
                        }

                        // Allow only number keys
                        if ((keyCode < 48 || keyCode > 57) && (keyCode < 96 || keyCode > 105)) {
                            e.preventDefault();
                            return;
                        }

                        // Predict the value after key press
                        const input = el[0];
                        const start = input.selectionStart;
                        const end = input.selectionEnd;
                        const futureValue = val.substring(0, start) + key + val.substring(end);

                        if (futureValue.includes('.')) {
                            const decimalPart = futureValue.split('.')[1];
                            if (decimalPart.length > 2) {
                                e.preventDefault();
                            }
                        }
                    });

                    el.on('input', function () {
                        let val = el.val();
                        val = val.replace(/[^0-9.]/g, '');

                        if (val.includes('.')) {
                            let parts = val.split('.');
                            if (parts[1].length > 2) {
                                parts[1] = parts[1].substring(0, 2);
                            }
                            val = parts[0] + '.' + parts[1];
                        }

                        el.val(val);
                    });

                    el.bind('blur', function () {
                        var val = parseFloat(el.val().replace(/,/g, '')) || 0;
                        scope.$apply(function () {
                            scope.amount = val;
                        });
                        el.val($filter('currency')(val, '', 2));
                    });
                }
            }
        }).directive('formatToQuantity', function ($filter) {
            return {
                scope: {
                    amount: '='
                },
                link: function (scope, el, attrs) {
                    scope.$watch('amount', function (newVal) {
                        if (el[0] !== document.activeElement) { // ไม่เปลี่ยนค่าตอนที่โฟกัสอยู่
                            el.val($filter('currency')(newVal || 0, '', 8));//.replace('.00', '')); // ตัด .00 ถ้าต้องการ
                        }
                    });

                    el.bind('focus', function () {
                        if (scope.amount != 0) {
                            el.val(parseFloat(scope.amount).toFixed(8));
                        } else {
                            el.val('');
                        }
                    });

                    el.bind('keydown', function (e) {
                        let val = el.val();
                        let key = e.key;
                        let keyCode = e.keyCode;

                        // Block multiple '.' (dot)
                        if ((keyCode === 190 || key === '.') && val.indexOf('.') !== -1) {
                            e.preventDefault();
                            return;
                        }

                        //block '-'
                        if (keyCode === 189 || key === '-') {
                            e.preventDefault();
                            return;
                        }

                        // Allow: backspace, delete, tab, escape, enter, arrows, Ctrl+A/C/V/X
                        if (
                            [8, 9, 13, 27, 46, 110, 190].includes(keyCode) ||
                            (keyCode >= 35 && keyCode <= 39) || // home, end, left, right
                            (keyCode === 65 && e.ctrlKey) || // Ctrl+A
                            (keyCode === 67 && e.ctrlKey) || // Ctrl+C
                            (keyCode === 86 && e.ctrlKey) || // Ctrl+V
                            (keyCode === 88 && e.ctrlKey)    // Ctrl+X
                        ) {
                            return;
                        }

                        // Allow only number keys
                        if ((keyCode < 48 || keyCode > 57) && (keyCode < 96 || keyCode > 105)) {
                            e.preventDefault();
                            return;
                        }

                        // Predict the value after key press
                        const input = el[0];
                        const start = input.selectionStart;
                        const end = input.selectionEnd;
                        const futureValue = val.substring(0, start) + key + val.substring(end);

                        if (futureValue.includes('.')) {
                            const decimalPart = futureValue.split('.')[1];
                            if (decimalPart.length > 8) {
                                e.preventDefault();
                            }
                        }
                    });

                    el.on('input', function () {
                        let val = el.val();
                        val = val.replace(/[^0-9.]/g, '');

                        if (val.includes('.')) {
                            let parts = val.split('.');
                            if (parts[1].length > 2) {
                                parts[1] = parts[1].substring(0, 8);
                            }
                            val = parts[0] + '.' + parts[1];
                        }

                        el.val(val);
                    });

                    el.bind('blur', function () {
                        var val = parseFloat(el.val().replace(/,/g, '')) || 0;
                        scope.$apply(function () {
                            scope.amount = val;
                        });
                        el.val($filter('currency')(val, '', 8));
                    });
                }
            }
        }).directive('formatToNumber', function ($filter) {
            return {
                scope: {
                    amount: '='
                },
                link: function (scope, el, attrs) {
                    scope.$watch('amount', function (newVal) {
                        if (el[0] !== document.activeElement) { // ไม่เปลี่ยนค่าตอนที่โฟกัสอยู่
                            el.val($filter('number')(newVal || 0, '').replace('.00', '')); // ตัด .00 ถ้าต้องการ
                        }
                    });

                    //el.val($filter('currency')(scope.amount, ''));

                    el.bind('focus', function () {
                        if (scope.amount != 0) {
                            el.val(scope.amount);
                        } else {
                            el.val('');
                        }
                    });

                    el.bind('keydown', function (e) {
                        //block '-'
                        if (e.keyCode == 189) {
                            e.preventDefault();
                        }
                        // Allow: backspace, delete, tab, escape, enter
                        if ($.inArray(e.keyCode, [46, 8, 9, 27, 13]) !== -1 ||
                            // Allow: Ctrl+A
                            (e.keyCode == 65 && e.ctrlKey === true) ||
                            // Allow: Ctrl+C
                            (e.keyCode == 67 && e.ctrlKey === true) ||
                            // Allow: Ctrl+V
                            (e.keyCode == 86 && e.ctrlKey === true) ||
                            // Allow: Ctrl+X
                            (e.keyCode == 88 && e.ctrlKey === true) ||
                            // Allow: home, end, left, right
                            (e.keyCode >= 35 && e.keyCode <= 39)) {
                            // let it happen, don't do anything
                            return;
                        }

                        // Ensure that it is a number and stop the keypress
                        if ((e.shiftKey || (e.keyCode < 48 || e.keyCode > 57)) && (e.keyCode < 96 || e.keyCode > 105)) {
                            e.preventDefault();
                        }
                        if ($.isNumeric(e.key) == false) {
                            e.preventDefault();
                        }
                    });

                    el.on('input', function () {
                        let val = el.val();

                        val = val.replace(/[^0-9]/g, '');

                        el.val(val);
                    });

                    el.bind('blur', function () {
                        var val = parseFloat(el.val().replace(/,/g, '')) || 0;
                        scope.$apply(function () {
                            scope.amount = val;
                        });
                        el.val($filter('number')(val, '').replace('.00', ''));
                    });
                }
            }
        }).directive('myEnter', function () {
            return function (scope, element, attrs) {
                element.bind("keydown keypress", function (event) {
                    if (event.which === 13) {
                        scope.$apply(function () {
                            scope.$eval(attrs.myEnter);
                        });

                        event.preventDefault();
                    }
                });
            };
        }).directive('year', function () {
            return {
                restrict: 'A',
                link: function (scope, element) {
                    element.mask("0000");
                }
            };
        }).filter('range', function () {
            return function (input, total) {
                total = parseInt(total);

                for (var i = 0; i < total; i++) {
                    input.push(i);
                }

                return input;
            };
        }).filter('truncateDecimal', function () {
            return function (input, digits) {
                if (input === null || input === undefined || input === '') return input;

                digits = digits || 8;

                // แปลงเป็น string เพื่อไม่ให้ JS ปัดเอง
                let str = input.toString();

                // แยกส่วนจำนวนเต็ม / ทศนิยม
                let parts = str.split('.');
                let integerPart = parts[0];
                let decimalPart = parts[1] || '';

                // ตัดทศนิยม (ไม่ปัด)
                if (decimalPart.length > digits) {
                    decimalPart = decimalPart.substring(0, digits);
                }

                // ใส่ comma ให้จำนวนเต็ม
                integerPart = integerPart.replace(/\B(?=(\d{3})+(?!\d))/g, ",");

                // รวมกลับ
                return decimalPart
                    ? integerPart + '.' + decimalPart
                    : integerPart;
            };
        });;
    </script>
</body>
</html>