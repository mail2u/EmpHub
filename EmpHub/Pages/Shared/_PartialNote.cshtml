<script>
    app.controller('NoteCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.$parent.LoadNote = function (refId) {
            $scope.id = refId;

            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Note/DataList',
                headers: { 'authorization': 'Bearer @User.AccessToken()' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                data: JSON.stringify({
                    refId: $scope.id
                    , userId: '@User.UserId()'
                }),
                cache: false,
                success: function (result) {
                    $timeout(function () {
                        $scope.lNote = result;
                    }, 0);
                }
            });
        }

        $scope.CreateNote = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Note/Create',
                headers: { 'authorization': 'Bearer @User.AccessToken()' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    refId: $scope.id
                    ,
                    userId: '@User.UserId()'
                }),
                success: function (result) {
                    $timeout(async function () {
                        $scope.$parent.LoadNote($scope.id);
                    }, 0);
                }
            });
        }

        $scope.DeleteNote = function (x) {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Note/Delete',
                headers: { 'authorization': 'Bearer @User.AccessToken()' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    noteId: x.noteId
                    ,
                    userId: '@User.UserId()'
                }),
                success: function (result) {
                    $timeout(async function () {
                        $scope.$parent.LoadNote($scope.id);
                    }, 0);
                }
            });
        }


        $scope.UpdateNote = function (x) {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Note/Update',
                headers: { 'authorization': 'Bearer @User.AccessToken()' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    noteId: x.noteId
                    ,
                    userId: '@User.UserId()'
                    ,
                    detail: x.detail
                }),
                success: function (result) {
                    $timeout(async function () {
                    }, 0);
                }
            });
        }
    });
</script>