@{
}

<div class="education-panel">
    <div class="education-panel-header">
        <span><i class="fas fa-graduation-cap text-primary me-2"></i>ประวัติการศึกษา</span>
        <a class="btn btn-sm btn-soft-primary text-primary" href="@Url.Page("/Service/FormCreate/FormUpdateDataEducation")?mode=EDIT_EDUCATION&id={{userId}}" target="_blank">
            <i class="bi bi-pencil-fill me-1"></i>แก้ไข
        </a>
    </div>
    <div class="education-panel-body">
        <div class="empty-state" ng-show="!lEducation || lEducation.length == 0">ยังไม่มีข้อมูลประวัติการศึกษา</div>
        <div ng-show="lEducation.length > 0">
            <div class="education-history-item" ng-repeat="x in educationHistoryItems()">
                <div class="education-year">
                    <div>{{ educationYearRange(x) }}</div>
                    <div class="small text-muted fw-normal">{{ educationDurationText(x) }}</div>
                </div>
                <div class="education-line"><span class="education-dot"></span></div>
                <div class="education-card">
                    <span class="education-icon"><i class="fas fa-graduation-cap"></i></span>
                    <div class="min-w-0">
                        <div class="fs-5 fw-bold text-dark mb-2">{{ valueOrDash(x.degreeName || x.levelName) }}</div>
                        <div class="text-primary fw-semibold mb-2">{{ valueOrDash(x.programName || x.major) }}</div>
                        <div class="text-muted mb-2">{{ valueOrDash(x.institutionDesc || x.institution) }}</div>
                        <div class="text-muted">เกรดเฉลี่ย {{ educationGradeText(x.grade) }}</div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-soft-success text-success">สำเร็จการศึกษา</span>
                        <button type="button" class="btn btn-sm btn-light" title="เมนูเพิ่มเติม">
                            <i class="bi bi-three-dots-vertical"></i>
                        </button>
                    </div>
                </div>
            </div>
          @*   <div class="text-center mt-2">
                <a class="btn btn-outline-primary px-5" href="@Url.Page("/Service/FormCreate/FormUpdateDataEducation")?mode=EDIT_EDUCATION&id={{userId}}" target="_blank">
                    <i class="bi bi-plus-lg me-2"></i>เพิ่มข้อมูลการศึกษา
                </a>
            </div> *@
        </div>
    </div>
</div>
