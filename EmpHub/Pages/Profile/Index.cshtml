@page
@model EmpHub.Pages.Profile.IndexModel
@{
    ViewData["Title"] = "โปรไฟล์พนักงาน";
    var token = User.AccessToken(HttpContext);
}

<style>
    .profile-shell {
        display: grid;
        grid-template-columns: 340px minmax(0, 1fr);
        gap: 24px;
        align-items: start;
    }

    .profile-card,
    .profile-panel {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
    }

    .profile-card-cover {
        height: 104px;
        background: linear-gradient(135deg, #1e3b92 0%, #2d6cdf 55%, #fbde14 55%, #fbde14 100%);
    }

    .profile-avatar {
        width: 104px;
        height: 104px;
        margin: -52px auto 16px;
        border: 4px solid #fff;
        background: #f8fafc;
    }

    .profile-meta {
        display: grid;
        gap: 10px;
    }

    .profile-meta-row {
        display: grid;
        grid-template-columns: 28px minmax(0, 1fr);
        gap: 10px;
        align-items: start;
    }

    .profile-kpi {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
    }

    .profile-kpi-item {
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 12px;
        background: #f9fafb;
        min-height: 78px;
    }

    .profile-tabs {
        overflow-x: auto;
        flex-wrap: nowrap;
    }

    .profile-section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 18px;
        color: #283c50;
        font-weight: 700;
        font-size: 18px;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
    }

    .info-field {
        min-height: 68px;
        padding: 12px;
        border: 1px solid #edf0f4;
        border-radius: 8px;
        background: #fcfcfc;
    }

    .info-label {
        color: #64748b;
        font-size: 12px;
        margin-bottom: 6px;
    }

    .info-value {
        color: #283c50;
        font-weight: 600;
        word-break: break-word;
    }

    .timeline {
        position: relative;
        display: grid;
        gap: 14px;
    }

    .timeline-item {
        display: grid;
        grid-template-columns: 22px minmax(0, 1fr);
        gap: 12px;
    }

    .timeline-dot {
        width: 12px;
        height: 12px;
        margin-top: 6px;
        border-radius: 50%;
        background: #1e3b92;
        box-shadow: 0 0 0 4px #e5ecff;
    }

    .timeline-content {
        border: 1px solid #edf0f4;
        border-radius: 8px;
        padding: 14px 16px;
        background: #fff;
    }

    .document-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
    }

    .document-item {
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 16px;
        background: #fff;
        min-height: 150px;
        display: flex;
        flex-direction: column;
    }

    .empty-state {
        border: 1px dashed #cbd5e1;
        border-radius: 8px;
        padding: 24px;
        text-align: center;
        color: #64748b;
        background: #f8fafc;
    }

    @@media (max-width: 1199.98px) {
        .profile-shell {
            grid-template-columns: 1fr;
        }

        .info-grid,
        .document-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 767.98px) {
        .info-grid,
        .document-grid,
        .profile-kpi {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="w-100" ng-controller="DataCtrl">
    @section PageHeader {
        <div class="page-header">
            <div class="page-header-left d-flex align-items-center">
                <div class="page-header-title">
                    <h5 class="m-b-10">โปรไฟล์</h5>
                </div>
                <ul class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Page("/Index")">หน้าหลัก</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Page("/Employee/Index")">พนักงาน</a></li>
                    <li class="breadcrumb-item">{{ displayName() }}</li>
                </ul>
            </div>
        </div>
    }

    <div class="profile-shell">
        <aside>
            <div class="profile-card overflow-hidden mb-3">
                <div class="profile-card-cover"></div>
                <div class="p-4">
                    <div class="profile-avatar rounded-circle overflow-hidden d-flex align-items-center justify-content-center">
                        <img src="~/Images/icon-user.png" width="78" alt="รูปพนักงาน" />
                    </div>
                    <div class="text-center mb-4">
                        <div class="fs-4 fw-bold text-dark">{{ displayName() }}</div>
                        <div class="text-primary fw-semibold">{{ valueOrDash(iEmployee.positionDesc) }}</div>
                        <div class="text-muted">{{ valueOrDash(iEmployee.departmentDesc) }}</div>
                    </div>

                    <div class="profile-kpi mb-4">
                        <div class="profile-kpi-item">
                            <div class="info-label">รหัสพนักงาน</div>
                            <div class="info-value">{{ valueOrDash(iEmployee.employeeCode) }}</div>
                        </div>
                        <div class="profile-kpi-item">
                            <div class="info-label">อายุงาน</div>
                            <div class="info-value">{{ valueOrDash(iEmployee.work_day) }}</div>
                        </div>
                        <div class="profile-kpi-item">
                            <div class="info-label">สถานะ</div>
                            <div class="info-value">{{ valueOrDash(iEmployee.employeeStatus) }}</div>
                        </div>
                        <div class="profile-kpi-item">
                            <div class="info-label">ประเภท</div>
                            <div class="info-value">{{ valueOrDash(iEmployee.employeeType || iEmployee.employeeDesc) }}</div>
                        </div>
                    </div>

                    <div class="profile-meta">
                        <div class="profile-meta-row">
                            <i class="bi bi-envelope-fill text-primary"></i>
                            <div class="text-truncate">{{ valueOrDash(iEmployee.email || iPersonal.email) }}</div>
                        </div>
                        <div class="profile-meta-row">
                            <i class="bi bi-phone-fill text-primary"></i>
                            <div>{{ valueOrDash(iPersonal.phoneNo) }}</div>
                        </div>
                        <div class="profile-meta-row">
                            <i class="bi bi-geo-alt-fill text-primary"></i>
                            <div>{{ addressText() }}</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="profile-card p-4 mb-3">
                <div class="info-label mb-2">หัวหน้างาน</div>
                <div class="d-flex align-items-center">
                    <img src="~/Images/icon-user.png" class="rounded-circle me-3" width="42" alt="หัวหน้างาน" />
                    <div class="min-w-0">
                        <div class="fw-bold text-dark text-truncate">{{ valueOrDash(iEmployee.supervisorName) }}</div>
                        <div class="text-muted text-truncate">{{ valueOrDash(iEmployee.supervisorPosition) }}</div>
                    </div>
                </div>
            </div>

            <div class="profile-card p-4">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="fw-bold text-dark">ความครบถ้วนของข้อมูล</div>
                    <div class="badge bg-soft-primary text-primary">{{ profileScore() }}%</div>
                </div>
                <div class="progress ht-5 mb-3">
                    <div class="progress-bar bg-primary" role="progressbar" ng-style="{ width: profileScore() + '%' }"></div>
                </div>
                <div class="small text-muted">ประเมินจากข้อมูลพนักงาน ส่วนบุคคล ประวัติการทำงาน การศึกษา และการฝึกอบรม</div>
            </div>
        </aside>

        <section class="profile-panel overflow-hidden">
            <nav class="border-bottom px-4 pt-2 bg-gray-100">
                <div class="nav nav-underline profile-tabs" id="nav-tab" role="tablist">
                    <a class="nav-link text-nowrap active" href="?tab=nav-employee" data-bs-toggle="tab" data-bs-target="#nav-employee">ข้อมูลพนักงาน</a>
                    <a class="nav-link text-nowrap" href="?tab=nav-personal" data-bs-toggle="tab" data-bs-target="#nav-personal">ข้อมูลส่วนบุคคล</a>
                    <a class="nav-link text-nowrap" href="?tab=nav-job" data-bs-toggle="tab" data-bs-target="#nav-job">ประวัติการทำงาน</a>
                    <a class="nav-link text-nowrap" href="?tab=nav-education" data-bs-toggle="tab" data-bs-target="#nav-education">ประวัติการศึกษา</a>
                    <a class="nav-link text-nowrap" href="?tab=nav-training" data-bs-toggle="tab" data-bs-target="#nav-training">ประวัติการฝึกอบรม</a>
                    <a class="nav-link text-nowrap" href="?tab=nav-document" data-bs-toggle="tab" data-bs-target="#nav-document">เอกสารที่เกี่ยวข้อง</a>
                </div>
            </nav>

            <div class="tab-content p-4">
                <div class="tab-pane fade show active" id="nav-employee" role="tabpanel" tabindex="0">
                    <div class="profile-section-title"><i class="bi bi-building-fill text-primary"></i> ข้อมูลพนักงาน</div>
                    <div class="info-grid">
                        <div class="info-field"><div class="info-label">รหัสพนักงาน</div><div class="info-value">{{ valueOrDash(iEmployee.employeeCode) }}</div></div>
                        <div class="info-field"><div class="info-label">วันเข้างาน</div><div class="info-value">{{ valueOrDash(iEmployee.join_date) }}</div></div>
                        <div class="info-field"><div class="info-label">วันบรรจุงาน</div><div class="info-value">{{ valueOrDash(iEmployee.probation_end_date) }}</div></div>
                        <div class="info-field"><div class="info-label">ด้าน</div><div class="info-value">{{ valueOrDash(iEmployee.divisionDesc) }}</div></div>
                        <div class="info-field"><div class="info-label">สายงาน</div><div class="info-value">{{ valueOrDash(iEmployee.departmentDesc) }}</div></div>
                        <div class="info-field"><div class="info-label">ฝ่าย</div><div class="info-value">{{ valueOrDash(iEmployee.sectionDesc) }}</div></div>
                        <div class="info-field"><div class="info-label">ตำแหน่งงาน</div><div class="info-value">{{ valueOrDash(iEmployee.positionDesc) }}</div></div>
                        <div class="info-field"><div class="info-label">ระดับพนักงาน</div><div class="info-value">{{ valueOrDash(iEmployee.levelDesc) }}</div></div>
                        <div class="info-field"><div class="info-label">เกรด</div><div class="info-value">{{ valueOrDash(iEmployee.grade) }}</div></div>
                    </div>
                </div>

                <div class="tab-pane fade" id="nav-personal" role="tabpanel" tabindex="0">
                    <div class="profile-section-title"><i class="bi bi-person-vcard-fill text-primary"></i> ข้อมูลส่วนบุคคล</div>
                    <div class="info-grid">
                        <div class="info-field"><div class="info-label">ชื่อ-นามสกุล</div><div class="info-value">{{ valueOrDash(iPersonal.prefix_th) }} {{ valueOrDash(iPersonal.firstname_th) }} {{ valueOrDash(iPersonal.lastname_th) }}</div></div>
                        <div class="info-field"><div class="info-label">ชื่อ-นามสกุลภาษาอังกฤษ</div><div class="info-value">{{ valueOrDash(iPersonal.prefix_en) }} {{ valueOrDash(iPersonal.firstname_en) }} {{ valueOrDash(iPersonal.lastname_en) }}</div></div>
                        <div class="info-field"><div class="info-label">ชื่อเล่น</div><div class="info-value">{{ valueOrDash(iPersonal.nickname) }}</div></div>
                        <div class="info-field"><div class="info-label">วันเกิด</div><div class="info-value">{{ valueOrDash(iPersonal.birth_date) }}</div></div>
                        <div class="info-field"><div class="info-label">อายุ</div><div class="info-value">{{ valueOrDash(iPersonal.age) }}</div></div>
                        <div class="info-field"><div class="info-label">เพศ</div><div class="info-value">{{ valueOrDash(iPersonal.sex) }}</div></div>
                        <div class="info-field"><div class="info-label">สัญชาติ</div><div class="info-value">{{ valueOrDash(iPersonal.nationality) }}</div></div>
                        <div class="info-field"><div class="info-label">ศาสนา</div><div class="info-value">{{ valueOrDash(iPersonal.religion) }}</div></div>
                        <div class="info-field"><div class="info-label">สถานภาพ</div><div class="info-value">{{ valueOrDash(iPersonal.maritalStatus) }}</div></div>
                    </div>
                </div>

                <div class="tab-pane fade" id="nav-job" role="tabpanel" tabindex="0">
                    <div class="profile-section-title"><i class="bi bi-briefcase-fill text-primary"></i> ประวัติการทำงาน</div>
                    <div class="empty-state" ng-show="!lJobExperience || lJobExperience.length == 0">ยังไม่มีข้อมูลประวัติการทำงาน</div>
                    <div class="timeline" ng-show="lJobExperience.length > 0">
                        <div class="timeline-item" ng-repeat="x in lJobExperience">
                            <div class="timeline-dot"></div>
                            <div class="timeline-content">
                                <div class="d-flex flex-wrap justify-content-between gap-2 mb-1">
                                    <div class="fw-bold text-dark">{{ valueOrDash(x.position) }}</div>
                                    <div class="text-muted">{{ dateRangeText(x.from_date, x.end_date) }}</div>
                                </div>
                                <div class="text-primary fw-semibold mb-2">{{ valueOrDash(x.company) }}</div>
                                <div class="text-muted">{{ valueOrDash(x.description) }}</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="nav-education" role="tabpanel" tabindex="0">
                    <div class="profile-section-title"><i class="fas fa-graduation-cap text-primary"></i> ประวัติการศึกษา</div>
                    <div class="empty-state" ng-show="!lEducation || lEducation.length == 0">ยังไม่มีข้อมูลประวัติการศึกษา</div>
                    <div class="info-grid" ng-show="lEducation.length > 0">
                        <div class="info-field" ng-repeat="x in lEducation">
                            <div class="info-label">{{ valueOrDash(x.year) }}</div>
                            <div class="info-value mb-1">{{ valueOrDash(x.degreeName || x.levelName) }}</div>
                            <div class="text-muted">{{ valueOrDash(x.institution) }}</div>
                            <div class="text-muted" ng-show="x.programName || x.major">{{ valueOrDash(x.programName) }} {{ valueOrDash(x.major) }}</div>
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="nav-training" role="tabpanel" tabindex="0">
                    <div class="profile-section-title"><i class="bi bi-patch-check-fill text-primary"></i> ประวัติการฝึกอบรม</div>
                    <div class="empty-state" ng-show="!lTraining || lTraining.length == 0">ยังไม่มีข้อมูลประวัติการฝึกอบรม</div>
                    <div class="timeline" ng-show="lTraining.length > 0">
                        <div class="timeline-item" ng-repeat="x in lTraining">
                            <div class="timeline-dot"></div>
                            <div class="timeline-content">
                                <div class="d-flex flex-wrap justify-content-between gap-2 mb-1">
                                    <div class="fw-bold text-dark">{{ valueOrDash(x.license) }}</div>
                                    <div class="text-muted">{{ valueOrDash(x.issueDate) }}</div>
                                </div>
                                <div class="text-primary fw-semibold mb-2">{{ valueOrDash(x.organization) }}</div>
                                <div class="text-muted">{{ valueOrDash(x.description) }}</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="nav-document" role="tabpanel" tabindex="0">
                    <div class="profile-section-title"><i class="bi bi-folder-check text-primary"></i> เอกสารที่เกี่ยวข้อง</div>
                    <div class="document-grid">
                        <div class="document-item" ng-repeat="x in lRelatedDocument">
                            <div class="d-flex align-items-start mb-3">
                                <div class="avatar-text avatar-md bg-soft-primary text-primary me-3">
                                    <i class="{{ x.icon }}"></i>
                                </div>
                                <div class="min-w-0">
                                    <div class="fw-bold text-dark">{{ x.title }}</div>
                                    <div class="small text-muted">{{ x.desc }}</div>
                                </div>
                            </div>
                            <div class="mt-auto d-flex align-items-center justify-content-between">
                                <span class="badge {{ x.statusClass }}">{{ x.status }}</span>
                                <a class="btn btn-sm btn-light" href="{{ x.url }}" target="_blank">
                                    <i class="bi bi-box-arrow-up-right me-1"></i> เปิด
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

<script>
    app.controller('DataCtrl', function ($scope, $http, $timeout, $filter) {
        var tabName = '@Model.tab';
        $scope.userId = '@Model.id' || '@User.UserId()';
        $scope.iPersonal = {};
        $scope.iEmployee = {};
        $scope.iAddress = {};
        $scope.lJobExperience = [];
        $scope.lEducation = [];
        $scope.lTraining = [];
        $scope.lRelatedDocument = [
            {
                title: 'PDPA',
                desc: 'เอกสารยินยอมและข้อมูลส่วนบุคคล',
                icon: 'bi bi-shield-check',
                status: 'เอกสารสำคัญ',
                statusClass: 'bg-soft-primary text-primary',
                url: '@Url.Page("/Service/FormCreate/FormPdpaEmployee")?mode=FORM_PDPA_EMPLOYEE'
            },
            {
                title: 'WFH',
                desc: 'เอกสารหรือคำขอปฏิบัติงานจากที่บ้าน',
                icon: 'bi bi-house-check',
                status: 'เกี่ยวกับการทำงาน',
                statusClass: 'bg-soft-success text-success',
                url: '@Url.Page("/Service/FormCreate/FormWfhEmployee")?mode=FORM_WFH_EMPLOYEE'
            },
            {
                title: 'Job Description',
                desc: 'หน้าที่ ความรับผิดชอบ และขอบเขตงาน',
                icon: 'bi bi-file-earmark-text',
                status: 'ข้อมูลตำแหน่ง',
                statusClass: 'bg-soft-warning text-warning',
                url: '@Url.Page("/Service/FormCreate/FormUpdateDataEmployee")?mode=EDIT_EMPLOYEE&id=' + $scope.userId
            }
        ];

        if (tabName != '') {
            const triggerEl = document.querySelector(`#nav-tab [data-bs-target="#${tabName}"]`);

            if (triggerEl) {
                new bootstrap.Tab(triggerEl).show();
            }
        }

        $scope.valueOrDash = function (value) {
            return value === null || value === undefined || value === '' ? '-' : value;
        }

        $scope.displayName = function () {
            var fullnameTh = [$scope.iPersonal.firstname_th, $scope.iPersonal.lastname_th].filter(Boolean).join(' ');
            var fullnameEn = [$scope.iPersonal.firstname_en, $scope.iPersonal.lastname_en].filter(Boolean).join(' ');
            return fullnameTh || fullnameEn || $scope.iEmployee.fullname || 'โปรไฟล์พนักงาน';
        }

        $scope.addressText = function () {
            var address = [
                $scope.iAddress.live_home || $scope.iAddress.home,
                $scope.iAddress.live_road || $scope.iAddress.road,
                $scope.iAddress.live_subDistrictName || $scope.iAddress.subDistrictName,
                $scope.iAddress.live_districtName || $scope.iAddress.districtName,
                $scope.iAddress.live_provinceName || $scope.iAddress.provinceName,
                $scope.iAddress.live_postcode || $scope.iAddress.postcode
            ].filter(Boolean).join(' ');

            return address || '-';
        }

        $scope.dateRangeText = function (fromDate, endDate) {
            var fromText = fromDate ? $filter('date')(fromDate, 'MMM yyyy') : '-';
            var endText = endDate ? $filter('date')(endDate, 'MMM yyyy') : 'ปัจจุบัน';
            return fromText + ' - ' + endText;
        }

        $scope.profileScore = function () {
            var checks = [
                $scope.iPersonal.firstname_th,
                $scope.iEmployee.employeeCode,
                $scope.iEmployee.positionDesc,
                $scope.iEmployee.departmentDesc,
                $scope.iPersonal.phoneNo,
                $scope.iEmployee.email || $scope.iPersonal.email,
                $scope.lJobExperience.length,
                $scope.lEducation.length,
                $scope.lTraining.length
            ];
            var completed = checks.filter(function (x) { return !!x; }).length;
            return Math.round((completed / checks.length) * 100);
        }

        $scope.CalcAge = function () {
            $scope.iPersonal.age = '';

            if ($scope.iPersonal.birth_date) {
                const b = ConvertToDate($scope.iPersonal.birth_date);
                const c = new Date();

                let years = c.getFullYear() - b.getFullYear();
                let months = c.getMonth() - b.getMonth();
                let days = c.getDate() - b.getDate();

                if (days < 0) {
                    months--;
                    const prevMonth = new Date(c.getFullYear(), c.getMonth(), 0);
                    days += prevMonth.getDate();
                }

                if (months < 0) {
                    years--;
                    months += 12;
                }

                if (years > 0) {
                    $scope.iPersonal.age = years + ' ปี ';
                }
                if (months > 0) {
                    $scope.iPersonal.age += months + ' เดือน ';
                }
                if (days > 0) {
                    $scope.iPersonal.age += days + ' วัน';
                }
            }
        }

        $scope.CalcWorkDay = function () {
            $scope.iEmployee.work_day = '';

            if ($scope.iEmployee.join_date) {
                const b = ConvertToDate($scope.iEmployee.join_date);
                const c = new Date();

                let years = c.getFullYear() - b.getFullYear();
                let months = c.getMonth() - b.getMonth();
                let days = c.getDate() - b.getDate();

                if (days < 0) {
                    months--;
                    const prevMonth = new Date(c.getFullYear(), c.getMonth(), 0);
                    days += prevMonth.getDate();
                }

                if (months < 0) {
                    years--;
                    months += 12;
                }

                if (years > 0) {
                    $scope.iEmployee.work_day = years + ' ปี ';
                }
                if (months > 0) {
                    $scope.iEmployee.work_day += months + ' เดือน ';
                }
                if (days > 0) {
                    $scope.iEmployee.work_day += days + ' วัน';
                }
            }
        }

        $scope.LoadPersonal = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/UserPersonal',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
