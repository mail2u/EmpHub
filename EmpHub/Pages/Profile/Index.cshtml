        $scope.LoadRequiredDocuments = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Service/RequiredDocumentList',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    userId: $scope.userId,
                    userBy: '@User.UserId()'
                }),
