@page
@model EmpHub.Pages.Profile.IndexModel
@{
    ViewData["Title"] = "EmpHub";
    var token = User.AccessToken(HttpContext);
}
<div class="w-100" ng-controller="DataCtrl">
    @section PageHeader {
        <!-- [ page-header ] start -->
        <div class="page-header">
            <div class="page-header-left d-flex align-items-center">
                <div class="page-header-title">
                    <h5 class="m-b-10">Employees</h5>
                </div>
                <ul class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Page("/Index")">Home</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Page("/Employee/Index")">Employees</a></li>
                    <li class="breadcrumb-item">Info {{ $parent.fullname }}</li>
                </ul>
            </div>
        </div>
    }

    <div class="d-flex">
        @* Profile *@
        <div class=" me-4" style="width:400px">
            <div class="rounded-4 border overflow-hidden position-relative mb-4">
                <div class="bg-light-blue" style="height:120px;">
                </div>
                <div class="bg-white p-4">
                    <div class="position-absolute start-50 translate-middle-x" style="top:75px;">
                        <div class="border border-white rounded-pill overflow-hidden shadow">
                            <img src="~/Images/icon-user.png" width="100px" />
                        </div>
                    </div>
                    <div class="text-center pb-3" style="padding-top: 50px;">
                        <div class="text-dark fs-4 fw-bolder" style="line-height:20px;">
                            {{ iPersonal.firstname_en }} {{ iPersonal.lastname_en }}
                        </div>
                        <div class="text-blue fs-5">{{ iEmployee.positionDesc }}</div>
                    </div>
                    <div class="rounded-3 bg-light text-dark-gray p-3 mb-4">
                        <table class="">
                            <tbody>
                                <tr>
                                    <td width="30px" class="p-2 align-top"><i class="bi bi-envelope-fill"></i></td>
                                    <td class="p-2">{{ iEmployee.email }}</td>
                                </tr>
                                <tr>
                                    <td class="p-2 align-top"><i class="bi bi-phone-fill"></i></td>
                                    <td class="p-2">{{ iPersonal.phoneNo }}</td>
                                </tr>
                                <tr>
                                    <td class="p-2 align-top"><i class="bi bi-geo-alt-fill"></i></td>
                                    <td class="p-2">
                                        {{ iAddress.home }}
                                        <span ng-show="iAddress.road != ''">ถ.{{ iAddress.road }}</span>
                                        {{ iAddress.subDistrictName }}
                                        {{ iAddress.districtName }}
                                        {{ iAddress.provinceName }}
                                        {{ iAddress.postcode }}
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div>
                        <a class="btn btn-primary" href="@Url.Page("Edit")?id=@Model.id">
                            <i class="bi bi-pen-fill me-2"></i> Edit Profile
                        </a>
                    </div>
                </div>
            </div>
            @* Report To *@
            <div class="rounded-4 bg-white border p-4">
                <div class="text-gray mb-2">
                    REPORT TO
                </div>
                <div class="d-flex">
                    <div class="overflow-hidden me-2">
                        <img src="~/Images/icon-user.png" class="rounded-pill" width="35px" />
                    </div>
                    <div>
                        <div class="text-dark fw-bolder">{{ iEmployee.supervisorName }}</div>
                        <div class="text-gray">{{ iEmployee.supervisorPosition }}</div>
                    </div>
                </div>
            </div>
        </div>
        @* Other *@
        <div class="flex-fill bg-white overflow-hidden rounded-4 border">
            <nav class="border-bottom px-4 pt-2 bg-gray-100">
                <div class="nav nav-underline" id="nav-tab" role="tablist">
                    <a class="nav-link active" href="?tab=nav-profile"
                       data-bs-target="#nav-profile">
                        Profile
                    </a>
                    <a class="nav-link" href="?tab=nav-talent"
                       data-bs-target="#nav-talent">
                        Talent
                    </a>
                    <a class="nav-link" href="?tab=nav-lifecycle"
                       data-bs-target="#nav-lifecycle">
                        Lifecycle
                    </a>
                    <a class="nav-link" href="?tab=nav-document"
                       data-bs-target="#nav-document">
                        Document
                    </a>
                </div>
            </nav>
            <div class="tab-content p-4" id="nav-tabContent">
                <div class="tab-pane fade show active" id="nav-profile" role="tabpanel" aria-labelledby="nav-employee-tab" tabindex="0">
                    @* Profile *@
                    <div class="text-dark fs-5 fw-bolder d-flex align-items-center mb-3">
                        <i class="bi bi-person-vcard-fill fs-4 me-2 text-blue"></i> Basic Infomation
                    </div>
                    <div class="row">
                        <div class="col-sm-6 mb-3">
                            <div class="text-gray">FULL NAME</div>
                            <div class="text-dark">{{ iPersonal.firstname_th }} {{ iPersonal.lastname_th }}</div>
                        </div>
                        <div class="col-sm-6 mb-3">
                            <div class="text-gray">NICKNAME</div>
                            <div class="text-dark">{{ iPersonal.nickname }}</div>
                        </div>
                        <div class="col-sm-6 mb-3">
                            <div class="text-gray">DEPARTMENT</div>
                            <div class="text-dark">{{ iEmployee.departmentDesc }}</div>
                        </div>
                        <div class="col-sm-6 mb-3">
                            <div class="text-gray">EMPLOYEE ID</div>
                            <div class="text-dark">{{ iEmployee.employeeCode }}</div>
                        </div>
                        <div class="col-sm-6 mb-3">
                            <div class="text-gray">EMPLOYMENT TYPE</div>
                            <div class="text-dark">{{ iEmployee.employeeDesc }}</div>
                        </div>
                        <div class="col-sm-6 mb-3">
                            <div class="text-gray">HIRE DATE</div>
                            <div class="text-dark">{{ iEmployee.join_date }}</div>
                        </div>
                    </div>
                    <hr class="my-3" />
                    @* Job Experience *@
                    <div class="text-dark fs-5 fw-bolder d-flex align-items-center mb-3">
                        <i class="bi bi-person-vcard-fill fs-4 me-2 text-blue"></i> Job Experience
                    </div>
                    <table>
                        <tbody>
                            <tr ng-repeat="x in lJobExperience">
                                <td class="align-top pt-1 px-2">
                                    <i class="bi bi-circle-fill {{ $index == 0 ? 'text-blue shadow-sm' : '' }}"></i>
                                </td>
                                <td>
                                    <div class="text-dark fw-bolder">{{ x.company }}</div>
                                    <div class="text-gray">{{ x.position }}</div>
                                    <div class="text-light">{{ x.from_date | date:'MMM yyyy' }} - {{ x.end_date | date:'MMM yyyy' }}</div>
                                </td>
                                <td>
                                    {{ x.description }}
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="d-flex">
                        <div>
                        </div>

                    </div>
                    <hr class="my-3" />
                    <div class="row">
                        <div class="col-sm-6 mb-3">
                            @* Eductaion *@
                            <div class="text-dark fs-5 fw-bolder d-flex align-items-center mb-3">
                                <i class="fas fa-graduation-cap fs-4 me-2 text-blue"></i> Education
                            </div>
                            <div class="mt-3" ng-repeat="x in lEducation">
                                <div class="text-dark fw-bolder">{{ x.levelName }}</div>
                                <div class="text-gray">{{ x.institution }}</div>
                                <div class="text-light" ng-show="x.year != ''">class of {{ x.year }}</div>
                            </div>
                        </div>
                        <div class="col-sm-6 mb-3">
                            @* Training History *@
                            <div class="text-dark fs-5 fw-bolder d-flex align-items-center mb-3">
                                <i class="bi bi-patch-check fs-4 me-2 text-blue"></i> Training History
                            </div>
                            <div class="mt-3" ng-repeat="x in lTraining">
                                <div class="text-dark fw-bolder">{{ x.organization }}</div>
                                <div class="text-gray">{{ x.license }} {{ issueDate }}</div>
                            </div>
                        </div>
                    </div>
                    @* Document *@
                    <div class="text-dark fs-5 fw-bolder d-flex align-items-center mb-3">
                        <i class="bi bi-file-earmark-text-fill fs-4 me-2 text-blue"></i> Documents
                    </div>
                    <div class="border border-dash text-gray-500 text-center p-3 rounded-3">
                        <i class="bi bi-cloud-arrow-up-fill fs-3"></i>
                        <div class="fw-bolder">Upload New Document</div>
                        <div class="">PDF, DOCX up to 10MB</div>
                    </div>
                </div>
                <div class="tab-pane fade" id="nav-talent" role="tabpanel" aria-labelledby="nav-talent-tab" tabindex="0">
                    @* Partial Address *@
                </div>
                <div class="tab-pane fade" id="nav-lifecycle" role="tabpanel" aria-labelledby="nav-lifecycle-tab" tabindex="0">
                    @* Lifecycle *@
                    @*  <partial name="Employee/_PartialUserEducation" /> *@
                </div>
                <div class="tab-pane fade" id="nav-document" role="tabpanel" aria-labelledby="nav-document-tab" tabindex="0">
                    @* Document *@
                    @* <partial name="Employee/_PartialUserTraining" /> *@
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    app.controller('DataCtrl', function ($scope, $http, $timeout, $filter) {
        var tabName = '@Model.tab';
        $scope.userId = '@Model.id';

        if (tabName != '') {
            const triggerEl = document.querySelector(
                `#nav-tab [data-bs-target="#${tabName}"]`
            );

            if (triggerEl) {
                new bootstrap.Tab(triggerEl).show();
            }
        }

        $scope.LoadPersonal = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/UserPersonal',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    userId: $scope.userId
                    , create_by: '@User.UserId()'
                }),
                success: function (result) {
                    $timeout(async function () {
                        $scope.iPersonal = result.data;
                        $scope.can_view = result.can_view;
                        $scope.can_edit = result.can_edit;
                    }, 0);
                }, error: AjaxError
            });
        }
        $scope.LoadPersonal();

        $scope.LoadEmployee = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/UserEmployee',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    userId: $scope.userId
                    , create_by: '@User.UserId()'
                }),
                success: function (result) {
                    $timeout(async function () {
                        $scope.iEmployee = result.data;
                    }, 0);
                }, error: AjaxError
            });
        }
        $scope.LoadEmployee();

        $scope.LoadAddress = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/UserAddress',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    userId: $scope.userId
                    , create_by: '@User.UserId()'
                }),
                success: function (result) {
                    $timeout(async function () {
                        $scope.iAddress = result.data;
                    }, 0);
                }, error: AjaxError
            });
        }
        $scope.LoadAddress();


        $scope.LoadJobExperience = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/UserJobExperience',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    userId: $scope.userId
                    , create_by: '@User.UserId()'
                }),
                success: function (result) {
                    $timeout(async function () {
                        $scope.lJobExperience = result.data;
                        if ($scope.lData.length > 0) {
                            $scope.lData = $scope.lData.map((x) => {
                                x.from_date = x.fromDate != '' ? ConvertToDate(x.fromDate) : '';
                                x.end_date = x.endDate != '' ? ConvertToDate(x.endDate) : '';
                                return x;
                            });
                        }

                    }, 0);
                }, error: AjaxError
            });
        }
        $scope.LoadJobExperience();

        $scope.LoadEducation = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/UserEducation',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    userId: $scope.userId
                    , create_by: '@User.UserId()'
                }),
                success: function (result) {
                    $timeout(async function () {
                        $scope.lEducation = result.data;
                    }, 0);
                }, error: AjaxError
            });
        }
        $scope.LoadEducation();

        $scope.LoadTraining = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/UserTraining',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    userId: $scope.userId
                    , create_by: '@User.UserId()'
                }),
                success: function (result) {
                    $timeout(async function () {
                        $scope.lTraining = result.data;
                    }, 0);
                }, error: AjaxError
            });
        }
        $scope.LoadTraining();
    });
</script>
