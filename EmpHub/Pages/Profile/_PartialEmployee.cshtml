@{
}
<div class="profile-section-title"><span class="section-icon"><i class="bi bi-briefcase-fill"></i></span> ข้อมูลพนักงาน</div>
<div class="info-grid employee-info-grid mb-3">
    <div class="info-field">
        <span class="info-icon"><i class="bi bi-person-vcard"></i></span>
        <div><div class="info-label">รหัสพนักงาน</div><div class="info-value">{{ valueOrDash(iEmployee.employeeCode) }}</div></div>
    </div>
    <div class="info-field">
        <span class="info-icon"><i class="bi bi-calendar-plus"></i></span>
        <div><div class="info-label">วันที่เริ่มงาน</div><div class="info-value">{{ valueOrDash(iEmployee.join_date) }}</div></div>
    </div>
    <div class="info-field">
        <span class="info-icon"><i class="bi bi-calendar2-check"></i></span>
        <div><div class="info-label">วันบรรจุงาน</div><div class="info-value">{{ valueOrDash(iEmployee.probation_end_date) }}</div></div>
    </div>
    <div class="info-field">
        <span class="info-icon"><i class="bi bi-diagram-3"></i></span>
        <div><div class="info-label">ด้าน</div><div class="info-value">{{ valueOrDash(iEmployee.divisionDesc) }}</div></div>
    </div>
    <div class="info-field">
        <span class="info-icon"><i class="bi bi-bezier2"></i></span>
        <div><div class="info-label">สายงาน</div><div class="info-value">{{ valueOrDash(iEmployee.departmentDesc) }}</div></div>
    </div>
    <div class="info-field">
        <span class="info-icon"><i class="bi bi-building"></i></span>
        <div><div class="info-label">ฝ่าย</div><div class="info-value">{{ valueOrDash(iEmployee.sectionDesc) }}</div></div>
    </div>
    <div class="info-field">
        <span class="info-icon"><i class="bi bi-person"></i></span>
        <div><div class="info-label">ตำแหน่งงาน</div><div class="info-value">{{ valueOrDash(iEmployee.positionDesc) }}</div></div>
    </div>
    <div class="info-field">
        <span class="info-icon"><i class="bi bi-award"></i></span>
        <div><div class="info-label">ระดับพนักงาน</div><div class="info-value">{{ valueOrDash(iEmployee.levelDesc) }}</div></div>
    </div>
    <div class="info-field">
        <span class="info-icon"><i class="bi bi-patch-check"></i></span>
        <div><div class="info-label">เกรด</div><div class="info-value">{{ valueOrDash(iEmployee.grade) }}</div></div>
    </div>
</div>
<div class="profile-person-card mb-3">
    <div class="profile-person-grid p-2">
        <div class="profile-person-block" ng-show="valueOrDash(iEmployee.supervisorName) != '-'">
            <div class="info-label mb-3">ผู้บังคับบัญชา</div>
            <div class="d-flex align-items-center mb-3">
                <img src="~/Images/icon-user.png" class="rounded-circle me-3" width="58" height="58" alt="ผู้บังคับบัญชา" />
                <div class="min-w-0">
                    <div class="fw-bold text-dark text-truncate">{{ valueOrDash(iEmployee.supervisorName) }}</div>
                    <div class="text-muted text-truncate">{{ valueOrDash(iEmployee.supervisorPosition) }}</div>
                    <div class="text-muted text-truncate">{{ valueOrDash(iEmployee.supervisorEmail) }}</div>
                </div>
            </div>
           @*  <div class="d-flex gap-2">
                <a class="btn btn-outline-primary profile-action-btn" ng-href="mailto:{{ iEmployee.supervisorEmail || '' }}" title="อีเมลผู้บังคับบัญชา">
                    <i class="bi bi-envelope"></i>
                </a>
                <a class="btn btn-outline-primary profile-action-btn" ng-href="tel:{{ iEmployee.supervisorPhone || '' }}" title="โทรหาผู้บังคับบัญชา">
                    <i class="bi bi-telephone"></i>
                </a>
            </div> *@
        </div>
        <div class="profile-person-block">
            <div class="info-label mb-3">หน่วยงาน</div>
            <div class="d-flex align-items-center gap-3 mb-3">
                <span class="org-icon"><i class="bi bi-buildings"></i></span>
                <div class="min-w-0">
                    <div class="fw-bold text-dark">{{ valueOrDash(iEmployee.sectionDesc || iEmployee.departmentDesc) }}</div>
                    <div class="text-muted">{{ valueOrDash(iEmployee.divisionDesc) }}</div>
                </div>
            </div>
            <a class="btn btn-outline-primary" href="@Url.Page("/Organization/Team")">
                <i class="bi bi-diagram-3 me-2"></i>ดูโครงสร้างหน่วยงาน
            </a>
        </div>
    </div>
</div>
<div class="border rounded-3 p-4" ng-if="lUserSub.length > 0">
    <div class="px-2">
        <div class="info-label mb-3">สมาชิกในทีม</div>
        <div class="row">
            <div class="col-sm-6" ng-repeat="x in lUserSub">
                <a class="d-flex align-items-center mb-3 p-2 select bg-light-gray rounded-2 shadow-sm" href="@Url.Page("Profile")?id={{ x.userId }}" target="_blank">
                    <img src="~/Images/icon-user.png" class="rounded-circle me-3" width="58" height="58" alt="ผู้บังคับบัญชา" />
                    <div class="min-w-0">
                        <div class="fw-bold text-dark text-truncate">{{ valueOrDash(x.employeeName) }}</div>
                        <div class="text-muted text-truncate">{{ valueOrDash(x.positionDesc) }}</div>
                        <div class="text-muted text-truncate">{{ valueOrDash(x.sectionDesc) }}</div>
                    </div>
                </a>
            </div>
        </div>
    </div>
</div>