@page
@model EmpHub.Pages.Account.LoginModel
@Html.AntiForgeryToken()
@{
    Layout = "_LayoutEmpty";

}<style>
     body {
         min-height: 100vh;
         font-family: "Segoe UI", sans-serif;
         background: radial-gradient(circle at 15% 35%, rgba(0, 123, 255, .08), transparent 28%), radial-gradient(circle at 85% 45%, rgba(0, 123, 255, .08), transparent 26%), linear-gradient(135deg, #f7fbff, #ffffff);
         overflow: hidden;
     }

     .login-page {
         min-height: 100vh;
         position: relative;
         display: flex;
         align-items: center;
         justify-content: center;
         padding: 30px;
     }

     .welcome-bg {
         position: absolute;
         bottom: 0;
         right: 0;
         width: 100%;
         height: 40%;
     }

    .welcome-bg svg {
        width: 100%;
        height: 100%;
    }

     .bg-card {
         position: absolute;
         width: 260px;
         height: 150px;
         border-radius: 24px;
         background: rgba(255,255,255,.55);
         box-shadow: 0 20px 50px rgba(0, 80, 180, .08);
         opacity: .55;
         z-index: 2;
     }

         .bg-card.left {
             left: 7%;
             top: 38%;
             transform: rotate(8deg);
         }

         .bg-card.right {
             right: 10%;
             top: 38%;
             transform: rotate(8deg);
         }

     .login-card {
         position: relative;
         z-index: 5;
         width: 100%;
         max-width: 480px;
         border: 0;
         border-radius: 26px;
         padding: 42px 48px;
         background: rgba(255,255,255,.96);
         box-shadow: 0 30px 80px rgba(0, 50, 120, .14);
     }

     .logo-icon {
         width: 82px;
         height: 82px;
         margin: 0 auto 12px;
         border-radius: 50%;
         background: linear-gradient(135deg, #005bea, #00c6c6);
         color: #fff;
         display: flex;
         align-items: center;
         justify-content: center;
         font-size: 42px;
         font-weight: 800;
         box-shadow: 0 15px 30px rgba(0, 118, 255, .22);
     }

     .brand-title {
         font-size: 38px;
         font-weight: 800;
         color: #061b4e;
         line-height: 1;
     }

         .brand-title span {
             color: #1682ff;
         }

     .brand-subtitle {
         color: #1682ff;
         font-weight: 600;
         margin-top: 8px;
     }

     .form-label {
         font-weight: 700;
         color: #061b4e;
         margin-bottom: 8px;
     }

     .input-group-text {
         background: #fff;
         border-radius: 14px 0 0 14px;
         border-right: 0;
         color: #7b879a;
     }

     .form-control {
         height: 52px;
         border-left: 0;
         border-radius: 0 14px 14px 0;
         color: #061b4e;
     }

         .form-control:focus {
             box-shadow: none;
             border-color: #86bfff;
         }

     .btn-login {
         height: 54px;
         border: 0;
         border-radius: 14px;
         font-weight: 700;
         background: linear-gradient(135deg, #1682ff, #006eff);
         box-shadow: 0 12px 25px rgba(0, 110, 255, .24);
     }

     .btn-sso {
         height: 54px;
         border-radius: 14px;
         font-weight: 700;
     }

     .divider {
         display: flex;
         align-items: center;
         color: #9aa6b8;
         gap: 16px;
     }

         .divider::before,
         .divider::after {
             content: "";
             flex: 1;
             height: 1px;
             background: #e3e8f0;
         }

     .footer {
         position: absolute;
         bottom: 22px;
         z-index: 6;
         color: #fff;
         font-size: 14px;
     }

     @@media (max-width: 576px) {
         .login-card {
             padding: 32px 24px;
         }

         .brand-title {
             font-size: 32px;
         }

         .bg-card {
             display: none;
         }
     }
</style>
@* Version *@
<div class="position-fixed bottom-0 end-0 m-3">
    @webInfo.CurrentValue.version
</div>
<div class="d-flex align-items-center position-absolute top-0 end-0 mt-2">
    @if (webInfo.CurrentValue.label.Contains("UAT"))
    {
        <div>
            <img src="~/Images/UAT.png" height="50" />
        </div>
    }
    <div>
        <img src="~/Images/Logo-TIP.png" width="120" class="me-2" />
    </div>
</div>
@* Login *@
