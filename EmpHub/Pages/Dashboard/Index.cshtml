        $scope.LoadCharEducation = function (lData) {
            chart_education.data = {
                labels: lData.map(i => i.levelName),
                datasets: [{
                    data: lData.map(i => i.total),
                }],
            };

            chart_education.update();
        }

        /* Data */

        $scope.LoadData = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Dashboard/DataList'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , success: function (result) {
                    $timeout(function () {
                        var lSex = result.Table;
                        var lGeneration = result.Table1;
                        var lEmployeeType = result.Table2;
                        var lDepartment = result.Table3;
                        var lPosition = result.Table4;
                        var lEducation = result.Table5;

                        $scope.LoadCharSex(lSex);
                        $scope.LoadCharGeneration(lGeneration);
                        //$scope.LoadCharGenerationSex(lGeneration);
                        $scope.LoadCharEmployeeType(lEmployeeType);
                        $scope.LoadCharPosition(lPosition);
                        $scope.LoadCharDepartment(lDepartment);
                        $scope.LoadCharEducation(lEducation);
                    }, 0);
                }
                , error: AjaxError
            });
        }
        $scope.LoadData();
    });
</script>