                                                pointStyle: pointStyle,
                                                hidden: !chart.getDataVisibility(i),

                                                // Extra data used for toggling the correct item
                                                index: i
                                            };
                                        });
                                    }
                                    return [];
                                }
                            },
                            position: 'right'
                        }
                    },
                }
            }
        );

        $scope.LoadCharDepartment = function (lData) {
            chart_department.data = {
                labels: lData.map(i => i.departmentDesc),
                datasets: [{
                    data: lData.map(i => i.total),
                }],
            };

            chart_department.update();
        }

        /* Education */
        
        var chart_education = new Chart(
            document.getElementById('chart_education'),
            {
                type: 'pie',
                options: {
                    responsive: true,
                    aspectRatio: 2,
                    borderRadius: 5,
                    weight: 5,
                    cutout: 35,
                    plugins: {
                        legend: {
                            display: true,
                            labels: {
                                usePointStyle: true,
