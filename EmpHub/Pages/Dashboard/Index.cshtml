            chart_gen.update();
        }

        /* Generateion & Sex */

        // var chart_gen_sex = new Chart(
        //     document.getElementById('chart_gen_sex'),
        //     {
        //         type: 'bar',
        //         options: {
        //             responsive: true,
        //             aspectRatio: 2,
        //             borderRadius: 5,
        //             weight: 5,
        //             cutout: 35,
        //             plugins: {
        //                 legend: {
        //                     display: false,
        //                 }
        //             },
        //         }
        //     }
        // );

        $scope.LoadCharGenerationSex = function (lData) {
            chart_gen_sex.data = {
                labels: lData.map(i => i.gen),
                datasets: [{
                    data: lData.map(i => i.male),
                    backgroundColor: '#36a2eb',
                    label:'Male'
                }, {
                    data: lData.map(i => i.female),
                    backgroundColor: '#ff6384',
                    label: 'Female'
                }, {
                    data: lData.map(i => i.unset),
                    backgroundColor: '#adb5bd',
                    label: 'None'
                }],
                options: {
                    responsive: true,
                    plugins: {
                        legend: {
                            position: 'top' // แสดง label dataset ด้านบน
                        },
                        tooltip: {
                            callbacks: {
                                label: function (context) {
                                    return context.dataset.label + ' ' + context.formattedValue + ' บาท';
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            stacked: true
                        },
                        y: {
                            stacked: true,
                            beginAtZero: true
                        }
                    }
                }
            };

            chart_gen_sex.update();
        }

