@{
}
<div>
    <div class="row">
        <div class="col-sm-4 mb-3">
            <div class="text-dark fw-bolder">บัตรพนักงาน</div>
            <div>{{ iEmployee.employeeCode == '' ? '-' : iEmployee.employeeCode }}</div>
        </div>
        <div class="col-sm-4 mb-3">
            <div class="text-dark fw-bolder">บัตรประชาชน</div>
            <div>{{ iPersonal.idcard == '' ? '-' : iPersonal.idcard }}</div>
        </div>
        <div class="col-sm-4 mb-3">
            <div class="text-dark fw-bolder">หนังสือเดินทาง</div>
            <div>{{ iPersonal.passport == '' ? '-' : iPersonal.passport }}</div>
        </div>
        <div class="col-sm-4 mb-3">
            <div class="text-dark fw-bolder">ประกันสังคม</div>
            <div>{{ iPersonal.idcard == '' ? '-' : iPersonal.idcard }}</div>
        </div>
        <div class="col-sm-4 mb-3">
            <div class="text-dark fw-bolder">เลขที่ผู้เสียภาษี</div>
            <div>{{ iPersonal.idcard == '' ? '-' : iPersonal.idcard }}</div>
        </div>
        <div class="col-sm-4 mb-3">
            <div class="text-dark fw-bolder">ใบอนุญาตทำงานคนต่างด้าว</div>
            <div>{{ iPersonal.workPermitNo == '' ? '-' : iPersonal.workPermitNo }}</div>
        </div>
    </div>
    <hr class="my-3" />
    <div class="mb-2 d-flex align-items-center">
        <div class="flex-fill">
            <div>
                ปรับปรุงล่าสุด <span class="fw-bolder">{{ iPersonal.update_date }}</span> โดย <span class="fw-bolder">{{ iPersonal.update_by }}</span>
            </div>
        </div>
        <div>
            <a class="btn btn-sm btn-warning-invert" href="@Url.Page("/Service/FormUpdateCard")?mode=EDIT_CARD&id={{userId}}" target="_blank">
                <i class="bi bi-pen me-2"></i> แก้ไข
            </a>
        </div>
    </div>
</div>