@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
<div>
    <div class="list-group list-group-flush">
        <div class="list-group-item px-0" ng-repeat="x in lEducation">
            <div class="d-flex mb-3">
                <div class="flex-fill me-3">
                    <div class="text-dark fw-bolder">
                        สถาบันการศึกษา
                    </div>
                    <div class="text-gray">{{ x.institution != '' ? x.institution : '-' }}</div>
                </div>
                <div class="me-3">
                    <div class="text-dark fw-bolder">
                        ปีที่สำเร็จการศึกษา
                    </div>
                    <div class="text-gray">{{ x.year != '' ? x.year : '-' }}</div>
                </div>
                <div class="">
                    <div class="text-dark fw-bolder">
                        เกรดเฉลี่ย
                    </div>
                    <div class="text-gray">{{ x.grade != '' ? x.grade : '-' }}</div>
                </div>
            </div>
            <div class="d-flex mb-3">
                <div class="flex-fill me-3">
                    <div class="text-dark fw-bolder">
                        วุฒิการศึกษา
                    </div>
                    <div class="text-gray">{{ x.degreeName != '' ? x.degreeName : '-' }}</div>
                </div>
                <div class="flex-fill me-3">
                    <div class="text-dark fw-bolder">
                        หลักสูตร
                    </div>
                    <div class="text-gray">{{ x.programName != '' ? x.programName : '-' }}</div>
                </div>
                <div class="flex-fill me-3">
                    <div class="text-dark fw-bolder">
                        สาขาวิชา
                    </div>
                    <div class="text-gray">{{ x.major != '' ? x.major : '-' }}</div>
                </div>
            </div>
            <div class="mb-3">
                <div class="text-dark fw-bolder">
                    เพิ่มกิจกรรม เกียรตินิยม รางวัล หรือโครงการพิเศษที่ประสบความสำเร็จระหว่างการศึกษา
                </div>
                <div class="text-gray">{{ x.description != '' ? x.description : '-' }}</div>
            </div>
        </div>
    </div>
    <hr class="my-3" />
    <div class="mb-2 d-flex align-items-center">
        <div class="flex-fill">
            <div ng-show="iEducation">
                ปรับปรุงล่าสุด <span class="fw-bolder">{{ iEducation.update_date }}</span> โดย <span class="fw-bolder">{{ iEducation.update_by }}</span>
            </div>
        </div>
        <div>
            <a class="btn btn-sm btn-warning-invert" href="@Url.Page("/Service/FormUpdateDataEducation")?mode=EDIT_EDUCATION&id={{userId}}" target="_blank">
                <i class="bi bi-pen me-2"></i> เพิ่ม/แก้ไข
            </a>
        </div>
    </div>
</div>