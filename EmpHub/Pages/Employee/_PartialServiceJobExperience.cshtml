@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    var token = User.AccessToken(Context);
}
<div ng-controller="ServiceJobExperienceCtrl" id="tab_job">
    @* View *@
    <div class="bg-white rounded-5 p-4 mb-3">
        <div class="d-flex align-items-center mb-4" ng-click="EditStage('education')">
            <div class="fw-bolder flex-fill text-secondary fs-5">
                ประวัติการทำงาน
            </div>
        </div>
        <div ng-show="lData.length > 0">
            <div class="list-group list-group-flush">
                <div class="list-group-item px-0" ng-repeat="x in lData">
                    <div class="row">
                        <div class="col-sm-8 mb-3">
                            <div class="text-gray">
                                บริษัท
                            </div>
                            <div class="fw-bolder">{{ x.company }}</div>
                        </div>
                        <div class="col-sm-2 mb-3">
                            <div class="text-gray">
                                วันที่เริ่ม
                            </div>
                            <div class="fw-bolder">{{ x.from_date | date:'MMM yyyy' }}</div>
                        </div>
                        <div class="col-sm-2 mb-3">
                            <div class="text-gray">
                                วันที่สิ้นสุด
                            </div>
                            <div class="fw-bolder">{{ x.end_date | date:'MMM yyyy' }}</div>
                        </div>
                        <div class="col-sm-8 mb-3">
                            <div class="text-gray">
                                ตำแหน่ง
                            </div>
                            <div class="fw-bolder">{{ x.position }}</div>
                        </div>
                        <div class="col-sm-12 mb-3">
                            <div class="text-gray">
                                รายละเอียดการทำงาน
                            </div>
                            <div class="fw-bolder">{{ x.description }}</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="pt-2 d-flex align-items-center">
                <div class="btn btn-secondary-invert" ng-click="View()">
                    <i class="bi bi-pen"></i> แก้ไข
                </div>
                <div ng-show="status == 'Pending'" class="ms-3 bg-gray rounded-3 d-flex p-2">
                    <div class="me-2 text-warning">รออนุมัติการปรับปรุงข้อมูล</div>
                    <div class="badge bg-danger select" ng-click="Cancel()">
                        <i class="bi bi-x-circle"></i> ยกเลิก
                    </div>
                </div>
            </div>
        </div>
        <div ng-show="lData.length == 0">
            <div class="row">
                <div class="col-sm-12 mb-3 text-gray">
                    เพิ่มข้อมูลประวัติการทำงานของคุณ
                </div>
            </div>
            <div class="pt-2 d-flex align-items-center">
                <div class="btn btn-secondary-invert" ng-click="New()">
                    <i class="bi bi-plus-lg"></i> เพิ่มตำแหน่งงาน
                </div>
            </div>
        </div>
    </div>
    @* Dialog *@
    <div class="offcanvas offcanvas-end" data-bs-scroll="true" tabindex="-1" id="jobOff" aria-labelledby="offcanvasLabel" style="width:600px;">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title text-secondary fw-bolder" id="offcanvasLabel">ประวัติการทำงาน</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <div class="list-group list-group-flush">
                <div class="list-group-item list-group-item-action rounded-3 p-3 mb-3" ng-repeat="x in lData">
                    <div>
                        <div class="badge badge-{{ x.mode }}">{{ x.mode }}</div>
                    </div>
                    <div class="row">
                        <div class="col-sm-8 mb-3">
                            <div class="text-gray">
                                บริษัท
                            </div>
                            <div class="fw-bolder">{{ x.company }}</div>
                        </div>
                        <div class="col-sm-2 mb-3">
                            <div class="text-gray">
                                วันที่เริ่ม
                            </div>
                            <div class="fw-bolder">{{ x.from_date | date:'MMM yyyy' }}</div>
                        </div>
                        <div class="col-sm-2 mb-3">
                            <div class="text-gray">
                                วันที่สิ้นสุด
                            </div>
                            <div class="fw-bolder">{{ x.end_date | date:'MMM yyyy' }}</div>
                        </div>
                        <div class="col-sm-8 mb-3">
                            <div class="text-gray">
                                ตำแหน่ง
                            </div>
                            <div class="fw-bolder">{{ x.position }}</div>
                        </div>
                        <div class="col-sm-12 mb-3">
                            <div class="text-gray">
                                รายละเอียดการทำงาน
                            </div>
                            <div class="fw-bolder">{{ x.description }}</div>
                        </div>
                        <div class="col-sm-12">
                            <div class="btn btn-warning-invert" ng-click="Edit(x)">
                                <i class="bi bi-pen"></i> แก้ไข
                            </div>
                            <div class="btn btn-danger-invert" ng-click="Delete(x)">
                                <i class="bi bi-trash3"></i> ลบ
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="pt-2 d-flex align-items-center">
                <div class="btn btn-secondary-invert" ng-click="New()">
                    <i class="bi bi-plus-lg"></i> เพิ่มตำแหน่งงาน
                </div>
            </div>
        </div>
    </div>

    <div class="offcanvas offcanvas-end" data-bs-scroll="true" tabindex="-1" id="jobOffEdit" aria-labelledby="offcanvasLabel" style="width:600px;">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title text-secondary fw-bolder" id="offcanvasLabel">ประวัติการทำงาน</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <div class="row">
                <div class="col-sm-12 mb-3">
                    <div class="fw-bolder">บริษัท</div>
                    <input ng-model="iEdit.company" class="form-control" />
                </div>
                <div class="col-sm-12 mb-3">
                    <div class="fw-bolder">ตำแหน่ง</div>
                    <input ng-model="iEdit.position" class="form-control" />
                </div>
                <div class="col-sm-6 mb-3">
                    <div class="fw-bolder">วันเริ่ม</div>
                    <input class="form-control icon-calendar date"
                           ng-model="iEdit.from_date_select"
                           ng-model-options="{ updateOn: 'blur' }"
                           moment-picker="iEdit.from_date_select"
                           locale="th"
                           format="MMM YYYY"
                           min-view="year"
                           max-view="year" required />
                </div>
                <div class="col-sm-6 mb-3">
                    <div class="fw-bolder">วันที่สิ้นสุด</div>
                    <input class="form-control icon-calendar date"
                           ng-model="iEdit.end_date_select"
                           ng-model-options="{ updateOn: 'blur' }"
                           moment-picker="iEdit.end_date_select"
                           locale="th"
                           format="MMM YYYY"
                           min-view="year"
                           max-view="year" required />
                </div>
                <div class="col-sm-12 mb-3">
                    <div class="fw-bolder">รายละเอียดงาน</div>
                    <textarea ng-model="iEdit.descripition" class="form-control" maxlength="4000" rows="5"></textarea>
                </div>
            </div>
            <div class="pt-3">
                <div class="btn btn-secondary" ng-click="Save()">
                    <i class="bi bi-send"></i> ส่งปรับปรุงข้อมูล
                </div>
                <div class="btn btn-link" data-bs-dismiss="offcanvas">
                    ยกเลิก
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    app.controller('ServiceJobExperienceCtrl', function ($scope, $http, $timeout, $filter) {

        $scope.LoadData = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/ServiceJobExperience/Detail',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    userId: $scope.userId
                    , create_by: '@User.UserId()'
                }),
                success: function (result) {
                    $timeout(async function () {
                        $scope.lData = result.map((x) => {
                            x.from_date = x.fromDate != '' ? ConvertToDate(x.fromDate) : '';
                            x.end_date = x.endDate != '' ? ConvertToDate(x.endDate) : '';
                            return x;
                        });
                        $scope.status = $scope.lData.filter(x => x.status == 'Pending').length > 0 ? 'Pending' : 'Approve';

                    }, 0);
                }, error: AjaxError
            });
        }

        $scope.InitJob = function () {
            $scope.userId = $scope.$parent.userId
            $scope.LoadData();
        }
        $scope.InitJob();

        $scope.View = function () {
            $scope.LoadData();
            $("#jobOff").offcanvas('show');
        }

        $scope.New = function () {
            $("#jobOffEdit").offcanvas('show');
            $scope.iEdit = { jobId :''};
        }

        $scope.Edit = function (x) {
            $("#jobOffEdit").offcanvas('show');
            $scope.iEdit = x;

            if (x.fromDate != '' && x.fromDate != undefined) {
                var date = ConvertToDate(x.fromDate);
                $scope.iEdit.from_date_select = new moment(date);
            }

            if (x.endDate != '' && x.endDate != undefined) {
                var date = ConvertToDate(x.endDate);
                $scope.iEdit.end_date_select = new moment(date);
            }
        }

        $scope.Save = async function () {
            $("#jobOffEdit").offcanvas('hide');

            if ($scope.iEdit.jobId == '') {
                $scope.lData.splice($scope.lData.length, 0, $scope.iEdit);
            }

            for (var i = 0; i < $scope.lData.length; i++) {
                var iData = $scope.lData[i];
                await $scope.SaveItem(iData);
            }

            $scope.LoadData();
        }

        $scope.SaveItem = function (x) {
            return new Promise((resolve) => {

                x.fromDate = '';
                x.endDate = '';

                if (x.from_date_select) {
                    x.fromDate = x.from_date_select.format("DD/MM/YYYY");
                }
                if (x.end_date_select) {
                    x.endDate = x.end_date_select.format("DD/MM/YYYY");
                }

                x.create_by = '@User.UserId()';
                x.userId = '@User.UserId()';

                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/ServiceJobExperience/Save',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    cache: false,
                    data: JSON.stringify(x),
                    success: function () {
                        $timeout(async function () {
                            resolve(true);
                        }, 0);
                    }, error: function () {
                        resolve(false);
                    }
                });
            });
        }

        $scope.Cancel = function () {
            alertConfirm("ท่านต้องการยกเลิกรายการ", "ยืนยันการยกเลิกการปรับปรุงประวัติการทำงาน", function () {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/ServiceJobExperience/Cancel',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    cache: false,
                    data: JSON.stringify({
                        userId: $scope.userId
                        , update_by: '@User.UserId()'
                    }),
                    success: function () {
                        $timeout(async function () {
                            $scope.LoadData();
                        }, 0);
                    }, error: AjaxError
                });
            });
        }

        $scope.Delete = function (x) {
            alertConfirm("ท่านต้องการลบรายการ", "ยืนยันการลบประวัติการทำงาน", function () {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/ServiceJobExperience/Delete',
                    headers: { 'authorization': 'Bearer @token' }, 
                    type: "POST",
                    contentType: 'application/json',
                    cache: false,
                    data: JSON.stringify({
                            jobId: x.jobId
                        , update_by: '@User.UserId()'
                    }),
                    success: function () {
                        $timeout(async function () {
                            $scope.LoadData();
                        }, 0);
                    }, error: AjaxError
                });
            });
        }
    });
</script>