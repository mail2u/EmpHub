@page
@model EmpHub.Pages.Employee.DetailModel
@{
    ViewData["Title"] = "EmpHub";
}
<div class="w-100" ng-controller="DataCtrl">
    @section PageHeader {
        <!-- [ page-header ] start -->
        <div class="page-header">
            <div class="page-header-left d-flex align-items-center">
                <div class="page-header-title">
                    <h5 class="m-b-10">Employees</h5>
                </div>
                <ul class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Page("/Index")">Home</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Page("/Employee/Index")">Employees</a></li>
                    <li class="breadcrumb-item">Info {{ $parent.fullname }}</li>
                </ul>
            </div>
        </div>
    }

    <div class="bg-white rounded-4 p-4 border shadow-sm container d-flex">
        <div class="border-end me-4" style="min-width:500px; width:500px;">
            @* Prosonal *@
            <partial name="Employee/_PartialServicePersonal" />
        </div>
        <div class="flex-fill">
            <nav class="mb-3">
                <div class="nav nav-underline" id="nav-tab" role="tablist">
                    <button class="nav-link active" id="nav-employee-tab" data-bs-toggle="tab" data-bs-target="#nav-employee" type="button" role="tab" aria-controls="nav-employee" aria-selected="true">
                        <i class="fas fa-id-card-alt"></i> Employee
                    </button>
                    <button class="nav-link" id="nav-address-tab" data-bs-toggle="tab" data-bs-target="#nav-address" type="button" role="tab" aria-controls="nav-address" aria-selected="false">
                        <i class="fas fa-map-marker-alt"></i> Address
                    </button>
                    <button class="nav-link" id="nav-education-tab" data-bs-toggle="tab" data-bs-target="#nav-education" type="button" role="tab" aria-controls="nav-education" aria-selected="false">
                        <i class="fas fa-user-graduate"></i> Education
                    </button>
                    <button class="nav-link" id="nav-traning-tab" data-bs-toggle="tab" data-bs-target="#nav-traning" type="button" role="tab" aria-controls="nav-traning" aria-selected="false">
                        <i class="fas fa-chalkboard-teacher"></i> Traning
                    </button>
                    <button class="nav-link" id="nav-jobs-tab" data-bs-toggle="tab" data-bs-target="#nav-job-exper" type="button" role="tab" aria-controls="nav-job" aria-selected="false">
                        <i class="fas fa-building"></i> Job Experience
                    </button>
                </div>
            </nav>
            <div class="tab-content" id="nav-tabContent">
                <div class="tab-pane fade show active" id="nav-employee" role="tabpanel" aria-labelledby="nav-employee-tab" tabindex="0">
                    @* Employee *@
                    <partial name="Employee/_PartialServiceEmployee" />
                </div>
                <div class="tab-pane fade" id="nav-address" role="tabpanel" aria-labelledby="nav-address-tab" tabindex="0">
                    @* Location *@
                    <partial name="Employee/_PartialServiceAddress" />
                </div>
                <div class="tab-pane fade" id="nav-education" role="tabpanel" aria-labelledby="nav-education-tab" tabindex="0">
                    @* Education *@
                    <partial name="Employee/_PartialServiceEducation" />
                </div>
                <div class="tab-pane fade" id="nav-traning" role="tabpanel" aria-labelledby="nav-traning-tab" tabindex="0">
                    @* Traning *@
                    <partial name="Employee/_PartialServiceTraning" />
                </div>
                <div class="tab-pane fade" id="nav-job-exper" role="tabpanel" aria-labelledby="nav-jobs-tab" tabindex="0">
                    @* JobExperience*@
                    <partial name="Employee/_PartialServiceJobExperience" />
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    app.controller('DataCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.userId = '@Model.id';
    });
</script>
