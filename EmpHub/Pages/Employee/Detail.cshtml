@page
@model EmpHub.Pages.Employee.DetailModel
@{
    ViewData["Title"] = "EmpHub";
}
<div class="w-100" ng-controller="DataCtrl">
    @section PageHeader {
        <!-- [ page-header ] start -->
        <div class="page-header">
            <div class="page-header-left d-flex align-items-center">
                <div class="page-header-title">
                    <h5 class="m-b-10">Employees</h5>
                </div>
                <ul class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Page("/Index")">Home</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Page("/Employee/Index")">Employees</a></li>
                    <li class="breadcrumb-item">Info {{ $parent.fullname }}</li>
                </ul>
            </div>
        </div>
    }

    <div class="bg-white rounded-4 p-4 border shadow-sm container d-flex">
        <div class="border-end me-4" style="min-width:500px; width:500px;">
            @* Prosonal *@
            <partial name="Employee/_PartialUserPersonal" />
        </div>
        <div class="flex-fill">
            <nav class="mb-3">
                <div class="nav nav-underline" id="nav-tab" role="tablist">
                    <a class="nav-link active" href="?tab=nav-employee"
                       data-bs-target="#nav-employee">
                        <i class="fas fa-id-card-alt"></i> Employee
                    </a>
                    <a class="nav-link" href="?tab=nav-address"
                       data-bs-target="#nav-address">
                        <i class="fas fa-map-marker-alt"></i> Address
                    </a>
                    <a class="nav-link" href="?tab=nav-education"
                       data-bs-target="#nav-education">
                        <i class="fas fa-user-graduate"></i> Education
                    </a>
                    <a class="nav-link" href="?tab=nav-training"
                       data-bs-target="#nav-training">
                        <i class="fas fa-chalkboard-teacher"></i> Training
                    </a>
                    <a class="nav-link" href="?tab=nav-job"
                       data-bs-target="#nav-job">
                        <i class="fas fa-building"></i> Job Experience
                    </a>
                </div>
            </nav>
            <div class="tab-content" id="nav-tabContent">
                <div class="tab-pane fade show active" id="nav-employee" role="tabpanel" aria-labelledby="nav-employee-tab" tabindex="0">
                    @* Employee *@
                    <partial name="Employee/_PartialUserEmployee" />
                </div>
                <div class="tab-pane fade" id="nav-address" role="tabpanel" aria-labelledby="nav-address-tab" tabindex="0">
                    @* Location *@
                    <partial name="Employee/_PartialUserAddress" />
                </div>
                <div class="tab-pane fade" id="nav-education" role="tabpanel" aria-labelledby="nav-education-tab" tabindex="0">
                    @* Education *@
                    <partial name="Employee/_PartialUserEducation" />
                </div>
                <div class="tab-pane fade" id="nav-training" role="tabpanel" aria-labelledby="nav-training-tab" tabindex="0">
                    @* Training *@
                    <partial name="Employee/_PartialUserTraining" />
                </div>
                <div class="tab-pane fade" id="nav-job" role="tabpanel" aria-labelledby="nav-job-tab" tabindex="0">
                    @* JobExperience*@
                    <partial name="Employee/_PartialUserJobExperience" />
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    app.controller('DataCtrl', function ($scope, $http, $timeout, $filter) {
        var tabName = '@Model.tab';
        $scope.userId = '@Model.id';

        if (tabName != '') {
            const triggerEl = document.querySelector(
                `#nav-tab [data-bs-target="#${tabName}"]`
            );

            if (triggerEl) {
                new bootstrap.Tab(triggerEl).show();
            }
        }
    });
</script>
