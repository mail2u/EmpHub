@page
@model EmpHub.Pages.Employee.DetailModel
@{
    ViewData["Title"] = "EmpHub";
    var token = User.AccessToken(HttpContext);
}

<div class="w-100" ng-controller="DataCtrl">
    @section PageHeader {
        <!-- [ page-header ] start -->
        <div class="page-header">
            <div class="page-header-left d-flex align-items-center">
                <div class="page-header-title">
                    <h5 class="m-b-10">ข้อมูลพนักงาน</h5>
                </div>
                <ul class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Page("/Index")">หน้าแรก</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Page("/Employee/Index")">พนักงาน</a></li>
                    <li class="breadcrumb-item">{{ iPersonal.prefix_en + ' ' + iPersonal.firstname_en + ' ' + iPersonal.lastname_en }}</li>
                </ul>
            </div>
        </div>
    }
    <div class="d-flex">
        @* Profile *@
        <div class=" me-4" style="width:400px">
            <div class="rounded-4 border overflow-hidden position-relative mb-4">
                <div class="bg-light-blue" style="height:120px;">
                </div>
                <div class="bg-white p-4">
                    <div class="position-absolute start-50 translate-middle-x" style="top:75px;">
                        <div class="border border-white rounded-pill overflow-hidden shadow">
                            <img src="~/Images/icon-user.png" width="100px" />
                        </div>
                    </div>
                    <div class="text-center pb-3" style="padding-top: 50px;">
                        <div class="text-dark fs-4 fw-bolder" style="line-height:20px;">
                            {{ iPersonal.perfix_en }} {{ iPersonal.firstname_en }} {{ iPersonal.lastname_en }}
                        </div>
                        <div class="text-blue fs-5">{{ iEmployee.positionDesc }}</div>
                    </div>
                    <div class="rounded-3 bg-light text-dark-gray p-3">
                        <table class="">
                            <tbody>
                                <tr>
                                    <td width="30px" class="p-2 align-top"><i class="bi bi-envelope-fill text-primary"></i></td>
                                    <td class="p-2">{{ iEmployee.email }}</td>
                                </tr>
                                <tr>
                                    <td class="p-2 align-top">
                                        <i class="bi bi-telephone-fill text-primary"></i>
                                    </td>
                                    <td class="p-2">
                                        {{ iEmployee.ext }}
                                    </td>
                                </tr>
                                <tr>
                                    <td class="p-2 align-top"><i class="bi bi-phone-fill text-primary"></i></td>
                                    <td class="p-2">{{ iPersonal.phoneNo }}</td>
                                </tr>
                                <tr>
                                    <td class="p-2 align-top"><i class="bi bi-geo-alt-fill text-primary"></i></td>
                                    <td class="p-2">
                                        {{ iAddress.live_home }}
                                        {{ iAddress.live_road }}
                                        {{ iAddress.live_subDistrictName }}
                                        {{ iAddress.live_districtName }}
                                        {{ iAddress.live_provinceName }}
                                        {{ iAddress.live_postcode }}
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                   @*  <div>
                        <a class="btn btn-primary" href="@Url.Page("Edit")?id=@Model.id">
                            <i class="bi bi-pen-fill me-2"></i> Edit Profile
                        </a>
                    </div> *@
                </div>
            </div>
            @* Report To *@
            <div class="rounded-4 bg-white border p-4">
                <div class="text-gray mb-2">
                    ผู้บังคับบัญชา
                </div>
                <div class="d-flex">
                    <div class="overflow-hidden me-2">
                        <img src="~/Images/icon-user.png" class="rounded-pill" width="35px" />
                    </div>
                    <div>
                        <div class="text-dark fw-bolder">{{ iEmployee.supervisorName }}</div>
                        <div class="text-gray">{{ iEmployee.supervisorPosition }}</div>
                    </div>
                </div>
            </div>
        </div>
        @* Other *@
        <div class="flex-fill bg-white overflow-hidden rounded-4 border">
            <nav class="border-bottom px-4 pt-2 bg-gray-100">
                <div class="nav nav-underline" id="nav-tab" role="tablist">
                    <a class="nav-link text-nowrap active" href="?tab=nav-personal"
                       data-bs-target="#nav-personal">
                        ข้อมูลส่วนบุคคล
                    </a>
                    <a class="nav-link text-nowrap" href="?tab=nav-employment"
                       data-bs-target="#nav-employment">
                        ข้อมูลการว่าจ้าง
                    </a>
                    <a class="nav-link text-nowrap" href="?tab=nav-card"
                       data-bs-target="#nav-card">
                        ข้อมูลบัตร
                    </a>
                    <a class="nav-link text-nowrap" href="?tab=nav-contact"
                       data-bs-target="#nav-contact">
                        ข้อมูลการติดต่อ
                    </a>
                    <a class="nav-link text-nowrap" href="?tab=nav-job"
                       data-bs-target="#nav-job">
                        ประสบการณ์ทำงาน
                    </a>
                    <a class="nav-link text-nowrap" href="?tab=nav-education"
                       data-bs-target="#nav-education">
                        การศึกษา
                    </a>
                    <a class="nav-link text-nowrap" href="?tab=nav-talent"
                       data-bs-target="#nav-talent">
                        ความสามารถทางภาษา
                    </a>
                    <a class="nav-link text-nowrap" href="?tab=nav-training"
                       data-bs-target="#nav-training">
                        การฝึกอบรม
                    </a>
                  @*   <a class="nav-link text-nowrap" href="?tab=nav-document"
                       data-bs-target="#nav-document">
                        เอกสาร
                    </a> *@
                </div>
            </nav>
            <div class="tab-content p-4" id="nav-tabContent">
                <div class="tab-pane fade show active" id="nav-personal" role="tabpanel" aria-labelledby="nav-personal-tab" tabindex="0">
                    <partial name="_PartialUserPersonal" />
                </div>
                <div class="tab-pane fade" id="nav-employment" role="tabpanel" aria-labelledby="nav-employment-tab" tabindex="0">
                    <partial name="_PartialUserEmployee" />
                </div>
                <div class="tab-pane fade" id="nav-card" role="tabpanel" aria-labelledby="nav-card-tab" tabindex="0">
                    <partial name="_PartialUserCard" />
                </div>
                <div class="tab-pane fade" id="nav-contact" role="tabpanel" aria-labelledby="nav-contact-tab" tabindex="0">
                    <partial name="_PartialUserContact" />
                </div>
                <div class="tab-pane fade" id="nav-job" role="tabpanel" aria-labelledby="nav-job-tab" tabindex="0">
                    <partial name="_PartialUserJobExperience" />
                </div>
                <div class="tab-pane fade" id="nav-education" role="tabpanel" aria-labelledby="nav-education-tab" tabindex="0">
                    <partial name="_PartialUserEducation" />
                </div>
                <div class="tab-pane fade" id="nav-talent" role="tabpanel" aria-labelledby="nav-talent-tab" tabindex="0">
                    <partial name="_PartialUserTalent" />
                </div>
                <div class="tab-pane fade" id="nav-training" role="tabpanel" aria-labelledby="nav-training-tab" tabindex="0">
                    <partial name="_PartialUserTraining" />
                </div>
                <div class="tab-pane fade" id="nav-document" role="tabpanel" aria-labelledby="nav-document-tab" tabindex="0">
                    <partial name="_PartialUserDocument" />
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    app.controller('DataCtrl', function ($scope, $http, $timeout, $filter) {
        var tabName = '@Model.tab';
        $scope.userId = '@Model.id';

        if (tabName != '') {
            const triggerEl = document.querySelector(
                `#nav-tab [data-bs-target="#${tabName}"]`
            );

            if (triggerEl) {
                new bootstrap.Tab(triggerEl).show();
            }
        }

        $scope.CalcAge = function () {
            $scope.iPersonal.age = '';

            if ($scope.iPersonal.birth_date) {
                const b = ConvertToDate($scope.iPersonal.birth_date);
                const c = new Date();

                let years = c.getFullYear() - b.getFullYear();
                let months = c.getMonth() - b.getMonth();
                let days = c.getDate() - b.getDate();

                // ถ้าวันติดลบ → ยืมเดือน
                if (days < 0) {
                    months--;

                    // เอาจำนวนวันของเดือนก่อนหน้า
                    const prevMonth = new Date(c.getFullYear(), c.getMonth(), 0);
                    days += prevMonth.getDate();
                }

                // ถ้าเดือนติดลบ → ยืมปี
                if (months < 0) {
                    years--;
                    months += 12;
                }

                if (years > 0) {
                    $scope.iPersonal.age = years + ' ปี ';
                }
                if (months > 0) {
                    $scope.iPersonal.age += months + ' เดือน ';
                }
                if (days > 0) {
                    $scope.iPersonal.age += days + ' วัน';
                }
            }
        }

        $scope.LoadPersonal = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/UserPersonal',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    userId: $scope.userId
                    , create_by: '@User.UserId()'
                }),
                success: function (result) {
                    $timeout(async function () {
                        $scope.iPersonal = result.data;
                        $scope.can_view = result.can_view;
                        $scope.can_edit = result.can_edit;
                        $scope.CalcAge();
                    }, 0);
                }, error: AjaxError
            });
        }
        $scope.LoadPersonal();

        $scope.CalcWorkDay = function () {
            $scope.iEmployee.work_day = '';

            if ($scope.iEmployee.join_date) {
                const b = ConvertToDate($scope.iEmployee.join_date);
                const c = new Date();

                let years = c.getFullYear() - b.getFullYear();
                let months = c.getMonth() - b.getMonth();
                let days = c.getDate() - b.getDate();

                // ถ้าวันติดลบ → ยืมเดือน
                if (days < 0) {
                    months--;

                    // เอาจำนวนวันของเดือนก่อนหน้า
                    const prevMonth = new Date(c.getFullYear(), c.getMonth(), 0);
                    days += prevMonth.getDate();
                }

                // ถ้าเดือนติดลบ → ยืมปี
                if (months < 0) {
                    years--;
                    months += 12;
                }

                if (years > 0) {
                    $scope.iEmployee.work_day = years + ' ปี ';
                }
                if (months > 0) {
                    $scope.iEmployee.work_day += months + ' เดือน ';
                }
                if (days > 0) {
                    $scope.iEmployee.work_day += days + ' วัน';
                }
            }
        }

        $scope.LoadEmployee = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/UserEmployee',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    userId: $scope.userId
                    , create_by: '@User.UserId()'
                }),
                success: function (result) {
                    $timeout(async function () {
                        $scope.iEmployee = result.data;
                        $scope.CalcWorkDay();
                    }, 0);
                }, error: AjaxError
            });
        }
        $scope.LoadEmployee();

        $scope.LoadAddress = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/UserAddress',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    userId: $scope.userId
                    , create_by: '@User.UserId()'
                }),
                success: function (result) {
                    $timeout(async function () {
                        $scope.iAddress = result.data;
                    }, 0);
                }, error: AjaxError
            });
        }
        $scope.LoadAddress();


        $scope.LoadJobExperience = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/UserJobExperience',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    userId: $scope.userId
                    , create_by: '@User.UserId()'
                }),
                success: function (result) {
                    $timeout(async function () {
                        $scope.lJobExperience = result.data;
                        if ($scope.lJobExperience.length > 0) {
                            $scope.lJobExperience = $scope.lJobExperience.map((x) => {
                                x.from_date = x.fromDate != '' ? ConvertToDate(x.fromDate) : '';
                                x.end_date = x.endDate != '' ? ConvertToDate(x.endDate) : '';
                                return x;
                            });
                        }

                    }, 0);
                }, error: AjaxError
            });
        }
        $scope.LoadJobExperience();

        $scope.LoadEducation = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/UserEducation',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    userId: $scope.userId
                    , create_by: '@User.UserId()'
                }),
                success: function (result) {
                    $timeout(async function () {
                        $scope.lEducation = result.data;
                    }, 0);
                }, error: AjaxError
            });
        }
        $scope.LoadEducation();

        $scope.LoadTraining = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/UserTraining',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    userId: $scope.userId
                    , create_by: '@User.UserId()'
                }),
                success: function (result) {
                    $timeout(async function () {
                        $scope.lTraining = result.data;
                    }, 0);
                }, error: AjaxError
            });
        }
        $scope.LoadTraining();

    });
</script>
