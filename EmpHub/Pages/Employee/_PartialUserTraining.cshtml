<div>
    <div class="list-group list-group-flush">
        <div class="list-group-item px-0" ng-repeat="x in lTraining">
            <div class="d-flex mb-3">
                <div class="flex-fill me-3">
                    <div class="text-dark fw-bolder">
                        ชื่อใบอนุญาต
                    </div>
                    <div class="text-gray">{{ x.license != '' ? x.license : '-' }}</div>
                </div>
                <div class="flex-fill me-3">
                    <div class="text-dark fw-bolder">
                        องค์กรที่ออกเอกสาร
                    </div>
                    <div class="text-gray">{{ x.organization != '' ? x.organization : '-' }}</div>
                </div>
                <div class="me-3">
                    <div class="text-dark fw-bolder">
                        เลขที่ใบรับรอง
                    </div>
                    <div class="text-gray">{{ x.certificateNo ? x.certificateNo : '-' }}</div>
                </div>
                <div class="me-3">
                    <div class="text-dark fw-bolder">
                        วันที่ออกเอกสาร
                    </div>
                    <div class="text-gray">{{ x.issueDate != '' ? x.issueDate : '-' }}</div>
                </div>
                <div class="">
                    <div class="text-dark fw-bolder">
                        วันหมดอายุ
                    </div>
                    <div class="text-gray">{{ x.expireDate != '' ? x.expireDate : '-' }}</div>
                </div>
            </div>
            <div class="mb-3">
                <div class="text-dark fw-bolder">
                    รายละเอียด
                </div>
                <div class="text-gray">{{ x.description != '' ? x.description : '-' }}</div>
            </div>
        </div>
    </div>
    <hr class="my-3" />
    <div class="mb-2 d-flex align-items-center">
        <div class="flex-fill">
            <div ng-show="iTraining">
                ปรับปรุงล่าสุด <span class="fw-bolder">{{ iTraining.update_date }}</span> โดย <span class="fw-bolder">{{ iTraining.update_by }}</span>
            </div>
        </div>
        <div>
            <a class="btn btn-sm btn-warning-invert" href="@Url.Page("/Service/FormCreate/FormUpdateDataTraining")?mode=EDIT_TRAINING&id={{userId}}" target="_blank">
                <i class="bi bi-pen me-2"></i> เพิ่ม/แก้ไข
            </a>
        </div>
    </div>
</div>
