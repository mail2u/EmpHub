@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
<div ng-controller="ServiceTraningCtrl" id="tab_traning">
    @* View *@
    <div class="bg-white rounded-5 p-4 mb-3">
        <div class="d-flex align-items-center mb-4" ng-click="EditStage('education')">
            <div class="fw-bolder flex-fill text-secondary fs-5">
                ใบอนุญาติหรือประกาศนียบัตร
            </div>
        </div>
        <div ng-show="lData.length > 0">
            <div class="list-group list-group-flush">
                <div class="list-group-item px-0" ng-repeat="x in lData">
                    <div class="row ">
                        <div class="col-sm-8 mb-3">
                            <div class="text-gray">
                                ชื่อใบอนุญาติ
                            </div>
                            <div class="fw-bolder">{{ x.license }}</div>
                        </div>
                        <div class="col-sm-2 mb-3">
                            <div class="text-gray">
                                วันที่ออกเอกสาร
                            </div>
                            <div class="fw-bolder">{{ x.issueDate }}</div>
                        </div>
                        <div class="col-sm-2 mb-3">
                            <div class="text-gray">
                                วันหมดอายุ
                            </div>
                            <div class="fw-bolder">{{ x.expireDate }}</div>
                        </div>
                        <div class="col-sm-12 mb-3">
                            <div class="text-gray">
                                องค์กรที่ออกเอกสาร
                            </div>
                            <div class="fw-bolder">{{ x.organization }}</div>
                        </div>
                        <div class="col-sm-12 mb-3">
                            <div class="text-gray">
                                รายละเอียด
                            </div>
                            <div class="fw-bolder">{{ x.description }}</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="pt-2 d-flex align-items-center">
                <div class="btn btn-secondary-invert" ng-click="View()">
                    <i class="bi bi-pen"></i> แก้ไข
                </div>
                <div ng-show="status == 'Pending'" class="ms-3 text-warning bg-light-gray rounded-3 flex-fill p-2">
                    รออนุมัติการปรับปรุงข้อมูล
                    <div class="badge bg-danger select" ng-click="Cancel()">
                        <i class="bi bi-x"></i> ยกเลิก
                    </div>
                </div>
            </div>
        </div>
        <div ng-show="lData.length == 0">
            <div class="row">
                <div class="col-sm-12 mb-3 text-gray">
                    แสดงข้อมูลที่เกี่ยวข้อง เพิ่มใบอนุญาติ ประกาศนียบัตร การเป็นสมาชิกและใบรับรองที่เกี่ยวข้องกับงานที่นี่
                </div>
            </div>
            <div class="pt-2 d-flex align-items-center">
                <div class="btn btn-secondary-invert" ng-click="New()">
                    <i class="bi bi-plus-lg"></i> เพิ่มใบอนุญาติหรือประกาศนียบัตร
                </div>
            </div>
        </div>
    </div>
    @* Dialog *@
    <div class="offcanvas offcanvas-end" data-bs-scroll="true" tabindex="-1" id="traningOff" aria-labelledby="offcanvasLabel" style="width:600px;">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title text-secondary fw-bolder" id="offcanvasLabel">ใบอนุญาติหรือประกาศนียบัตร</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <div class="list-group list-group-flush">
                <div class="list-group-item list-group-item-action rounded-3 p-3 mb-3" ng-repeat="x in lData">
                    <div class="row ">
                        <div class="col-sm-8 mb-3">
                            <div class="text-gray">
                                ชื่อใบอนุญาติ
                            </div>
                            <div class="fw-bolder">{{ x.license }}</div>
                        </div>
                        <div class="col-sm-2 mb-3">
                            <div class="text-gray">
                                วันที่ออกเอกสาร
                            </div>
                            <div class="fw-bolder">{{ x.issueDate }}</div>
                        </div>
                        <div class="col-sm-2 mb-3">
                            <div class="text-gray">
                                วันหมดอายุ
                            </div>
                            <div class="fw-bolder">{{ x.expireDate }}</div>
                        </div>
                        <div class="col-sm-12 mb-3">
                            <div class="text-gray">
                                องค์กรที่ออกเอกสาร
                            </div>
                            <div class="fw-bolder">{{ x.organization }}</div>
                        </div>
                        <div class="col-sm-12 mb-3">
                            <div class="text-gray">
                                รายละเอียด
                            </div>
                            <div class="fw-bolder">{{ x.description }}</div>
                        </div>
                        <div class="col-sm-12">
                            <div class="btn btn-warning-invert" ng-click="Edit(x)">
                                <i class="bi bi-pen"></i> แก้ไข
                            </div>
                            <div class="btn btn-danger-invert" ng-click="Delete(x)">
                                <i class="bi bi-trash3"></i> ลบ
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="btn btn-secondary-invert" ng-click="New()">
                <i class="bi bi-plus-lg"></i> พิ่มใบอนุญาติหรือประกาศนียบัตร
            </div>
        </div>
    </div>

    <div class="offcanvas offcanvas-end" data-bs-scroll="true" tabindex="-1" id="traningOffEdit" aria-labelledby="offcanvasLabel" style="width:600px;">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title text-secondary fw-bolder" id="offcanvasLabel">ใบอนุญาติหรือประกาศนียบัตร</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <div class="row">
                <div class="col-sm-12 mb-3">
                    <div class="fw-bolder">ชื่อใบอนุญาติ</div>
                    <input ng-model="iEdit.license" class="form-control" />
                </div>
                <div class="col-sm-12 mb-3">
                    <div class="fw-bolder">องค์กรที่ออกเอกสาร</div>
                    <input ng-model="iEdit.organization" class="form-control" />
                </div>
                <div class="col-sm-6 mb-3">
                    <div class="fw-bolder">วันที่ออกเอกสาร</div>
                    <input class="form-control icon-calendar target"
                           ng-model="iEdit.issue_date_select"
                           ng-model-options="{ updateOn: 'blur' }"
                           moment-picker="iEdit.issue_date_select"
                           locale="th"
                           format="DD/MM/YYYY"
                           min-view="month"
                           max-view="month" required />
                </div>
                <div class="col-sm-6 mb-3">
                    <div class="fw-bolder">วันที่หมดอายุ</div>
                    <input class="form-control icon-calendar target"
                           ng-model="iEdit.expire_date_select"
                           ng-model-options="{ updateOn: 'blur' }"
                           moment-picker="iEdit.expire_date_select"
                           locale="th"
                           format="DD/MM/YYYY"
                           min-view="month"
                           max-view="month" required />
                </div>
                <div class="col-sm-12 mb-3">
                    <div class="fw-bolder">รายละเอียด</div>
                    <textarea ng-model="iEdit.description" class="form-control" rows="5" maxlength="4000"></textarea>
                </div>
            </div>
            <div class="pt-3">
                <div class="btn btn-secondary" ng-click="Save()">
                    บันทึก
                </div>
                <div class="btn btn-link" data-bs-dismiss="offcanvas">
                    ยกเลิก
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    app.controller('ServiceTraningCtrl', function ($scope, $http, $timeout, $filter) {

        $scope.LoadData = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/ServiceTraning/Detail',
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    userId: $scope.userId
                    , create_by: '@User.UserId()'
                }),
                success: function (result) {
                    $timeout(async function () {
                        $scope.lData = result;
                        $scope.status = $scope.lData.filter(x => x.status == 'Pending').length > 0 ? 'Pending' : 'Approve';
                    }, 0);
                }, error: AjaxError
            });
        }

        $scope.InitTraning = function () {
            $scope.userId = $scope.$parent.userId
            $scope.LoadData();
        }
        $scope.InitTraning();

        $scope.View = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/ServiceTraning/Clone',
                type: "POST",
                contentType: 'application/json',
                cache: false,
                data: JSON.stringify({
                    userId: $scope.userId
                    , create_by: '@User.UserId()'
                }),
                success: function () {
                    $timeout(async function () {
                        $scope.LoadData();
                        $("#traningOff").offcanvas('show');
                    }, 0);
                }, error: AjaxError
            });
        }

        $scope.New = function () {
            $("#traningOffEdit").offcanvas('show');
            $scope.iEdit = {};
            $scope.iEdit.traningId = '';
            $scope.iEdit.userId = $scope.userId;
            $scope.iEdit.create_by = '@User.UserId()';
        }

        $scope.Edit = function (x) {
            $("#traningOffEdit").offcanvas('show');
            $scope.iEdit = {};
            $scope.iEdit.traningId = x.traningId;
            $scope.iEdit.license = x.license;
            $scope.iEdit.oranization = x.oranization;
            $scope.iEdit.issueDate = x.issueDate;
            $scope.iEdit.expireDate = x.expireDate;
            $scope.iEdit.description = x.description;
            $scope.iEdit.userId = $scope.userId;
            $scope.iEdit.create_by = '@User.UserId()';

            if (x.issueDate != '' && x.issueDate != undefined) {
                var date = ConvertToDate(x.issueDate);
                $scope.iEdit.issue_date_select = new moment(date);
            }
            if (x.expireDate != '' && x.expireDate != undefined) {
                var date = ConvertToDate(x.expireDate);
                $scope.iEdit.expire_date_select = new moment(date);
            }

        }

        $scope.Save = function () {
            $("#traningOffEdit").offcanvas('hide');

            if ($scope.iEdit.issue_date_select) {
                $scope.iEdit.issueDate = $scope.iEdit.issue_date_select.format("DD/MM/YYYY");
            }
            if ($scope.iEdit.expire_date_select) {
                $scope.iEdit.expireDate = $scope.iEdit.expire_date_select.format("DD/MM/YYYY");
            }

            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/ServiceTraning/Save',
                type: "POST",
                contentType: 'application/json',
                cache: false,
                data: JSON.stringify($scope.iEdit),
                success: function () {
                    $timeout(async function () {
                        $scope.LoadData();
                    }, 0);
                }, error: AjaxError
            });
        }

        $scope.Cancel = function () {
            alertConfirm("ท่านต้องการยกเลิกรายการ", "ยืนยันการยกเลิกการปรับปรุงใบอนุญาติหรือประกาศนียบัตร", function () {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/ServiceTraning/Cancel',
                    type: "POST",
                    contentType: 'application/json',
                    cache: false,
                    data: JSON.stringify({
                        userId: $scope.userId
                        , update_by: '@User.UserId()'
                    }),
                    success: function () {
                        $timeout(async function () {
                            $scope.LoadData();
                        }, 0);
                    }, error: AjaxError
                });
            });
        }

        $scope.Delete = function (x) {
            alertConfirm("ท่านต้องการลบรายการ", "ยืนยันการลบใบอนุญาติหรือประกาศนียบัตร", function () {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/ServiceTraning/Delete',
                    type: "POST",
                    contentType: 'application/json',
                    cache: false,
                    data: JSON.stringify({
                        traningId: x.traningId
                        , update_by: '@User.UserId()'
                    }),
                    success: function () {
                        $timeout(async function () {
                            $scope.LoadData();
                        }, 0);
                    }, error: AjaxError
                });
            });
        }
    });
</script>