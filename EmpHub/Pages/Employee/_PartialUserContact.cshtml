@{
}
<div>
    <div class="row">
        <div class="col-sm-4 mb-3">
            <div class="text-dark fw-bolder">ที่อยู่ตามทะเบียนบ้าน</div>
            <div>
                {{ iAddress.registered_home }}
                {{ iAddress.registered_road }}
                {{ iAddress.registered_subDistrictName }}
                {{ iAddress.registered_districtName }}
                {{ iAddress.registered_provinceName }}
                {{ iAddress.registered_postcode }}
            </div>
        </div>
        <div class="col-sm-4 mb-3">
            <div class="text-dark fw-bolder">ที่อยู่ตามบัตรประชาชน</div>
            <div>
                {{ iAddress.card_home }}
                {{ iAddress.card_road }}
                {{ iAddress.card_subDistrictName }}
                {{ iAddress.card_districtName }}
                {{ iAddress.card_provinceName }}
                {{ iAddress.card_postcode }}
            </div>
        </div>
        <div class="col-sm-4 mb-3">
            <div class="text-dark fw-bolder">ที่อยู่พักอาศัย</div>
            <div>
                {{ iAddress.live_home }}
                {{ iAddress.live_road }}
                {{ iAddress.live_subDistrictName }}
                {{ iAddress.live_districtName }}
                {{ iAddress.live_provinceName }}
                {{ iAddress.live_postcode }}
            </div>
        </div>
        <div class="col-sm-4 mb-3">
            <div class="text-dark fw-bolder">มือถือ</div>
            <div>{{ iPersonal.mobile == '' ? '-' : iPersonal.mobile }}</div>
        </div>
        <div class="col-sm-4 mb-3">
            <div class="text-dark fw-bolder">เบอร์ติดต่อ</div>
            <div>{{ iPersonal.phone == '' ? '-' : iPersonal.phone }}</div>
        </div>
        <div class="col-sm-4 mb-3">
            <div class="text-dark fw-bolder">อีเมล์ติดต่อ</div>
            <div>{{ iPersonal.email == '' ? '-' : iPersonal.email }}</div>
        </div>
        <div class="col-sm-4 mb-3">
            <div class="text-dark fw-bolder">มือถือบริษัท</div>
            <div>{{ iEmployee.phone_office == '' ? '-' : iEmployee.phone_office }}</div>
        </div>
        <div class="col-sm-4 mb-3">
            <div class="text-dark fw-bolder">อีเมล์บริษัท</div>
            <div>{{ iEmployee.email == '' ? '-' : iEmployee.email }}</div>
        </div>
    </div>
    <hr class="my-3" />
    <div class="mb-2 d-flex align-items-center">
        <div class="flex-fill">
            <div>
                ปรับปรุงล่าสุด <span class="fw-bolder">{{ iPersonal.update_date }}</span> โดย <span class="fw-bolder">{{ iPersonal.update_by }}</span>
            </div>
        </div>
        <div>
            <a class="btn btn-sm btn-warning-invert" href="@Url.Page("/Service/FormUpdateContact")?mode=EDIT_CONTACT&id={{userId}}" target="_blank">
                <i class="bi bi-pen me-2"></i> แก้ไข
            </a>
        </div>
    </div>
</div>