                    , contentType: 'application/json'
                    , dataType: 'json'
                    , cache: false
                    , data: JSON.stringify({
                        page: 1
                        , row: 99
                    })
                    , success: function (result) {
                        $timeout(function () {
                            $scope.lPosition = result;
                        }, 0);
                    }
                    , error: AjaxError
                });
            }
            if (!$scope.lEmployee) {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/User/DataList'
                    , headers: { 'authorization': 'Bearer @token' }
                    , type: 'post'
                    , contentType: 'application/json'
                    , dataType: 'json'
                    , cache: false
                    , data: JSON.stringify({
                        page: 1
                        , row: 999
                    })
                    , success: function (result) {
                        $timeout(function () {
                            $scope.lEmployee = result.data;
                        }, 0);
                    }
                    , error: AjaxError
                });
            }
        }
        $scope.LoadMasterEmployee();

        $scope.LoadEmployee = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/UserEmployee',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    userId: $scope.userId
                    , create_by: '@User.UserId()'
                }),
                success: function (result) {
                    $timeout(async function () {
                        $scope.iEmployee = result.data;
                        $scope.iEmployee.is_change = 0;

                        if($scope.iEmployee.join_date){
                            $scope.iEmployee.join_date_select = moment($scope.iEmployee.join_date);
                        }
                    }, 0);
                }, error: AjaxError
            });
        }
        $scope.LoadEmployee();

        $scope.SelectSupervisor = function (x) {
            $scope.iEmployee.supervisorId = x.userId;
            $scope.iEmployee.supervisorName = x.firstname_th + ' ' + x.lastname_th;
            $scope.iEmployee.supervisorPosition = x.positionDesc;
            $scope.iEmployee.supervisorDepartment = x.departmentDesc;
            $scope.iEmployee.is_change = 1;
            $("#supervisorModal").modal('hide');
        }

        // Address

        $scope.LoadMasterAddress = function () {
            if (!$scope.lMasterAddress) {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/MasterCode/Address'
