        }

        $scope.CreateEmployee = function (id) {
            return new Promise((resolve) => {
                $scope.iEmployee.id = id;
                $scope.iEmployee.refId = id;

                if ($scope.iEmployee.birth_date_select) {
                    $scope.iEmployee.birth_date = $scope.iEmployee.birth_date_select.format("DD/MM/YYYY");
                }

                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/ServiceEmployee/Save',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    cache: false,
                    data: JSON.stringify($scope.iEmployee),
                    success: function () {
                        $timeout(async function () {
                            resolve(true);
                        }, 0);
                    }, error: function (jqXHR, error, errorThrown) {
                        resolve(null);
                        Swal.fire({
                            title: "Save Employee Error",
                            text: jqXHR.responseText,
                            icon: "error",
                            confirmButtonColor: '#1e3b92',
                        });
                    }
                });
            });
        }

        $scope.CreateEducation = function (id) {
            return new Promise((resolve) => {
                $scope.lEducation = $scope.lEducation.map(item => {
                    item.refId = id;

                    if(item.is_change == 1 && item.mode != 'delete'){
                        item.mode = item.educationId == '' ? 'add' : 'modify'; 
                    }

                    return item;
                });

                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/ServiceEducation/Save',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    cache: false,
                    data: JSON.stringify($scope.lEducation),
                    success: function () {
                        $timeout(async function () {
                            resolve(true);
                        }, 0);
                    }, error: function (jqXHR, error, errorThrown) {
                        resolve(null);
                        Swal.fire({
                            title: "Save Education Error",
                            text: jqXHR.responseText,
                            icon: "error",
                            confirmButtonColor: '#1e3b92',
                        });
                    }
                });
            });
        }

        $scope.CreateJobExperience = function (id) {
            return new Promise((resolve) => {
                $scope.lJobExperience = $scope.lJobExperience.map(item=>{
                    item.refId = id;
                    
                    if(item.is_change == 1 && item.mode != 'delete'){
                        item.mode = item.jobId == '' ? 'add' : 'modify'; 
                    }
                    
                    item.fromDate = item.from_date ? item.from_date.format("DD/MM/YYYY") : null;
                    item.endDate = item.end_date ? item.end_date.format("DD/MM/YYYY") : null;

                    return item;
                });

                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/ServiceJobExperience/Save',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    cache: false,
                    data: JSON.stringify($scope.lJobExperience),
                    success: function () {
                        $timeout(async function () {
                            resolve(true);
                        }, 0);
                    }, error: function (jqXHR, error, errorThrown) {
                        resolve(null);
                        Swal.fire({
                            title: "Save JobExperience Error",
                            text: jqXHR.responseText,
                            icon: "error",
                            confirmButtonColor: '#1e3b92',
                        });
                    }
                });
            });
        }

        $scope.CreateTraining = function (id) {
            return new Promise((resolve) => {
                $scope.lTraining = $scope.lTraining.map(item => {
                    item.refId = id;
                    
                    if(item.is_change == 1 && item.mode != 'delete'){
                        item.mode = item.trainingId == '' ? 'add' : 'modify'; 
                    }
                    
                    item.issueDate = item.issue_date ? item.issue_date.format("DD/MM/YYYY") : null;

                    return item;
                });

                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/ServiceTraining/Save',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    cache: false,
                    data: JSON.stringify($scope.lTraining),
                    success: function () {
                        $timeout(async function () {
                            resolve(true);
                        }, 0);
                    }, error: function (jqXHR, error, errorThrown) {
                        resolve(null);
                        Swal.fire({
                            title: "Save Training Error",
                            text: jqXHR.responseText,
                            icon: "error",
                            confirmButtonColor: '#1e3b92',
                        });
                    }
                });
            });
        }
    });
</script>
