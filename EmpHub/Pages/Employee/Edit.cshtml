@page
@model EmpHub.Pages.Employee.EditModel
@{
    ViewData["Title"] = "EmpHub";
    var token = User.AccessToken(HttpContext);
}
<div class="w-100" ng-controller="DataCtrl">
    @section PageHeader {
        <div class="px-4 pt-4">
            <ul class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="@Url.Page("Index")">Employee Directory</a></li>
                <li class="breadcrumb-item">Edit Profile</li>
            </ul>
        </div>
    }
    <div class="fs-3 fw-bolder text-dark">Edit Employee Profile</div>
    <div class="mb-4">Update personal and professional details for employee ID <a href="@Url.Page("Detail")/@Model.id" target="_blank" class="text-blue">#{{ iEmployee.employeeCode }}</a></div>
    <div class="d-flex">
        <div class="flex-fill me-4">
            @* Personal Information *@
            <div class="rounded-4 border bg-white mb-4 p-4 pb-2">
                <div class="text-dark fs-5 fw-bolder d-flex align-items-center mb-3">
                    <i class="bi bi-person-fill fs-4 me-2 text-blue"></i> Personal Information 
                    <span ng-show="iPersonal.is_change == 1" class="text-warning">
                        <i class="bi bi-pen-fill ms-2"></i>
                    </span>
                </div>
                <div class="row">
                    <div class="col-sm-6 mb-3">
                        <div class="text-dark fs-5">Firstname (TH)</div>
                        <input ng-model="iPersonal.firstname_th" class="form-control firstname_th" ng-change="iPersonal.is_change = 1" />
                    </div>
                    <div class="col-sm-6 mb-3">
                        <div class="text-dark fs-5">Lastname (TH)</div>
                        <input ng-model="iPersonal.lastname_th" class="form-control lastname_th" ng-change="iPersonal.is_change = 1" />
                    </div>
                    <div class="col-sm-6 mb-3">
                        <div class="text-dark fs-5">Firstname (EN)</div>
                        <input ng-model="iPersonal.firstname_en" class="form-control" ng-change="iPersonal.is_change = 1" />
                    </div>
                    <div class="col-sm-6 mb-3">
                        <div class="text-dark fs-5">Lastname (EN)</div>
                        <input ng-model="iPersonal.lastname_en" class="form-control" ng-change="iPersonal.is_change = 1" />
                    </div>
                    <div class="col-sm-6 mb-3">
                        <div class="text-dark fs-5">Nickname</div>
                        <input ng-model="iPersonal.nickname" class="form-control" ng-change="iPersonal.is_change = 1" />
                    </div>
                    <div class="col-sm-6 mb-3">
                        <div class="text-dark fs-5">Birth Date</div>
                        <input class="form-control icon-calendar date"
                               ng-model="iPersonal.birth_date_select"
                               ng-model-options="{ updateOn: 'blur' }"
                               moment-picker="iPersonal.birth_date_select"
                               locale="th"
                               format="DD/MM/YYYY"
                               min-view="month"
                               max-view="month" required ng-blur="iPersonal.is_change = 1" />
                    </div>
                    <div class="col-sm-6 mb-3">
                        <div class="text-dark fs-5">Phone No</div>
                        <input ng-model="iPersonal.phoneNo" class="form-control" ng-change="iPersonal.is_change = 1" />
                    </div>
                    <div class="col-sm-6 mb-3">
                        <div class="text-dark fs-5">Email</div>
                        <input ng-model="iPersonal.email" class="form-control" ng-change="iPersonal.is_change = 1" />
                    </div>
                    <div class="col-sm-6 mb-3">
                        <div class="text-dark fs-5">Sex</div>
                        <div class="d-flex align-items-center p-2">
                            <div class="me-4">
                                <input ng-model="iPersonal.sex" type="radio" value="Male" id="ra_male" ng-change="iPersonal.is_change = 1" />
                                <label for="ra_male">ชาย</label>
                            </div>
                            <div>
                                <input ng-model="iPersonal.sex" type="radio" value="Female" id="ra_female" ng-change="iPersonal.is_change = 1" />
                                <label for="ra_female">หญิง</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            @* Address *@
            <div class="rounded-4 border bg-white mb-4 p-4 pb-2">
                <div class="text-dark fs-5 fw-bolder d-flex align-items-center mb-3">
                    <i class="bi bi-geo-alt-fill fs-4 me-2 text-blue"></i> Address Information
                    <span ng-show="iAddress.is_change == 1" class="text-warning">
                        <i class="bi bi-pen-fill ms-2"></i>
                    </span>
                </div>
                <div class="row">
                    <div class="col-sm-6 mb-3">
                        <div class="text-dark fs-5">Home</div>
                        <input ng-model="iAddress.home" class="form-control" maxlength="200" ng-change="iAddress.is_change = 1" />
                    </div>
                    <div class="col-sm-6 mb-3">
                        <div class="text-dark fs-5">Road</div>
                        <input ng-model="iAddress.road" class="form-control" maxlength="100" ng-change="iAddress.is_change = 1" />
                    </div>
                    <div class="col-sm-6 mb-3">
                        <div class="text-dark fs-5">Tambon</div>
                        <input ng-model="iAddress.subDistrictName" class="form-select bg-light-blue" data-bs-toggle="modal" data-bs-target="#addressModal" readonly />
                    </div>
                    <div class="col-sm-6 mb-3">
                        <div class="text-dark fs-5">Amphur</div>
                        <input ng-model="iAddress.districtName" class="form-select bg-light-blue" data-bs-toggle="modal" data-bs-target="#addressModal" readonly />
                    </div>
                    <div class="col-sm-6 mb-3">
                        <div class="text-dark fs-5">Province</div>
                        <input ng-model="iAddress.provinceName" class="form-select bg-light-blue" data-bs-toggle="modal" data-bs-target="#addressModal" readonly />
                    </div>
                    <div class="col-sm-6 mb-3">
                        <div class="text-dark fs-5">Postcode</div>
                        <input ng-model="iAddress.postcode" class="form-control postcode" ng-change="iAddress.is_change = 1" />
                    </div>
                </div>
            </div>
            @* Job Information *@
            <div class="rounded-4 border bg-white mb-4 p-4 pb-2">
                <div class="text-dark fs-5 fw-bolder d-flex align-items-center mb-3">
                    <i class="bi bi-briefcase-fill fs-4 me-2 text-blue"></i> Job Information
                    <span ng-show="iEmployee.is_change == 1" class="text-warning">
                        <i class="bi bi-pen-fill ms-2"></i>
                    </span>
                </div>
                <div class="row">
                    <div class="col-sm-6 mb-3">
                        <div class="text-dark fs-5">Employee ID</div>
                        <input ng-model="iEmployee.employeeCode" class="form-control" maxlength="6" ng-change="iEmployee.is_change = 1" />
                    </div>
                    <div class="col-sm-6 mb-3">
                        <div class="text-dark fs-5">Employment Type</div>
                        <select ng-model="iEmployee.employeeType" class="form-select" ng-options="x.code as x.desc_th for x in lEmployeeType" ng-change="iEmployee.is_change = 1"></select>
                    </div>
                    <div class="col-sm-6 mb-3">
                        <div class="text-dark fs-5">Department</div>
                        <select ng-model="iEmployee.departmentCode" class="form-select" ng-options="x.code as x.desc_th + ' (' + x.desc_en + ')' for x in lDepartment" ng-change="iEmployee.is_change = 1"></select>
                    </div>
                    <div class="col-sm-6 mb-3">
                        <div class="text-dark fs-5">Position</div>
                        <select ng-model="iEmployee.positionCode" class="form-select" ng-options="x.code as x.desc_th + ' (' + x.desc_en + ')' for x in lPosition" ng-change="iEmployee.is_change = 1"></select>
                    </div>
                    <div class="col-sm-6 mb-3">
                        <div class="text-dark fs-5">Hire Date</div>
                        <input class="form-control icon-calendar date"
                               ng-model="iEmployee.join_date_select"
                               ng-model-options="{ updateOn: 'blur' }"
                               moment-picker="iEmployee.join_date_select"
                               locale="th"
                               format="DD/MM/YYYY"
                               min-view="month"
                               max-view="month" required ng-blur="iEmployee.is_change = 1" />
                    </div>
                    <div class="col-sm-6 mb-3">
                        <div class="text-dark fs-5">Reporting To</div>
                        <input ng-model="iEmployee.supervisorName" class="form-select bg-light-blue" data-bs-toggle="modal" data-bs-target="#supervisorModal" readonly />
                    </div>
                    <div class="col-sm-6 mb-3">
                        <div class="text-dark fs-5">Email</div>
                        <input ng-model="iEmployee.email" class="form-control email" ng-change="iEmployee.is_change = 1" />
                    </div>
                    @*     <div class="col-sm-4 mb-3">
                    <div class="text-dark fs-5">เบอร์ติดต่อภายใน</div>
                    <input ng-model="iData.ext" class="form-control ext" maxlength="10" />
                    </div> *@
                </div>
            </div>
            @* Education *@
            <div class="rounded-4 border bg-white mb-4 p-4 pb-2">
                <div class="d-flex align-items-center mb-3">
                    <div class="text-dark fs-5 fw-bolder flex-fill">
                        <i class="fas fa-graduation-cap fs-4 me-2 text-blue"></i> Education
                        <span ng-show="iEducation.is_change == 1" class="text-warning">
                            <i class="bi bi-pen-fill ms-2"></i>
                        </span>
                    </div>
                    <div class="select text-blue fw-bolder" ng-click="AddEducation()">
                        <i class="bi bi-plus-lg me-1"></i> Add Degree
                    </div>
                </div>
                <div class="p-3 pb-1 mb-4 border rounded-3 position-relative {{ x.mode == 'delete' ? 'bg-light' : '' }}" ng-repeat="x in lEducation">
                    <div class="row">
                        <div class="col-sm-5 mb-3">
                            <div class="text-gray">
                                DEGREE
                            </div>
                            <input ng-model="x.levelName" class="form-control" ng-change="iEducation.is_change = 1; x.is_change = 1;" ng-disabled="x.mode == 'delete'" />
                        </div>
                        <div class="col-sm-5 mb-3">
                            <div class="text-gray">
                                INSTITUTION
                            </div>
                            <input ng-model="x.institution" class="form-control" maxlength="200" ng-change="iEducation.is_change = 1; x.is_change = 1;" ng-disabled="x.mode == 'delete'" />
                        </div>
                        <div class="col-sm-2 mb-3">
                            <div class="text-gray text-truncate" title="YEAR">
                                YEAR
                            </div>
                            <input ng-model="x.year" class="form-control" year ng-change="iEducation.is_change = 1; x.is_change = 1;" ng-disabled="x.mode == 'delete'" />
                        </div>
                    </div>
                    <div class="position-absolute" style="top:-20px; right:-15px;" ng-show="x.mode != 'delete'">
                        <div class="btn btn-circle border bg-white text-warning" ng-click="DeleteEducation(x)">
                            <i class="bi bi-x-circle fs-4"></i>
                        </div>
                    </div>
                    <div class="position-absolute" style="top:-20px; right:-15px;" ng-show="x.mode == 'delete'">
                        <div class="btn btn-circle border bg-white text-blue" ng-click="UndoEducation(x)">
                            <i class="bi bi-arrow-counterclockwise fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
            @* Job Experience *@
            <div class="rounded-4 border bg-white mb-4 p-4 pb-2">
                <div class="d-flex align-items-center mb-3">
                    <div class="text-dark fs-5 fw-bolder flex-fill">
                        <i class="fas fa-feather-alt fs-4 me-2 text-blue"></i> Job Experience
                        <span ng-show="iJobExperience.is_change == 1" class="text-warning">
                            <i class="bi bi-pen-fill ms-2"></i>
                        </span>
                    </div>
                    <div class="select text-blue fw-bolder" ng-click="AddJobExperience()">
                        <i class="bi bi-plus-lg me-1"></i> Add Experience
                    </div>
                </div>
                <div class="p-3 pb-1 mb-4 border rounded-3 position-relative {{ x.mode == 'delete' ? 'bg-light' : '' }}" ng-repeat="x in lJobExperience">
                    <div class="row">
                        <div class="col-sm-4 mb-3">
                            <div class="text-gray">
                                COMPANY
                            </div>
                            <input ng-model="x.company" class="form-control" maxlength="200" ng-change="iJobExperience.is_change = 1; x.is_change = 1;" ng-disabled="x.mode == 'delete'" />
                        </div>
                        <div class="col-sm-4 mb-3">
                            <div class="text-gray">
                                PREVIOUS ROLE
                            </div>
                            <input ng-model="x.position" class="form-control" ng-change="iJobExperience.is_change = 1; x.is_change = 1;" ng-disabled="x.mode == 'delete'" />
                        </div>
                        <div class="col-sm-2 mb-3">
                            <div class="text-gray text-truncate" title="GRADUATION YEAR">
                                FROM
                            </div>
                            <input class="form-control"
                               ng-model="x.from_date"
                               moment-picker="x.from_date"
                               locale="th"
                               format="MMM YYYY"
                               max-date="x.end_date"
                               min-view="year"
                               max-view="month" required change="iJobExperience.is_change = 1; x.is_change = 1;" ng-disabled="x.mode == 'delete'" />
                        </div>
                        <div class="col-sm-2 mb-3">
                            <div class="text-gray text-truncate" title="GRADUATION YEAR">
                                TO 
                            </div>
                            <input class="form-control"
                               ng-model="x.end_date"
                               moment-picker="x.end_date"
                               locale="th"
                               format="MMM YYYY"
                               min-date="x.from_date"
                               min-view="year"
                               max-view="month" required change="iJobExperience.is_change = 1; x.is_change = 1;" ng-disabled="x.mode == 'delete'" />
                        </div>
                    </div>
                    <div class="position-absolute" style="top:-20px; right:-15px;" ng-show="x.mode != 'delete'">
                        <div class="btn btn-circle border bg-white text-warning" ng-click="DeleteJobExperience(x)">
                            <i class="bi bi-x-circle fs-4"></i>
                        </div>
                    </div>
                    <div class="position-absolute" style="top:-20px; right:-15px;" ng-show="x.mode == 'delete'">
                        <div class="btn btn-circle border bg-white text-blue" ng-click="UndoJobExperience(x)">
                            <i class="bi bi-arrow-counterclockwise fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
            @* Training *@
            <div class="rounded-4 border bg-white mb-4 p-4 pb-2">
                <div class="d-flex align-items-center mb-3">
                    <div class="text-dark fs-5 fw-bolder flex-fill">
                        <i class="bi bi-patch-check fs-4 me-2 text-blue"></i> Training
                        <span ng-show="iTraining.is_change == 1" class="text-warning">
                            <i class="bi bi-pen-fill ms-2"></i>
                        </span>
                    </div>
                    <div class="select text-blue fw-bolder" ng-click="AddTraining()">
                        <i class="bi bi-plus-lg me-1"></i> Add Training
                    </div>
                </div>
               <div class="p-3 pb-1 mb-4 border rounded-3 position-relative {{ x.mode == 'delete' ? 'bg-light' : '' }}" ng-repeat="x in lTraining">
                    <div class="row">
                        <div class="col-sm-5 mb-3">
                            <div class="text-gray">
                                COURSE NAME
                            </div>
                            <input ng-model="x.license" class="form-control" ng-change="iTraining.is_change = 1; x.is_change = 1;" ng-disabled="x.mode == 'delete'" />
                        </div>
                        <div class="col-sm-5 mb-3">
                            <div class="text-gray">
                                PROVIDER
                            </div>
                            <input ng-model="x.organization" class="form-control" maxlength="200" ng-change="iTraining.is_change = 1; x.is_change = 1;" ng-disabled="x.mode == 'delete'" />
                        </div>
                        <div class="col-sm-2 mb-3">
                            <div class="text-gray text-truncate" title="GRADUATION YEAR">
                                ISSUE
                            </div>
                            <input class="form-control"
                               ng-model="x.issue_date"
                               moment-picker="x.issue_date"
                               locale="th"
                               format="DD/MM/YYYY"
                               min-view="year"
                               max-view="month" required change="iTraining.is_change = 1; x.is_change = 1;" ng-disabled="x.mode == 'delete'" />
                        </div>
                    </div>
                    <div class="position-absolute" style="top:-20px; right:-15px;" ng-show="x.mode != 'delete'">
                        <div class="btn btn-circle border bg-white text-warning" ng-click="DeleteTraining(x)">
                            <i class="bi bi-x-circle fs-4"></i>
                        </div>
                    </div>
                    <div class="position-absolute" style="top:-20px; right:-15px;" ng-show="x.mode == 'delete'">
                        <div class="btn btn-circle border bg-white text-blue" ng-click="UndoTraining(x)">
                            <i class="bi bi-arrow-counterclockwise fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="d-grid">
                <button class="btn btn-primary" ng-click="SendRequest()"
                        ng-disabled="iPersonal.is_change != 1 && iAddress.is_change != 1 && iEmployee.is_change != 1 && iEducation.is_change != 1 && iJobExperience.is_change != 1 && iTraining.is_change != 1">
                    Send Request
                </button>
            </div>
        </div>
        @* Document *@
        <div class="" style="width:300px; min-width:300px;">
            <div class="rounded-4 bg-white border mb-4 p-4">
                <div class="d-flex align-items-center">
                    <div class="text-dark fs-5 fw-bolder d-flex align-items-center flex-fill">
                        <i class="bi bi-folder-fill fs-4 me-2 text-blue"></i> Document
                    </div>
                    <div>
                        <div class="btn btn-circle" ng-click="AddDocument()">
                            <i class="bi bi-plus-circle-fill text-blue fs-5"></i>
                        </div>
                    </div>
                </div>
                <div class="border border-dash text-gray-500 text-center p-3 rounded-3 mt-3">
                    <i class="bi bi-cloud-arrow-up-fill fs-3"></i>
                    <div class="fw-bolder">Click to upload or drag & drop</div>
                    <div class="">PDF, DOCX up to 10MB</div>
                </div>
            </div>
            @* System Log *@
            <div class="rounded-4 bg-light-blue border border-blue mb-4 p-4 d-flex">
                <div class="text-blue me-3">
                    <i class="bi bi-info-circle-fill fs-5"></i>
                </div>
                <div>
                    <div class="text-blue mb-2">System Audit Log</div>
                    <div class="text-dark">Last profile update was made on {{ iProfile.update_date }} by {{ iProfile.update_by }} </div>
                </div>
            </div>
        </div>
    </div>
    @* Modal *@
    @* Address *@
    <div id="addressModal" class="modal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-body">
                    <div>
                        <div class="mb-2">
                            <input ng-model="filter_name" class="form-control" />
                            <div class="list-group list-group-flush overflow-auto" style="max-height: 400px;">
                                <div class="list-group-item list-group-item-action d-flex align-items-center justify-content-between" ng-repeat="x in lMasterAddress | filter : filter_name | limitTo : 50">
                                    <div class="p-2">
                                        <nav aria-label="breadcrumb">
                                            <ol class="breadcrumb mb-0">
                                                <li class="breadcrumb-item active">{{ x.subDistrictName }}</li>
                                                <li class="breadcrumb-item active">{{ x.districtName }}</li>
                                                <li class="breadcrumb-item active">{{ x.provinceName }}</li>
                                                <li class="breadcrumb-item active">{{ x.postcode }}</li>
                                            </ol>
                                        </nav>
                                    </div>
                                    <div>
                                        <button ng-click="SelectAddress(x)" class="btn btn-circle">
                                            <i class="fas fa-plus"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="text-end">
                            <button class="btn btn-light" data-bs-dismiss="modal" aria-label="Close">
                                ปิด
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    @* Employee *@

    <div id="supervisorModal" class="modal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-body">
                    <div>
                        <div class="mb-2">
                            <input ng-model="filter_name" class="form-control" placeholder="Find..." />
                            <div class="list-group list-group-flush overflow-auto" style="max-height: 400px;">
                                <div class="list-group-item list-group-item-action d-flex align-items-center justify-content-between" ng-repeat="x in lEmployee | filter : filter_name">
                                    <div>
                                        <div class="text-dark fs-5 text-secondary">
                                            {{ x.firstname_th + ' ' + x.lastname_th }} <span ng-show="x.nickname != ''">({{ x.nickname }})</span>
                                        </div>
                                        <div class="text-dark fs-5 text-secondary">
                                            {{ x.firstname + ' ' + x.lastname }}
                                        </div>
                                        <small class="text-dark">
                                            {{ x.positionDesc }} {{ x.departmentDesc }}
                                        </small>
                                    </div>
                                    <div>
                                        <button ng-click="SelectSupervisor(x)" class="btn btn-circle">
                                            <i class="fas fa-plus"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="text-end">
                            <button class="btn btn-light" data-bs-dismiss="modal" aria-label="Close">
                                ปิด
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    $(".date").mask('00/00/0000');
    app.controller('DataCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.userId = '@Model.id';
        $scope.mode = 'EDIT_PROFILE';
        $scope.iEducation = {is_change : 0};
        $scope.iJobExperience = {is_change : 0};
        $scope.iTraining = {is_change : 0};

        $scope.LoadPersonal = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/UserPersonal',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    userId: $scope.userId
                    , create_by: '@User.UserId()'
                }),
                success: function (result) {
                    $timeout(async function () {
                        $scope.iPersonal = result.data;
                        $scope.iPersonal.is_change = 0;
                        $scope.can_view = result.can_view;
                        $scope.can_edit = result.can_edit;
                        
                        if($scope.iPersonal.birth_date){
                            $scope.iPersonal.birth_date_select = moment($scope.iPersonal.birth_date);
                        }
                    }, 0);
                }, error: AjaxError
            });
        }
        $scope.LoadPersonal();

        // Employee

        $scope.LoadMasterEmployee = function () {
            if (!$scope.lEmployeeType) {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/MasterCode/DataList'
                    , headers: { 'authorization': 'Bearer @token' }
                    , type: 'post'
                    , contentType: 'application/json'
                    , dataType: 'json'
                    , cache: false
                    , data: JSON.stringify({
                        groupName: 'employeeType'
                    })
                    , success: function (result) {
                        $timeout(function () {
                            $scope.lEmployeeType = result;
                        }, 0);
                    }
                    , error: AjaxError
                });
            }
            if (!$scope.lDepartment) {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/Department/DataList'
                    , headers: { 'authorization': 'Bearer @token' }
                    , type: 'post'
                    , contentType: 'application/json'
                    , dataType: 'json'
                    , cache: false
                    , data: JSON.stringify({
                        page: 1
                        , row: 99
                    })
                    , success: function (result) {
                        $timeout(function () {
                            $scope.lDepartment = result;
                        }, 0);
                    }
                    , error: AjaxError
                });
            }
            if (!$scope.lPosition) {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/Position/DataList'
