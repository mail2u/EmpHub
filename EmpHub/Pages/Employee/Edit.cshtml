                    $timeout(async function () {
                        $scope.iEducation = { is_change: 0 };
                        $scope.lEducation = result.data;
                    }, 0);
                }, error: AjaxError
            });
        }
        $scope.LoadEducation();

        $scope.AddEducation = function () {
            $timeout(function () {
                $scope.lEducation.splice($scope.lEducation.length, 0, { educationId: '', mode: "modify" });
                $scope.iEducation.is_change = 1;
            }, 0);
        }

        $scope.DeleteEducation = function (x) {
            $timeout(function () {
                if(x.educationId == ''){
                    var index = $scope.lEducation.indexOf(x);
                    $scope.lEducation.splice(index,1);
                }else{
                    x.mode = 'delete';
                    $scope.iEducation.is_change = 1;
                }
            }, 0);
        }
        
        $scope.UndoEducation = function (x) {
            $timeout(function () {
                x.mode = '';
            }, 0);
        }

        // Job Experience

        $scope.LoadJobExperience = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/UserJobExperience',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    userId: $scope.userId
                    , create_by: '@User.UserId()'
                }),
                success: function (result) {
                    $timeout(async function () {
                        $scope.iJobExperience = { is_change: 0 };
                        $scope.lJobExperience = result.data;

                        if ($scope.lJobExperience.length > 0) {
                            $scope.lJobExperience = $scope.lJobExperience.map(x => {
                                if(x.fromDate){
                                    x.from_date = moment(x.fromDate, "DD/MM/YYYY");
                                }
                                if(x.endDate){
                                    x.end_date = moment(x.endDate, "DD/MM/YYYY");
                                }

                                return x;
                            });
                        }

                    }, 0);
                }, error: AjaxError
            });
        }
        $scope.LoadJobExperience();

        $scope.AddJobExperience = function () {
            $timeout(function () {
                $scope.lJobExperience.splice($scope.lJobExperience.length, 0, { jobId: '',  mode: "modify" });
                $scope.iJobExperience.is_change = 1;
            }, 0);
        }

        $scope.DeleteJobExperience = function (x) {
            $timeout(function () {
                 if(x.jobId == ''){
                    var index = $scope.lJobExperience.indexOf(x);
                    $scope.lJobExperience.splice(index,1);
                }else{
                    x.mode = 'delete';
                    $scope.iJobExperience.is_change = 1;
                }
            }, 0);
        }
        
        $scope.UndoJobExperience = function (x) {
            $timeout(function () {
                x.mode = '';
            }, 0);
        }

        // Training

        $scope.LoadTraining = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/UserTraining',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    userId: $scope.userId
                    , create_by: '@User.UserId()'
                }),
                success: function (result) {
                    $timeout(async function () {
                        $scope.iTraining = { is_change: 0 };
                        $scope.lTraining = result.data;

                        if ($scope.lTraining.length > 0) {
                            $scope.lTraining = $scope.lTraining.map(x => {
                                if(x.issueDate){
                                    x.issue_date = moment(x.issueDate, "DD/MM/YYYY");
                                }

                                return x;
                            });
                        }
                    }, 0);
                }, error: AjaxError
            });
        }
        $scope.LoadTraining();

        $scope.AddTraining = function () {
            $timeout(function () {
                $scope.lTraining.splice($scope.lTraining.length, 0, { trainingId: '', mode: "modify" });
                $scope.iTraining.is_change = 1;
            }, 0);
        }

        $scope.DeleteTraining = function (x) {
            $timeout(function () {
                 if(x.trainingId == ''){
                    var index = $scope.lTraining.indexOf(x);
                    $scope.lTraining.splice(index,1);
                }else{
                    x.mode = 'delete';
                    $scope.iTraining.is_change = 1;
                }
            }, 0);
        }
        
        $scope.UndoTraining = function (x) {
            $timeout(function () {
                x.mode = '';
            }, 0);
        }

        // Request

        $scope.SendRequest = async function(){
            var id = await $scope.CreateService();
            var flag = true;

            if ($scope.iPersonal.is_change == 1){
                var check = await $scope.CreatePersonal(id);
                flag = check == true ? flag : false;
            }
            if ($scope.iAddress.is_change == 1) {
                var check = await $scope.CreateAddress(id);
                flag = check == true ? flag : false;
            }
            if ($scope.iEmployee.is_change == 1) {
                var check = await $scope.CreateEmployee(id);
                flag = check == true ? flag : false;
            }
            if ($scope.iEducation.is_change == 1) {
                var check = await $scope.CreateEducation(id);
                flag = check == true ? flag : false;
            }
            if ($scope.iJobExperience.is_change == 1) {
                var check = await $scope.CreateJobExperience(id);
                flag = check == true ? flag : false;
            }
            if ($scope.iTraining.is_change == 1) {
                var check = await $scope.CreateTraining(id);
                flag = check == true ? flag : false;
            }

            if(flag){
                await $scope.ServiceRequest(id);
            }else{
                await $scope.CancelService(id);
            }
        }

        $scope.LoadCategory = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Category/CategoryByCode',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    subCategoryCode: $scope.mode
                }),
                success: function (result) {
                    $timeout(async function () {
                        if (result.length > 0) {
                            $scope.iCategory = result[0];

                            $scope.iData = {};
                            $scope.iData.categoryId = $scope.iCategory.cateId;
                            $scope.iData.categoryCode = $scope.iCategory.categoryCode;
                            $scope.iData.categoryDesc = $scope.iCategory.categoryDesc;
                            $scope.iData.subCategoryId = $scope.iCategory.subCateId;
                            $scope.iData.subCategoryCode = $scope.iCategory.subCategoryCode;
                            $scope.iData.subCategoryDesc = $scope.iCategory.subCategoryDesc;
                            $scope.iData.userId = $scope.userId;
                            $scope.iData.createBy = '@User.UserId()';
                        }else{

                        }
                    }, 0);
                }, error: AjaxError
            });
        }
        $scope.LoadCategory();

        $scope.CreateService = function () {
            return new Promise((resolve) => {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/Service/Create',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    dataType: 'json',
                    cache: false,
                    data: JSON.stringify($scope.iData),
                    success: function (result) {
                        $timeout(async function () {
                            resolve(result.id);
                        }, 0);
                    }, error: function (jqXHR, error, errorThrown) {
                        resolve(null);
                        Swal.fire({
                            title: "Create Service Error",
                            text: jqXHR.responseText,
                            icon: "error",
                            confirmButtonColor: '#1e3b92',
                        });
                    }
                });
            });
        }

        $scope.ServiceRequest = function (id) {
            return new Promise((resolve) => {
                $scope.iData.id = id;
                $scope.iData.userBy = '@User.UserId()';

                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/Service/Request',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    dataType: 'json',
                    cache: false,
                    data: JSON.stringify($scope.iData),
                    success: function (result) {
                        $timeout(async function () {
                            alertSuccess("Send Request", "Successful", function () {
                                location.href = '@Url.Page("/Service/Detail")/' + id;
                            });

                            resolve(result.serviceNo)
                        }, 0);
                    }, error: function (jqXHR, error, errorThrown) {
                        resolve(null);
                        Swal.fire({
                            title: "Service Request Error",
                            text: jqXHR.responseText,
                            icon: "error",
                            confirmButtonColor: '#1e3b92',
                        });
                    }
                });
            });
        }

        $scope.CancelService = function (id) {
            return new Promise((resolve) => {
                $scope.iData.id = id;
                $scope.iData.userBy = '@User.UserId()';
                $scope.iData.description = 'Error Auto Cancel';

                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/Service/Cancel',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    dataType: 'json',
                    cache: false,
                    data: JSON.stringify($scope.iData),
                    success: function (result) {
                        $timeout(async function () {
                            alertSuccess("Send Request Error", "The transaction failed to save. Please check.", function () {
                                location.href = '@Url.Page("/Service/Detail")/' + id;
                            });
                            resolve(result.serviceNo)
                        }, 0);
                    }, error: function (jqXHR, error, errorThrown) {
                        resolve(null);
                        Swal.fire({
                            title: "Cancel Service Error",
                            text: jqXHR.responseText,
                            icon: "error",
                            confirmButtonColor: '#1e3b92',
                        });
                    }
                });
            });
        }

        $scope.CreatePersonal = function (id) {
            return new Promise((resolve) => {
                $scope.iPersonal.id = id;
                $scope.iPersonal.refId = id;

                if ($scope.iPersonal.birth_date_select) {
                    $scope.iPersonal.birth_date = $scope.iPersonal.birth_date_select.format("DD/MM/YYYY");
                }

                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/ServicePersonal/Save',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    cache: false,
                    data: JSON.stringify($scope.iPersonal),
                    success: function () {
                        $timeout(async function () {
                            resolve(true);
                        }, 0);
                    }, error: function (jqXHR, error, errorThrown) {
                        resolve(null);
                        Swal.fire({
                            title: "Save Personal Error",
                            text: jqXHR.responseText,
                            icon: "error",
                            confirmButtonColor: '#1e3b92',
                        });
                    }
                });
            });
        }

        $scope.CreateAddress = function(id){
            return new Promise((resolve) => {
                $scope.iAddress.id = id;
                $scope.iAddress.refId = id;

                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/ServiceAddress/Save',
                    headers: { 'authorization': 'Bearer @token' },
