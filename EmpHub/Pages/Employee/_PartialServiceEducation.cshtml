@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    var token = User.AccessToken(Context);
}
<div ng-controller="ServiceEducationCtrl" id="tab_education">
    @* View *@
    <div class="">
        <div ng-show="lData.length > 0">
            <div class="list-group list-group-flush">
                <div class="list-group-item px-0" ng-repeat="x in lData">
                    <div class="row ">
                        <div class="col-sm-8 mb-3">
                            <div class="text-gray">
                                หลักสูตรหรือวุฒิการศึกษา
                            </div>
                            <div class="text-dark fs-5">{{ x.levelName != '' ? x.levelName : '-' }}</div>
                        </div>
                        <div class="col-sm-4 mb-3">
                            <div class="text-gray">
                                ปีที่สำเร็จการศึกษา
                            </div>
                            <div class="text-dark fs-5">{{ x.year != '' ? x.year : '-' }}</div>
                        </div>
                        <div class="col-sm-12 mb-3">
                            <div class="text-gray">
                                สถาบันการศึกษา
                            </div>
                            <div class="text-dark fs-5">{{ x.institution != '' ? x.institution : '-' }}</div>
                        </div>
                    </div>
                </div>
            </div>
            @* <div class="pt-2 d-flex align-items-center">
                <div class="btn btn-secondary-invert" ng-click="View()">
                    <i class="bi bi-pen"></i> แก้ไข
                </div>
                <div ng-show="status == 'Pending'" class="ms-3 bg-gray rounded-3 d-flex p-2">
                    <div class="me-2 text-warning">รออนุมัติการปรับปรุงข้อมูล</div>
                    <div class="badge bg-danger select" ng-click="Cancel()">
                        <i class="bi bi-x-circle"></i> ยกเลิก
                    </div>
                </div>
            </div> *@
        </div>
        <div ng-show="lData.length == 0">
            <a class="btn btn-light fw-bolder rounded-3 p-4" href="@Url.Page("/Service/Create")?cateCode=AddInfo&subCateCode=Education">
                <i class="fas fa-plus me-2"></i> เพิ่มประวัติการศึกษาของคุณ
            </a>
        </div>
    </div>

    @* Dialog *@
    <div class="offcanvas offcanvas-end" data-bs-scroll="true" tabindex="-1" id="educationOff" aria-labelledby="offcanvasLabel" style="width:600px;">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title text-secondary text-dark fs-5" id="offcanvasLabel">ข้อมูลการศึกษา</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <div class="list-group list-group-flush">
                <div class="list-group-item list-group-item-action rounded-3 p-3 mb-3" ng-repeat="x in lData">
                    <div>
                        <div class="badge badge-{{ x.mode }}">{{ x.mode }}</div>
                    </div>
                    <div class="row ">
                        <div class="col-sm-8 mb-3">
                            <div class="text-gray">
                                หลักสูตรหรือวุฒิการศึกษา
                            </div>
                            <div class="text-dark fs-5">{{ x.levelName }}</div>
                        </div>
                        <div class="col-sm-4 mb-3">
                            <div class="text-gray">
                                ปีที่สำเร็จการศึกษา
                            </div>
                            <div class="text-dark fs-5">{{ x.year }}</div>
                        </div>
                        <div class="col-sm-12 mb-3">
                            <div class="text-gray">
                                สถาบันการศึกษา
                            </div>
                            <div class="text-dark fs-5">{{ x.institution }}</div>
                        </div>
                        <div class="col-sm-12 mb-3">
                            <div class="text-gray">
                                เพิ่มกิจกรรม เกียรตินิยม รางวัล หรือโครงการพิเศษที่ประสบความสำเร็จระหว่างการศึกษา
                            </div>
                            <div class="text-dark fs-5">{{ x.description }}</div>
                        </div>
                        <div class="col-sm-12">
                            <div class="btn btn-warning-invert" ng-click="Edit(x)">
                                <i class="bi bi-pen"></i> แก้ไข
                            </div>
                            <div class="btn btn-danger-invert" ng-click="Delete(x)">
                                <i class="bi bi-trash3"></i> ลบ
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="btn btn-secondary-invert" ng-click="New()">
                <i class="bi bi-plus-lg"></i> เพิ่มข้อมูลการศึกษา
            </div>
        </div>
    </div>

    <div class="offcanvas offcanvas-end" data-bs-scroll="true" tabindex="-1" id="educationOffEdit" aria-labelledby="offcanvasLabel" style="width:600px;">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title text-secondary text-dark fs-5" id="offcanvasLabel">ข้อมูลการศึกษา</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <div class="row">
                <div class="col-sm-12 mb-3">
                    <div class="text-dark fs-5">หลักสูตรหรือวุฒิการศึกษา</div>
                    <select ng-model="iEdit.levelCode" class="form-select" ng-options="x.code as x.desc_th for x in lEduction"></select>
                </div>
                <div class="col-sm-12 mb-3">
                    <div class="text-dark fs-5">สถาบันการศึกษา</div>
                    <input ng-model="iEdit.institution" class="form-control" maxlength="200" />
                </div>
                <div class="col-sm-6 mb-3">
                    <div class="text-dark fs-5">ปีที่สำเร็จการศึกษา</div>
                    <input ng-model="iEdit.year" class="form-control year" />
                </div>
                <div class="col-sm-12 mb-3">
                    <div class="text-gray">เพิ่มกิจกรรม เกียรตินิยม รางวัล หรือโครงการพิเศษที่ประสบความสำเร็จระหว่างการศึกษา</div>
                    <textarea ng-model="iEdit.description" class="form-control" rows="5" maxlength="4000"></textarea>
                </div>
            </div>
            <div class="pt-3">
                <div class="btn btn-secondary" ng-click="Save()">
                    <i class="bi bi-send"></i> ส่งปรับปรุงข้อมูล
                </div>
                <div class="btn btn-link" data-bs-dismiss="offcanvas">
                    ยกเลิก
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    $(".year").mask("0000");
    app.controller('ServiceEducationCtrl', function ($scope, $http, $timeout, $filter) {

        $scope.LoadMaster = function () {
            if (!$scope.lEduction) {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/MasterCode/DataList'
                    , headers: { 'authorization': 'Bearer @token' }
                    , type: 'post'
                    , contentType: 'application/json'
                    , dataType: 'json'
                    , cache: false
                    , data: JSON.stringify({
                        groupName: 'educationCode'
                    })
                    , success: function (result) {
                        $timeout(function () {
                            $scope.lEduction = result;
                        }, 0);
                    }
                    , error: AjaxError
                });
            }
        }
        $scope.LoadData = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/ServiceEducation/Detail',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    userId: $scope.userId
                    , create_by: '@User.UserId()'
                }),
                success: function (result) {
                    $timeout(async function () {
                        $scope.lData = result;
                        $scope.status = $scope.lData.filter(x => x.status == 'Pending').length > 0 ? 'Pending' : 'Approve';
                    }, 0);
                }, error: AjaxError
            });
        }

        $scope.InitEducation = function () {
            $scope.userId = $scope.$parent.userId
            $scope.LoadData();
        }
        $scope.InitEducation();

        $scope.View = function () {
            $scope.LoadData();
            $("#educationOff").offcanvas('show');
        }

        $scope.New = function () {
            $scope.LoadMaster();

            $("#educationOffEdit").offcanvas('show');
            $scope.iEdit = { educationId: '' };
        }

        $scope.Edit = function (x) {
            $scope.LoadMaster();

            $("#educationOffEdit").offcanvas('show');
            $scope.iEdit = x;
        }

        $scope.Save = async function () {
            $("#educationOffEdit").offcanvas('hide');

            if ($scope.iEdit.educationId == '') {
                $scope.lData.splice($scope.lData.length, 0, $scope.iEdit);
            }

            for(var i = 0; i < $scope.lData.length; i++){
                var iData = $scope.lData[i];
                await $scope.SaveItem(iData);
            }

            $scope.LoadData();
        }

        $scope.SaveItem = function(x){
            return new Promise((resolve) => {
                x.levelName = $scope.lEduction.find(a => a.code == x.levelCode).desc_th;
                x.create_by = '@User.UserId()';
                x.userId = '@User.UserId()';
                
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/ServiceEducation/Save',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    cache: false,
                    data: JSON.stringify(x),
                    success: function () {
                        $timeout(async function () {
                            resolve(true);
                        }, 0);
                    }, error: function(){
                        resolve(false);
                    }
                });
            });
        }

        $scope.Cancel = function () {
            alertConfirm("ท่านต้องการยกเลิกรายการ", "ยืนยันการยกเลิกการปรับปรุงข้อมูลการศึกษา", function () {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/ServiceEducation/Cancel',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    cache: false,
                    data: JSON.stringify({
                        userId: $scope.userId
                        , update_by: '@User.UserId()'
                    }),
                    success: function () {
                        $timeout(async function () {
                            $scope.LoadData();
                        }, 0);
                    }, error: AjaxError
                });
            });
        }

        $scope.Delete = function (x) {
            alertConfirm("ท่านต้องการลบรายการ", "ยืนยันการลบข้อมูลการศึกษา", function () {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/ServiceEducation/Delete',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    cache: false,
                    data: JSON.stringify({
                        educationId: x.educationId
                        , update_by: '@User.UserId()'
                    }),
                    success: function () {
                        $timeout(async function () {
                            $scope.LoadData();
                        }, 0);
                    }, error: AjaxError
                });
            });
        }
    });
</script>