@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
<div ng-controller="ServiceEducationCtrl" id="tab_education">
    @* View *@
    <div class="bg-white rounded-5 p-4 mb-3">
        <div class="d-flex align-items-center mb-4" ng-click="EditStage('education')">
            <div class="fw-bolder flex-fill text-secondary fs-5">
                ข้อมูลการศึกษา
            </div>
        </div>
        <div ng-show="lData.length > 0">
            <div class="list-group list-group-flush">
                <div class="list-group-item px-0" ng-repeat="x in lData">
                    <div class="row ">
                        <div class="col-sm-8 mb-3">
                            <div class="text-gray">
                                หลักสูตรหรือวุฒิการศึกษา
                            </div>
                            <div class="fw-bolder">{{ x.levelName }}</div>
                        </div>
                        <div class="col-sm-4 mb-3">
                            <div class="text-gray">
                                ปีที่สำเร็จการศึกษา
                            </div>
                            <div class="fw-bolder">{{ x.year }}</div>
                        </div>
                        <div class="col-sm-12 mb-3">
                            <div class="text-gray">
                                สถาบันการศึกษา
                            </div>
                            <div class="fw-bolder">{{ x.institution }}</div>
                        </div>
                        <div class="col-sm-12 mb-3">
                            <div class="text-gray">
                                เพิ่มกิจกรรม เกียรตินิยม รางวัล หรือโครงการพิเศษที่ประสบความสำเร็จระหว่างการศึกษา
                            </div>
                            <div class="fw-bolder">{{ x.description }}</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="pt-2 d-flex align-items-center">
                <div class="btn btn-secondary-invert" ng-click="View()">
                    <i class="bi bi-pen"></i> แก้ไข
                </div>
                <div ng-show="status == 'Pending'" class="ms-3 text-warning bg-light-gray rounded-3 flex-fill p-2">
                    รออนุมัติการปรับปรุงข้อมูล
                    <div class="badge bg-danger select" ng-click="Cancel()">
                        <i class="bi bi-x"></i> ยกเลิก
                    </div>
                </div>
            </div>
        </div>
        <div ng-show="lData.length == 0">
            <div class="row">
                <div class="col-sm-12 mb-3 text-gray">
                    เพิ่มประวัติการศึกษาของคุณ
                </div>
            </div>
            <div class="pt-2 d-flex align-items-center">
                <div class="btn btn-secondary-invert" ng-click="New()">
                    <i class="bi bi-plus-lg"></i> เพิ่มข้อมูลการศึกษา
                </div>
            </div>
        </div>
    </div>

    @* Dialog *@
    <div class="offcanvas offcanvas-end" data-bs-scroll="true" tabindex="-1" id="educationOff" aria-labelledby="offcanvasLabel" style="width:600px;">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title text-secondary fw-bolder" id="offcanvasLabel">ข้อมูลการศึกษา</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <div class="list-group list-group-flush">
                <div class="list-group-item list-group-item-action rounded-3 p-3 mb-3" ng-repeat="x in lData">
                    <div class="row ">
                        <div class="col-sm-8 mb-3">
                            <div class="text-gray">
                                หลักสูตรหรือวุฒิการศึกษา
                            </div>
                            <div class="fw-bolder">{{ x.levelName }}</div>
                        </div>
                        <div class="col-sm-4 mb-3">
                            <div class="text-gray">
                                ปีที่สำเร็จการศึกษา
                            </div>
                            <div class="fw-bolder">{{ x.year }}</div>
                        </div>
                        <div class="col-sm-12 mb-3">
                            <div class="text-gray">
                                สถาบันการศึกษา
                            </div>
                            <div class="fw-bolder">{{ x.institution }}</div>
                        </div>
                        <div class="col-sm-12 mb-3">
                            <div class="text-gray">
                                เพิ่มกิจกรรม เกียรตินิยม รางวัล หรือโครงการพิเศษที่ประสบความสำเร็จระหว่างการศึกษา
                            </div>
                            <div class="fw-bolder">{{ x.description }}</div>
                        </div>
                        <div class="col-sm-12">
                            <div class="btn btn-warning-invert" ng-click="Edit(x)">
                                <i class="bi bi-pen"></i> แก้ไข
                            </div>
                            <div class="btn btn-danger-invert" ng-click="Delete(x)">
                                <i class="bi bi-trash3"></i> ลบ
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="btn btn-secondary-invert" ng-click="New()">
                <i class="bi bi-plus-lg"></i> เพิ่มข้อมูลการศึกษา
            </div>
        </div>
    </div>

    <div class="offcanvas offcanvas-end" data-bs-scroll="true" tabindex="-1" id="educationOffEdit" aria-labelledby="offcanvasLabel" style="width:600px;">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title text-secondary fw-bolder" id="offcanvasLabel">ข้อมูลการศึกษา</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <div class="row">
                <div class="col-sm-12 mb-3">
                    <div class="fw-bolder">หลักสูตรหรือวุฒิการศึกษา</div>
                    <select ng-model="iEdit.levelCode" class="form-select" ng-options="x.code as x.desc_th for x in lEduction"></select>
                </div>
                <div class="col-sm-12 mb-3">
                    <div class="fw-bolder">สถาบันการศึกษา</div>
                    <input ng-model="iEdit.institution" class="form-control" maxlength="200" />
                </div>
                <div class="col-sm-6 mb-3">
                    <div class="fw-bolder">ปีที่สำเร็จการศึกษา</div>
                    <input ng-model="iEdit.year" class="form-control year" />
                </div>
                <div class="col-sm-12 mb-3">
                    <div class="text-gray">เพิ่มกิจกรรม เกียรตินิยม รางวัล หรือโครงการพิเศษที่ประสบความสำเร็จระหว่างการศึกษา</div>
                    <textarea ng-model="iEdit.description" class="form-control" rows="5" maxlength="4000"></textarea>
                </div>
            </div>
            <div class="pt-3">
                <div class="btn btn-secondary" ng-click="Save()">
                    บันทึก
                </div>
                <div class="btn btn-link" data-bs-dismiss="offcanvas">
                    ยกเลิก
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    $(".year").mask("0000");
    app.controller('ServiceEducationCtrl', function ($scope, $http, $timeout, $filter) {

        $scope.LoadMaster = function () {
            if (!$scope.lEduction) {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/MasterCode/DataList'
                    , headers: { 'authorization': 'Bearer @User.AccessToken()' }
                    , type: 'post'
                    , contentType: 'application/json'
                    , dataType: 'json'
                    , cache: false
                    , data: JSON.stringify({
                        groupName: 'educationCode'
                    })
                    , success: function (result) {
                        $timeout(function () {
                            $scope.lEduction = result;
                        }, 0);
                    }
                    , error: AjaxError
                });
            }
        }
        $scope.LoadData = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/ServiceEducation/Detail',
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    userId: $scope.userId
                    , create_by: '@User.UserId()'
                }),
                success: function (result) {
                    $timeout(async function () {
                        $scope.lData = result;
                        $scope.status = $scope.lData.filter(x => x.status == 'Pending').length > 0 ? 'Pending' : 'Approve';
                    }, 0);
                }, error: AjaxError
            });
        }

        $scope.InitEducation = function () {
            $scope.userId = $scope.$parent.userId
            $scope.LoadData();
        }
        $scope.InitEducation();

        $scope.View = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/ServiceEducation/Clone',
                type: "POST",
                contentType: 'application/json',
                cache: false,
                data: JSON.stringify({
                    userId: $scope.userId
                    , create_by: '@User.UserId()'
                }),
                success: function () {
                    $timeout(async function () {
                        $scope.LoadData();
                        $("#educationOff").offcanvas('show');
                    }, 0);
                }, error: AjaxError
            });
        }

        $scope.New = function () {
            $scope.LoadMaster();

            $("#educationOffEdit").offcanvas('show');
            $scope.iEdit = {};
            $scope.iEdit.educationId = '';
            $scope.iEdit.userId = $scope.userId;
            $scope.iEdit.create_by = '@User.UserId()';
        }

        $scope.Edit = function (x) {
            $scope.LoadMaster();

            $("#educationOffEdit").offcanvas('show');
            $scope.iEdit = {};
            $scope.iEdit.educationId = x.educationId;
            $scope.iEdit.levelCode = x.levelCode;
            $scope.iEdit.levelName = x.levelName;
            $scope.iEdit.institution = x.institution;
            $scope.iEdit.year = x.year;
            $scope.iEdit.description = x.description;
            $scope.iEdit.userId = $scope.userId;
            $scope.iEdit.create_by = '@User.UserId()';
        }

        $scope.Save = function () {
            $("#educationOffEdit").offcanvas('hide');

            $scope.iEdit.levelName = $scope.lEduction.find(a => a.code == $scope.iEdit.levelCode).desc_th;

            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/ServiceEducation/Save',
                type: "POST",
                contentType: 'application/json',
                cache: false,
                data: JSON.stringify($scope.iEdit),
                success: function () {
                    $timeout(async function () {
                        $scope.LoadData();
                    }, 0);
                }, error: AjaxError
            });
        }

        $scope.Cancel = function () {
            alertConfirm("ท่านต้องการยกเลิกรายการ", "ยืนยันการยกเลิกการปรับปรุงข้อมูลการศึกษา", function () {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/ServiceEducation/Cancel',
                    type: "POST",
                    contentType: 'application/json',
                    cache: false,
                    data: JSON.stringify({
                        userId: $scope.userId
                        , update_by: '@User.UserId()'
                    }),
                    success: function () {
                        $timeout(async function () {
                            $scope.LoadData();
                        }, 0);
                    }, error: AjaxError
                });
            });
        }

        $scope.Delete = function (x) {
            alertConfirm("ท่านต้องการลบรายการ", "ยืนยันการลบข้อมูลการศึกษา", function () {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/ServiceEducation/Delete',
                    type: "POST",
                    contentType: 'application/json',
                    cache: false,
                    data: JSON.stringify({
                        educationId: x.educationId
                        , update_by: '@User.UserId()'
                    }),
                    success: function () {
                        $timeout(async function () {
                            $scope.LoadData();
                        }, 0);
                    }, error: AjaxError
                });
            });
        }
    });
</script>