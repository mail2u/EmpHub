@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
<div>
    <div class="row">
        <div class="col-sm-4 mb-3">
            <div class="text-dark fw-bolder">ชื่อ-นามสกุล</div>
            <div>{{ iPersonal.prefix_th }} {{ iPersonal.firstname_th }} {{ iPersonal.lastname_th }}</div>
        </div>
        <div class="col-sm-4 mb-3">
            <div class="text-dark fw-bolder">ชื่อ-นามสกุล (ภาษาอังกฤษ)</div>
            <div>{{ iPersonal.prefix_en }} {{ iPersonal.firstname_en }} {{ iPersonal.lastname_en }}</div>
        </div>
        <div class="col-sm-4 mb-3">
            <div class="text-dark fw-bolder">ชื่อเล่น</div>
            <div>{{ iPersonal.nickname == '' ? '-' : iPersonal.nickname }}</div>
        </div>
        <div class="col-sm-4 mb-3">
            <div class="text-dark fw-bolder">วันเกิด</div>
            <div>{{ iPersonal.birth_date == '' ? '-' : iPersonal.birth_date }}</div>
        </div>
        <div class="col-sm-4 mb-3">
            <div class="text-dark fw-bolder">อายุ</div>
            <div>{{ iPersonal.age == '' ? '-' : iPersonal.age }}</div>
        </div>
        <div class="col-sm-4 mb-3">
            <div class="text-dark fw-bolder">เพศ</div>
            <div>{{ iPersonal.sex == '' ? '-' : iPersonal.sex }}</div>
        </div>
        <div class="col-sm-4 mb-3">
            <div class="text-dark fw-bolder">น้ำหนัก</div>
            <div>{{ iPersonal.weight == '' ? '-' : iPersonal.weight }}</div>
        </div>
        <div class="col-sm-4 mb-3">
            <div class="text-dark fw-bolder">ส่วนสูง</div>
            <div>{{ iPersonal.height == '' ? '-' : iPersonal.height }}</div>
        </div>
        <div class="col-sm-4 mb-3">
            <div class="text-dark fw-bolder">กรุ๊ปเลือด</div>
            <div>{{ iPersonal.blood == '' ? '-' : iPersonal.blood }}</div>
        </div>
        <div class="col-sm-4 mb-3">
            <div class="text-dark fw-bolder">สัญชาติ</div>
            <div>{{ iPersonal.nationality == '' ? '-' : iPersonal.nationality }}</div>
        </div>
        <div class="col-sm-4 mb-3">
            <div class="text-dark fw-bolder">เชื้อชาติ</div>
            <div>{{ iPersonal.ethnicity == '' ? '-' : iPersonal.ethnicity }}</div>
        </div>
        <div class="col-sm-4 mb-3">
            <div class="text-dark fw-bolder">ศาสนา</div>
            <div>{{ iPersonal.religion == '' ? '-' : iPersonal.religion }}</div>
        </div>
        <div class="col-sm-4 mb-3">
            <div class="text-dark fw-bolder">สถานภาพการสมรส</div>
            <div>{{ iPersonal.maritalStatus == '' ? '-' : iPersonal.maritalStatus }}</div>
        </div>
        <div class="col-sm-4 mb-3">
            <div class="text-dark fw-bolder">สถานะทางการทหาร</div>
            <div>{{ iPersonal.militaryStatus == '' ? '-' : iPersonal.militaryStatus }}</div>
        </div>
        <div class="col-sm-4 mb-3">
            <div class="text-dark fw-bolder">สถานะความพิการ</div>
            <div>{{ iPersonal.disabilityStatus == '' ? '-' : iPersonal.disabilityStatus }}</div>
        </div>
    </div>
    <hr class="my-3" />
    <div class="mb-2 d-flex align-items-center">
        <div class="flex-fill">
            <div>
                ปรับปรุงล่าสุด <span class="fw-bolder">{{ iPersonal.update_date }}</span> โดย <span class="fw-bolder">{{ iPersonal.update_by }}</span>
            </div>
        </div>
        <div>
            <a class="btn btn-sm btn-warning-invert" href="@Url.Page("/Service/FormUpdateDataPersonal")?mode=EDIT_PERSONAL&id={{userId}}" target="_blank">
                <i class="bi bi-pen me-2"></i> แก้ไข
            </a>
        </div>
    </div>
</div>