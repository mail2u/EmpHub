@{
    var token = User.AccessToken(Context);
}
<div ng-controller="ServicePersonalCtrl" id="tab_personal">
    @* View *@
    <div class="rounded-4 mb-2 bg-white position-relative">
        <div class="text-center mb-4">
            <img src="~/Images/icon-user.png" class="rounded-pill" width="200px" />
        </div>
        <div class="d-flex">
            <div class="flex-fill">
                <div class="row">
                    <div class="col-sm-5 mb-3">
                        <div class="text-gray">
                            ชื่อ-สกุล (ภาษาไทย)
                        </div>
                        <div class="text-dark fs-5">{{ iData.firstname_th }} {{ iData.lastname_th }}</div>
                    </div>
                    <div class="col-sm-7 mb-3">
                        <div class="text-gray">
                            ชื่อเล่น
                        </div>
                        <div class="text-dark fs-5">{{ iData.nickname != '' ? iData.nickname : '-' }}</div>
                    </div>
                    <div class="col-sm-5 mb-3">
                        <div class="text-gray">
                            ชื่อ-สกุล (ภาษาอังกฤษ)
                        </div>
                        <div class="text-dark fs-5">{{ iData.firstname_en }} {{ iData.lastname_en }}</div>
                    </div>
                    <div class="col-sm-5 mb-3">
                        <div class="text-gray">
                            วันเกิด
                        </div>
                        <div class="text-dark fs-5">{{ iData.birth_date != '' ? iData.birth_date : '-' }}</div>
                    </div>
                    <div class="col-sm-2 mb-3">
                        <div class="text-gray">
                            เพศ
                        </div>
                        <div class="text-dark fs-5">{{ iData.sex == 'Male' ? 'ชาย' : iData.sex == 'Female' ? 'หญิง' : '-'  }}</div>
                    </div>
                    <div class="col-sm-5 mb-3">
                        <div class="text-gray">
                            เบอร์ติดต่อ
                        </div>
                        <div class="text-dark fs-5">{{ iData.phoneNo != '' ? iData.phoneNo : '-' }}</div>
                    </div>
                    <div class="col-sm-7">
                        <div class="text-gray">
                            อีเมล์
                        </div>
                        <div class="text-dark fs-5">{{ iData.email != '' ? iData.email : '-' }}</div>
                    </div>
                </div>
                @* Notify *@
                @* <div class="d-flex align-items-center">
                    <div ng-show="iData.status == 'Pending'" class="ms-3 d-flex bg-white bg-opacity-25 rounded p-2">
                        <div class="me-2 text-warning">
                            รออนุมัติการปรับปรุงข้อมูล
                        </div>
                        <div class="badge bg-danger select" ng-click="Cancel()">
                            <i class="bi bi-x-circle"></i> ยกเลิก
                        </div>
                    </div>
                </div> *@
                @* Edit *@
              @*   <div class="position-absolute top-0 end-0 m-2">
                    <div class="btn btn-circle border-0" ng-click="Edit()">
                        <i class="bi bi-pen"></i>
                    </div>
                </div> *@
            </div>
        </div>
    </div>
    @* Dialog *@
    <div class="offcanvas offcanvas-end" data-bs-scroll="true" tabindex="-1" id="personalOff" aria-labelledby="offcanvasLabel" style="width:600px;">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title text-secondary text-dark fs-5" id="offcanvasLabel">ข้อมูลส่วนบุคคล</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <div class="row">
                <div class="col-sm-6 mb-3">
                    <div class="text-dark fs-5">ชื่อ</div>
                    <input ng-model="iEdit.firstname_th" class="form-control" />
                </div>
                <div class="col-sm-6 mb-3">
                    <div class="text-dark fs-5">นามสกุล</div>
                    <input ng-model="iEdit.lastname_th" class="form-control" />
                </div>
                <div class="col-sm-6 mb-3">
                    <div class="text-dark fs-5">Firstname</div>
                    <input ng-model="iEdit.firstname_en" class="form-control" />
                </div>
                <div class="col-sm-6 mb-3">
                    <div class="text-dark fs-5">Lastname</div>
                    <input ng-model="iEdit.lastname_en" class="form-control" />
                </div>
                <div class="col-sm-4 mb-3">
                    <div class="text-dark fs-5">ชื่อเล่น</div>
                    <input ng-model="iEdit.nickname" class="form-control" />
                </div>
                <div class="col-sm-4 mb-3">
                    <div class="text-dark fs-5">วันเกิด (ค.ศ.)</div>
                    <input class="form-control icon-calendar date"
                           ng-model="iEdit.birth_date_select"
                           ng-model-options="{ updateOn: 'blur' }"
                           moment-picker="iEdit.birth_date_select"
                           locale="th"
                           format="DD/MM/YYYY"
                           min-view="month"
                           max-view="month" required />
                </div>
                <div class="col-sm-4 mb-3">
                    <div class="text-dark fs-5">เพศ</div>
                    <div class="d-flex align-items-center p-2">
                        <div class="me-4">
                            <input ng-model="iEdit.sex" type="radio" value="Male" id="ra_male" />
                            <label for="ra_male">ชาย</label>
                        </div>
                        <div>
                            <input ng-model="iEdit.sex" type="radio" value="Female" id="ra_female" />
                            <label for="ra_female">หญิง</label>
                        </div>
                    </div>
                </div>
                @*  <div class="col-sm-4 mb-3">
                <div class="text-dark fs-5">สถานะ</div>
                <input ng-model="iEdit.maritalStatus" class="form-control" />
                </div> *@
                <div class="col-sm-6 mb-3">
                    <div class="text-dark fs-5">เบอร์ติดต่อ</div>
                    <input ng-model="iEdit.phoneNo" class="form-control phone" />
                </div>
                <div class="col-sm-6 mb-3">
                    <div class="text-dark fs-5">อีเมล์</div>
                    <input ng-model="iEdit.email" class="form-control" />
                </div>
            </div>
            <div class="pt-3">
                <div class="btn btn-secondary" ng-click="Save()">
                    <i class="bi bi-send"></i> ส่งปรับปรุงข้อมูล
                </div>
                <div class="btn btn-link" data-bs-dismiss="offcanvas">
                    ยกเลิก
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    $(".date").mask("00/00/0000");
    $(".phone").mask("000-000-0000");
    app.controller('ServicePersonalCtrl', function ($scope, $http, $timeout, $filter) {

        $scope.LoadData = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/ServicePersonal/Detail',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    userId: $scope.userId
                    , create_by: '@User.UserId()'
                }),
                success: function (result) {
                    $timeout(async function () {
                        $scope.iData = result;

                        $scope.$parent.fullname = $scope.iData.firstname_en + ' ' + $scope.iData.lastname_en;
                        console.log( $scope.$parent.fullname);
                    }, 0);
                }, error: AjaxError
            });
        }

        $scope.InitPersonal = function () {
            $scope.userId = $scope.$parent.userId
            $scope.LoadData();
        }
        $scope.InitPersonal();

        $scope.Edit = function () {
            $("#personalOff").offcanvas('show');
            $scope.iEdit = {};
            $scope.iEdit.personalId = $scope.iData.personalId;
            $scope.iEdit.firstname_th = $scope.iData.firstname_th;
            $scope.iEdit.lastname_th = $scope.iData.lastname_th;
            $scope.iEdit.firstname_en = $scope.iData.firstname_en;
            $scope.iEdit.lastname_en = $scope.iData.lastname_en;
            $scope.iEdit.nickname = $scope.iData.nickname;
            $scope.iEdit.sex = $scope.iData.sex;
            $scope.iEdit.maritalStatus = $scope.iData.maritalStatus;
            $scope.iEdit.email = $scope.iData.email;
            $scope.iEdit.phoneNo = $scope.iData.phoneNo;
            $scope.iEdit.userId = $scope.userId;
            $scope.iEdit.create_by = '@User.UserId()';

            if ($scope.iData.birth_date != '' && $scope.iData.birth_date != undefined){
                var date = ConvertToDate($scope.iData.birth_date);
                $scope.iEdit.birth_date_select = new moment(date);
            }

        }

        $scope.Save = function () {
            $("#personalOff").offcanvas('hide');

            if ($scope.iEdit.birth_date_select) {
                $scope.iEdit.birth_date = $scope.iEdit.birth_date_select.format("DD/MM/YYYY");
            }

            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/ServicePersonal/Save',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                cache: false,
                data: JSON.stringify($scope.iEdit),
                success: function () {
                    $timeout(async function () {
                        $scope.LoadData();
                    }, 0);
                }, error: AjaxError
            });
        }

        $scope.Cancel = function () {
                alertConfirm("ท่านต้องการยกเลิกรายการ", "ยืนยันการยกเลิกการปรับปรุงข้อมูลส่วนบุคคล", function () {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/ServicePersonal/Cancel',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    cache: false,
                    data: JSON.stringify({
                        userId: $scope.userId
                        , update_by: '@User.UserId()'
                    }),
                    success: function () {
                        $timeout(async function () {
                            $scope.LoadData();
                        }, 0);
                    }, error: AjaxError
                });
            });
        }
    });
</script>