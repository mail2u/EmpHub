    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    var token = User.AccessToken(Context);
}
<div ng-controller="ServiceAddressCtrl" id="tab_address">
    @* View *@
    <div class="bg-white rounded-5 p-4 mb-3">
        <div class="d-flex align-items-center mb-4">
            <div class="fw-bolder flex-fill text-secondary fs-5">
                ที่พักอาศัย
            </div>
        </div>
        <div class="row" ng-show="iData.status != undefinded">
            <div class="col-sm-8 mb-3">
                <div class="text-gray">
                    บ้านเลขที่
                </div>
                <div class="fw-bolder">{{ iData.home }}</div>
            </div>
            <div class="col-sm-4 mb-3">
                <div class="text-gray">
                    ถนน
                </div>
                <div class="fw-bolder">{{ iData.road }}</div>
            </div>
            <div class="col-sm-4 mb-3">
                <div class="text-gray">
                    แขวง/ตำบล
                </div>
                <div class="fw-bolder">{{ iData.subDistrictName }}</div>
            </div>
            <div class="col-sm-4 mb-3">
                <div class="text-gray">
                    เขต/อำเภอ
                </div>
                <div class="fw-bolder">{{ iData.districtName }}</div>
            </div>
            <div class="col-sm-4 mb-3">
                <div class="text-gray">
                    จังหวัด
                </div>
                <div class="fw-bolder">{{ iData.provinceName }}</div>
            </div>
            <div class="col-sm-4 mb-3">
                <div class="text-gray">
                    รหัสไปรษณีย์
                </div>
                <div class="fw-bolder">{{ iData.postcode }}</div>
            </div>
            <div class="col-sm-12">
                <div class="pt-2 d-flex align-items-center">
                    <div class="btn btn-secondary-invert" ng-click="Edit()">
                        <i class="bi bi-pen"></i> แก้ไข
                    </div>
                    <div ng-show="iData.status == 'Pending'" class="ms-3 bg-gray rounded-3 d-flex p-2">
                        <div class="me-2 text-warning">รออนุมัติการปรับปรุงข้อมูล</div>
                        <div class="badge bg-danger select" ng-click="Cancel()">
                            <i class="bi bi-x-circle"></i> ยกเลิก
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row" ng-show="iData.status == undefinded">
            <div class="col-sm-12 mb-3">
                <div class="text-gray">
                    เพิ่มข้อมูลที่พักอาศัย ณ ปัจจุบันของคุณ
                </div>
            </div>
            <div class="col-sm-12">
                <div class="pt-2 d-flex align-items-center">
                    <div class="btn btn-secondary-invert" ng-click="Edit()">
                        <i class="bi bi-plus-lg"></i> เพิ่มข้อมูลที่พักอาศัย
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Dialog *@
    <div class="offcanvas offcanvas-end" data-bs-scroll="true" tabindex="-1" id="addressOff" aria-labelledby="offcanvasLabel" style="width:600px;">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title text-secondary fw-bolder" id="offcanvasLabel">ที่พักอาศัย</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <div class="row">
                <div class="col-sm-12 mb-3">
                    <div class="fw-bolder">บ้านเลขที่</div>
                    <textarea ng-model="iEdit.home" class="form-control" maxlength="200" rows="2"></textarea>
                </div>
                <div class="col-sm-12 mb-3">
                    <div class="fw-bolder">ถนน</div>
                    <input ng-model="iEdit.road" class="form-control" maxlength="100" />
                </div>
                <div class="col-sm-6 mb-3">
                    <div class="fw-bolder">แขวง/ตำบล</div>
                    <input ng-model="iEdit.subDistrictName" class="form-select bg-light-blue" data-bs-toggle="modal" data-bs-target="#addressModal" readonly />
                </div>
                <div class="col-sm-6 mb-3">
                    <div class="fw-bolder">เขต/อำเภอ</div>
                    <input ng-model="iEdit.districtName" class="form-select bg-light-blue" data-bs-toggle="modal" data-bs-target="#addressModal" readonly />
                </div>
                <div class="col-sm-6 mb-3">
                    <div class="fw-bolder">จังหวัด</div>
                    <input ng-model="iEdit.provinceName" class="form-select bg-light-blue" data-bs-toggle="modal" data-bs-target="#addressModal" readonly />
                </div>
                <div class="col-sm-6 mb-3">
                    <div class="fw-bolder">รหัสไปรษณีย์</div>
                    <input ng-model="iEdit.postcode" class="form-control postcode" />
                </div>
            </div>
            <div class="pt-3">
                <div class="btn btn-secondary" ng-click="Save()">
                    <i class="bi bi-send"></i> ส่งปรับปรุงข้อมูล
                </div>
                <div class="btn btn-link" data-bs-dismiss="offcanvas">
                    ยกเลิก
                </div>
            </div>
        </div>
    </div>

    @* Modal *@
    <div id="addressModal" class="modal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-body">
                    <div>
                        <div class="mb-2">
                            <input ng-model="filter_name" class="form-control" />
                            <div class="list-group list-group-flush overflow-auto" style="max-height: 400px;">
                                <div class="list-group-item list-group-item-action d-flex align-items-center justify-content-between" ng-repeat="x in lAddress | filter : filter_name | limitTo : 50">
                                    <div class="p-2">
                                        <nav aria-label="breadcrumb">
                                            <ol class="breadcrumb mb-0">
                                                <li class="breadcrumb-item active">{{ x.subDistrictName }}</li>
                                                <li class="breadcrumb-item active">{{ x.districtName }}</li>
                                                <li class="breadcrumb-item active">{{ x.provinceName }}</li>
                                                <li class="breadcrumb-item active">{{ x.postcode }}</li>
                                            </ol>
                                        </nav>
                                    </div>
                                    <div>
                                        <button ng-click="SelectAddress(x)" class="btn btn-circle">
                                            <i class="fas fa-plus"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="text-end">
                            <button class="btn btn-light" data-bs-dismiss="modal" aria-label="Close">
                                ปิด
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    $(".postcode").mask("00000");

    app.controller('ServiceAddressCtrl', function ($scope, $http, $timeout, $filter) {
        
        $scope.LoadMaster = function () {
            if(!$scope.lAddress){
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/MasterCode/Address'
                    , headers: { 'authorization': 'Bearer @token' }
                    , type: 'post'
                    , dataType: 'json'
                    , cache: false
                    , success: function (result) {
                        $timeout(function () {
                            $scope.lAddress = result;
                        }, 0);
                    }
                    , error: AjaxError
                });
            }
        }

        $scope.LoadData = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/ServiceAddress/Detail',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    userId: $scope.userId
                    , create_by: '@User.UserId()'
                }),
                success: function (result) {
                    $timeout(async function () {
                        $scope.iData = result;

                    }, 0);
                }, error: AjaxError
            });
        }

        $scope.SelectAddress = function (x) {
            $scope.iEdit.subDistrictCode = x.subDistrictCode;
            $scope.iEdit.subDistrictName = x.subDistrictName;
            $scope.iEdit.districtCode = x.districtCode;
            $scope.iEdit.districtName = x.districtName;
            $scope.iEdit.provinceCode = x.provinceCode;
            $scope.iEdit.provinceName = x.provinceName;
            $scope.iEdit.postcode = x.postcode;

            $("#addressModal").modal('hide');
        }

        $scope.InitAddress = function () {
            $scope.userId = $scope.$parent.userId
            $scope.LoadData();
        }
        $scope.InitAddress();

        $scope.Edit = function () {
            $scope.LoadMaster();

            $("#addressOff").offcanvas('show');
            $scope.iEdit = {};
            $scope.iEdit.addressId = $scope.iData.addressId;
            $scope.iEdit.home = $scope.iData.home;
            $scope.iEdit.road = $scope.iData.road;
            $scope.iEdit.subDistrictCode = $scope.iData.subDistrictCode;
            $scope.iEdit.subDistrictName = $scope.iData.subDistrictName;
            $scope.iEdit.districtCode = $scope.iData.districtCode;
            $scope.iEdit.districtName = $scope.iData.districtName;
            $scope.iEdit.provinceCode = $scope.iData.provinceCode;
            $scope.iEdit.provinceName = $scope.iData.provinceName;
            $scope.iEdit.postcode = $scope.iData.postcode;
            $scope.iEdit.userId = $scope.userId;
            $scope.iEdit.create_by = '@User.UserId()';
        }

        $scope.Save = function () {
            $("#addressOff").offcanvas('hide');

            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/ServiceAddress/Save',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                cache: false,
                data: JSON.stringify($scope.iEdit),
                success: function () {
                    $timeout(async function () {
                        $scope.LoadData();
                    }, 0);
                }, error: AjaxError
            });
        }

        $scope.Cancel = function () {
            alertConfirm("ท่านต้องการยกเลิกรายการ", "ยืนยันการยกเลิกการปรับปรุงที่พักอาศัย", function () {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/ServiceAddress/Cancel',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    cache: false,
                    data: JSON.stringify({
                        userId: $scope.userId
                        , update_by: '@User.UserId()'
                    }),
                    success: function () {
                        $timeout(async function () {
                            $scope.LoadData();
                        }, 0);
                    }, error: AjaxError
                });
            });
        }
    });
</script>