@page
@model EmpHub.Pages.Employee.IndexModel
@{
    var token = User.AccessToken(HttpContext);
}

@section PageHeader{
    <!-- [ page-header ] start -->
   @*  <div class="page-header">
        <div class="page-header-left d-flex align-items-center">
            <div class="page-header-title">
                <h5 class="m-b-10">Employee Directory</h5>
            </div>
            <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Page("/Index")">Home</a></li>
                <li class="breadcrumb-item">Employees</li>
            </ul>
        </div>
    </div> *@
}

<div ng-controller="EmpCtrl" class="">
    <div class="d-flex align-items-center mb-3">
        <div class="flex-fill">
            <div class="fs-4 text-dark fw-bolder">
                รายชื่อพนักงาน
            </div>
            <div class="text-gray">
                จำนวน {{ total | number }} คน | {{ lDepartment.length }} ฝ่ายงาน
            </div>
        </div>
        <div>
         @*    <div class="btn btn-primary">
                <i class="bi bi-person-plus-fill me-2"></i> Add New Employee
            </div> *@
        </div>
    </div>
    <div class="rounded-4 p-3 bg-white shadow-sm border d-flex mb-4 aling-items-center">
        <div class="flex-fill me-2 position-relative">
            <input class="form-control rounded-3 p-2" ng-model="firstname_th" my-enter="LoadData()" placeholder="ค้นหา..." />
            <span class="position-absolute top-50 end-0 translate-middle badge bg-gray" ng-show="firstname_th != ''">
                enter
            </span>
        </div>
        <div class="dropdown me-2">
            <button class="btn btn-light dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-buildings me-2"></i> {{ departmentName != '' ? departmentName : 'ฝ่ายงาน' }}
            </button>
            <ul class="dropdown-menu overflow-auto" style="width:400px; max-height: 400px;">
                <li ng-repeat="d in lDepartment"><a class="dropdown-item" href="#" ng-click="SelectDepartment(d)">{{ d.desc_th }}</a></li>
            </ul>
        </div>
        <div class="dropdown me-2">
            <button class="btn btn-light dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-briefcase-fill me-2"></i> {{ positionName != '' ? positionName : 'ตำแหน่ง' }}
            </button>
            <ul class="dropdown-menu overflow-auto" style="width:450px; max-height: 400px;">
                <li ng-repeat="d in lPosition"><a class="dropdown-item" href="#" ng-click="SelectPosition(d)">
                    {{ d.desc_th }}
                    <br />{{ d.desc_en }}
                    </a></li>
            </ul>
        </div>
        <div class="dropdown">
            <button class="btn btn-light dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-briefcase-fill me-2"></i> {{ typeName != '' ? typeName : 'ประเภทพนักงาน' }}
            </button>
            <ul class="dropdown-menu">
                <li ng-repeat="d in lType"><a class="dropdown-item" href="#" ng-click="SelectType(d)">{{ d.desc_th }}</a></li>
            </ul>
        </div>
        <div class="btn btn-warning ms-2" ng-click="Clear()" ng-show="firstname_th != '' || departmentName != '' || positionName != '' || typeName != ''">
            Clear
        </div>
    </div>
    <div class="mb-4">
        <table class="table table-tip border shadow-sm">
            <thead>
                <tr>
                    <th>ชื่อ-สกุล</th>
                    <th>ชื่อเล่น</th>
                    <th>สังกัด</th>
                    <th>สาย</th>
                    <th>ฝ่าย</th>
                    <th>เมล</th>
                    <th>เบอร์โทรที่ทำงาน</th>
                    <th width="50"></th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="x in lData">
                    <td class="text-dark align-middle">
                        {{ x.prefix_th + ' ' + x.firstname_th + ' ' + x.lastname_th }}
                    </td>
                    <td class="text-dark align-middle">
                        {{ x.nickname }}
                    </td>
                    <td class="text-dark align-middle">
                        {{ x.functionDesc }}
                    </td>
                    <td class="text-dark align-middle">
                        {{ x.divisionDesc }}
                    </td>
                    <td class="text-dark align-middle">
                        {{ x.departmentDesc }}
                    </td>
                    <td class="text-dark align-middle">
                        {{ x.email }}
                    </td>
                    <td class="text-dark align-middle">
                        {{ x.ext }}
                    </td>
                    <td class="align-middle text-end">
                        <a href="@Url.Page("Detail")/{{ x.userId }}" class="btn btn-circle" target="_blank">
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </td>
                </tr>
            </tbody>
            <tfoot>
                <tr>
                    <td>
                        <div class="text-light-gray">Showing {{ ((page - 1) * row) + 1 }} to {{ (page * row) > total ? total : page * row }} of {{ total }} employees</div>
                    </td>
                    <td colspan="7">
                        <div class="d-flex">
                            <div class="flex-fill"></div>
                            <button class="btn btn-circle me-2" ng-click="LoadData(page - 1)" ng-disabled="page <= 1">
                                <i class="fas fa-chevron-left"></i>
                            </button>
                            <button class="btn btn-circle" ng-click="LoadData(page + 1)" ng-disabled="page * row >= total">
                                <i class="fas fa-chevron-right"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
<script>
    app.controller('EmpCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.page = 1
        $scope.row = 10;
        $scope.lRow = [10,25,50,100];

        $scope.sortBy = 'joindate';
        $scope.lSort = [
            {value:'joindate',key:'วันเริ่มงาน'}
            , {value:'position',key:'ตำแหน่ง'}
            , {value:'department',key:'ฝ่ายงาน'}
        ]

        $scope.LoadInit = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/MasterCode/DataList'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    groupName: 'departmentCode'
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lDepartment = result;
                    }, 0);
                }
                , error: AjaxError
            });
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/MasterCode/DataList'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    groupName: 'positionCode'
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lPosition = result;
                    }, 0);
                }
                , error: AjaxError
            });
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/MasterCode/DataList'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    groupName: 'employeeType'
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lType = result;
                    }, 0);
                }
                , error: AjaxError
            });
        }
        $scope.LoadInit();

        $scope.SelectDepartment = function(x){
            $scope.departmentCode = x.code;
            $scope.departmentName = x.desc_th;
            $scope.LoadData();
        }

        $scope.SelectPosition = function(x){
            $scope.positionCode = x.code;
            $scope.positionName = x.desc_th;
            $scope.LoadData();
        }
        
        $scope.SelectType = function(x){
            $scope.typeCode = x.code;
            $scope.typeName = x.desc_th;
            $scope.LoadData();
        }

        $scope.LoadData = function (page = 1) {
            $scope.page = page;

            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/DataList'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    page: $scope.page
                    , row: $scope.row
                    , sortBy: $scope.sortBy
                    , firstname_th: $scope.firstname_th
                    , positionCode: $scope.positionCode
                    , departmentCode: $scope.departmentCode
                    , employeeType: $scope.typeCode
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lData = result.data;
                        $scope.total = result.total;
                    }, 0);
                }
                , error: AjaxError
            });
            
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/UserSummary', 
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    firstname_th: $scope.firstname_th
                    , positionCode: $scope.positionCode
                    , departmentCode: $scope.departmentCode
                }),
                success: function (result) {
                    $timeout(function () {
                        $scope.sum_permanent = 0;
                        $scope.sum_contract = 0;
                        $scope.sum_none = 0;
                        
                        var find = result.find(x => x.status == 'Permanent');
                        if (find) { 
                            $scope.sum_permanent = find.total; 
                        }
                        find = result.find(x => x.status == 'Contract');
                        if (find) { 
                            $scope.sum_contract = find.total; 
                        }
                        find = result.find(x => x.status == 'None');
                        if (find) { 
                            $scope.sum_none = find.total; 
                        }

                        $scope.sum_all = $scope.sum_permanent
                        + $scope.sum_contract
                        + $scope.sum_none
                    }, 0);
                },
                error: AjaxError
            });
        }
        
        $scope.Clear = function(){
            $scope.firstname_th = '';
            $scope.departmentCode = '';
            $scope.departmentName = '';
            $scope.positionCode = '';
            $scope.positionName = '';
            $scope.typeCode = '';
            $scope.typeName = '';
            $scope.LoadData();
        }
        $scope.Clear();

        $scope.Detail = function (x) {
            window.open('@Url.Page("Detail")/' + x.userId, '_blank');
        }
    });
</script>