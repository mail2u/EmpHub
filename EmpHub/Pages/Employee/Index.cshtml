@page
@model EmpHub.Pages.Employee.IndexModel
@{
}
<div ng-controller="EmpCtrl">
    <div class="sticky-top bg-secondary rounded-4 p-2">
        <div class="d-flex align-items-center">
            <div class="fs-5 me-4">
                <span class="text-white">จำนวน</span> <b class="text-orange">{{ total }}</b>
            </div>
            <div class="flex-fill me-2 position-relative">
                <input ng-model="search" class="form-control" />
                <div class="position-absolute top-50 end-0 translate-middle-y me-3 text-orange">
                    <i class="bi bi-search"></i> Search
                </div>
            </div>
            <div class="">
                <div class="btn btn-orange" ng-click="New()">
                    <i class="bi bi-plus"></i> New Employee
                </div>
            </div>
        </div>
    </div>
    <div class="row pt-3">
        <div class="col-sm-4 mb-4" ng-repeat="x in lData | filter : search">
            <div class="bg-white rounded-4 p-4 h-100">
                <div class="d-flex mb-3">
                    <div class="flex-fill">
                        <div class="">
                            <img src="~/Images/icon-user.png" height="80px" class="rounded-pill" />
                        </div>
                    </div>
                    <div class="">
                        <div class="dropdown">
                            <div class="btn btn-circle" data-bs-toggle="dropdown">
                                <i class="bi bi-three-dots"></i>
                            </div>
                            <div class="dropdown-menu p-1">
                                <div class="list-group list-group-flush">
                                    <a href='@Url.Page("Detail")/{{ x.userId}}' class="list-group-item" target="_blank">
                                        <i class="bi bi-person-badge me-2"></i> Profile
                                    </a>
                                    <div class="list-group-item select" ng-click="Delete(x)">
                                        <i class="bi bi-trash3 me-2"></i> Delete
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="d-flex mb-3">
                    <div class="flex-fill" style="height:50px;">
                        <div class="fw-bolder text-secondary">
                            {{ x.firstname_th + ' ' + x.lastname_th }} <span ng-show="x.nickname != ''">({{ x.nickname }})</span>
                        </div>
                        <div class="text-dark">
                            {{ x.positionDesc }}
                        </div>
                    </div>
                </div>
                <div class="bg-gray p-3 rounded-4">
                    <div class="mb-3">
                        <div class="fw-bolder text-truncate">{{ x.departmentDesc }}</div>
                    </div>
                    <div class="mb-2">
                        <i class="bi bi-envelope"></i> {{ x.email }}
                    </div>
                    <div class="">
                        <i class="bi bi-telephone"></i> {{ x.phoneNo }}
                    </div>
                </div>
            </div>
        </div>
    </div>
    @* Modal *@
    <div class="offcanvas offcanvas-end" data-bs-scroll="true" tabindex="-1" id="createOff" aria-labelledby="offcanvasLabel" style="width:600px;">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title text-secondary fw-bolder" id="offcanvasLabel">เพิ่มผู้ใช้งาน</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <div class="row">
                <div class="col-sm-6 mb-3">
                    <div class="fw-bolder">username</div>
                    <input ng-model="iData.username" class="form-control" />
                </div>
            </div>
            <div class="pt-3">
                <div class="btn btn-secondary" ng-click="Create()">
                    สร้าง
                </div>
                <div class="btn btn-link" data-bs-dismiss="offcanvas">
                    ยกเลิก
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    app.controller('EmpCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.page = 1
        $scope.row = 1000;

        $scope.LoadInit = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/MasterCode/DataList'
                , headers: { 'authorization': 'Bearer @User.AccessToken()' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    groupName: 'departmentCode'
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lDepartment = result;
                    }, 0);
                }
                , error: AjaxError
            });
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/MasterCode/DataList'
                , headers: { 'authorization': 'Bearer @User.AccessToken()' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    groupName: 'positionCode'
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lPosition = result;
                    }, 0);
                }
                , error: AjaxError
            });
        }
        $scope.LoadInit();

        $scope.LoadData = function (page = 1) {
            $scope.page = page;

            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/DataList'
                , headers: { 'authorization': 'Bearer @User.AccessToken()' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    page: $scope.page
                    , row: $scope.row
                    , firstname: $scope.subject
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lData = result.data;
                        $scope.total = result.total;
                    }, 0);
                }
                , error: AjaxError
            });
        }
        $scope.LoadData();

        $scope.New = function () {
            $scope.iData = { username: '' };
            $("#createOff").offcanvas('show');
        }

        $scope.Create = function () {
            $scope.iData.create_by = '@User.UserId()';
            $("#createOff").offcanvas('hide');

            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/Create'
                , headers: { 'authorization': 'Bearer @User.AccessToken()' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify($scope.iData)
                , success: function (result) {
                    $timeout(function () {
                        $scope.LoadData($scope.page);
                        window.open('@Url.Page("/Employee/Detail")/' + result.userId);
                    }, 0);
                }
                , error: AjaxError
            });
        }

        $scope.Delete = function (x) {
            alertConfirm('ยืนยันการทำรายการ', 'ท่านต้องการลบข้อมูลผู้ใช้งานนี้', function () {
                x.update_by = '@User.UserId()';
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/User/Delete'
                    , headers: { 'authorization': 'Bearer @User.AccessToken()' }
                    , type: 'post'
                    , contentType: 'application/json'
                    , cache: false
                    , data: JSON.stringify({
                        userId: x.userId
                        , update_by: '@User.UserId()'
                    })
                    , success: function () {
                        $timeout(function () {
                            $scope.LoadData($scope.page);
                        }, 0);
                    }
                    , error: AjaxError
                });
            });
        }

        $scope.Download = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/FullList',
                headers: { 'authorization': 'Bearer @User.AccessToken()' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    page: $scope.page
                    , row: 2000
                    , firstname: $scope.subject
                }),
                success: function (result) {
                    $timeout(function () {
                        var lData = result.data;

                        if (lData.length > 0) {
                            var JSData = [[
                                { 'text': 'Username' }
                                , { 'text': 'Fullname' }
                                , { 'text': 'ชื่อ - สกุล' }
                                , { 'text': 'E-mail' }
                                , { 'text': 'ประเภท' }
                                , { 'text': 'วันที่สร้าง' }
                            ]];

                            for (var i = 0; i < lData.length; i++) {
                                var iData = lData[i];

                                JSData.splice(JSData.length, 0, [
                                    { 'text': iData.serviceNo }
                                    , { 'text': iData.categoryDesc }
                                    , { 'text': iData.subCategoryDesc }
                                    , { 'text': iData.title }
                                    , { 'text': iData.status }
                                    , { 'text': iData.createName }
                                    , { 'text': iData.createDate }
                                ]);
                            }

                            var dt = new Date().toISOString().slice(0, 10).replace(/-/g, "");
                            ExportFile(JSData, 'รายงานฝ่าย_' + dt);
                        }
                    }, 0);
                },
                error: AjaxError
            });
        }
    });
</script>