@page
@model EmpHub.Pages.Employee.IndexModel
@{
    var token = User.AccessToken(HttpContext);
}

@section PageHeader{
    <!-- [ page-header ] start -->
    <div class="page-header">
        <div class="page-header-left d-flex align-items-center">
            <div class="page-header-title">
                <h5 class="m-b-10">Employees</h5>
            </div>
            <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Page("/Index")">Home</a></li>
                <li class="breadcrumb-item">Employees</li>
            </ul>
        </div>
    </div>
}

<div ng-controller="EmpCtrl" class="">
   @*  <div class="d-flex mb-3 align-items-center">
        <div class="overflow-auto flex-fill">
            <div class="flex-fill d-flex flex-nowrap align-items-center">
                <div class="btn btn-link text-nowrap {{ iStatus == '' ? 'active' : '' }}" ng-click="SelectStatus('')">
                    ทั้งหมด <span class="badge" ng-show="sum_all > 0">{{ sum_all | number }}</span>
                </div> |
                <div class="btn btn-link text-nowrap {{ iStatus == 'Permanent' ? 'active' : '' }}" ng-click="SelectStatus('Permanent')">
                    พนง.ประจำ <span class="badge" ng-show="sum_permanent > 0">{{ sum_permanent | number }}</span>
                </div>
                <div class="btn btn-link text-nowrap {{ iStatus == 'Contract' ? 'active' : '' }}" ng-click="SelectStatus('Contract')">
                    พนง.สัญญาจ้าง <span class="badge" ng-show="sum_contract > 0">{{ sum_contract | number }}</span>
                </div>
                <div class="btn btn-link text-nowrap {{ iStatus == 'None' ? 'active' : '' }}" ng-click="SelectStatus('None')">
                    ไม่ระบุ <span class="badge" ng-show="sum_none > 0">{{ sum_none | number }}</span>
                </div>
            </div>
        </div>
    </div> *@
    <div class="fs-4 mb-2">
        All Employees {{ total | number }}
    </div>
    <div class="rounded-2 p-3 bg-white shadow-sm border">
        <div class="d-flex mb-3">
            <div class="flex-fill">
                <div class="d-flex align-items-end">
                    <div class="me-2">
                        <div>ชื่อ - สกุล</div>
                        <div class="d-flex">
                            <input class="form-control form-control-sm" ng-model="firstname_th" my-enter="LoadData()" />
                        </div>
                    </div>
                    <div class="me-2">
                        <div>ตำแหน่ง</div>
                        <div class="d-flex">
                            <input class="form-control form-control-sm" ng-model="positionCode" my-enter="LoadData()" />
                        </div>
                    </div>
                    <div class="me-2">
                        <div>ฝ่ายงาน</div>
                        <div class="d-flex">
                            <input class="form-control form-control-sm" ng-model="departmentCode" my-enter="LoadData()" />
                        </div>
                    </div>
                    <div>
                        <button ng-click="LoadData()" class="btn btn-light me-2">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                    <div class="flex-fill">
                    </div>
                </div>
            </div>
            <div class="d-flex align-items-end">
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="fas fa-sort-amount-down-alt"></i>
                    </span>
                    <select ng-model="sortBy" class="form-select form-select-sm" ng-options="x.value as x.key for x in lSort" ng-change="LoadData()" style="width:120px;"></select>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-4 mb-1 p-2" ng-repeat="x in lData">
                <div class="box-shadow rounded-1 d-flex position-relative p-3 h-100" ng-click="Detail(x)">
                    <div class="me-3" style="width:80px; min-width:80px;">
                        <img src="~/Images/icon-user.png" class="rounded-circle" width="100%" />
                    </div>
                    <div>
                        <div class="text-dark fs-5">{{ x.firstname_th + ' ' + x.lastname_th }}</div>
                        <div class="text-secondary">{{ x.positionDesc }} {{ x.departmentDesc }}</div>
                        <div>{{ x.email != '' ? x.email : '-'}}</div>
                    </div>
                    @* icon *@
                    <div class="position-absolute top-0 end-0 m-2">
                        <span ng-show="x.employeeType == 'permanent'" class="text-teal" title="permanent">
                            <i class="bi bi-shield-check"></i>
                        </span>
                        <span ng-show="x.employeeType == 'contract'" class="text-orange" title="contract">
                            <i class="bi bi-hourglass-split"></i>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    app.controller('EmpCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.page = 1
        $scope.row = 10;
        $scope.lRow = [10,25,50,100];

        $scope.sortBy = 'joindate';
        $scope.lSort = [
            {value:'joindate',key:'วันเริ่มงาน'}
            , {value:'position',key:'ตำแหน่ง'}
            , {value:'department',key:'ฝ่ายงาน'}
        ]

        $scope.LoadInit = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/MasterCode/DataList'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    groupName: 'departmentCode'
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lDepartment = result;
                    }, 0);
                }
                , error: AjaxError
            });
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/MasterCode/DataList'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    groupName: 'positionCode'
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lPosition = result;
                    }, 0);
                }
                , error: AjaxError
            });
        }
        $scope.LoadInit();

        $scope.LoadData = function (page = 1) {
            $scope.page = page;

            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/DataList'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    page: $scope.page
                    , row: 9999
                    , sortBy: $scope.sortBy
                    , firstname_th: $scope.firstname_th
                    , positionCode: $scope.positionCode
                    , departmentCode: $scope.departmentCode
                    , employeeType: $scope.iStatus
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lData = result.data;
                        $scope.total = result.total;
                    }, 0);
                }
                , error: AjaxError
            });
            
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/UserSummary', 
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    firstname_th: $scope.firstname_th
                    , positionCode: $scope.positionCode
                    , departmentCode: $scope.departmentCode
                }),
                success: function (result) {
                    $timeout(function () {
                        $scope.sum_permanent = 0;
                        $scope.sum_contract = 0;
                        $scope.sum_none = 0;
                        
                        var find = result.find(x => x.status == 'Permanent');
                        if (find) { 
                            $scope.sum_permanent = find.total; 
                        }
                        find = result.find(x => x.status == 'Contract');
                        if (find) { 
                            $scope.sum_contract = find.total; 
                        }
                        find = result.find(x => x.status == 'None');
                        if (find) { 
                            $scope.sum_none = find.total; 
                        }

                        $scope.sum_all = $scope.sum_permanent
                        + $scope.sum_contract
                        + $scope.sum_none
                    }, 0);
                },
                error: AjaxError
            });
        }
        $scope.LoadData();

        $scope.Detail = function (x) {
            window.open('@Url.Page("Detail")/' + x.userId, '_blank');
        }
    });
</script>