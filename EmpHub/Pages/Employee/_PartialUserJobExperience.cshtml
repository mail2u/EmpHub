    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
<div>
    <div class="list-group list-group-flush">
        <div class="list-group-item px-0" ng-repeat="x in lJobExperience">
            <div class="d-flex mb-3">
                <div class="flex-fill me-3">
                    <div class="text-dark fw-bolder">
                        บริษัท
                    </div>
                    <div class="text-gray">{{ x.company != '' ? x.company : '-' }}</div>
                </div>
                <div class="flex-fill me-3">
                    <div class="text-dark fw-bolder">
                        ตำแหน่ง
                    </div>
                    <div class="text-gray">{{ x.position != '' ? x.position : '-' }}</div>
                </div>
                <div class="me-3">
                    <div class="text-dark fw-bolder">
                        วันที่เริ่ม
                    </div>
                    <div class="text-gray">{{ x.from_date | date:'MMM yyyy' }}</div>
                </div>
                <div class="">
                    <div class="text-dark fw-bolder">
                        วันที่สิ้นสุด
                    </div>
                    <div class="text-gray">{{ x.end_date | date:'MMM yyyy' }}</div>
                </div>
            </div>
            <div class="mb-3">
                <div class="text-dark fw-bolder">
                    รายละเอียดการทำงาน
                </div>
                <div class="text-gray">{{ x.description != '' ? x.description : '-' }}</div>
            </div>
        </div>
    </div>
    <hr class="my-3" />
    <div class="mb-2 d-flex align-items-center">
        <div class="flex-fill">
            <div ng-show="iJobExperience">
                ปรับปรุงล่าสุด <span class="fw-bolder">{{ iJobExperience.update_date }}</span> โดย <span class="fw-bolder">{{ iJobExperience.update_by }}</span>
            </div>
        </div>
        <div>
            <a class="btn btn-sm btn-warning-invert" href="@Url.Page("/Service/FormCreate/FormUpdateDataJobs")?mode=EDIT_JOB&id={{userId}}" target="_blank">
                <i class="bi bi-pen me-2"></i> เพิ่ม/แก้ไข
            </a>
        </div>
    </div>
</div>