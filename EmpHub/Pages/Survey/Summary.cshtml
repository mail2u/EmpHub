@page
@model EmpHub.Pages.Survey.SummaryModel
@{
    var token = User.AccessToken(HttpContext);
}
<style>
    .main-content {
        padding: 5px !important;
    }
</style>
<div ng-controller="SurveyCtrl" class="position-relative p-0">
    <div class="d-flex align-items-center mb-2">
        <div class="flex-fill">
        </div>
        <button class="btn btn-circle" ng-click="SelectSection(section_index - 1)" ng-disabled="section_index <= 0">
            <i class="bi bi-chevron-left"></i>
        </button>
        <div class="mx-3 text-nowrap fw-bolder text-dark">
            Section {{ (section_index + 1) }} of {{ lSection.length }}
        </div>
        <button class="btn btn-circle" ng-click="SelectSection(section_index + 1)" ng-disabled="section_index >= lSection.length - 1">
            <i class="bi bi-chevron-right"></i>
        </button>
    </div>
    <div class="container">
        <div>
            @* Section *@
            <div class="fs-5 text-dark fw-bolder mb-1">
                {{ iSection.title }}
            </div>
            <div class="fs-5 text-dark mb-3">
                {{ iSection.description }}
            </div>
            @* Question *@
            <div ng-repeat="q in iSection.lQuestion">
                <div class="rounded-4 bg-white shadow-sm p-4 mb-4">
                    <div class="d-flex">
                        <div class="flex-fill fs-5 fw-bolder text-dark">
                            {{ q.title }}
                        </div>
                        <div ng-show="q.is_required > 0" class="text-danger">
                            (require)
                        </div>
                    </div>
                    <div class="fs-5 text-dark">
                        {{ q.description }}
                    </div>
                    @* Radio *@
                    <div ng-if="q.type == 'radio'" class="mt-3 list-group">
                        <div ng-repeat="c in q.lChoice" class="d-flex list-group-item list-group-item-action">
                            <div class="flex-fill">
                                <label>
                                    {{ c.text }}
                                </label>
                            </div>
                            <div class="text-blue">
                                {{ c.total | number }} ครั้ง
                            </div>
                        </div>
                    </div>
                    @* Checkbox *@
                    <div ng-if="q.type == 'checkbox'" class="mt-3 list-group">
                        <div ng-repeat="c in q.lChoice" class="d-flex list-group-item list-group-item-action">
                            <div class="flex-fill">
                                <label>
                                    {{ c.text }}
                                </label>
                            </div>
                            <div class="text-blue">
                                {{ c.total | number }} ครั้ง
                            </div>
                        </div>
                    </div>
                    @* Text *@
                    <div class="mt-3 list-group">
                        <div class="list-group-item list-group-item-action" ng-repeat="a in q.lAnswer">
                            {{ a.answerText }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    app.controller('SurveyCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.surveyId = '@Model.id';
        $scope.is_save = 0;
        $scope.section_index = 0;
        $scope.iSection = {};
        $scope.lSection = [];
        $scope.lType = ['radio', 'checkbox', 'text', 'textarea', 'number'];

        if ($scope.surveyId == '') {
            location.href = '@Url.Page("Index")';
        }

        $scope.LoadSummary = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/SurveyAnswer/DataListBySurvey',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    surveyId: $scope.surveyId
                }),
                success: function (result) {
                    $timeout(function () {
                        var lSummary = result;

                        for (var i = 0; i < $scope.lSection.length; i++) {
                            var iSection = $scope.lSection[i];

                            for (var j = 0; j < iSection.lQuestion.length; j++) {
                                var iQuestion = iSection.lQuestion[j];
                                iQuestion.lAnswer = [];

                                if (iQuestion.type == 'radio' || iQuestion.type == 'checkbox') {
                                    iQuestion.lChoice = iQuestion.lChoice.map(item => {
                                        var find = lSummary.find(a => a.choiceId == item.id);
                                        item.total = 0;

                                        if (find) {
                                            item.total = find.total;
                                        }

                                        return item;
                                    });
                                } else {
                                    var lAnswerText = lSummary.filter(a => a.questionId == iQuestion.id && a.answerText != '');

                                    iQuestion.lAnswer = lAnswerText;
                                }
                            }
                        }
                    }, 0);
                },
                error: AjaxError
            });
        }

        $scope.LoadSection = async function () {
            return new Promise((resolve) => {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/SurveySection/DataList',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    dataType: 'json',
                    cache: false,
                    data: JSON.stringify({
                        surveyId: $scope.surveyId
                    }),
                    success: function (result) {
                        $timeout(async function () {
                            $scope.lSection = result;

                            if ($scope.lSection.length > 0) {
                                for (var i = 0; i < $scope.lSection.length; i++) {
                                    var iSection = $scope.lSection[i];

                                    await $scope.LoadQuestion(iSection);
                                }
                                $scope.SelectSection(0)
                                resolve(true);
                            } else {
                                alertWarning("Warning", "ไม่พบข้อมูลแบบสอบถาม", function () {
                                    location.href = '@Url.Page("Index")';
                                });
                                resolve(false);
                            }
                        }, 0);
                    },
                    error: function () {
                        resolve(false);
                    }
                });
            });
        }

        $scope.Init = async function () {
            var flag = await $scope.LoadSection();

            if (flag) {
                $scope.LoadSummary();
            }
        }
        $scope.Init();

        $scope.SelectSection = function (index) {
            $scope.section_index = index;
            $scope.iSection = $scope.lSection[$scope.section_index];
        }

        /* Question */

        $scope.LoadQuestion = function (x) {
            return new Promise((resolve) => {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/SurveyQuestion/DataList',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    dataType: 'json',
                    cache: false,
                    data: JSON.stringify({
                        sectionId: x.id
                    }),
                    success: function (result) {
                        $timeout(async function () {
                            x.lQuestion = result;

                            for (var i = 0; i < x.lQuestion.length; i++) {
                                var iQuestion = x.lQuestion[i];
                                iQuestion.lChoice = [];

                                if (['radio', 'checkbox'].indexOf(iQuestion.type) > -1) {
                                    await $scope.LoadChoice(iQuestion);
                                }
                            }

                            resolve(true);
                        }, 0);
                    },
                    error: function () {
                        resolve(false);
                    }
                });
            });
        }

    @* Choice *@

            $scope.LoadChoice = function (x) {
                return new Promise((resolve) => {
                    $.ajax({
                        url: '@webAPI.CurrentValue.APIEmpHub/api/SurveyChoice/DataList',
                        headers: { 'authorization': 'Bearer @token' },
                        type: "POST",
                        contentType: 'application/json',
                        dataType: 'json',
                        cache: false,
                        data: JSON.stringify({
                            questionId: x.id
                        }),
                        success: function (result) {
                            $timeout(function () {
                                x.lChoice = result;

                                resolve(true);
                            }, 0);
                        },
                        error: function () {
                            resolve(false);
                        }
                    });
                });
            }

        /* Action */
        $scope.toggleCheckbox = function (q, choiceId) {

            if (!q.choiceIds) {
                q.choiceIds = [];
            }

            var index = q.choiceIds.indexOf(choiceId);

            if (index > -1) {
                q.choiceIds.splice(index, 1);
            }
            else {
                q.choiceIds.push(choiceId);
            }
        };

        $scope.BackSection = function () {
            if ($scope.section_index > 0) {
                $scope.SelectSection($scope.section_index - 1);
            }
        }

        $scope.validateSurvey = function () {

            var isValid = true;

            angular.forEach($scope.iSection.lQuestion, function (q) {

                q.is_invalid = false;

                // ข้ามถ้าไม่ required
                if (q.is_required != 1) {
                    return;
                }

                // radio
                if (q.type == 'radio') {

                    if (!q.choiceId) {
                        q.is_invalid = true;
                        isValid = false;
                    }

                }

                // checkbox
                else if (q.type == 'checkbox') {

                    if (!q.choiceIds || q.choiceIds.length == 0) {
                        q.is_invalid = true;
                        isValid = false;
                    }

                }

                // text / textarea
                else if (q.type == 'text'
                    || q.type == 'textarea') {

                    if (!q.answerText
                        || q.answerText.trim() == '') {

                        q.is_invalid = true;
                        isValid = false;
                    }

                }

            });

            return isValid;
        };

        $scope.NextSection = function () {
            /* Validate */
            if ($scope.validateSurvey()) {
                if ($scope.section_index < $scope.lSection.length - 1) {
                    $scope.SelectSection($scope.section_index + 1);
                }
            } else {
                alertWarning("Validate Form", "กรุณากรอกข้อมูลให้ครบ");
            }

        }

        $scope.BuildAnswer = function () {
            var lAnswer = [];

            angular.forEach($scope.lSection, function (s) {
                angular.forEach(s.lQuestion, function (q) {

                    // radio
                    if (q.type == 'radio' && q.choiceId) {

                        lAnswer.push({
                            questionId: q.id,
                            choiceId: q.choiceId,
                            answerText: null
                        });

                    }

                    // checkbox
                    if (q.type == 'checkbox' && q.choiceIds) {

                        angular.forEach(q.choiceIds, function (choiceId) {

                            lAnswer.push({
                                questionId: q.id,
                                choiceId: choiceId,
                                answerText: null
                            });

                        });

                    }

                    // text
                    if ((q.type == 'text' || q.type == 'textarea')
                        && q.answerText) {

                        lAnswer.push({
                            questionId: q.id,
                            choiceId: null,
                            answerText: q.answerText
                        });

                    }

                });
            });

            console.log(lAnswer);
        }

        $scope.Submit = function () {
            $scope.BuildAnswer();
        }
    });
</script>