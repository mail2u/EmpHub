@page
@model EmpHub.Pages.Survey.DetailModel
@{
}

<div ng-controller="SurveyCtrl">
    <div class="d-md-flex mb-2">
        <div class="fs-4 me-3">Survey</div>
        <div class="overflow-auto flex-fill">
            <div class="flex-fill d-flex flex-nowrap align-items-center">
                <div class="btn btn-link text-nowrap {{ iStatus == '' ? 'active' : '' }}" ng-click="SelectStatus('')">
                    All <span class="badge ms-1" ng-show="sum_all > 0">{{ sum_all | number }}</span>
                </div> |
                <div class="btn btn-link border-0 text-nowrap {{ iStatus == 'Private' ? 'active' : '' }}" ng-click="SelectStatus('Private')">
                    Private <span class="badge ms-1" ng-show="sum_private > 0">{{ sum_private | number }}</span>
                </div>
                <div class="btn btn-link border-0 text-nowrap {{ iStatus == 'Publish' ? 'active' : '' }}" ng-click="SelectStatus('Publish')">
                    Publish <span class="badge ms-1" ng-show="sum_publish > 0">{{ sum_publish | number }}</span>
                </div>
            </div>
        </div>
        <div class="d-none d-sm-block">
            <div class="btn btn-primary" ng-click="ShowCreate()">
                <i class="fas fa-plus me-2"></i> Create New Survey
            </div>
        </div>
    </div>
    <div class="rounded-4 p-3 bg-white shadow-sm border mb-4">
        <div class="d-flex mb-1">
            <div class="flex-fill">
                <div class="d-flex align-items-end">
                    <div class="me-2">
                        <small>Title</small>
                        <div class="d-flex">
                            <input class="form-control form-control-sm" ng-model="title" my-enter="LoadData()" />
                        </div>
                    </div>
              @*       <div class="me-2">
                        <small>Request Date</small>
                        <div class="d-flex">
                            <input class="form-control form-control-sm icon-calendar date"
                                   ng-model="createDate"
                                   ng-model-options="{ updateon: 'blur' }"
                                   moment-picker="createDate"
                                   locale="th"
                                   format="DD/MM/YYYY"
                                   min-view="month"
                                   max-view="month"
                                   start-view="month"
                                   my-enter="LoadData()" />
                        </div>
                    </div> *@
                    <div class="me-2">
                        <button ng-click="LoadData()" class="btn btn-circle" title="Search">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                    <div class="me-2">
                        <button ng-click="Download()" class="btn btn-circle" title="Download" ng-disabled="total == 0">
                            <i class="fas fa-arrow-down"></i>
                        </button>
                    </div>
                    <div class="flex-fill">

                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="mb-4">
        <div style="min-height:calc(100vh - 410px);" class="position-relative">
            <table class="table table-tip border shadow-sm">
                <thead>
                    <tr>
                        <th width="50"></th>
                        <th class="select" ng-click="SetSort('title')">
                            Title
                            <i ng-show="sortBy.indexOf('title') > -1" ng-class="sortBy.indexOf('-') > - 1 ? 'bi bi-arrow-up-short' : 'bi bi-arrow-down-short'"></i>
                        </th>
                        <th class="select text-center" ng-click="SetSort('status')">
                            Status
                            <i ng-show="sortBy.indexOf('status') > -1" ng-class="sortBy.indexOf('-') > - 1 ? 'bi bi-arrow-up-short' : 'bi bi-arrow-down-short'"></i>
                        </th>
                        <th class="select text-center" ng-click="SetSort('total')">
                            Total Questions
                            <i ng-show="sortBy.indexOf('total') > -1" ng-class="sortBy.indexOf('-') > - 1 ? 'bi bi-arrow-up-short' : 'bi bi-arrow-down-short'"></i>
                        </th>
                        <th class="select" ng-click="SetSort('create_date')">
                            Create
                            <i ng-show="sortBy.indexOf('create_date') > -1" ng-class="sortBy.indexOf('-') > - 1 ? 'bi bi-arrow-up-short' : 'bi bi-arrow-down-short'"></i>
                        </th>
                        <th>
                            Actions
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="x in lData" class="{{ x.statusCss }} {{ x.is_not_read == 1 ? 'fw-bolder' : '' }}">
                        <td class="text-center align-middle">
                            <span ng-show="x.status == 'Private'" class="text-warning" title="Private">
                                <i class="bi bi-clipboard"></i>
                            </span>
                            <span ng-show="x.status == 'Publish'" class="text-green" title="Publish">
                                <i class="bi bi-clipboard-check"></i>
                            </span>
                        </td>
                        <td>
                            <div class="fw-bolder text-truncate">
                                {{ x.title }}
                            </div>
                            <div>{{ x.start_date }} - {{ x.end_date }}</div>
                        </td>
                        <td class="text-center align-middle">
                            <div class="badge bg-{{ x.status }}">{{ x.status }}</div>
                        </td>
                        <td class="text-center align-middle">
                            {{ x.total | number }}
                        </td>
                        <td class="align-middle">
                            {{ x.create_date }}
                        </td>
                        <td>
                            <div class="d-flex">
                                <button ng-click="ShowEdit(x)" class="btn btn-circle me-2" title="Edit">
                                    <i class="bi bi-pen"></i>
                                </button>
                                <button ng-click="Delete(x)" class="btn btn-circle me-2" title="Delete">
                                   <i class="bi bi-trash"></i>
                                </button>
                                <button ng-click="ShowDetail(x)" class="btn btn-circle" title="Detail">
                                    <i class="bi bi-arrow-right"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="3">
                            <div class="text-light-gray">Showing {{ ((page - 1) * row) + 1 }} to {{ (page * row) > total ? total : page * row }} of {{ total }} requests</div>
                        </td>
                        <td colspan="3">
                            <div class="d-flex">
                                <div class="flex-fill"></div>
                                <button class="btn btn-circle me-2" ng-click="LoadData(page - 1)" ng-disabled="page <= 1">
                                    <i class="fas fa-chevron-left"></i>
                                </button>
                                <button class="btn btn-circle" ng-click="LoadData(page + 1)" ng-disabled="page * row >= total">
                                    <i class="fas fa-chevron-right"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
    @* Modal *@
    <div class="modal fade" id="detailModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                <h1 class="modal-title fs-5">Survey Info</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <div class="fs-6 text-dark">
                            Title
                        </div>
                        <textarea ng-model="iData.title" class="form-control" rows="3" maxlength="2000"></textarea>
                    </div>
                    <div class="mb-3">
                        <div class="fs-6 text-dark">
                            Description
                        </div>
                        <textarea ng-model="iData.description" class="form-control" rows="7"></textarea>
                    </div>
                    <div class="row">
                        <div class="col-sm-4 mb-3">
                            <div class="fs-6 text-dark">
                                Status
                            </div>
                            <select ng-model="iData.status" class="form-select" ng-options="x as x for x in lStatus"></select>
                        </div>
                        <div class="col-sm-4 mb-3">
                            <div class="fs-6 text-dark">
                                Start Date
                            </div>
                            <input class="form-control form-control-sm icon-calendar date"
                                   ng-model="iData.start_date_select"
                                   ng-model-options="{ updateon: 'blur' }"
                                   moment-picker="iData.start_date_select"
                                   locale="th"
                                   format="DD/MM/YYYY"
                                   min-view="month"
                                   max-view="month"
                                   max-date="iData.end_date_select"
                                   start-view="month" />
                        </div>
                        <div class="col-sm-4 mb-3">
                            <div class="fs-6 text-dark">
                                End Date
                            </div>
                            <input class="form-control form-control-sm icon-calendar date"
                                   ng-model="iData.end_date_select"
                                   ng-model-options="{ updateon: 'blur' }"
                                   moment-picker="iData.end_date_select"
                                   locale="th"
                                   format="DD/MM/YYYY"
                                   min-view="month"
                                   max-view="month"
                                   min-date="iData.start_date_select"
                                   start-view="month" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" ng-click="SaveChange()" ng-disabled="iData.title == ''">Save changes</button>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    app.controller('SurveyCtrl', function ($scope, $http, $timeout, $filter) {

    });
</script>