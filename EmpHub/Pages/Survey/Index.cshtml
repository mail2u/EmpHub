@page
@model EmpHub.Pages.Survey.IndexModel
@{
    var token = User.AccessToken(HttpContext);
}
<style>
    .bg-Private{
        background-color:var(--light-orange);
        color:var(--bs-orange);
    }
    .bg-Publish{
        background-color:var(--light-green);
        color:var(--bs-green);
    }

    .bg-Employee{
        background-color: #0d6efd;
    }
    
    .bg-Position{
        background-color: #6f42c1;
    }
    
    .bg-Level{
        background-color: #fd7e14;
    }
    
    .bg-Department{
        background-color: #198754;
    }
    
    .bg-Division{
        background-color: #20c997;
    }
    
    .bg-Business{
        background-color: #dc3545;
    }
</style>
@section PageHeader {
    <!-- [ page-header ] start -->
    <div class="page-header">
        <div class="page-header-left d-flex align-items-center">
            <div class="page-header-title">
                <h5 class="m-b-10">My Survey</h5>
            </div>
            <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Page("/Index")">Home</a></li>
                <li class="breadcrumb-item">Survey Setting</li>
            </ul>
        </div>
    </div>
}

<div ng-controller="SurveyCtrl">
    <div class="d-md-flex mb-2">
        <div class="fs-4 me-3">Survey</div>
        <div class="overflow-auto flex-fill">
            <div class="flex-fill d-flex flex-nowrap align-items-center">
                <div class="btn btn-link text-nowrap {{ iStatus == '' ? 'active' : '' }}" ng-click="SelectStatus('')">
                    All <span class="badge ms-1" ng-show="sum_all > 0">{{ sum_all | number }}</span>
                </div> |
                <div class="btn btn-link border-0 text-nowrap {{ iStatus == 'Private' ? 'active' : '' }}" ng-click="SelectStatus('Private')">
                    Waiting <span class="badge ms-1" ng-show="sum_waiting > 0">{{ sum_waiting | number }}</span>
                </div>
                <div class="btn btn-link border-0 text-nowrap {{ iStatus == 'Publish' ? 'active' : '' }}" ng-click="SelectStatus('Publish')">
                    Complete <span class="badge ms-1" ng-show="sum_complete > 0">{{ sum_complete | number }}</span>
                </div>
            </div>
        </div>
    </div>
    <div class="mb-4">
        <div style="min-height:calc(100vh - 410px);" class="position-relative">
            <table class="table table-tip border shadow-sm">
                <thead>
                    <tr>
                        <th width="50"></th>
                        <th class="select" ng-click="SetSort('title')">
                            Title
                            <i ng-show="sortBy.indexOf('title') > -1" ng-class="sortBy.indexOf('-') > - 1 ? 'bi bi-arrow-up-short' : 'bi bi-arrow-down-short'"></i>
                        </th>
                        <th class="select text-center" ng-click="SetSort('status')">
                            Status
                            <i ng-show="sortBy.indexOf('status') > -1" ng-class="sortBy.indexOf('-') > - 1 ? 'bi bi-arrow-up-short' : 'bi bi-arrow-down-short'"></i>
                        </th>
                        <th class="select text-center" ng-click="SetSort('total')">
                            Total Questions
                            <i ng-show="sortBy.indexOf('total') > -1" ng-class="sortBy.indexOf('-') > - 1 ? 'bi bi-arrow-up-short' : 'bi bi-arrow-down-short'"></i>
                        </th>
                        <th class="select" ng-click="SetSort('create_date')">
                            Create
                            <i ng-show="sortBy.indexOf('create_date') > -1" ng-class="sortBy.indexOf('-') > - 1 ? 'bi bi-arrow-up-short' : 'bi bi-arrow-down-short'"></i>
                        </th>
                        <th>
                            Actions
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="x in lData" class="{{ x.statusCss }} {{ x.is_not_read == 1 ? 'fw-bolder' : '' }}">
                        <td class="text-center align-middle">
                            <span ng-show="x.status == 'Private'" class="text-warning" title="Private">
                                <i class="bi bi-clipboard"></i>
                            </span>
                            <span ng-show="x.status == 'Publish'" class="text-green" title="Publish">
                                <i class="bi bi-clipboard-check"></i>
                            </span>
                        </td>
                        <td>
                            <div class="fw-bolder text-truncate">
                                {{ x.title }}
                            </div>
                            <div>{{ x.start_date }} - {{ x.end_date }}</div>
                        </td>
                        <td class="text-center align-middle">
                            <div class="badge bg-{{ x.status }}">{{ x.status }}</div>
                        </td>
                        <td class="text-center align-middle">
                            {{ x.total | number }}
                        </td>
                        <td class="align-middle">
                            {{ x.create_date }}
                        </td>
                        <td>
                            <div class="d-flex">
                                <button ng-click="ShowPublish(x)" class="btn btn-circle bg-light-green me-2" title="Publish">
                                    <i class="bi bi-send"></i>
                                </button>
                                <button ng-click="ShowEdit(x)" class="btn btn-circle bg-light-orange me-2" title="Edit">
                                    <i class="bi bi-pen"></i>
                                </button>
                                <button ng-click="Delete(x)" class="btn btn-circle bg-light-red me-2" title="Delete">
                                   <i class="bi bi-trash"></i>
                                </button>
                                <button ng-click="ShowDetail(x)" class="btn btn-circle bg-light-blue" title="Detail">
                                    <i class="bi bi-arrow-right"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="3">
                            <div class="text-light-gray">Showing {{ ((page - 1) * row) + 1 }} to {{ (page * row) > total ? total : page * row }} of {{ total }} requests</div>
                        </td>
                        <td colspan="3">
                            <div class="d-flex">
                                <div class="flex-fill"></div>
                                <button class="btn btn-circle me-2" ng-click="LoadData(page - 1)" ng-disabled="page <= 1">
                                    <i class="fas fa-chevron-left"></i>
                                </button>
                                <button class="btn btn-circle" ng-click="LoadData(page + 1)" ng-disabled="page * row >= total">
                                    <i class="fas fa-chevron-right"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
<script>
    app.controller('SurveyCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.is_not_read = 99;
        $scope.createBy = '';
        $scope.iStatus = '';

        $scope.page = 1;
        $scope.row = 10;
        $scope.lData = [];
        
        $scope.LoadData = function(page = 1){
            $scope.page = page;

            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Survey/MyList',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    page: $scope.page
                    , row: $scope.row
                    , status: $scope.iStatus
                    , userBy: '@User.UserId()'
                }),
                success: function (result) {
                    $timeout(function () {
                        $scope.lData = result.data;
                        $scope.total = result.total;
                    }, 0);
                },
                error: AjaxError
            });
            
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Survey/MySummary', 
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    userBy: '@User.UserId()'
                }),
                success: function (result) {
                    $timeout(function () {
                        $scope.sum_waiting = 0;
                        $scope.sum_complete = 0;
                        
                        var find = result.find(x => x.status == 'Waiting');
                        if (find) { 
                            $scope.sum_waiting = find.total; 
                        }
                        find = result.find(x => x.status == 'Complete');
                        if (find) { 
                            $scope.sum_complete = find.total; 
                        }

                        $scope.sum_all = $scope.sum_waiting
                            + $scope.sum_complete;
                    }, 0);
                },
                error: AjaxError
            });
        }
        $scope.LoadData();

        $scope.SelectStatus = function (status) {
            $scope.iStatus = status;
            $scope.LoadData();
        }

        $scope.SetPage = function (page) {
            $scope.LoadData(page);
        }
        
        $scope.ShowDetail = function(x){
            x.is_not_read = 0;
            window.open('@Url.Page("Detail")?id=' + x.id, '_blank');
        }
        
        window.parent.ReloadRequest = function () {
            $scope.LoadData();
        }
    })
</Script>