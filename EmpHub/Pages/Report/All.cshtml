@page
@model EmpHub.Pages.Report.AllModel
@{
    ViewData["Title"] = "EmpHub";
}
<style>
    .bg-main {
        min-height: calc(100% - 70px);
    }
</style>
<div ng-controller="ReportCtrl" class="p-2">
    <div class="d-md-flex">
        <div class="mb-3 me-2 text-nowrap">
            <div class="fs-4"><i class="bi bi-file-earmark-text"></i> ใบคำขอทั้งหมด</div>
        </div>
        <div class="overflow-auto mb-3 flex-fill">
            <div class="flex-fill d-flex flex-nowrap align-items-center">
                <div class="btn btn-link text-dark-gray text-nowrap {{ iStatus == '' ? 'active' : '' }}" ng-click="SelectStatus('')">
                    ทั้งหมด <span class="badge bg-dark-gray" ng-show="sum_all > 0">{{ sum_all | number }}</span>
                </div>
                |
                <div class="btn btn-link text-dark-gray text-nowrap {{ iStatus == 'Cancel' ? 'active' : '' }}" ng-click="SelectStatus('Cancel')">
                    ยกเลิก <span class="badge bg-dark-gray" ng-show="sum_cancel > 0">{{ sum_cancel | number }}</span>
                </div>
                <div class="btn btn-link text-dark-gray text-nowrap {{ iStatus == 'Approve' ? 'active' : '' }}" ng-click="SelectStatus('Approve')">
                    รออนุมัติ <span class="badge bg-dark-gray" ng-show="sum_approve > 0">{{ sum_approve | number }}</span>
                </div>
                <div class="btn btn-link text-dark-gray text-nowrap {{ iStatus == 'Work' ? 'active' : '' }}" ng-click="SelectStatus('Work')">
                    รอดำเนินการ <span class="badge bg-dark-gray" ng-show="sum_work > 0">{{ sum_work | number }}</span>
                </div>
                <div class="btn btn-link text-dark-gray text-nowrap {{ iStatus == 'Change' ? 'active' : '' }}" ng-click="SelectStatus('Change')">
                    เปลี่ยนประเภท <span class="badge bg-dark-gray" ng-show="sum_change > 0">{{ sum_change | number }}</span>
                </div>
                <div class="btn btn-link text-dark-gray text-nowrap {{ iStatus == 'Complete' ? 'active' : '' }}" ng-click="SelectStatus('Complete')">
                    สำเร็จ <span class="badge bg-dark-gray" ng-show="sum_complete > 0">{{ sum_complete | number }}</span>
                </div>
                <div class="btn btn-link text-dark-gray text-nowrap {{ iStatus == 'Reject' ? 'active' : '' }}" ng-click="SelectStatus('Reject')">
                    ไม่ผ่าน <span class="badge bg-dark-gray" ng-show="sum_reject > 0">{{ sum_reject | number }}</span>
                </div>
            </div>
        </div>
        <div class="d-none d-sm-block text-nowrap">
            <div class="btn btn-primary" ng-click="Download()">
                <i class="bi bi-download"></i> ดาวน์โหลด
            </div>
        </div>
    </div>
    <div class="rounded-4 p-2 bg-white border shadow-sm">
        <partial name="_PartialNavBarReportAll" />
        <div class="p-1">
            <partial name="Service/_PartialAllDataList"></partial>
        </div>
    </div>
</div>
<script>
    app.controller('ReportCtrl', function ($scope, $http, $timeout, $filter, $sce) {
        $scope.sysId = 'ITS';
        $scope.is_not_read = 99;
        $scope.page = 1;
        $scope.row = 10;
        $scope.lData = [];
        $scope.iStatus = '';
        $scope.load_data_user = 1;

        $scope.lRead = [
            { key: 'ทั้งหมด', value: 99 }
            , { key: 'ยังไม่ได้อ่าน', value: 1 }
            , { key: 'อ่านแล้ว', value: 0 }
        ];

        $scope.LoadData = function(page = 1){
            $scope.page = page;
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Service/ReportAll',
                headers: { 'authorization': 'Bearer @User.AccessToken()' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    sysId: $scope.sysId
                    , userBy: '@User.UserId()'
                    , page: $scope.page
                    , row: $scope.row
                    , sortBy: $scope.sortBy
                    , status: $scope.iStatus
                    , is_not_read: $scope.is_not_read
                    , search_title: $scope.search_title
                    , search_detail: $scope.search_detail
                    , search_create_by: $scope.search_create_by
                    , departmentCode: $scope.search_department_by
                    , search_create_date_start: $scope.search_create_date_start
                    , search_create_date_end: $scope.search_create_date_end
                    , search_work_by: $scope.search_work_by
                    , search_comment: $scope.search_comment
                }),
                success: function (result) {
                    $timeout(function () {
                        $scope.lData = result.data;
                        $scope.total = result.total;
                        $scope.lUser = result.lUser;
                        $scope.lWork = result.lWork;
                    }, 0);
                },
                error: AjaxError
            });
            
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Service/ReportAllSummary',
                headers: { 'authorization': 'Bearer @User.AccessToken()' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    sysId: $scope.sysId
                    , userBy: '@User.UserId()'
                    , search_title: $scope.search_title
                    , search_detail: $scope.search_detail
                    , search_create_by: $scope.search_create_by
                    , departmentCode: $scope.search_department_by
                    , search_create_date_start: $scope.search_create_date_start
                    , search_create_date_end: $scope.search_create_date_end
                    , search_work_by: $scope.search_work_by
                    , search_comment: $scope.search_comment
                }),
                success: function (result) {
                    $timeout(function () {
                        $scope.sum_request = 0;
                        $scope.sum_cancel = 0;
                        $scope.sum_approve = 0;
                        $scope.sum_reject = 0;
                        $scope.sum_work = 0;
                        $scope.sum_complete = 0;
                        $scope.sum_change = 0;

                        var find = result.find(x => x.status == 'Request');
                        if (find) { $scope.sum_request = find.total; }
                        find = result.find(x => x.status == 'Cancel');
                        if (find) { $scope.sum_cancel = find.total; }
                        find = result.find(x => x.status == 'Approve');
                        if (find) { $scope.sum_approve = find.total; }
                        find = result.find(x => x.status == 'Reject');
                        if (find) { $scope.sum_reject = find.total; }
                        find = result.find(x => x.status == 'Work');
                        if (find) { $scope.sum_work = find.total; }
                        find = result.find(x => x.status == 'Complete');
                        if (find) { $scope.sum_complete = find.total; }
                        find = result.find(x => x.status == 'Change');
                        if (find) { $scope.sum_change = find.total; }

                        $scope.sum_all = $scope.sum_request
                        + $scope.sum_cancel
                        + $scope.sum_approve
                        + $scope.sum_reject
                        + $scope.sum_work
                        + $scope.sum_complete
                        + $scope.sum_change;
                    }, 0);
                },
                error: AjaxError
            });
        }
        $scope.LoadData();
        
        $scope.SelectStatus = function (status) {
            $scope.iStatus = status;
            $scope.LoadData();
        }

        $scope.SetPage = function (page) {
            $scope.LoadData(page);
        }
        
        $scope.SetSort = function(sortBy){
            if ($scope.sortBy != null && $scope.sortBy.indexOf(sortBy) > -1) {
                if ($scope.sortBy.indexOf("-") > -1) {
                    $scope.sortBy = sortBy;
                }else{
                    $scope.sortBy = '-' + sortBy;
                }
            }else{
                $scope.sortBy = sortBy;
            }
            $scope.LoadData();
        }

        $scope.PreviewHtml = function(html_code){
            return $sce.trustAsHtml(html_code);
        }

        $scope.ShowDetail = function(x){
            window.open('@Url.Page("/Service/Detail")/' + x.id, '_blank');
        }
        
        window.parent.ReloadRequest = function () {
            $scope.LoadData();
        }
        
        $scope.Search = function () {
            $scope.search_detail = '';
            $scope.search_create_by = '';
            $scope.search_create_date_start = '';
            $scope.search_create_date_end = '';
            $scope.search_comment = '';
            $scope.LoadData();
        }

        $scope.SearchAdvance = function(){
            $scope.search_title = '';
            $scope.search_create_date_start = '';
            $scope.search_create_date_end = '';

            if ($scope.input_create_date_start != '' && $scope.input_create_date_start != undefined) {
                $scope.search_create_date_start = $scope.input_create_date_start.format("DD/MM/YYYY");
            }
            if ($scope.input_create_date_end != '' && $scope.input_create_date_end != undefined) {
                $scope.search_create_date_end = $scope.input_create_date_end.format("DD/MM/YYYY");
            }

            $("#ddSearch").dropdown('toggle');
            $scope.LoadData();
        }

        $scope.CancelSearchAdvance = function(){
            $scope.search_title = '';
            $scope.search_detail = '';
            $scope.search_create_by = '';
            $scope.search_create_date_from = '';
            $scope.search_create_date_end = '';
            $scope.search_comment = '';
            $scope.input_create_date_start = null;
            $scope.input_create_date_end = null;
            $("#ddSearch").dropdown('toggle');
            $scope.LoadData();
        }

        $scope.SelectReadMode = function (x) {
            $scope.is_not_read = x.value;
            $scope.LoadData();
        }
        
        $scope.Download = function(){
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Service/ReportAll',
                headers: { 'authorization': 'Bearer @User.AccessToken()' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    sysId: $scope.sysId
                    , userBy: '@User.UserId()'
                    , page: 1
                    , row: $scope.total
                    , sortBy: $scope.sortBy
                    , status: $scope.iStatus
                    , is_not_read: $scope.is_not_read
                    , search_title: $scope.search_title
                    , search_detail: $scope.search_detail
                    , search_create_by: $scope.search_create_by
                    , departmentCode: $scope.search_department_by
                    , search_create_date_start: $scope.search_create_date_start
                    , search_create_date_end: $scope.search_create_date_end
                    , search_work_by: $scope.search_work_by
                    , search_comment: $scope.search_comment
                }),
                success: function (result) {
                    $timeout(function () {
                        var lData = result.data;
                        
                        if (lData.length > 0) {
                            var JSData = [[
                                { 'text': 'เลขที่เอกสาร' }
                                , { 'text': 'ประเภท' }
                                , { 'text': 'ความประสงค์' }
                                , { 'text': 'เรื่อง' }
                                , { 'text': 'สถานะ' }
                                , { 'text': 'คำขอโดย' }
                                , { 'text': 'วันที่ขอ' }
                            ]];

                            for (var i = 0; i < lData.length; i++) {
                                var iData = lData[i];

                                JSData.splice(JSData.length, 0, [
                                    { 'text': iData.serviceNo }
                                    , { 'text': iData.categoryDesc }
                                    , { 'text': iData.subCategoryDesc }
                                    , { 'text': iData.title }
                                    , { 'text': iData.status }
                                    , { 'text': iData.createName }
                                    , { 'text': iData.createDate }
                                ]);
                            }

                            var dt = new Date().toISOString().slice(0, 10).replace(/-/g, "");
                            ExportFile(JSData, 'รายงานฝ่าย_' + dt);
                        }
                    }, 0);
                },
                error: AjaxError
            });
        }
    })
</Script>