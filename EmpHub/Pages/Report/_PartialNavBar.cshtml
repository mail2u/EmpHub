@{
    var token = User.AccessToken(Context);
}
<style>
    .form-control-filter {
        background-color: var(--light-blue);
        border: none;
        width: 100%;
        display: block;
        border-bottom: 1px solid var(--soft-blue);
    }
</style>
<div class="d-flex mb-1" ng-controller="NavBarCtrl">
    <div class="flex-fill">
        <div class="d-flex">
            <div class="dropdown me-2">
                <div id="ddSearch" class="btn btn-circle btn-circle-hover" data-bs-toggle="dropdown" aria-expanded="false" data-bs-auto-close="false">
                    <i class="fas fa-filter"></i>
                </div>
                <div class="dropdown-menu shadow p-2" style="width:380px;">
                    <table class="table table-borderless mb-0">
                        <tr>
                            <td>รายละเอียด</td>
                            <td>
                                <input ng-model="$parent.search_detail" class="form-control-filter" />
                            </td>
                        </tr>
                        <tr ng-show="lUser.length > 0">
                            <td>ผู้ขอรับบริการ</td>
                            <td>
                                <div class="dropdown">
                                    <input ng-model="search_create_name" class="form-control-filter icon-user" data-bs-toggle="dropdown" readonly />
                                    <div ng-show="search_create_name == ''" class="select position-absolute top-50 end-0 translate-middle">
                                        <i class="bi bi-person"></i>
                                    </div>
                                    <div ng-show="search_create_name != ''" class="select position-absolute top-50 end-0 translate-middle text-danger" ng-click="RemoveUser()">
                                        <i class="bi bi-x-circle"></i>
                                    </div>
                                    <div class="dropdown-menu p-1" style="z-index:2000">
                                        <input ng-model="search_create_name_find" class="form-control mb-1" placeholder="ค้นหา" />
                                        <div class="list-group list-group-flush overflow-auto" style="max-height:400px">
                                            <div class="list-group-item list-group-item-action select text-nowrap text-secondary" ng-repeat="u in lUser | filter : search_create_name_find as total_user" ng-click="SelectUser(u)">
                                                <i class="bi bi-person-fill"></i> {{ u.fullname }}
                                            </div>
                                        </div>
                                        <div ng-show="total_user.length == 0" class="h-100 justify-content-center d-flex align-items-center opacity-25" style="min-height: 200px; ">
                                            ไม่พบข้อมูล
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td>วันที่ขอรับบริการ</td>
                            <td>
                                <div class="d-flex">
                                    <input class="form-control-filter icon-calendar date"
                                           ng-model="$parent.input_create_date_start"
                                           ng-model-options="{ updateOn: 'blur' }"
                                           moment-picker="$parent.input_create_date_start"
                                           locale="th"
                                           format="DD/MM/YYYY"
                                           min-view="month"
                                           max-view="month"
                                           start-view="month"
                                           max-date="$parent.input_create_date_end"
                                           required />
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td>ถึง</td>
                            <td>
                                <div class="d-flex">
                                    <input class="form-control-filter icon-calendar date"
                                           ng-model="$parent.input_create_date_end"
                                           ng-model-options="{ updateOn: 'blur' }"
                                           moment-picker="$parent.input_create_date_end"
                                           locale="th"
                                           format="DD/MM/YYYY"
                                           min-view="month"
                                           max-view="month"
                                           start-view="month"
                                           min-date="$parent.input_create_date_start"
                                           required />
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td>ความคิดเห็น</td>
                            <td>
                                <input ng-model="$parent.search_comment" class="form-control-filter" />
                            </td>
                        </tr>
                        <tr ng-show="lWork.length > 0">
                            <td>ผู้ดำเนินการ</td>
                            <td>
                                <div class="dropdown">
                                    <input ng-model="search_work_name" class="form-control-filter icon-user" data-bs-toggle="dropdown" readonly />
                                    <div ng-show="search_work_name == ''" class="select position-absolute top-50 end-0 translate-middle">
                                        <i class="bi bi-person"></i>
                                    </div>
                                    <div ng-show="search_work_name != ''" class="select position-absolute top-50 end-0 translate-middle text-danger" ng-click="RemoveWork()">
                                        <i class="bi bi-x-circle"></i>
                                    </div>
                                    <div class="dropdown-menu p-1" style="z-index:2000">
                                        <input ng-model="search_work_name_find" class="form-control mb-1" placeholder="ค้นหา" />
                                        <div class="list-group list-group-flush overflow-auto" style="max-height:400px">
                                            <div class="list-group-item list-group-item-action select text-nowrap text-secondary" ng-repeat="u in lWork | filter : search_work_name_find as total_work" ng-click="SelectWork(u)">
                                                <i class="bi bi-person-fill"></i> {{ u.createName }}
                                            </div>
                                        </div>
                                        <div ng-show="total_work.length == 0" class="h-100 justify-content-center d-flex align-items-center opacity-25" style="min-height: 200px; ">
                                            ไม่พบข้อมูล
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td></td>
                            <td class="text-end">
                                <div class="btn btn-secondary" ng-click="SearchAdvance()">
                                    <i class="bi bi-search"></i> ค้นหา
                                </div>
                                <div class="btn btn-light" ng-click="CancelSearchAdvance()">
                                    ล้างตัวกรอง
                                </div>
                            </td>
                        </tr>
                    </table>
                    @*  <a href="#" class="dropdown-item {{ x.value == is_not_read ? 'active' : '' }}" ng-click="SelectReadMode(x)" ng-repeat="x in lRead">
                    {{ x.key }}
                    </a> *@
                </div>
            </div>
            <input class="form-control form-control-search flex-fill me-2" ng-model="$parent.search_title" placeholder="ค้นหา" my-enter="Search()" />
            <button ng-click="Search()" class="btn btn-light me-2">
                <i class="fas fa-search"></i>
            </button>
        </div>
    </div>
    <div class="text-end d-flex flex-nowrap align-items-center">
        <span class="d-none d-md-block">
            {{ (total > 0 ? ((page - 1) * row) + 1 : 0) | number }} - {{ (page * row < total ? page * row : total) | number }} of {{ total | number }}
        </span>
        <button class="btn btn-circle" ng-click="SetPage(page - 1)" ng-disabled="page <= 1">
            <i class="fas fa-chevron-left"></i>
        </button>
        <button class="btn btn-circle" ng-click="SetPage(page + 1)" ng-disabled="page * row >= total">
            <i class="fas fa-chevron-right"></i>
        </button>
    </div>
</div>
<script>
    app.controller('NavBarCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.search_create_name = '';
        $scope.search_create_name_find = '';

        $scope.LoadUser = function () {
            if ($scope.$parent.load_data_user == 1) {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/User/DataList'
                    , headers: { 'authorization': 'Bearer @token' }
                    , type: 'post'
                    , dataType: 'json'
                    , cache: false
                    , success: function (result) {
                        $timeout(function () {
                            $scope.$parent.lUser = result.map((x) => {return { userId:x.userId, fullname : x.firstname_th + ' ' + x.lastname_th }; });
                        }, 0);
                    }
                    , error: AjaxError
                });
            }
        }
        $scope.LoadUser();

        $scope.SelectUser = function (x) {
            $scope.$parent.search_create_by = x.userId;
            $scope.search_create_name = x.fullname;
        }

        $scope.RemoveUser = function () {
            $scope.$parent.search_create_by = '';
            $scope.search_create_name = '';
        }

        $scope.SelectWork = function (x) {
            $scope.$parent.search_work_by = x.createBy;
            $scope.search_work_name = x.createName;
        }

        $scope.RemoveWork = function () {
            $scope.$parent.search_work_by = '';
            $scope.search_work_name = '';
        }

        $scope.Search = function () {
            $scope.$parent.search_detail = '';
            $scope.$parent.search_create_by = '';
            $scope.$parent.search_create_date_start = '';
            $scope.$parent.search_create_date_end = '';
            $scope.$parent.search_comment = '';
            $scope.$parent.LoadData();
        }

        $scope.SearchAdvance = function () {
            $scope.$parent.search_title = '';
            $scope.$parent.search_create_date_start = '';
            $scope.$parent.search_create_date_end = '';

            if ($scope.$parent.input_create_date_start != '' && $scope.$parent.input_create_date_start != undefined) {
                $scope.$parent.search_create_date_start = $scope.$parent.input_create_date_start.format("DD/MM/YYYY");
            }
            if ($scope.$parent.input_create_date_end != '' && $scope.$parent.input_create_date_end != undefined) {
                $scope.$parent.search_create_date_end = $scope.$parent.input_create_date_end.format("DD/MM/YYYY");
            }

            $("#ddSearch").dropdown('toggle');
            $scope.$parent.LoadData();
        }

        $scope.CancelSearchAdvance = function () {
            $scope.$parent.search_title = '';
            $scope.$parent.search_detail = '';
            $scope.$parent.search_create_by = '';
            $scope.$parent.search_create_date_from = '';
            $scope.$parent.search_create_date_end = '';
            $scope.$parent.search_comment = '';
            $scope.$parent.input_create_date_start = null;
            $scope.$parent.input_create_date_end = null;
            $scope.search_work_name = '';
            $scope.search_work_name_find = '';

            $("#ddSearch").dropdown('toggle');
            $scope.$parent.LoadData();
        }

        $scope.SelectReadMode = function (x) {
            $scope.$parent.is_not_read = x.value;
            $scope.$parent.LoadData();
        }
    });
</script>