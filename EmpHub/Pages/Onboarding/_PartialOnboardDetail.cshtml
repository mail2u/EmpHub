@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@

<style>
    .form-input {
        padding: 5px;
        border: 0px;
        border-radius: 0;
        border-bottom: 2px solid var(--bs-gray-400);
        background-color: #fcfcfc;
    }

    .form-input:focus {
        border-bottom: 2px solid var(--tip-blue);
    }

    input.form-input:read-only {
        background-color: var(--bs-gray-200);
    }
</style>
<div class="position-relative m-4 pb-3">
    <div class="progress" role="progressbar" aria-label="Progress" aria-valuenow="{{ lStep[step_index].value }}" aria-valuemin="0" aria-valuemax="100" style="height: 1px;">
        <div class="progress-bar" style="width: {{ lStep[step_index].left }}"></div>
    </div>
    <div class="position-absolute top-0 translate-middle text-center" style="left:0%;">
        <button type="button" class="btn btn-sm rounded-pill btn-primary" style="width: 2rem; height:2rem;">1</button>
    </div>
    <div class="position-absolute top-0 translate-middle text-center" style="left:33.33%;">
        <button type="button" class="btn btn-sm rounded-pill {{ step_index >= 1 ? 'btn-primary' : 'btn-secondary' }}" style="width: 2rem; height:2rem;" ng-disabled="step_index < 1">2</button>
    </div>
    <div class="position-absolute top-0 translate-middle text-center" style="left:66.66%;">
        <button type="button" class="btn btn-sm rounded-pill {{ step_index >= 2 ? 'btn-primary' : 'btn-secondary' }}" style="width: 2rem; height:2rem;" ng-disabled="step_index < 2">3</button>
    </div>
    <div class="position-absolute top-0 translate-middle text-center" style="left:100%;">
        <button type="button" class="btn btn-sm rounded-pill {{ step_index >= 3 ? 'btn-primary' : 'btn-secondary' }}" style="width: 2rem; height:2rem;" ng-disabled="step_index < 3">4</button>
    </div>
</div>
<div class="rounded-4 border shadow-sm p-3 bg-white text-dark mb-3" ng-show="step_index == 0">
    <div class="fs-4 fw-bolder">
        ข้อมูลส่วนบุคคล
    </div>
    <hr/>
    <div class="fw-bolder fs-6 mb-2">ข้อมูลยืนยันตัวตน</div>
    <div class="row g-3 mb-2">
        <div class="col-sm-3 mb-3">
            <div>เลขประจำตัวประชาชน</div>
            <input ng-model="iPersonal.idcard" class="form-control form-input idcard" placeholder="0000000000000" maxlength="13" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>สัญชาติ</div>
            @* สัญชาติ "อื่น ๆ" เก็บชื่อไว้ในคอลัมน์ nationality ทำให้ nationalityDesc ว่าง จึงต้อง fallback *@
            <input value="{{ iPersonal.nationalityDesc || iPersonal.nationality }}" class="form-control form-input nationality" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>เชื้อชาติ</div>
            <input ng-model="iPersonal.ethnicityDesc" class="form-control form-input ethnicity" readonly></input>
        </div>
        <div class="col-sm-3 mb-3">
            <div>ศาสนา</div>
            <input ng-model="iPersonal.religionDesc" class="form-control form-input religion" readonly></input>
        </div>
    </div>

    <div class="fw-bolder fs-6 mb-2">ชื่อภาษาไทย</div>
    <div class="row g-3 mb-2">
        <div class="col-sm-3 mb-3">
            <div>คำนำหน้าชื่อ</div>
            @* คำนำหน้า "อื่น ๆ" เก็บชื่อไว้ในคอลัมน์ prefix_th ทำให้ prefix_th_desc ว่าง จึงต้อง fallback *@
            <input value="{{ iPersonal.prefix_th_desc || iPersonal.prefix_th }}" class="form-control form-input prefix_th" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>ชื่อ</div>
            <input ng-model="iPersonal.firstname_th" class="form-control form-input firstname_th" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>นามสกุล</div>
            <input ng-model="iPersonal.lastname_th" class="form-control form-input lastname_th" readonly />
        </div>
    </div>

    <div class="fw-bolder fs-6 mb-2">ชื่อภาษาอังกฤษ</div>
    <div class="row g-3 mb-2">
        <div class="col-sm-3 mb-3">
            <div>คำนำหน้าชื่อ</div>
            <input value="{{ iPersonal.prefix_en_desc || iPersonal.prefix_en }}" class="form-control form-input prefix_en" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>ชื่อ</div>
            <input ng-model="iPersonal.firstname_en" class="form-control form-input firstname_en" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>นามสกุล</div>
            <input ng-model="iPersonal.lastname_en" class="form-control form-input lastname_en" readonly />
        </div>
    </div>

    <div class="fw-bolder fs-6 mb-2">ข้อมูลทั่วไป</div>
    <div class="row g-3">
        <div class="col-sm-3 mb-3">
            <div>วันเกิด</div>
            <input ng-model="iPersonal.birth_date" class="form-control form-input" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>อายุ</div>
            <input ng-model="iPersonal.age" class="form-control form-input age" maxlength="50" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>เพศ</div>
            <input ng-model="iPersonal.sex_desc" class="form-control form-input sex" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>สถานภาพการสมรส</div>
            <input ng-model="iPersonal.maritalStatusDesc" class="form-control form-input maritalStatus" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>สถานะทางการทหาร</div>
            <input ng-model="iPersonal.militaryStatusDesc" class="form-control form-input militaryStatus" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>สถานะความพิการ</div>
            <input ng-model="iPersonal.disabilityStatusDesc" class="form-control form-input disabilityStatus" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>เลขบัตรผู้พิการ</div>
            <input ng-model="iPersonal.disabilityCardNo" class="form-control form-input disabilityCardNo" readonly />
        </div>
    </div>
    <div class="d-flex">
        <div class="flex-fill"></div>
        <div>
            <button class="btn btn-primary" ng-click="step_index = 1">ต่อไป</button>
        </div>
    </div>
</div>
<div class="rounded-4 border shadow-sm p-3 bg-white text-dark mb-3" ng-show="step_index == 1">
    <div class="fs-4 fw-bolder">ข้อมูลที่อยู่</div>
    @* Address *@
    <div class="fw-bolder fs-6">ที่อยู่ทะเบียนบ้าน</div>
    <div class="row">
        <div class="col-sm-6 mb-3">
            <div>บ้านเลขที่</div>
            <input ng-model="iAddress.registered_home" class="form-control form-input registered_home" maxlength="100" readonly />
        </div>
        <div class="col-sm-6 mb-3">
            <div>ถนน</div>
            <input ng-model="iAddress.registered_road" class="form-control form-input registered_road" maxlength="100" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>แขวง/ตำบล</div>
            <input ng-model="iAddress.registered_subDistrictName" class="form-control form-input registered_subDistrictName" maxlength="50" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>เขต/อำเภอ</div>
            <input ng-model="iAddress.registered_districtName" class="form-control form-input registered_districtName" maxlength="50" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>จังหวัด</div>
            <input ng-model="iAddress.registered_provinceName" class="form-control form-input registered_provinceName" maxlength="50" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>ไปรษณีย์</div>
            <input ng-model="iAddress.registered_postcode" class="form-control form-input registered_postcode postcode" maxlength="5" readonly />
        </div>
    </div>
    <div class="fw-bolder fs-6 me-2">ที่อยู่ตามบัตรประชาชน</div>
    <div class="row">
        <div class="col-sm-6 mb-3">
            <div>บ้านเลขที่</div>
            <input ng-model="iAddress.card_home" class="form-control form-input card_home" maxlength="100" readonly />
        </div>
        <div class="col-sm-6 mb-3">
            <div>ถนน</div>
            <input ng-model="iAddress.card_road" class="form-control form-input card_road" maxlength="100" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>แขวง/ตำบล</div>
            <input ng-model="iAddress.card_subDistrictName" class="form-control form-input card_subDistrictName" maxlength="50" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>เขต/อำเภอ</div>
            <input ng-model="iAddress.card_districtName" class="form-control form-input card_districtName" maxlength="50" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>จังหวัด</div>
            <input ng-model="iAddress.card_provinceName" class="form-control form-input card_provinceName" maxlength="50" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>ไปรษณีย์</div>
            <input ng-model="iAddress.card_postcode" class="form-control form-input card_postcode postcode" maxlength="5" readonly />
        </div>
    </div>
    <div class="fw-bolder fs-6">ที่อยู่พักอาศัย</div>
    <div class="row">
        <div class="col-sm-6 mb-3">
            <div>บ้านเลขที่</div>
            <input ng-model="iAddress.live_home" class="form-control form-input live_home" maxlength="100" readonly />
        </div>
        <div class="col-sm-6 mb-3">
            <div>ถนน</div>
            <input ng-model="iAddress.live_road" class="form-control form-input live_road" maxlength="100" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>แขวง/ตำบล</div>
            <input ng-model="iAddress.live_subDistrictName" class="form-control form-input live_subDistrictName" maxlength="50" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>เขต/อำเภอ</div>
            <input ng-model="iAddress.live_districtName" class="form-control form-input live_districtName" maxlength="50" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>จังหวัด</div>
            <input ng-model="iAddress.live_provinceName" class="form-control form-input live_provinceName" maxlength="50" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>ไปรษณีย์</div>
            <input ng-model="iAddress.live_postcode" class="form-control form-input live_postcode postcode" maxlength="5" readonly />
        </div>
    </div>
    <div class="d-flex">
        <div class="flex-fill">
            <div>
                <button class="btn btn-light" ng-click="step_index = 0">กลับ</button>
            </div>
        </div>
        <div>
            <button class="btn btn-primary" ng-click="step_index = 2">ต่อไป</button>
        </div>
    </div>
</div>
<div class="rounded-4 border shadow-sm p-3 bg-white text-dark mb-3" ng-show="step_index == 2">
    @* Contact *@
    <div class="fw-bolder fs-4">
        ข้อมูลการติดต่อ
    </div>
    <div class="row">
        <div class="col-sm-3 mb-3">
            <div>มือถือ</div>
            <input ng-model="iPersonal.mobile" class="form-control form-input mobile phone" maxlength="50" readonly placeholder="000-000-0000" />
        </div>
        <div class="col-sm-3 mb-3">
            <div>อีเมลบริษัท</div>
            <input ng-model="iEmployee.email" class="form-control form-input email_office" maxlength="50" readonly />
        </div>
    </div>
    <div class="d-flex">
        <div class="flex-fill">
            <div>
                <button class="btn btn-light" ng-click="step_index = 1">กลับ</button>
            </div>
        </div>
        <div>
            <button class="btn btn-primary" ng-click="step_index = 3">ต่อไป</button>
        </div>
    </div>
</div>
<div class="rounded-4 border shadow-sm p-3 bg-white text-dark mb-3" ng-show="step_index == 3">
    <div class="fw-bolder fs-4">
        ข้อมูลพนักงาน
    </div>
    <div class="row">
        <div class="col-sm-3 mb-3">
            <div>รหัสพนักงาน</div>
            <input ng-model="iEmployee.employeeCode" class="form-control form-input employeeCode" placeholder="000000" maxlength="6" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>วันเข้างาน</div>
            <input ng-model="iEmployee.join_date" class="form-control form-input probation_day" maxlength="50" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>วันผ่านการทดลองงาน</div>
            <input ng-model="iEmployee.probation_end_date" class="form-control form-input probation_day" maxlength="50" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>ระยะเวลาทดลองงาน (วัน)</div>
            <input ng-model="iEmployee.probation_day" class="form-control form-input probation_day" maxlength="50" readonly />
        </div>
    </div>
    <div class="row">
        <div class="col-sm-3 mb-3">
            <div>ด้าน</div>
            <input ng-model="iEmployee.functionDesc" class="form-control form-input functionCode" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>สาย</div>
            <input ng-model="iEmployee.divisionDesc" class="form-control form-input divisionCode" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>ฝ่าย</div>
            <input ng-model="iEmployee.departmentDesc" class="form-control form-input departmentCode" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>ส่วน</div>
            <input ng-model="iEmployee.sectionDesc" class="form-control form-input sectionCode" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>ตำแหน่งงาน</div>
            <input ng-model="iEmployee.positionDesc" class="form-control form-input positionCode" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>เกรด</div>
            <input ng-model="iEmployee.grade" class="form-control form-input grade" maxlength="50" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>ประเภทพนักงาน</div>
            <input ng-model="iEmployee.employeeType" class="form-control form-input employeeType" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>ระดับพนักงาน</div>
            <input ng-model="iEmployee.levelDesc" class="form-control form-input levelCode" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>หัวหน้างาน</div>
            <input ng-model="iEmployee.supervisorName" class="form-control form-input supervisorName" maxlength="50" readonly />
        </div>
    </div>
    <div class="d-flex">
        <div class="flex-fill">
            <div>
                <button class="btn btn-light" ng-click="step_index = 2">กลับ</button>
            </div>
        </div>
    </div>
</div>
<script>
    $(".employeeCode").mask("000000");
    $(".idcard").mask("0000000000000");
    $(".date").mask("00/00/0000");
    $(".postcode").mask("00000");
    $(".phone").mask("000-000-0000");
</script>
