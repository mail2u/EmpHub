@page
@model EmpHub.Pages.Onboarding.CheckModel
@{
    ViewData["Title"] = "Onboarding";
    var token = User.AccessToken(HttpContext);
}
@section PageHeader {
    <!-- [ page-header ] start -->
    <div class="page-header">
        <div class="page-header-left d-flex align-items-center">
            <div class="page-header-title">
                <h5 class="m-b-10">Onboarding</h5>
            </div>
            <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Page("/Index")">Home</a></li>
                <li class="breadcrumb-item"><a href="@Url.Page("Index")">Onboarding</a></li>
                <li class="breadcrumb-item">Create</li>
            </ul>
        </div>
    </div>
}
<div ng-controller="ManageCtrl" class="p-2">
    <div class="d-flex align-items-center mb-3">
        <div class="flex-fill text-dark">
            <div class="fs-4 fw-bolder ">
                ค้นหาพนักงานเก่า (Re-hire)
            </div>
            <div>
                ค้นหาจากเลขบัตรประชาชนพนักงานเดิมเพื่อนำข้อมูลกลับมาใช้ใหม่
            </div>
        </div>
        <div>
            <a class="btn btn-light bg-white" href="@Url.Page("Create")">
                สร้างใหม่ <i class="bi bi-arrow-right ms-2"></i>
            </a>
        </div>
    </div>
    <div class="rounded-4 border shadow-sm p-3 bg-white text-dark mb-3">
        <div class="row">
            <div class="col-sm-4">
                <div>ค้นหาพนักงาน (เลขประจำตัวประชาชน)</div>
                <div class="d-flex">
                    <input ng-model="iPersonal.idcard" class="form-control me-2" maxlength="13" />
                    <button class="btn btn-primary" ng-click="ExistsIdcard()" ng-disabled="!iPersonal.idcard">
                        <i class="bi bi-search me-2"></i> ค้นหา
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="rounded-4 p-3 bg-white shadow-sm border">
        <div class="overflow-auto d-none d-lg-block">
            <div class="pt-3" style="height:calc(100vh - 265px);">
                <table class="table">
                    <thead>
                        <tr>
                            <th class="text-nowrap">
                                ชื่อ-นามสกุล
                                <i ng-show="sortBy.indexOf('desc_th') > -1" ng-class="sortBy.indexOf('-') > - 1 ? 'bi bi-arrow-up-short' : 'bi bi-arrow-down-short'"></i>
                            </th>
                            <th class="text-nowrap">
                                รหัสพนักงานเดิม
                                <i ng-show="sortBy.indexOf('desc_en') > -1" ng-class="sortBy.indexOf('-') > - 1 ? 'bi bi-arrow-up-short' : 'bi bi-arrow-down-short'"></i>
                            </th>
                            <th class="text-nowrap">
                                ตำแหน่ง
                                <i ng-show="sortBy.indexOf('total') > -1" ng-class="sortBy.indexOf('-') > - 1 ? 'bi bi-arrow-up-short' : 'bi bi-arrow-down-short'"></i>
                            </th>
                            <th class="text-nowrap">
                                แผนก
                                <i ng-show="sortBy.indexOf('total') > -1" ng-class="sortBy.indexOf('-') > - 1 ? 'bi bi-arrow-up-short' : 'bi bi-arrow-down-short'"></i>
                            </th>
                            <th class="text-nowrap">
                                สถานะล่าสุด
                                <i ng-show="sortBy.indexOf('total') > -1" ng-class="sortBy.indexOf('-') > - 1 ? 'bi bi-arrow-up-short' : 'bi bi-arrow-down-short'"></i>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="x in lData">
                            <td>
                                {{ x.firstname + ' ' + x.lastname }}
                            </td>
                            <td>
                                {{ x.employeeCode }}
                            </td>
                            <td>
                                {{ x.position }}
                            </td>
                            <td>
                                {{ x.department }}
                            </td>
                            <td>
                                {{ x.status }}
                            </td>
                            <td>
                                <a class="btn btn-primary" href="@Url.Page("Create")?userId={{x.userId}}">
                                    เลือกและกรอกข้อมูล
                                </a>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<script>
    app.controller('ManageCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.page = 1
        $scope.row = 10;

        $scope.ExistsIdcard = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Onboard/ExistsByIDCard'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    idcard: $scope.iPersonal.idcard
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lData = result;

                        if($scope.lData.length == 0){
                            alertWarning("Search Data", "ไม่พบข้อมูล");
                        }
                    }, 0);
                }
                , error: AjaxError
            });
        }
    });
</script>