@page
@model EmpHub.Pages.Onboarding.IndexModel
@{
    ViewData["Title"] = "Onboarding";
    var token = User.AccessToken(HttpContext);
}
<style>
    .bg-Draft{
        background-color: var(--bs-gray-200);
        color: var(--bs-gray-800);
    }

    .bg-Complete {
        background-color: var(--bs-green);
        color: var(--bs-white);
    }
</style>
@section PageHeader {
    <!-- [ page-header ] start -->
    <div class="page-header">
        <div class="page-header-left d-flex align-items-center">
            <div class="page-header-title">
                <h5 class="m-b-10">พนักงาน</h5>
            </div>
            <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Page("/Index")">หน้าแรก</a></li>
                <li class="breadcrumb-item">พนักงานเข้าใหม่</li>
            </ul>
        </div>
    </div>
}

<div ng-controller="ManageCtrl">
    <div class="d-flex mb-2">
        <div class="fs-4 me-3">พนักงานเข้าใหม่</div>
        <div class="overflow-auto flex-fill">
            <div class="flex-fill d-flex flex-nowrap align-items-center">
                <div class="btn btn-link text-nowrap {{ status == '' ? 'active' : '' }}" ng-click="SelectStatus('')">
                    ทั้งหมด <span class="badge ms-1" ng-show="sum_all > 0">{{ sum_all | number }}</span>
                </div> |
                <div class="btn btn-link border-0 text-nowrap {{ status == 'Draft' ? 'active' : '' }}" ng-click="SelectStatus('Draft')">
                    แบบร่าง <span class="badge ms-1" ng-show="sum_request > 0">{{ sum_request | number }}</span>
                </div>
                <div class="btn btn-link border-0 text-nowrap {{ status == 'Complete' ? 'active' : '' }}" ng-click="SelectStatus('Complete')">
                    <span ng-show="alert_complete > 0" class="ms-1 badge rounded-circle bg-danger p-1">
                        <span class="visually-hidden">unread messages</span>
                    </span>
                    สำเร็จ <span class="badge ms-1" ng-show="sum_complete > 0">{{ sum_complete | number }}</span>
                </div>
            </div>
        </div>
        <div class="d-none d-sm-block">
            <a class="btn btn-primary" href="@Url.Page("Check")">
                <i class="fas fa-plus me-2"></i> สร้าง
            </a>
        </div>
    </div>
    <div class="rounded-4 p-3 bg-white shadow-sm border d-flex mb-4 align-items-end">
        <div class="me-2">
            <small>รหัสพนักงาน</small>
            <input class="form-control form-control-sm me-2" ng-model="employeeCode" my-enter="LoadData()" style="width:300px;" />
        </div>
        <div class="me-2">
            <small>ชื่อ - สกุล</small>
            <input class="form-control form-control-sm me-2" ng-model="search" my-enter="LoadData()" style="width:300px;" />
        </div>
        <div class="me-2">
            <button ng-click="LoadData()" class="btn btn-light shadow-sm" title="Search">
                <i class="fas fa-search"></i>
            </button>
        </div>
        <div class="me-2">
            <button ng-click="Download()" class="btn btn-light shadow-sm" title="Download" ng-disabled="total == 0">
                <i class="fas fa-arrow-down"></i>
            </button>
        </div>
        <div class="flex-fill">
        </div>
    </div>
    <div class="mb-4">
        <table class="table table-tip border shadow-sm">
            <thead>
                <tr>
                    <th>ชื่อ-สกุล</th>
                    <th>ชื่อเล่น</th>
                    <th>สังกัด</th>
                    <th>สาย</th>
                    <th>ฝ่าย</th>
                    <th>เมล</th>
                    <th>วันที่สร้าง</th>
                    <th class="text-center">สถานะ</th>
                    <th width="120"></th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="x in lData">
                    <td class="text-dark align-middle">
                        {{ x.prefix_th + ' ' + x.firstname_th + ' ' + x.lastname_th }}
                    </td>
                    <td class="text-dark align-middle">
                        {{ x.nickname }}
                    </td>
                    <td class="text-dark align-middle">
                        {{ x.function }}
                    </td>
                    <td class="text-dark align-middle">
                        {{ x.division }}
                    </td>
                    <td class="text-dark align-middle">
                        {{ x.department }}
                    </td>
                    <td class="text-dark align-middle">
                        {{ x.email }}
                    </td>
                    <td>
                    @*     <div class="fw-bolder text-dark">{{ x.create_by }}</div> *@
                        <div class="text-dark">{{ x.create_date }}</div>
                    </td>
                    <td class="text-center align-middle">
                        <div class="badge bg-{{ x.status }}">
                            {{ x.status }}
                        </div>
                    </td>
                    <td class="align-middle text-end">
                        <div class="d-flex">
                            <a href="#" class="btn btn-circle me-1" ng-click="Edit(x)" ng-show="x.status == 'Draft'">
                                <i class="bi bi-pen"></i>
                            </a>
                            <a href="#" class="btn btn-circle" ng-click="Delete(x)" ng-show="x.status == 'Draft'">
                                <i class="bi bi-trash"></i>
                            </a>
                            <a href="#" class="btn btn-circle" ng-click="Detail(x)" ng-show="x.status == 'Complete'">
                                <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            </tbody>
            <tfoot>
                <tr>
                    <td>
                        <div class="text-light-gray">Showing {{ ((page - 1) * row) + 1 }} to {{ (page * row) > total ? total : page * row }} of {{ total }} employees</div>
                    </td>
                    <td colspan="8">
                        <div class="d-flex">
                            <div class="flex-fill"></div>
                            <button class="btn btn-circle me-2" ng-click="LoadData(page - 1)" ng-disabled="page <= 1">
                                <i class="fas fa-chevron-left"></i>
                            </button>
                            <button class="btn btn-circle" ng-click="LoadData(page + 1)" ng-disabled="page * row >= total">
                                <i class="fas fa-chevron-right"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
<script>
    app.controller('ManageCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.page = 1
        $scope.row = 10;
        $scope.status = '';

        $scope.LoadSummary = function(){
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Onboard/Summary'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    userId: '@User.UserId()'
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.sum_request = 0;
                        $scope.sum_complete = 0;
                        
                        $scope.alert_complete = 0;

                        var find = result.find(x => x.status == 'Draft');
                        if (find) { 
                            $scope.sum_request = find.total; 
                            $scope.alert_request = find.alert_total; 
                        }
                        find = result.find(x => x.status == 'Complete');
                        if (find) { 
                            $scope.sum_complete = find.total; 
                            $scope.alert_complete = find.alert_total; 
                        }

                        $scope.sum_all = $scope.sum_request
                            + $scope.sum_complete;
                    }, 0);
                }
                , error: AjaxError
            });
        }
        $scope.LoadSummary();

        $scope.LoadData = function (page = 1) {
            $scope.page = page;

            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Onboard/DataList'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    page: $scope.page
                    , row: $scope.row
                    , employeeCode: $scope.employeeCode
                    , firstname_th: $scope.search
                    , status: $scope.status
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lData = result.data;
                        $scope.total = result.total;
                    }, 0);
                }
                , error: AjaxError
            });
        }
        $scope.LoadData();

        $scope.SelectStatus = function (status) {
            $scope.status = status;
            $scope.LoadData();
        }

        $scope.Edit = function(x){
            window.open('@Url.Page("Update")?userId=' + x.userId);
        }

        $scope.Detail = function (x) {
            window.open('@Url.Page("Detail")?userId=' + x.userId);
        }

        $scope.Delete = function (x) {
            alertConfirm("ลบช้อมูลแบบร่าง", "ยืนยันการลบข้อมูลแบบร่าง", function () {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/Onboard/Cancel'
                    , headers: { 'authorization': 'Bearer @token' }
                    , type: 'post'
                    , contentType: 'application/json'
                    , cache: false
                    , data: JSON.stringify({
                        userId: x.userId
                        , update_by: '@User.UserId()'
                    })
                    , success: function () {
                        $timeout(function () {
                            $scope.LoadData();
                        }, 0);
                    }
                    , error: AjaxError
                });
            });
        }

        $scope.Download = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Onboard/DataList',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    page: 1
                    , row: 2000
                    , employeeCode: $scope.employeeCode
                    , firstname: $scope.search
                    , status: $scope.status
                }),
                success: function (result) {
                    $timeout(function () {
                        var lData = result.data;

                        if (lData.length > 0) {
                            var JSData = [[
                                { 'text': 'ชื่อ - สกุล' }
                                , { 'text': 'ชื่อเล่น' }
                                , { 'text': 'สังกัด' }
                                , { 'text': 'สาย' }
                                , { 'text': 'ฝ่าย' }
                                , { 'text': 'เมล' }
                                , { 'text': 'วันที่สร้าง' }
                                , { 'text': 'สถานะ' }
                            ]];

                            for (var i = 0; i < lData.length; i++) {
                                var iData = lData[i];

                                JSData.splice(JSData.length, 0, [
                                    { 'text': iData.prefix_th + ' ' + iData.firstname_th + ' ' + iData.lastname_th }
                                    , { 'text': iData.nickname }
                                    , { 'text': iData.function }
                                    , { 'text': iData.division }
                                    , { 'text': iData.department }
                                    , { 'text': iData.email }
                                    , { 'text': iData.create_date }
                                    , { 'text': iData.status }
                                ]);
                            }

                            var dt = new Date().toISOString().slice(0, 10).replace(/-/g, "");
                            ExportFile(JSData, 'ข้อมูลพนักงานเข้าใหม่_' + dt);
                        }
                    }, 0);
                },
                error: AjaxError
            });
        }
    });
</script>