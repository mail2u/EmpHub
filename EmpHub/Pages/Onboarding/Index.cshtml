@page
@model EmpHub.Pages.Onboarding.IndexModel
@{
    ViewData["Title"] = "Onboarding";
    var token = User.AccessToken(HttpContext);
}

@section PageHeader {
    <!-- [ page-header ] start -->
    <div class="page-header">
        <div class="page-header-left d-flex align-items-center">
            <div class="page-header-title">
                <h5 class="m-b-10">Onboarding</h5>
            </div>
            <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Page("/Index")">Home</a></li>
                <li class="breadcrumb-item">Onboarding</li>
            </ul>
        </div>
    </div>
}

<div ng-controller="ManageCtrl" class="p-2">
    <div class="d-flex">
        <div class="mb-2 me-2">
            <div class="fs-4">Onboarding</div>
        </div>
    </div>
    <div class="rounded-4 border shadow-sm p-3 bg-white">
        <div class="mb-3 d-flex align-items-center">
            <div class="position-relative me-2">
                <input class="form-control form-control-sm me-2" ng-model="search" my-enter="LoadData()" />
                <span class="position-absolute top-50 end-0 translate-middle-y me-3">
                    <i class="fas fa-search"></i>
                </span>
            </div>
            <div>
                <a class="btn btn-light" href="@Url.Page("Create")">
                    <i class="fas fa-user-plus me-2"></i> Create
                </a>
            </div>
            <div class="flex-fill">
            </div>
            <div>
                <div class="btn btn-light border-0">
                    <i class="far fa-arrow-alt-circle-down me-2"></i> download
                </div>
            </div>
        </div>
        <hr class="m-1" />
        <table class="table">
            <tbody>
                <tr ng-repeat="x in lData">
                    <td>
                        <div class="me-3" style="width:40px; min-width:40px;">
                            <img src="~/Images/icon-user.png" class="rounded-circle" width="100%" />
                        </div>
                    </td>
                    <td>
                        <div class="text-secondary">{{ x.firstname + ' ' + x.lastname }}</div>
                    </td>
                    <td>
                        <div class="text-secondary">{{ x.positionDesc }} {{ x.departmentDesc }}</div>
                        <div>{{ x.email != '' ? x.email : '-'}}</div>
                    </td>
                    <td>
                        <span class="badge bg-info">{{ x.status }}</span>
                    </td>
                    <td>
                        join date
                    </td>
                    <td width="50">
                        <div class="btn btn-circle" ng-click="Edit(x)">
                            <i class="bi bi-pen-fill"></i>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
<script>
    app.controller('ManageCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.page = 1
        $scope.row = 10;

        $scope.LoadData = function (page = 1) {
            $scope.page = page;

            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Onboard/DataList'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    page: $scope.page
                    , row: $scope.row
                    , firstname: $scope.search
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lData = result.data;
                        $scope.total = result.total;
                    }, 0);
                }
                , error: AjaxError
            });
        }
        $scope.LoadData();

        $scope.Edit = function(x){
            window.open('@Url.Page("Update")?userId=' + x.userId);
        }

        $scope.Download = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/FullList',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    page: $scope.page
                    , row: 2000
                    , firstname: $scope.subject
                }),
                success: function (result) {
                    $timeout(function () {
                        var lData = result.data;

                        if (lData.length > 0) {
                            var JSData = [[
                                { 'text': 'Username' }
                                , { 'text': 'Fullname' }
                                , { 'text': 'ชื่อ - สกุล' }
                                , { 'text': 'E-mail' }
                                , { 'text': 'ประเภท' }
                                , { 'text': 'วันที่สร้าง' }
                            ]];

                            for (var i = 0; i < lData.length; i++) {
                                var iData = lData[i];

                                JSData.splice(JSData.length, 0, [
                                    { 'text': iData.serviceNo }
                                    , { 'text': iData.categoryDesc }
                                    , { 'text': iData.subCategoryDesc }
                                    , { 'text': iData.title }
                                    , { 'text': iData.status }
                                    , { 'text': iData.createName }
                                    , { 'text': iData.createDate }
                                ]);
                            }

                            var dt = new Date().toISOString().slice(0, 10).replace(/-/g, "");
                            ExportFile(JSData, 'รายงานฝ่าย_' + dt);
                        }
                    }, 0);
                },
                error: AjaxError
            });
        }
    });
</script>