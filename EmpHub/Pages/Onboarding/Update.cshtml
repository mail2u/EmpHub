@page
@model EmpHub.Pages.Onboarding.UpdateModel
@{
    ViewData["Title"] = "Onboarding";
    var token = User.AccessToken(HttpContext);
}
@section PageHeader {
    <!-- [ page-header ] start -->
    <div class="page-header">
        <div class="page-header-left d-flex align-items-center">
            <div class="page-header-title">
                <h5 class="m-b-10">Onboarding</h5>
            </div>
            <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Page("/Index")">Home</a></li>
                <li class="breadcrumb-item"><a href="@Url.Page("Index")">Onboarding</a></li>
                <li class="breadcrumb-item">Update</li>
            </ul>
        </div>
    </div>
}
<div ng-controller="ManageCtrl" class="p-2">

    <div class="rounded-4 border shadow-sm p-3 bg-white text-dark mb-3">
        <div class="fs-4 fw-bolder">
            Search Existing Employee
        </div>
        <div class="row">
            <div class="col-sm-3">
                <div>เลขประจำตัวประชาชน</div>
                <input ng-model="iData.idcard" class="form-control" maxlength="13" />
            </div>
        </div>
    </div>
    <partial name="_PartialOnboard" />
    <div class="text-end mt-2">
        <button class="btn btn-primary" ng-click="Save()">
            <i class="far fa-paper-plane me-2"></i> Save Change
        </button>
    </div>
</div>
<script>
    app.controller('ManageCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.page = 1
        $scope.row = 10;
        $scope.userId = '@Model.userId';

        $scope.lProcessType = [
            { key: 'เข้าใหม่', value: 'new' }
            , { key: 'กลับเข้าใหม่', value: 'comeback' }
            , { key: 'reinstatement', value: 'reinstatement' }
        ];
        $scope.lSex = [
            { key: 'ชาย', value: 'M' }
            , { key: 'หญิง', value: 'F' }
        ];

        $scope.iPersonal = {};
        $scope.iEmployee = {};
        $scope.iAddress = {};

        $scope.LoadInit = function(){
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/MasterCode/DataList'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    groupName: 'departmentCode'
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lDepartment = result;
                    }, 0);
                }
                , error: AjaxError
            });
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/MasterCode/DataList'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    groupName: 'positionCode'
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lPosition = result;
                    }, 0);
                }
                , error: AjaxError
            });
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/MasterCode/DataList'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    groupName: 'Disability'
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lDisability = result;
                    }, 0);
                }
                , error: AjaxError
            });
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/MasterCode/DataList'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    groupName: 'Ethnicity'
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lEthnicity = result;
                    }, 0);
                }
                , error: AjaxError
            });
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/MasterCode/DataList'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    groupName: 'Marital'
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lMarital = result;
                    }, 0);
                }
                , error: AjaxError
            });
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/MasterCode/DataList'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    groupName: 'Military'
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lMilitary = result;
                    }, 0);
                }
                , error: AjaxError
            });
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/MasterCode/DataList'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    groupName: 'Nationality'
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lNationality = result;
                    }, 0);
                }
                , error: AjaxError
            });
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/MasterCode/DataList'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    groupName: 'Religion'
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lReligion = result;
                    }, 0);
                }
                , error: AjaxError
            });
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/MasterCode/DataList'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    groupName: 'Prefix'
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lPrefix = result;
                    }, 0);
                }
                , error: AjaxError
            });
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/MasterCode/DataList'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    groupName: 'WorkMode'
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lWorkMode = result;
                    }, 0);
                }
                , error: AjaxError
            });
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/MasterCode/DataList'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    groupName: 'OTMode'
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lOTMode = result;
                    }, 0);
                }
                , error: AjaxError
            });
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/MasterCode/Address'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , dataType: 'json'
                , cache: false
                , success: function (result) {
                    $timeout(function () {
                        $scope.lAddress = result;
                    }, 0);
                }
                , error: AjaxError
            });
        }
        $scope.LoadInit();

        $scope.LoadData = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/UserPersonal'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    userId: $scope.userId
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.iPersonal = result.data;

                        if ($scope.iPersonal.birth_date) {
                            $scope.iPersonal.birth_date_select = moment($scope.iPersonal.birth_date, "DD/MM/YYYY");
                        }
                    }, 0);
                }
                , error: AjaxError
            });
            
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/UserAddress'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    userId: $scope.userId
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.iAddress = result.data;
                    }, 0);
                }
                , error: AjaxError
            });

            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/UserEmployee'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    userId: $scope.userId
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.iEmployee = result.data;

                        if ($scope.iEmployee.join_date) {
                            $scope.iEmployee.join_date_select = moment($scope.iEmployee.join_date, "DD/MM/YYYY");
                        }
                        if ($scope.iEmployee.probation_end_date) {
                            $scope.iEmployee.probation_end_date_select = moment($scope.iEmployee.probation_end_date, "DD/MM/YYYY");
                        }
                    }, 0);
                }
                , error: AjaxError
            });
        }
        $scope.LoadData();

        $scope.ShowAddress = function (type) {
            $scope.address_type = type;
            $("#addressModal").modal('show');
        }

        $scope.SelectAddress = function (x) {
            $timeout(function () {
                console.log($scope.address_type);
                if ($scope.address_type == 'registered') {
                    $scope.iAddress.registered_subDistrictCode = x.subDistrictCode;
                    $scope.iAddress.registered_subDistrictName = x.subDistrictName;
                    $scope.iAddress.registered_districtCode = x.districtCode;
                    $scope.iAddress.registered_districtName = x.districtName;
                    $scope.iAddress.registered_provinceCode = x.provinceCode;
                    $scope.iAddress.registered_provinceName = x.provinceName;
                    $scope.iAddress.registered_postcode = x.postcode;
                } else if ($scope.address_type == 'card') {
                    $scope.iAddress.card_subDistrictCode = x.subDistrictCode;
                    $scope.iAddress.card_subDistrictName = x.subDistrictName;
                    $scope.iAddress.card_districtCode = x.districtCode;
                    $scope.iAddress.card_districtName = x.districtName;
                    $scope.iAddress.card_provinceCode = x.provinceCode;
                    $scope.iAddress.card_provinceName = x.provinceName;
                    $scope.iAddress.card_postcode = x.postcode;
                } else if ($scope.address_type == 'live') {
                    $scope.iAddress.live_subDistrictCode = x.subDistrictCode;
                    $scope.iAddress.live_subDistrictName = x.subDistrictName;
                    $scope.iAddress.live_districtCode = x.districtCode;
                    $scope.iAddress.live_districtName = x.districtName;
                    $scope.iAddress.live_provinceCode = x.provinceCode;
                    $scope.iAddress.live_provinceName = x.provinceName;
                    $scope.iAddress.live_postcode = x.postcode;
                }
                $("#addressModal").modal('hide');
            }, 0);
        }

        $scope.CalcAge = function(){
            $scope.iPersonal.age = '';

            if ($scope.iPersonal.birth_date_select) {
                const b = new Date($scope.iPersonal.birth_date_select);
                const c = new Date();

                let years = c.getFullYear() - b.getFullYear();
                let months = c.getMonth() - b.getMonth();
                let days = c.getDate() - b.getDate();

                // ถ้าวันติดลบ → ยืมเดือน
                if (days < 0) {
                    months--;

                    // เอาจำนวนวันของเดือนก่อนหน้า
                    const prevMonth = new Date(c.getFullYear(), c.getMonth(), 0);
                    days += prevMonth.getDate();
                }

                // ถ้าเดือนติดลบ → ยืมปี
                if (months < 0) {
                    years--;
                    months += 12;
                }

                if (years > 0) {
                    $scope.iPersonal.age = years + ' ปี ';
                }
                if (months > 0) {
                    $scope.iPersonal.age += months + ' เดือน ';
                }
                if (days > 0) {
                    $scope.iPersonal.age += days + ' วัน';
                }
            }
        }

        $scope.calcProbationDay = function(){
            $scope.iEmployee.probation_day = 0;

            if ($scope.iEmployee.join_date_select && $scope.iEmployee.probation_end_date_select) {
                const startStr = $scope.iEmployee.join_date_select.format("DD/MM/YYYY");
                const endStr = $scope.iEmployee.probation_end_date_select.format("DD/MM/YYYY");
                const start = ConvertToDate(startStr);
                const end = ConvertToDate(endStr);
                const diffTime = end - start;

                $scope.iEmployee.probation_day = parseInt(diffTime / (1000 * 60 * 60 * 24)) + 1;
            }
        }

        $scope.SelectWorkMode = function(){
            $scope.iEmployee.workTime = '';

            if ($scope.iEmployee.workMode) {
                var find = $scope.lWorkMode.find(item => item.code == $scope.iEmployee.workMode);
                if(find){
                    $scope.iEmployee.workTime = find.condition_1 + '-' + find.condition_2;
                }
            }
        }

        $scope.ShowSupervisor = function(){
            if (!$scope.lEmployee) {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/User/DataList'
                    , headers: { 'authorization': 'Bearer @token' }
                    , type: 'post'
                    , contentType: 'application/json'
                    , dataType: 'json'
                    , cache: false
                    , data: JSON.stringify({
                        page: 1
                        , row: 999
                    })
                    , success: function (result) {
                        $timeout(function () {
                            $scope.lEmployee = result.data;
                            $("#supervisorModal").modal('show');
                        }, 0);
                    }
                    , error: AjaxError
                });
            } else {
                $("#supervisorModal").modal('show');
            }
        }

        $scope.SelectSupervisor = function(x){
            $scope.iEmployee.supervisorId = x.userId;
            $scope.iEmployee.supervisorName = x.firstname_th + ' ' + x.lastname_th;
        }

        $scope.Save = async function () {
            $scope.iPersonal.create_by = '@User.UserId()';

            var flag = await $scope.SavePersonal();
            flag = await $scope.SaveEmployee();
            flag = await $scope.SaveAddress();

            if(flag){
                alertSuccess("Save Change", "Success");
            }
        }

        $scope.SavePersonal = function () {
            if ($scope.iPersonal.birth_date_select) {
                $scope.iPersonal.birth_date = $scope.iPersonal.birth_date_select.format("DD/MM/YYYY");
            }

            return new Promise((resolve) => {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/User/UserPersonalSave'
                    , headers: { 'authorization': 'Bearer @token' }
                    , type: 'post'
                    , contentType: 'application/json'
                    , cache: false
                    , data: JSON.stringify($scope.iPersonal)
                    , success: function () {
                        $timeout(function () {
                            resolve(true);
                        }, 0);
                    }
                    , error: function () {
                        alertWarning("Save Data Personal", "Error");
                        resolve(false);
                    }
                });
            });
        }

        $scope.SaveEmployee = function () {
            if ($scope.iEmployee.join_date_select){
                $scope.iEmployee.join_date = $scope.iEmployee.join_date_select.format("DD/MM/YYYY");
            }
            if ($scope.iEmployee.probation_end_date_select) {
                $scope.iEmployee.probation_end_date = $scope.iEmployee.probation_end_date_select.format("DD/MM/YYYY");
            }

            return new Promise((resolve) => {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/User/UserEmployeeSave'
                    , headers: { 'authorization': 'Bearer @token' }
                    , type: 'post'
                    , contentType: 'application/json'
                    , cache: false
                    , data: JSON.stringify($scope.iEmployee)
                    , success: function () {
                        $timeout(function () {
                            resolve(true);
                        }, 0);
                    }
                    , error: function () {
                        alertWarning("Save Data Employee", "Error");
                        resolve(false);
                    }
                });
            });
        }

        $scope.SaveAddress = function () {
            return new Promise((resolve) => {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/User/UserAddressSave'
                    , headers: { 'authorization': 'Bearer @token' }
                    , type: 'post'
                    , contentType: 'application/json'
                    , cache: false
                    , data: JSON.stringify($scope.iAddress)
                    , success: function () {
                        $timeout(function () {
                            resolve(true);
                        }, 0);
                    }
                    , error: function () {
                        alertWarning("Save Data Address", "Error");
                        resolve(false);
                    }
                });
            });
        }

        $scope.ShowEdit = function (x) {
            $scope.iData = x;
            $("#DetailModal").modal('show');
        }

        $scope.Update = function () {
            $scope.iData.update_by = '@User.UserId()';
            $("#DetailModal").modal('hide');

            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/Update'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , cache: false
                , data: JSON.stringify($scope.iData)
                , success: function () {
                    $timeout(function () {
                        $scope.LoadData($scope.page);
                    }, 0);
                }
                , error: AjaxError
            });
        }

        $scope.Delete = function(x){
            alertConfirm('ยืนยันการทำรายการ', 'ท่านต้องการลบข้อมูลผู้ใช้งานนี้', function () {
                x.update_by = '@User.UserId()';
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/User/Delete'
                    , headers: { 'authorization': 'Bearer @token' }
                    , type: 'post'
                    , contentType: 'application/json'
                    , cache: false
                    , data: JSON.stringify(x)
                    , success: function () {
                        $timeout(function () {
                            $scope.LoadData($scope.page);
                        }, 0);
                    }
                    , error: AjaxError
                });
            });
        }

        $scope.ShowChangePass = function (x) {
            $scope.iData = x;
            $("#ChangePassModal").modal('show');
        }

        $scope.ChangePass = function () {
            $scope.iData.update_by = '@User.UserId()';
            $("#ChangePassModal").modal('hide');

            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/ChangePassword'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , cache: false
                , data: JSON.stringify($scope.iData)
                , success: function () {
                    $timeout(function () {
                        $scope.LoadData($scope.page);
                    }, 0);
                }
                , error: AjaxError
            });
        }
    });
</script>