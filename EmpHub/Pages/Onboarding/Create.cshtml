        function GetPickerDateValue(value) {
            if (!value) {
                return null;
            }
            if (moment.isMoment(value)) {
                return value.isValid() ? value.toDate() : null;
            }
            if (value instanceof Date) {
                return isNaN(value.getTime()) ? null : value;
            }
            if (typeof value === 'string') {
                var text = value.trim();

                if (!text) {
                    return null;
                }

                var parsed = moment(text, "DD/MM/YYYY", true);
                if (parsed.isValid()) {
                    return parsed.toDate();
                }

                var fallback = new Date(text);
                return isNaN(fallback.getTime()) ? null : fallback;
            }

            var parsedValue = moment(value);
            return parsedValue.isValid() ? parsedValue.toDate() : null;
        }

        function FormatPickerDate(value) {
            var date = GetPickerDateValue(value);
            return date ? moment(date).format("DD/MM/YYYY") : '';
        }

        function GetBirthDateValue() {
            return GetPickerDateValue($scope.iPersonal.birth_date_select);
        }

        $scope.CalcAge = function () {
            $scope.iPersonal.age = '';

            var b = GetBirthDateValue();

            if (b) {
                const c = new Date();
                b.setHours(0, 0, 0, 0);
                c.setHours(0, 0, 0, 0);

                if (b > c) {
                    return;
                }

                let years = c.getFullYear() - b.getFullYear();
                let months = c.getMonth() - b.getMonth();
                let days = c.getDate() - b.getDate();

                // ถ้าวันติดลบ → ยืมเดือน
                if (days < 0) {
                    months--;

                    // เอาจำนวนวันของเดือนก่อนหน้า
                    const prevMonth = new Date(c.getFullYear(), c.getMonth(), 0);
                    days += prevMonth.getDate();
                }

                // ถ้าเดือนติดลบ → ยืมปี
                if (months < 0) {
                    years--;
                    months += 12;
                }

                if (years > 0) {
                    $scope.iPersonal.age = years + ' ปี ';
                }
                if (months > 0) {
                    $scope.iPersonal.age += months + ' เดือน ';
                }
                if (days > 0) {
                    $scope.iPersonal.age += days + ' วัน';
                }
                if ($scope.iPersonal.age == '') {
                    $scope.iPersonal.age = '0 วัน';
                }
            }
        }

        $scope.$watch('iPersonal.birth_date_select', function (newValue, oldValue) {
            if (newValue !== oldValue) {
                $scope.CalcAge();
            }
        });

        function isFullDateTime(value) {
    if (!value) return false;

    // DD/MM/YYYY HH:mm = 16 ตัวอักษร เช่น 22/06/2026 14:30
    if (value.length !== 16) return false;

    // เช็คว่าครบหลักจริง
    var regex = /^\d{2}\/\d{2}\/\d{4} \d{2}:\d{2}$/;
    if (!regex.test(value)) return false;

    // เช็ควันที่จริง เช่น 31/02/2026 ต้องไม่ผ่าน
    return moment(value, 'DD/MM/YYYY HH:mm', true).isValid();
}

        $scope.calcProbationDay = function () {
            $scope.iEmployee.probation_day = 0;

            var startStr = FormatPickerDate($scope.iEmployee.join_date_select);
            var endStr = FormatPickerDate($scope.iEmployee.probation_end_date_select);

            if (startStr && endStr) {
                const start = ConvertToDate(startStr);
                const end = ConvertToDate(endStr);
                const diffTime = end - start;

                $scope.iEmployee.probation_day = parseInt(diffTime / (1000 * 60 * 60 * 24)) + 1;
            }
        }

        // เลือก/พิมพ์จำนวนวัน (หรือเปลี่ยนวันเข้างาน) แล้วคำนวณวันผ่านทดลองงานให้
        // บวก day - 1 เพราะ calcProbationDay นับวันเข้างานเป็นวันที่ 1 ค่าจึงกลับไปกลับมาได้ตรงกัน
        $scope.calcProbationDate = function () {
            var day = parseInt($scope.iEmployee.probation_day);

            var startStr = FormatPickerDate($scope.iEmployee.join_date_select);

            if (!startStr || !day || day < 1) {
                return;
            }

            var start = ConvertToDate(startStr);

            $scope.iEmployee.probation_end_date_select = new moment(start.addDays(day - 1));
        }

        $scope.SelectWorkMode = function () {
            $scope.iEmployee.workTime = '';

            if ($scope.iEmployee.workMode) {
                var find = $scope.lWorkMode.find(item => item.code == $scope.iEmployee.workMode);
                if (find) {
                    $scope.iEmployee.workTime = find.condition_1 + '-' + find.condition_2;
                }
            }
        }

        $scope.ShowSupervisor = function () {
            $scope.filter_name = '';
            if (!$scope.lEmployee) {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/User/DataList'
                    , headers: { 'authorization': 'Bearer @token' }
                    , type: 'post'
                    , contentType: 'application/json'
                    , dataType: 'json'
                    , cache: false
                    , data: JSON.stringify({
                        page: 1
                        , row: 999
                    })
                    , success: function (result) {
                        $timeout(function () {
                            $scope.lEmployee = result.data;
                            $("#supervisorModal").modal('show');
                        }, 0);
                    }
                    , error: AjaxError
                });
            } else {
                $("#supervisorModal").modal('show');
            }
        }

        $scope.SelectSupervisor = function (x) {
            $("#supervisorModal").modal('hide');
            $scope.iEmployee.supervisorId = x.userId;
            $scope.iEmployee.supervisorName = x.firstname_th + ' ' + x.lastname_th;
        }

        $scope.SelectCardAddressUserRegistered = function () {
            $scope.iAddress.card_home = $scope.is_card_same_register ? $scope.iAddress.registered_home : '';
            $scope.iAddress.card_road = $scope.is_card_same_register ? $scope.iAddress.registered_road : '';
            $scope.iAddress.card_subDistrictCode = $scope.is_card_same_register ? $scope.iAddress.registered_subDistrictCode : '';
            $scope.iAddress.card_subDistrictName = $scope.is_card_same_register ? $scope.iAddress.registered_subDistrictName : '';
            $scope.iAddress.card_districtCode = $scope.is_card_same_register ? $scope.iAddress.registered_districtCode : '';
            $scope.iAddress.card_districtName = $scope.is_card_same_register ? $scope.iAddress.registered_districtName : '';
            $scope.iAddress.card_provinceCode = $scope.is_card_same_register ? $scope.iAddress.registered_provinceCode : '';
            $scope.iAddress.card_provinceName = $scope.is_card_same_register ? $scope.iAddress.registered_provinceName : '';
            $scope.iAddress.card_postcode = $scope.is_card_same_register ? $scope.iAddress.registered_postcode : '';
        }

        $scope.SelectLiveAddressUserRegistered = function () {
            $scope.iAddress.live_home = $scope.is_live_same_register ? $scope.iAddress.registered_home : '';
            $scope.iAddress.live_road = $scope.is_live_same_register ? $scope.iAddress.registered_road : '';
            $scope.iAddress.live_subDistrictCode = $scope.is_live_same_register ? $scope.iAddress.registered_subDistrictCode : '';
            $scope.iAddress.live_subDistrictName = $scope.is_live_same_register ? $scope.iAddress.registered_subDistrictName : '';
            $scope.iAddress.live_districtCode = $scope.is_live_same_register ? $scope.iAddress.registered_districtCode : '';
            $scope.iAddress.live_districtName = $scope.is_live_same_register ? $scope.iAddress.registered_districtName : '';
            $scope.iAddress.live_provinceCode = $scope.is_live_same_register ? $scope.iAddress.registered_provinceCode : '';
            $scope.iAddress.live_provinceName = $scope.is_live_same_register ? $scope.iAddress.registered_provinceName : '';
            $scope.iAddress.live_postcode = $scope.is_live_same_register ? $scope.iAddress.registered_postcode : '';
        }

        $scope.CreateOnboard = function () {
            return new Promise((resolve) => {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/Onboard/Create'
                    , headers: { 'authorization': 'Bearer @token' }
                    , type: 'post'
                    , contentType: 'application/json'
                    , dataType: 'json'
                    , cache: false
                    , data: JSON.stringify({
                        create_by: '@User.UserId()'
                    })
                    , success: function (result) {
                        $timeout(function () {
                            resolve(result);
                        }, 0);
                    }
                    , error: function () {
                        alertWarning("Save Onboard", "Error");
                        resolve(null);
                    }
                });
            });
        }

        $scope.SavePersonal = function () {

            $scope.iPersonal.birth_date = FormatPickerDate($scope.iPersonal.birth_date_select);

            // แทนรหัส OTHER ด้วยชื่อที่พิมพ์เอง โดยไม่แก้ $scope.iPersonal เพื่อไม่ให้ dropdown เพี้ยนหลังบันทึก
            var iSave = angular.extend({}, $scope.iPersonal);

            if (iSave.nationality == MASTER_OTHER) {
                iSave.nationality = ($scope.nationality_other || '').trim();
            }
            if (iSave.prefix_th == MASTER_OTHER) {
                iSave.prefix_th = ($scope.prefix_th_other || '').trim();
            }
            if (iSave.prefix_en == MASTER_OTHER) {
                iSave.prefix_en = ($scope.prefix_en_other || '').trim();
            }

            // เก็บเลขบัตรได้แม้ master ไม่ได้ตั้งเป็น required; ล้างเฉพาะกรณียังไม่เลือกสถานะความพิการ
            if (!iSave.disabilityStatus) {
                iSave.disabilityCardNo = '';
            }

            return new Promise((resolve) => {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/User/UserPersonalSave'
                    , headers: { 'authorization': 'Bearer @token' }
                    , type: 'post'
                    , contentType: 'application/json'
                    , cache: false
                    , data: JSON.stringify(iSave)
                    , success: function () {
                        $timeout(function () {
                            resolve(true);
                        }, 0);
                    }
                    , error: function () {
                        alertWarning("Save Data Personal", "Error");
                        resolve(false);
                    }
                });
            });
        }

        $scope.SaveEmployee = function () {
            $scope.BuildOrgOption();

            // แปลงวันที่ตรงนี้ ไม่ใช่ใน CheckStep4 เพราะปุ่ม "บันทึกการเปลี่ยนแปลง" ไม่ได้เรียก CheckStep4
            // ถ้าไม่ทำ join_date/probation_end_date จะไม่ถูกส่งไปบันทึกเลย
            $scope.iEmployee.join_date = FormatPickerDate($scope.iEmployee.join_date_select);
            $scope.iEmployee.probation_end_date = FormatPickerDate($scope.iEmployee.probation_end_date_select);

            return new Promise((resolve) => {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/User/UserEmployeeSave'
                    , headers: { 'authorization': 'Bearer @token' }
                    , type: 'post'
                    , contentType: 'application/json'
                    , cache: false
                    , data: JSON.stringify($scope.iEmployee)
                    , success: function () {
                        $timeout(function () {
                            resolve(true);
                        }, 0);
                    }
                    , error: function (jqXHR) {
                        alertWarning("Save Data Employee", jqXHR.responseText || "Error");
                        resolve(false);
                    }
                });
            });
        }

        $scope.SaveAddress = function () {
            return new Promise((resolve) => {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/User/UserAddressSave'
                    , headers: { 'authorization': 'Bearer @token' }
                    , type: 'post'
                    , contentType: 'application/json'
                    , cache: false
                    , data: JSON.stringify($scope.iAddress)
                    , success: function () {
                        $timeout(function () {
                            resolve(true);
                        }, 0);
                    }
                    , error: function () {
                        alertWarning("Save Data Address", "Error");
                        resolve(false);
                    }
                });
            });
        }

        $scope.CancelOnboard = function (userId) {
            return new Promise((resolve) => {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/Onboard/Delete'
                    , headers: { 'authorization': 'Bearer @token' }
                    , type: 'post'
                    , contentType: 'application/json'
                    , cache: false
                    , data: JSON.stringify({
                        userId: userId
                        , update_by: '@User.UserId()'
                    })
                    , success: function () {
                        $timeout(function () {
                            resolve(true);
                        }, 0);
                    }
                    , error: function () {
                        alertWarning("Save Onboard", "Error");
                        resolve(false);
                    }
                });
            });
        }

        $scope.SendOnboard = function (userId) {
            return new Promise((resolve) => {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/Onboard/Send'
                    , headers: { 'authorization': 'Bearer @token' }
                    , type: 'post'
                    , contentType: 'application/json'
                    , cache: false
                    , data: JSON.stringify({
                        userId: userId
                        , update_by: '@User.UserId()'
                    })
                    , success: function () {
                        $timeout(function () {
                            resolve(true);
                        }, 0);
                    }
                    , error: function () {
                        alertWarning("Send Onboard", "Error");
                        resolve(false);
                    }
                });
            });
        }

        //Action

        $scope.Save = async function () {
            var iUser = await $scope.CreateOnboard();

            $scope.iPersonal.create_by = '@User.UserId()';
            $scope.iPersonal.userId = iUser.userId;

            var flag = await $scope.SavePersonal();

            if (flag) {
                $scope.iEmployee.create_by = '@User.UserId()';
                $scope.iEmployee.userId = iUser.userId;

                flag = await $scope.SaveEmployee();

                if (flag) {
                    $scope.iAddress.create_by = '@User.UserId()';
                    $scope.iAddress.userId = iUser.userId;

                    flag = await $scope.SaveAddress();
                }
            }

            if (flag) {                
                alertSuccess("Save Onboarding", "Success", function () {
                    location.href = '@Url.Page("Index")';
                });
            } else {
                await $scope.CancelOnboard(iUser.userId);
            }
        }

        function IsBlank(value) {
            return value == undefined || value == null || (typeof value === 'string' && value.trim() == '') || value == '';
        }

        function RequireField(messages, selector, label) {
            messages.push(label);
            JS_Require($(selector));
        }

        function ShowValidateMessages(stepIndex, messages) {
            if (messages.length == 0) {
                return true;
            }

            $scope.step_index = stepIndex;
            alertWarning("Form Validate", "กรุณาตรวจสอบ: " + messages.join(", "));
            return false;
        }

        $scope.CheckStep1 = function (options) {
            options = options || {};
            var messages = [];

            JS_Reset($(".nationality"));
            JS_Reset($(".nationality_other"));
            JS_Reset($(".idcard"));
            JS_Reset($(".prefix_th"));
            JS_Reset($(".prefix_th_other"));

            JS_Reset($(".disabilityCardNo"));
            JS_Reset($(".firstname_th"));
            JS_Reset($(".lastname_th"));
            JS_Reset($(".birth_date"));
            JS_Reset($(".sex"));
            JS_Reset($(".maritalStatus"));

            var birthDateValue = GetBirthDateValue();
            $scope.iPersonal.birth_date = birthDateValue ? moment(birthDateValue).format("DD/MM/YYYY") : '';

            if (IsBlank($scope.iPersonal.idcard)) {
                RequireField(messages, ".idcard", "ข้อมูลส่วนบุคคล > ข้อมูลยืนยันตัวตน > เลขประจำตัวประชาชน");
            }
            if (IsBlank($scope.iPersonal.nationality)) {
                RequireField(messages, ".nationality", "ข้อมูลส่วนบุคคล > ข้อมูลยืนยันตัวตน > สัญชาติ");
            }
            if ($scope.iPersonal.nationality == MASTER_OTHER && IsBlank($scope.nationality_other)) {
                RequireField(messages, ".nationality_other", "ข้อมูลส่วนบุคคล > ข้อมูลยืนยันตัวตน > ระบุสัญชาติ");
            }
            if (IsBlank($scope.iPersonal.prefix_th)) {
                RequireField(messages, ".prefix_th", "ข้อมูลส่วนบุคคล > ชื่อภาษาไทย > คำนำหน้าชื่อ");
            }
            if ($scope.iPersonal.prefix_th == MASTER_OTHER && IsBlank($scope.prefix_th_other)) {
                RequireField(messages, ".prefix_th_other", "ข้อมูลส่วนบุคคล > ชื่อภาษาไทย > ระบุคำนำหน้าชื่อ");
            }
            if ($scope.NeedDisabilityCard() && IsBlank($scope.iPersonal.disabilityCardNo)) {
                RequireField(messages, ".disabilityCardNo", "ข้อมูลส่วนบุคคล > ข้อมูลทั่วไป > เลขบัตรผู้พิการ");
            }
            if (IsBlank($scope.iPersonal.firstname_th)) {
                RequireField(messages, ".firstname_th", "ข้อมูลส่วนบุคคล > ชื่อภาษาไทย > ชื่อ");
            }
            if (IsBlank($scope.iPersonal.lastname_th)) {
                RequireField(messages, ".lastname_th", "ข้อมูลส่วนบุคคล > ชื่อภาษาไทย > นามสกุล");
            }
            if (IsBlank($scope.iPersonal.birth_date)) {
                RequireField(messages, ".birth_date", "ข้อมูลส่วนบุคคล > ข้อมูลทั่วไป > วันเกิด");
            }
            if (IsBlank($scope.iPersonal.sex)) {
                RequireField(messages, ".sex", "ข้อมูลส่วนบุคคล > ข้อมูลทั่วไป > เพศ");
            }
            if (IsBlank($scope.iPersonal.maritalStatus)) {
                RequireField(messages, ".maritalStatus", "ข้อมูลส่วนบุคคล > ข้อมูลทั่วไป > สถานภาพการสมรส");
            }

            if (messages.length == 0) {
                if (!options.skipMove) {
                $scope.step_index = 1;
                }
                return true;
            } else {
                return ShowValidateMessages(0, messages);
            }
        }

        $scope.CheckStep2 = function (options) {
            options = options || {};
            var messages = [];

            JS_Reset($(".registered_home"));
            JS_Reset($(".registered_provinceName"));
            JS_Reset($(".card_home"));
            JS_Reset($(".card_provinceName"));
            JS_Reset($(".live_home"));
            JS_Reset($(".live_provinceName"));


            if (IsBlank($scope.iAddress.registered_home)) {
                RequireField(messages, ".registered_home", "ข้อมูลที่อยู่ > ที่อยู่ทะเบียนบ้าน > บ้านเลขที่");
            }
            if (IsBlank($scope.iAddress.registered_provinceName)) {
                RequireField(messages, ".registered_provinceName", "ข้อมูลที่อยู่ > ที่อยู่ทะเบียนบ้าน > จังหวัด");
            }
            if (IsBlank($scope.iAddress.card_home)) {
                RequireField(messages, ".card_home", "ข้อมูลที่อยู่ > ที่อยู่ตามบัตรประชาชน > บ้านเลขที่");
            }
            if (IsBlank($scope.iAddress.card_provinceName)) {
                RequireField(messages, ".card_provinceName", "ข้อมูลที่อยู่ > ที่อยู่ตามบัตรประชาชน > จังหวัด");
            }
            if (IsBlank($scope.iAddress.live_home)) {
                RequireField(messages, ".live_home", "ข้อมูลที่อยู่ > ที่อยู่พักอาศัย > บ้านเลขที่");
            }
            if (IsBlank($scope.iAddress.live_provinceName)) {
                RequireField(messages, ".live_provinceName", "ข้อมูลที่อยู่ > ที่อยู่พักอาศัย > จังหวัด");
            }

            if (messages.length == 0) {
                if (!options.skipMove) {
                $scope.step_index = 2;
                }
                return true;
            } else {
                return ShowValidateMessages(1, messages);
            }
        }

        $scope.CheckStep3 = function (options) {
            options = options || {};
            var messages = [];

            JS_Reset($(".mobile"));
            JS_Reset($(".email_office"));

            if (IsBlank($scope.iPersonal.mobile)) {
                RequireField(messages, ".mobile", "ข้อมูลการติดต่อ > มือถือ");
            } else if (JS_ValidateMobile($scope.iPersonal.mobile) == false) {
                RequireField(messages, ".mobile", "ข้อมูลการติดต่อ > รูปแบบมือถือไม่ถูกต้อง");
            }
            if (!IsBlank($scope.iEmployee.email) && JS_ValidateEmail($scope.iEmployee.email) == false) {
                RequireField(messages, ".email_office", "ข้อมูลการติดต่อ > รูปแบบอีเมล์ที่ใช้ในบริษัทไม่ถูกต้อง");
            }

            if (messages.length == 0) {
                if (!options.skipMove) {
                $scope.step_index = 3;
                }
                return true;
            } else {
                return ShowValidateMessages(2, messages);
            }
        }

        $scope.CheckStep4 = function () {
            var messages = [];

            JS_Reset($(".employeeCode"));
            JS_Reset($(".join_date"));
            JS_Reset($(".functionCode"));
            JS_Reset($(".divisionCode"));
            JS_Reset($(".departmentCode"));
            JS_Reset($(".sectionCode"));
            JS_Reset($(".positionCode"));
            JS_Reset($(".levelCode"));
            JS_Reset($(".employeeType"));
            JS_Reset($(".employeeMode"));

            $scope.iEmployee.join_date = '';

            $scope.iEmployee.join_date = FormatPickerDate($scope.iEmployee.join_date_select);

            if (IsBlank($scope.iEmployee.employeeCode)) {
                RequireField(messages, ".employeeCode", "ข้อมูลพนักงาน > รหัสพนักงาน");
            }
            if (IsBlank($scope.iEmployee.join_date)) {
                RequireField(messages, ".join_date", "ข้อมูลพนักงาน > วันเข้างาน");
            }
            if (IsBlank($scope.iEmployee.functionCode)) {
                RequireField(messages, ".functionCode", "ข้อมูลพนักงาน > ด้าน");
            }
            if (IsBlank($scope.iEmployee.positionCode)) {
                RequireField(messages, ".positionCode", "ข้อมูลพนักงาน > ตำแหน่งงาน");
            }
            if (IsBlank($scope.iEmployee.employeeType)) {
                RequireField(messages, ".employeeType", "ข้อมูลพนักงาน > ประเภทพนักงาน");
            }
            if (IsBlank($scope.iEmployee.levelCode)) {
                RequireField(messages, ".levelCode", "ข้อมูลพนักงาน > ระดับพนักงาน");
            }
            // if ($scope.iEmployee.employeeMode == '') {
            //     flag = false;
            //     JS_Require($(".employeeMode"));
            // }

            return ShowValidateMessages(3, messages);
        }

        $scope.Send = async function () {
            if ($scope.CheckStep1({ skipMove: true }) && $scope.CheckStep2({ skipMove: true }) && $scope.CheckStep3({ skipMove: true }) && $scope.CheckStep4()) {
                var iUser = await $scope.CreateOnboard();

                $scope.iPersonal.create_by = '@User.UserId()';
                $scope.iPersonal.userId = iUser.userId;

                var flag = await $scope.SavePersonal();

                if (flag) {
                    $scope.iEmployee.create_by = '@User.UserId()';
                    $scope.iEmployee.userId = iUser.userId;

                    flag = await $scope.SaveEmployee();

                    if (flag) {
                        $scope.iAddress.create_by = '@User.UserId()';
                        $scope.iAddress.userId = iUser.userId;

                        flag = await $scope.SaveAddress();
                    }
                }

                flag = await $scope.SendOnboard(iUser.userId);

                if (flag) {
                    alertSuccess("Create Onboarding", "Success", function () {
                        location.href = '@Url.Page("Index")';
                    });
                } else {
                    await $scope.CancelOnboard(iUser.userId);
                }
            }
        }
    });
</script>
