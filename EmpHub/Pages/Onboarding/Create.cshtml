        $scope.SelectAddress = function (x) {
            $timeout(function () {
                console.log($scope.address_type);
                if ($scope.address_type == 'registered') {
                    $scope.iAddress.registered_subDistrictCode = x.subDistrictCode;
                    $scope.iAddress.registered_subDistrictName = x.subDistrictName;
                    $scope.iAddress.registered_districtCode = x.districtCode;
                    $scope.iAddress.registered_districtName = x.districtName;
                    $scope.iAddress.registered_provinceCode = x.provinceCode;
                    $scope.iAddress.registered_provinceName = x.provinceName;
                    $scope.iAddress.registered_postcode = x.postcode;
                } else if ($scope.address_type == 'card') {
                    $scope.iAddress.card_subDistrictCode = x.subDistrictCode;
                    $scope.iAddress.card_subDistrictName = x.subDistrictName;
                    $scope.iAddress.card_districtCode = x.districtCode;
                    $scope.iAddress.card_districtName = x.districtName;
                    $scope.iAddress.card_provinceCode = x.provinceCode;
                    $scope.iAddress.card_provinceName = x.provinceName;
                    $scope.iAddress.card_postcode = x.postcode;
                } else if ($scope.address_type == 'live') {
                    $scope.iAddress.live_subDistrictCode = x.subDistrictCode;
                    $scope.iAddress.live_subDistrictName = x.subDistrictName;
                    $scope.iAddress.live_districtCode = x.districtCode;
                    $scope.iAddress.live_districtName = x.districtName;
