        $scope.Send = async function () {
            if ($scope.Validate()) {
                var iUser = await $scope.CreateOnboard();

                $scope.iPersonal.create_by = '@User.UserId()';
                $scope.iPersonal.userId = iUser.userId;

                var flag = await $scope.SavePersonal();

                if (flag) {
                    $scope.iEmployee.create_by = '@User.UserId()';
                    $scope.iEmployee.userId = iUser.userId;

                    flag = await $scope.SaveEmployee();

                    if (flag) {
                        $scope.iAddress.create_by = '@User.UserId()';
                        $scope.iAddress.userId = iUser.userId;

                        flag = await $scope.SaveAddress();
                    }
                }

                flag = await $scope.SendOnboard();

                if (flag) {
                    alertSuccess("Create Onboarding", "Success", function () {
                        location.href = '@Url.Page("Index")';
                    });
                } else {
                    await $scope.CancelOnboard(iUser.userId);
                }
            } else {
                alertWarning("Form Validate", "Please fill in all the required fields.");
            }
        }

    });
</script>