@page
@model EmpHub.Pages.Onboarding.CreateModel
@{
    ViewData["Title"] = "Onboarding";
    var token = User.AccessToken(HttpContext);
}

@section PageHeader {
    <!-- [ page-header ] start -->
    <div class="page-header">
        <div class="page-header-left d-flex align-items-center">
            <div class="page-header-title">
                <h5 class="m-b-10">Onboarding</h5>
            </div>
            <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Page("/Index")">Home</a></li>
                <li class="breadcrumb-item"><a href="@Url.Page("Index")">Onboarding</a></li>
                <li class="breadcrumb-item">Create</li>
            </ul>
        </div>
    </div>
}

<div ng-controller="ManageCtrl" class="p-2">
    <div class="d-flex">
        <div class="mb-3 me-2">
            <div class="fs-4">Create</div>
        </div>
    </div>
    <div class="rounded-4 border shadow-sm p-3 bg-white">
        <div class="fs-4">
            System
        </div>
        <div class="row">
            <div class="col-sm-4">
                <div class="fw-bolder">Username</div>
                <input ng-model="iData.username" class="form-control" maxlength="50" />
            </div>
        </div>
        <hr />
        <div class="fs-4">
            Personal
        </div>
        <div class="row">
            <div class="col-sm-4 mb-3">
                <div class="fw-bolder">firstname (TH)</div>
                <input ng-model="iData.firstname_th" class="form-control" maxlength="50" />
            </div>
            <div class="col-sm-4 mb-3">
                <div class="fw-bolder">lastname (TH)</div>
                <input ng-model="iData.lastname_th" class="form-control" maxlength="50" />
            </div>
            <div class="col-sm-4 mb-3">
                <div class="fw-bolder">Nickname</div>
                <input ng-model="iData.nickname" class="form-control" maxlength="50" />
            </div>
        </div>
        <div class="row">
            <div class="col-sm-4 mb-3">
                <div class="fw-bolder">firstname (EN)</div>
                <input ng-model="iData.firstname" class="form-control" maxlength="50" />
            </div>
            <div class="col-sm-4 mb-3">
                <div class="fw-bolder">lastname (EN)</div>
                <input ng-model="iData.lastname" class="form-control" maxlength="50" />
            </div>
            <div class="col-sm-2 mb-3">
                <div class="fw-bolder">Birth Date</div>
                <input ng-model="iData.birth_date" class="form-control" maxlength="50" />
            </div>
            <div class="col-sm-2 mb-3">
                <div class="fw-bolder">Sex</div>
                <input ng-model="iData.sex" class="form-control" maxlength="50" />
            </div>
        </div>
        <div class="fs-4">
            Contact
        </div>
        <div class="row">
            <div class="col-sm-4 mb-3">
                <div class="fw-bolder">E-mail</div>
                <input ng-model="iData.email" class="form-control" maxlength="50" />
            </div>
            <div class="col-sm-4 mb-3">
                <div class="fw-bolder">Phone No</div>
                <input ng-model="iData.phoneNo" class="form-control" maxlength="50" />
            </div>
            <div class="col-sm-2 mb-3">
                <div class="fw-bolder">Ext</div>
                <input ng-model="iData.phoneNo" class="form-control" maxlength="4" />
            </div>
        </div>
        <div class="fs-4">
            Employee
        </div>
        <div class="row">
            <div class="col-sm-4 mb-3">
                <div class="fw-bolder">Employee Code</div>
                <select ng-model="iData.employeeCode" class="form-select" ng-options="x.code as x.desc_th for x in lPosition"></select>
            </div>
            <div class="col-sm-4 mb-3">
                <div class="fw-bolder">Type</div>
                <select ng-model="iData.employeeType" class="form-select" ng-options="x.code as x.desc_th for x in lDepartment"></select>
            </div>
            <div class="col-sm-4 mb-3">
                <div class="fw-bolder">Join Date</div>
                <select ng-model="iData.join_date" class="form-select" ng-options="x.code as x.desc_th for x in lDepartment"></select>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-4 mb-3">
                <div class="fw-bolder">Position</div>
                <select ng-model="iData.positionCode" class="form-select" ng-options="x.code as x.desc_th for x in lPosition"></select>
            </div>
            <div class="col-sm-4 mb-3">
                <div class="fw-bolder">Department</div>
                <select ng-model="iData.departmentCode" class="form-select" ng-options="x.code as x.desc_th for x in lDepartment"></select>
            </div>
            <div class="col-sm-4 mb-3">
                <div class="fw-bolder">Head</div>
                <select ng-model="iData.departmentCode" class="form-select" ng-options="x.code as x.desc_th for x in lDepartment"></select>
            </div>
        </div>
        <div class="text-end mt-2">
            <button class="btn btn-primary" ng-click="Update()">
                <i class="far fa-paper-plane me-2"></i> Submit
            </button>
        </div>
    </div>
</div>
<script>
    app.controller('ManageCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.page = 1
        $scope.row = 10;

        $scope.LoadInit = function(){
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/MasterCode/DataList'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    groupName: 'departmentCode'
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lDepartment = result;
                    }, 0);
                }
                , error: AjaxError
            });
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/MasterCode/DataList'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    groupName: 'positionCode'
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lPosition = result;
                    }, 0);
                }
                , error: AjaxError
            });
        }
        $scope.LoadInit();

        $scope.LoadData = function (page = 1) {
            $scope.page = page;

            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/FullList'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    page: $scope.page
                    , row: $scope.row
                    , firstname: $scope.subject
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lData = result.data;
                        $scope.total = result.total;
                    }, 0);
                }
                , error: AjaxError
            });
        }
        $scope.LoadData();

        $scope.New = function (x) {
            $scope.iData = { username: '', password: '', firstname: '', lastname: '' };
            $("#CreateModal").modal('show');
        }

        $scope.Create = function () {
            $scope.iData.create_by = '@User.UserId()';
            $("#CreateModal").modal('hide');

            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/Create'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , cache: false
                , data: JSON.stringify($scope.iData)
                , success: function () {
                    $timeout(function () {
                        $scope.LoadData($scope.page);
                    }, 0);
                }
                , error: AjaxError
            });
        }

        $scope.ShowEdit = function (x) {
            $scope.iData = x;
            $("#DetailModal").modal('show');
        }

        $scope.Update = function () {
            $scope.iData.update_by = '@User.UserId()';
            $("#DetailModal").modal('hide');

            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/Update'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , cache: false
                , data: JSON.stringify($scope.iData)
                , success: function () {
                    $timeout(function () {
                        $scope.LoadData($scope.page);
                    }, 0);
                }
                , error: AjaxError
            });
        }

        $scope.Delete = function(x){
            alertConfirm('ยืนยันการทำรายการ', 'ท่านต้องการลบข้อมูลผู้ใช้งานนี้', function () {
                x.update_by = '@User.UserId()';
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/User/Delete'
                    , headers: { 'authorization': 'Bearer @token' }
                    , type: 'post'
                    , contentType: 'application/json'
                    , cache: false
                    , data: JSON.stringify(x)
                    , success: function () {
                        $timeout(function () {
                            $scope.LoadData($scope.page);
                        }, 0);
                    }
                    , error: AjaxError
                });
            });
        }

        $scope.ShowChangePass = function (x) {
            $scope.iData = x;
            $("#ChangePassModal").modal('show');
        }

        $scope.ChangePass = function () {
            $scope.iData.update_by = '@User.UserId()';
            $("#ChangePassModal").modal('hide');

            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/ChangePassword'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , cache: false
                , data: JSON.stringify($scope.iData)
                , success: function () {
                    $timeout(function () {
                        $scope.LoadData($scope.page);
                    }, 0);
                }
                , error: AjaxError
            });
        }

        $scope.Resend = function (x) {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Mail/Resend'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , cache: false
                , data: JSON.stringify({
                    id: x.id
                })
                , success: function () {
                    $timeout(function () {
                        alertSuccess("ส่งเมล์สำเร็จ", "ดำเนินการส่งเมล์เรียบร้อยแล้ว");
                        $scope.LoadData($scope.page);
                    }, 0);
                }
                , error: AjaxError
            });
        }

        $scope.UpdateSync = function (x) {
            return new Promise((resolve) => {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/User/SyncData'
                    , headers: { 'authorization': 'Bearer @token' }
                    , type: 'post'
                    , contentType: 'application/json'
                    , cache: false
                    , data: JSON.stringify(x)
                    , success: function (data) {
                        resolve(true);
                    }
                    , error: function(){
                        resolve(false);
                    }
                });
            });
        }

        $scope.Download = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/FullList',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    page: $scope.page
                    , row: 2000
                    , firstname: $scope.subject
                }),
                success: function (result) {
                    $timeout(function () {
                        var lData = result.data;

                        if (lData.length > 0) {
                            var JSData = [[
                                { 'text': 'Username' }
                                , { 'text': 'Fullname' }
                                , { 'text': 'ชื่อ - สกุล' }
                                , { 'text': 'E-mail' }
                                , { 'text': 'ประเภท' }
                                , { 'text': 'วันที่สร้าง' }
                            ]];

                            for (var i = 0; i < lData.length; i++) {
                                var iData = lData[i];

                                JSData.splice(JSData.length, 0, [
                                    { 'text': iData.serviceNo }
                                    , { 'text': iData.categoryDesc }
                                    , { 'text': iData.subCategoryDesc }
                                    , { 'text': iData.title }
                                    , { 'text': iData.status }
                                    , { 'text': iData.createName }
                                    , { 'text': iData.createDate }
                                ]);
                            }

                            var dt = new Date().toISOString().slice(0, 10).replace(/-/g, "");
                            ExportFile(JSData, 'รายงานฝ่าย_' + dt);
                        }
                    }, 0);
                },
                error: AjaxError
            });
        }
    });
</script>