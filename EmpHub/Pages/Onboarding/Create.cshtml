        // โครงสร้างหน่วยงาน: condition_4 = ระดับ, condition_3 = รหัสหน่วยงานแม่
        // Business Unit = ด้าน, Group = สาย, Department = ฝ่าย, Section = ส่วน
        $scope.lFunction = [];
        $scope.lDivision = [];
        $scope.lDepartment = [];
        $scope.lSection = [];

        function OrgChildren(lTier, parentCode) {
            if (!parentCode) {
                return [];
            }

            return (lTier || []).filter(function (x) { return x.condition_3 == parentCode; });
        }

        function FindOrgItem(lTier, code) {
            return (lTier || []).find(function (x) { return x.code == code; });
        }

        function IsOrgMasterReady() {
            return $scope.lBusinessUnitAll && $scope.lGroupAll && $scope.lDepartmentAll && $scope.lSectionAll;
        }

        function ResolveLegacyOrgCode() {
            if (!$scope.iEmployee || !IsOrgMasterReady() || !$scope.iEmployee.departmentCode || $scope.iEmployee.sectionCode) {
                return;
            }

            if (FindOrgItem($scope.lBusinessUnitAll, $scope.iEmployee.departmentCode)) {
                $scope.iEmployee.functionCode = $scope.iEmployee.functionCode || $scope.iEmployee.departmentCode;
                $scope.iEmployee.departmentCode = '';
                return;
            }

            if (FindOrgItem($scope.lGroupAll, $scope.iEmployee.departmentCode)) {
                $scope.iEmployee.divisionCode = $scope.iEmployee.divisionCode || $scope.iEmployee.departmentCode;
                $scope.iEmployee.departmentCode = '';
                return;
            }

            if (FindOrgItem($scope.lSectionAll, $scope.iEmployee.departmentCode)) {
                $scope.iEmployee.sectionCode = $scope.iEmployee.departmentCode;
                $scope.iEmployee.departmentCode = '';
            }
        }

        function ResolveOrgParentChain() {
            if (!$scope.iEmployee) {
                return;
            }

            if ($scope.iEmployee.sectionCode && !$scope.iEmployee.departmentCode) {
                var section = FindOrgItem($scope.lSectionAll, $scope.iEmployee.sectionCode);
                $scope.iEmployee.departmentCode = section ? section.condition_3 : '';
            }
            if ($scope.iEmployee.departmentCode && !$scope.iEmployee.divisionCode) {
                var department = FindOrgItem($scope.lDepartmentAll, $scope.iEmployee.departmentCode);
                $scope.iEmployee.divisionCode = department ? department.condition_3 : '';
            }
            if ($scope.iEmployee.divisionCode && !$scope.iEmployee.functionCode) {
                var division = FindOrgItem($scope.lGroupAll, $scope.iEmployee.divisionCode);
                $scope.iEmployee.functionCode = division ? division.condition_3 : '';
            }
        }

        function NormalizeOrgSelection() {
            if (!$scope.iEmployee) {
                return;
            }
            if (!IsOrgMasterReady()) {
                return;
            }

            if ($scope.iEmployee.functionCode && !FindOrgItem($scope.lBusinessUnitAll, $scope.iEmployee.functionCode)) {
                $scope.iEmployee.functionCode = '';
                $scope.iEmployee.divisionCode = '';
                $scope.iEmployee.departmentCode = '';
                $scope.iEmployee.sectionCode = '';
                return;
            }

            if ($scope.iEmployee.divisionCode) {
                var division = FindOrgItem($scope.lGroupAll, $scope.iEmployee.divisionCode);
                if (!division || division.condition_3 != $scope.iEmployee.functionCode) {
                    $scope.iEmployee.divisionCode = '';
                    $scope.iEmployee.departmentCode = '';
                    $scope.iEmployee.sectionCode = '';
                }
            }

            if ($scope.iEmployee.departmentCode) {
                var department = FindOrgItem($scope.lDepartmentAll, $scope.iEmployee.departmentCode);
                if (!department || department.condition_3 != $scope.iEmployee.divisionCode) {
                    $scope.iEmployee.departmentCode = '';
                    $scope.iEmployee.sectionCode = '';
                }
            }

            if ($scope.iEmployee.sectionCode) {
                var section = FindOrgItem($scope.lSectionAll, $scope.iEmployee.sectionCode);
                if (!section || section.condition_3 != $scope.iEmployee.departmentCode) {
                    $scope.iEmployee.sectionCode = '';
                }
            }
        }

        $scope.BuildOrgOption = function () {
            ResolveLegacyOrgCode();
            ResolveOrgParentChain();
            NormalizeOrgSelection();
            $scope.lFunction = $scope.lBusinessUnitAll || [];
            $scope.lDivision = OrgChildren($scope.lGroupAll, $scope.iEmployee.functionCode);
            $scope.lDepartment = OrgChildren($scope.lDepartmentAll, $scope.iEmployee.divisionCode);
            $scope.lSection = OrgChildren($scope.lSectionAll, $scope.iEmployee.departmentCode);
        }

