    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@

<style>
    .form-input {
        padding: 5px;
        border: 0px;
        border-radius: 0;
        border-bottom: 2px solid var(--bs-gray-400);
        background-color: #fcfcfc;
    }

    .form-input:focus {
        border-bottom: 2px solid var(--tip-blue);
    }

    input.form-input:read-only {
        background-color: var(--bs-gray-200);
    }
</style>
<div class="position-relative m-4 pb-3">
    <div class="progress" role="progressbar" aria-label="Progress" aria-valuenow="{{ lStep[step_index].value }}" aria-valuemin="0" aria-valuemax="100" style="height: 1px;">
        <div class="progress-bar" style="width: {{ lStep[step_index].left }}"></div>
    </div>
    <div class="position-absolute top-0 translate-middle text-center" style="left:0%;">
        <button type="button" class="btn btn-sm rounded-pill btn-primary" style="width: 2rem; height:2rem;">1</button>
    </div>
    <div class="position-absolute top-0 translate-middle text-center" style="left:33.33%;">
        <button type="button" class="btn btn-sm rounded-pill {{ step_index >= 1 ? 'btn-primary' : 'btn-secondary' }}" style="width: 2rem; height:2rem;" ng-disabled="step_index < 1">2</button>
    </div>
    <div class="position-absolute top-0 translate-middle text-center" style="left:66.66%;">
        <button type="button" class="btn btn-sm rounded-pill {{ step_index >= 2 ? 'btn-primary' : 'btn-secondary' }}" style="width: 2rem; height:2rem;" ng-disabled="step_index < 2">3</button>
    </div>
    <div class="position-absolute top-0 translate-middle text-center" style="left:100%;">
        <button type="button" class="btn btn-sm rounded-pill {{ step_index >= 3 ? 'btn-primary' : 'btn-secondary' }}" style="width: 2rem; height:2rem;" ng-disabled="step_index < 3">4</button>
    </div>
</div>
<div class="rounded-4 border shadow-sm p-3 bg-white text-dark mb-3" ng-show="step_index == 0">
    <div class="fs-4 fw-bolder">
        ข้อมูลการจ้างงาน
    </div>
    <hr/>
    <div class="row">
        <div class="col-sm-3 mb-3">
            <div>ประเภทการดำเนินการ <span class="text-danger">*</span></div>
            <select ng-model="iEmployee.processType" class="form-select form-input processType" ng-options="x.value as x.key for x in lProcessType" ng-disabled="is_readonly"></select>
        </div>
        <div class="col-sm-9 mb-3">
            <div>เหตุผลการดำเนินการ</div>
            <input ng-model="iEmployee.processReason" class="form-control form-input processReason" maxlength="200" ng-disabled="is_readonly" />
        </div>
    </div>
    @* Employee *@
    <div class="row">
        <div class="col-sm-3 mb-3">
            <div>รหัสพนักงาน <span class="text-danger">*</span></div>
            <input ng-model="iEmployee.employeeCode" class="form-control form-input employeeCode" placeholder="000000" maxlength="6" ng-disabled="is_readonly" />
        </div>
        <div class="col-sm-3 mb-3">
            <div>เลขประจำตัวประชาชน <span class="text-danger">*</span></div>
            <input ng-model="iPersonal.idcard" class="form-control form-input idcard" placeholder="0000000000000" maxlength="13" ng-disabled="is_readonly" />
        </div>
        <div class="col-sm-3 mb-3">
            <div>สัญชาติ <span class="text-danger">*</span></div>
            <select ng-model="iPersonal.nationality" class="form-select form-input nationality" ng-options="x.code as x.desc_th for x in lNationality" ng-disabled="is_readonly"></select>
        </div>
        <div class="col-sm-3 mb-3">
            <div>เชื้อชาติ</div>
            <select ng-model="iPersonal.ethnicity" class="form-select form-input ethnicity" ng-options="x.code as x.desc_th for x in lEthnicity" ng-disabled="is_readonly"></select>
        </div>
        <div class="col-sm-3 mb-3">
            <div>ศาสนา</div>
            <select ng-model="iPersonal.religion" class="form-select form-input religion" ng-options="x.code as x.desc_th for x in lReligion" ng-disabled="is_readonly"></select>
        </div>
    </div>
    @* Personal *@
    <div class="fw-bolder fs-6">
        ชื่อพนักงาน (ไทย)
    </div>
    <div class="row">
        <div class="col-sm-3 mb-3">
            <div>คำนำหน้าชื่อ <span class="text-danger">*</span></div>
            <select ng-model="iPersonal.prefix_th" class="form-select form-input prefix_th" ng-options="x.code as x.desc_th for x in lPrefix" ng-disabled="is_readonly" ng-change="SelectPrefixTH()"></select>
        </div>
        <div class="col-sm-3 mb-3">
            <div>ชื่อ <span class="text-danger">*</span></div>
            <input ng-model="iPersonal.firstname_th" class="form-control form-input firstname_th" ng-disabled="is_readonly" />
        </div>
        <div class="col-sm-3 mb-3">
            <div>นามสกุล <span class="text-danger">*</span></div>
            <input ng-model="iPersonal.lastname_th" class="form-control form-input lastname_th" ng-disabled="is_readonly" />
        </div>
    </div>
    <div class="fw-bolder fs-6">
        ชื่อพนักงาน (อังกฤษ)
    </div>
    <div class="row">
        <div class="col-sm-3 mb-3">
            <div>คำนำหน้าชื่อ</div>
            <select ng-model="iPersonal.prefix_en" class="form-select form-input prefix_en" ng-options="x.code as x.desc_en for x in lPrefix" ng-disabled="is_readonly" ng-change="SelectPrefixEN()"></select>
        </div>
        <div class="col-sm-3 mb-3">
            <div>ชื่อ</div>
            <input ng-model="iPersonal.firstname_en" class="form-control form-input firstname_en" ng-disabled="is_readonly" />
        </div>
        <div class="col-sm-3 mb-3">
            <div>นามสกุล</div>
            <input ng-model="iPersonal.lastname_en" class="form-control form-input lastname_en" ng-disabled="is_readonly" />
        </div>
    </div>
    <div class="row">
        <div class="col-sm-3 mb-3">
            <div>วันเกิด (ปี ค.ศ.) <span class="text-danger">*</span></div>
            <input class="form-control form-input date birth_date icon-calendar"
                   ng-model="iPersonal.birth_date_select"
                   ng-model-options="{ updateOn: 'blur' }"
                   moment-picker="iPersonal.birth_date_select"
                   locale="th"
                   format="DD/MM/YYYY"
                   min-view="month"
                   max-view="month" 
                   required ng-change="CalcAge()" ng-disabled="is_readonly" />
        </div>
        <div class="col-sm-3 mb-3">
            <div>อายุ</div>
            <input ng-model="iPersonal.age" class="form-control form-input age" maxlength="50" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>เพศ <span class="text-danger">*</span></div>
            <select ng-model="iPersonal.sex" class="form-select form-input sex" ng-options="x.value as x.key for x in lSex" ng-disabled="is_readonly"></select>
        </div>
        <div class="col-sm-3 mb-3">
            <div>สถานภาพการสมรส <span class="text-danger">*</span></div>
            <select ng-model="iPersonal.maritalStatus" class="form-select form-input maritalStatus" ng-options="x.code as x.desc_th for x in lMarital" ng-disabled="is_readonly"></select>
        </div>
        <div class="col-sm-3 mb-3">
            <div>สถานะทางการทหาร</div>
            <select ng-model="iPersonal.militaryStatus" class="form-select form-input militaryStatus" ng-options="x.code as x.desc_th for x in lMilitary" ng-disabled="is_readonly"></select>
        </div>
        <div class="col-sm-3 mb-3">
            <div>สถานะความพิการ</div>
            <select ng-model="iPersonal.disabilityStatus" class="form-select form-input disabilityStatus" ng-options="x.code as x.desc_th for x in lDisability" ng-disabled="is_readonly"></select>
        </div>
    </div>
    <div class="d-flex">
        <div class="flex-fill"></div>
        <div class="me-2">
            <button class="btn btn-light" ng-click="Save()">
                บันทึกการเปลี่ยนแปลง
            </button>
        </div>
        <div>
            <button class="btn btn-primary" ng-click="CheckStep1()" ng-disabled="iPersonal.firstname_th == ''">ต่อไป</button>
        </div>
    </div>
</div>
<div class="rounded-4 border shadow-sm p-3 bg-white text-dark mb-3" ng-show="step_index == 1">
    <div class="fs-4 fw-bolder">ข้อมูลที่อยู่</div>
    @* Address *@
    <div class="fw-bolder fs-6">ที่อยู่ทะเบียนบ้าน</div>
    <div class="row">
        <div class="col-sm-6 mb-3">
            <div>บ้านเลขที่ <span class="text-danger">*</span></div>
            <input ng-model="iAddress.registered_home" class="form-control form-input registered_home" maxlength="100" ng-disabled="is_readonly" />
        </div>
        <div class="col-sm-6 mb-3">
            <div>ถนน</div>
            <input ng-model="iAddress.registered_road" class="form-control form-input registered_road" maxlength="100" ng-disabled="is_readonly" />
        </div>
        <div class="col-sm-3 mb-3">
            <div>แขวง/ตำบล</div>
            <input ng-model="iAddress.registered_subDistrictName" class="form-control form-input icon-search registered_subDistrictName" maxlength="50" ng-click="ShowAddress('registered')" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>เขต/อำเภอ</div>
            <input ng-model="iAddress.registered_districtName" class="form-control form-input icon-search registered_districtName" maxlength="50" ng-click="ShowAddress('registered')" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>จังหวัด <span class="text-danger">*</span></div>
            <input ng-model="iAddress.registered_provinceName" class="form-control form-input icon-search registered_provinceName" maxlength="50" ng-click="ShowAddress('registered')" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>ไปรษณีย์</div>
            <input ng-model="iAddress.registered_postcode" class="form-control form-input registered_postcode postcode" maxlength="5" ng-disabled="is_readonly" />
        </div>
    </div>
    <div class="fw-bolder fs-6 me-2">ที่อยู่ตามบัตรประชาชน</div>
    <div class="mb-2">
        <input ng-model="is_card_same_register" type="checkbox" ng-change="SelectCardAddressUserRegistered()" ng-disabled="is_readonly" /> ใช้ที่อยู่เดียวกับทะเบียนบ้าน
    </div>
    <div class="row">
        <div class="col-sm-6 mb-3">
            <div>บ้านเลขที่ <span class="text-danger">*</span></div>
            <input ng-model="iAddress.card_home" class="form-control form-input card_home" maxlength="100" ng-disabled="is_readonly" />
        </div>
        <div class="col-sm-6 mb-3">
            <div>ถนน</div>
            <input ng-model="iAddress.card_road" class="form-control form-input card_road" maxlength="100" ng-disabled="is_readonly" />
        </div>
        <div class="col-sm-3 mb-3">
            <div>แขวง/ตำบล</div>
            <input ng-model="iAddress.card_subDistrictName" class="form-control form-input icon-search card_subDistrictName" maxlength="50" ng-click="ShowAddress('card')" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>เขต/อำเภอ</div>
            <input ng-model="iAddress.card_districtName" class="form-control form-input icon-search card_districtName" maxlength="50" ng-click="ShowAddress('card')" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>จังหวัด <span class="text-danger">*</span></div>
            <input ng-model="iAddress.card_provinceName" class="form-control form-input icon-search card_provinceName" maxlength="50" ng-click="ShowAddress('card')" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>ไปรษณีย์</div>
            <input ng-model="iAddress.card_postcode" class="form-control form-input card_postcode postcode" maxlength="5" ng-disabled="is_readonly" />
        </div>
    </div>
    <div class="fw-bolder fs-6">ที่อยู่พักอาศัย</div>
    <div class="mb-2">
        <input ng-model="is_live_same_register" type="checkbox" ng-change="SelectLiveAddressUserRegistered()" ng-disabled="is_readonly" /> ใช้ที่อยู่เดียวกับทะเบียนบ้าน
    </div>
    <div class="row">
        <div class="col-sm-6 mb-3">
            <div>บ้านเลขที่ <span class="text-danger">*</span></div>
            <input ng-model="iAddress.live_home" class="form-control form-input live_home" maxlength="100" ng-disabled="is_readonly" />
        </div>
        <div class="col-sm-6 mb-3">
            <div>ถนน</div>
            <input ng-model="iAddress.live_road" class="form-control form-input live_road" maxlength="100" ng-disabled="is_readonly" />
        </div>
        <div class="col-sm-3 mb-3">
            <div>แขวง/ตำบล</div>
            <input ng-model="iAddress.live_subDistrictName" class="form-control form-input icon-search live_subDistrictName" maxlength="50" ng-click="ShowAddress('live')" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>เขต/อำเภอ</div>
            <input ng-model="iAddress.live_districtName" class="form-control form-input icon-search live_districtName" maxlength="50" ng-click="ShowAddress('live')" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>จังหวัด <span class="text-danger">*</span></div>
            <input ng-model="iAddress.live_provinceName" class="form-control form-input icon-search live_provinceName" maxlength="50" ng-click="ShowAddress('live')" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>ไปรษณีย์</div>
            <input ng-model="iAddress.live_postcode" class="form-control form-input live_postcode postcode" maxlength="5" ng-disabled="is_readonly" />
        </div>
    </div>
    <div class="d-flex">
        <div class="flex-fill">
            <div>
                <button class="btn btn-light" ng-click="step_index = 0">กลับ</button>
            </div>
        </div>
        <div class="me-2">
            <button class="btn btn-light" ng-click="Save()">
                บันทึกการเปลี่ยนแปลง
            </button>
        </div>
        <div>
            <button class="btn btn-primary" ng-click="CheckStep2()" ng-disabled="iAddress.registered_home == ''">ต่อไป</button>
        </div>
    </div>
</div>
<div class="rounded-4 border shadow-sm p-3 bg-white text-dark mb-3" ng-show="step_index == 2">
    @* Contact *@
    <div class="fw-bolder fs-4">
        ข้อมูลการติดต่อ
    </div>
    <div class="row">
        <div class="col-sm-3 mb-3">
            <div>โทรศัพท์ <span class="text-danger">*</span></div>
            <input ng-model="iPersonal.phoneNo" class="form-control form-input phoneNo phone" maxlength="50" ng-disabled="is_readonly" placeholder="000-000-0000" />
        </div>
        <div class="col-sm-3 mb-3">
            <div>มือถือ</div>
            <input ng-model="iPersonal.mobile" class="form-control form-input mobile phone" maxlength="50" ng-disabled="is_readonly" placeholder="000-000-0000" />
        </div>
        <div class="col-sm-3 mb-3">
            <div>อีเมล์ส่วนตัว</div>
            <input ng-model="iPersonal.email" class="form-control form-input email" maxlength="50" ng-disabled="is_readonly" />
        </div>
        <div class="col-sm-3"></div>
        <div class="col-sm-3 mb-3">
            <div>เบอร์โทรศัพท์ที่ทำงาน</div>
            <input ng-model="iEmployee.phone_office" class="form-control form-input phone_office phone" maxlength="50" ng-disabled="is_readonly" placeholder="000-000-0000" />
        </div>
        <div class="col-sm-3 mb-3">
            <div>อีเมล์ที่ใช้ในบริษัท</div>
            <input ng-model="iEmployee.email" class="form-control form-input email_office" maxlength="50" ng-disabled="is_readonly" />
        </div>
    </div>
    <div class="d-flex">
        <div class="flex-fill">
            <div>
                <button class="btn btn-light" ng-click="step_index = 1">กลับ</button>
            </div>
        </div>
        <div class="me-2">
            <button class="btn btn-light" ng-click="Save()">
                บันทึกการเปลี่ยนแปลง
            </button>
        </div>
        <div>
            <button class="btn btn-primary" ng-click="CheckStep3()" ng-disabled="iPersonal.phoneNo == ''">ต่อไป</button>
        </div>
    </div>
</div>
<div class="rounded-4 border shadow-sm p-3 bg-white text-dark mb-3" ng-show="step_index == 3">
    <div class="fw-bolder fs-4">
        ข้อมูลพนักงาน
    </div>
    <div class="row">
        <div class="col-sm-3 mb-3">
            <div>วันเข้างาน (ปี ค.ศ.) <span class="text-danger">*</span></div>
            <input class="form-control form-input date join_date icon-calendar"
                   ng-model="iEmployee.join_date_select"
                   ng-model-options="{ updateOn: 'blur' }"
                   moment-picker="iEmployee.join_date_select"
                   locale="th"
                   format="DD/MM/YYYY"
                   max-date="iEmployee.probation_end_date_select"
                   min-view="month"
                   max-view="month" ng-disabled="is_readonly" />
        </div>
        <div class="col-sm-3 mb-3">
            <div>วันผ่านการทดลองงาน (ปี ค.ศ.)</div>
            <input class="form-control form-input date probation_end_date icon-calendar"
                   ng-model="iEmployee.probation_end_date_select"
                   ng-model-options="{ updateOn: 'blur' }"
                   moment-picker="iEmployee.probation_end_date_select"
                   locale="th"
                   min-date="iEmployee.join_date_select"
                   format="DD/MM/YYYY"
                   min-view="month"
                   max-view="month" ng-disabled="is_readonly" />

                   @* change="calcProbationDay()"  *@
        </div>
        <div class="col-sm-3 mb-3">
            <div>ระยะเวลาทดลองงาน (วัน)</div>
            <input ng-model="iEmployee.probation_day" class="form-control form-input probation_day" maxlength="50" readonly />
        </div>
    </div>
    <div class="row">
        <div class="col-sm-3 mb-3">
            <div>หน่วยงานเชิงธุรกิจ <span class="text-danger">*</span></div>
            <select ng-model="iEmployee.sectionCode" class="form-select form-input sectionCode" ng-options="x.code as x.desc_th for x in lDepartment" ng-disabled="is_readonly"></select>
        </div>
        <div class="col-sm-3 mb-3">
            <div>ตำแหน่งงาน <span class="text-danger">*</span></div>
            <select ng-model="iEmployee.positionCode" class="form-select form-input positionCode" ng-options="x.code as x.desc_th for x in lPosition" ng-disabled="is_readonly" ng-change="SelectPosition()"></select>
        </div>
        <div class="col-sm-3 mb-3">
            <div>ประเภทพนักงาน <span class="text-danger">*</span></div>
            <select ng-model="iEmployee.employeeType" class="form-select form-input employeeType" ng-options="x.code as x.desc_th for x in lEmployeeType" ng-disabled="is_readonly"></select>
        </div>
        <div class="col-sm-3 mb-3">
            <div>ระดับพนักงาน <span class="text-danger">*</span></div>
            <select ng-model="iEmployee.levelCode" class="form-select form-input levelCode" ng-options="x.code as x.desc_th for x in lLevel" ng-disabled="is_readonly"></select>
        </div>
        <div class="col-sm-3 mb-3">
            <div>เกรด</div>
            <input ng-model="iEmployee.grade" class="form-control form-input grade" maxlength="50" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>หัวหน้างาน</div>
            <input ng-model="iEmployee.supervisorName" class="form-control form-input icon-search supervisorName" maxlength="50" readonly ng-click="ShowSupervisor()" ng-disabled="is_readonly" />
        </div>
        <div class="col-sm-3 mb-3">
            <div>สถานที่</div>
            <input ng-model="iEmployee.location" class="form-control form-input location" maxlength="50" ng-disabled="is_readonly" />
        </div>
        <div class="col-sm-3 mb-3">
            <div>สาขาประกันสังคม</div>
            <input ng-model="iEmployee.sso" class="form-control form-input sso" maxlength="50" ng-disabled="is_readonly" />
        </div>
    </div>
    <div class="fw-bolder">เงื่อนไขการทำงาน</div>
    <div class="row">
        <div class="col-sm-3 mb-3">
            <div>รูปแบบการทำงาน</div>
            <select ng-model="iEmployee.workMode" class="form-select form-input workMode" ng-options="x.code as x.desc_th for x in lWorkMode" ng-change="SelectWorkMode()" ng-disabled="is_readonly"></select>
        </div>
        <div class="col-sm-3 mb-3">
            <div>บันทึกเวลาเข้าออก</div>
            <input ng-model="iEmployee.workTime" class="form-control form-input workTime" maxlength="50" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>ได้รับค่าล่วงเวลา</div>
            <select ng-model="iEmployee.otMode" class="form-select form-input otMode" ng-options="x.code as x.desc_th for x in lOTMode" ng-disabled="is_readonly"></select>
        </div>
    </div>
    @* <div class="fw-bolder">ข้อมูลการจ่ายเงิน</div>
    <div class="row">
        <div class="col-sm-3 mb-3">
            <div>ประเภทการจ้างงาน <span class="text-danger">*</span></div>
            <input ng-model="iEmployee.employeeMode" class="form-control form-input employeeMode" maxlength="50" ng-disabled="is_readonly" />
        </div>
        <div class="col-sm-3 mb-3">
            <div>รหัสปฏิทิน</div>
            <input ng-model="iEmployee.calendarCode" class="form-control form-input calendarCode" maxlength="50" ng-disabled="is_readonly" />
        </div>
        <div class="col-sm-3 mb-3">
            <div>เงินเดือน</div>
            <input ng-model="iEmployee.salary" class="form-control form-input salary" maxlength="50" ng-disabled="is_readonly" />
        </div>
        <div class="col-sm-3 mb-3">
            <div>ตัวเลือกในการจ่าย</div>
