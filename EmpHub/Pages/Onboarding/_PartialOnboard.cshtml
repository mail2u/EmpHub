@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@

<style>
    .form-input {
        padding: 5px;
        border: 0px;
        border-radius: 0;
        border-bottom: 2px solid var(--bs-gray-400);
        background-color: #fcfcfc;
    }

        .form-input:focus {
            border-bottom: 2px solid var(--tip-blue);
        }

    input.form-input:read-only {
        background-color: var(--bs-gray-200);
    }
</style>
<div class="rounded-4 border shadow-sm p-3 bg-white text-dark mb-3">
    <div class="fs-4 fw-bolder">
        ข้อมูลการจ้างงาน
    </div>
    <div class="row">
        <div class="col-sm-3 mb-3">
            <div>ประเภทการดำเนินการ <span class="text-danger">*</span></div>
            <select ng-model="iEmployee.processType" class="form-select form-input processType" ng-options="x.value as x.key for x in lProcessType"></select>
        </div>
        <div class="col-sm-9 mb-3">
            <div>เหตุผลการดำเนินการ</div>
            <input ng-model="iEmployee.processReason" class="form-control form-input processReason" maxlength="200" />
        </div>
    </div>
    @* Employee *@
    <div class="row">
        <div class="col-sm-3 mb-3">
            <div>รหัสพนักงาน <span class="text-danger">*</span></div>
            <input ng-model="iEmployee.employeeCode" class="form-control form-input employeeCode" placeholder="000000" maxlength="6" />
        </div>
        <div class="col-sm-3 mb-3">
            <div>เลขประจำตัวประชาชน <span class="text-danger">*</span></div>
            <input ng-model="iPersonal.idcard" class="form-control form-input idcard" placeholder="0000000000000" maxlength="13" />
        </div>
        <div class="col-sm-3 mb-3">
            <div>สัญชาติ <span class="text-danger">*</span></div>
            <select ng-model="iPersonal.nationality" class="form-select form-input nationality" ng-options="x.code as x.desc_th for x in lNationality"></select>
        </div>
        <div class="col-sm-3 mb-3">
            <div>เชื้อชาติ</div>
            <select ng-model="iPersonal.ethnicity" class="form-select form-input ethnicity" ng-options="x.code as x.desc_th for x in lEthnicity"></select>
        </div>
        <div class="col-sm-3 mb-3">
            <div>ศาสนา</div>
            <select ng-model="iPersonal.religion" class="form-select form-input religion" ng-options="x.code as x.desc_th for x in lReligion"></select>
        </div>
    </div>
    @* Personal *@
    <div class="fw-bolder fs-6">
        ชื่อพนักงาน (ไทย)
    </div>
    <div class="row">
        <div class="col-sm-3 mb-3">
            <div>คำนำหน้าชื่อ <span class="text-danger">*</span></div>
            <select ng-model="iPersonal.prefix_th" class="form-select form-input prefix_th" ng-options="x.code as x.desc_th for x in lPrefix"></select>
        </div>
        <div class="col-sm-3 mb-3">
            <div>ชื่อ <span class="text-danger">*</span></div>
            <input ng-model="iPersonal.firthname_th" class="form-control form-input firthname_th" />
        </div>
        <div class="col-sm-3 mb-3">
            <div>นามสกุล <span class="text-danger">*</span></div>
            <input ng-model="iPersonal.lastname_th" class="form-control form-input lastname_th" />
        </div>
    </div>
    <div class="fw-bolder fs-6">
        ชื่อพนักงาน (อังกฤษ)
    </div>
    <div class="row">
        <div class="col-sm-3 mb-3">
            <div>คำนำหน้าชื่อ</div>
            <select ng-model="iPersonal.prefix_en" class="form-select form-input prefix_en" ng-options="x.code as x.desc_en for x in lPrefix"></select>
        </div>
        <div class="col-sm-3 mb-3">
            <div>ชื่อ</div>
            <input ng-model="iPersonal.firthname_en" class="form-control form-input firthname_en" />
        </div>
        <div class="col-sm-3 mb-3">
            <div>นามสกุล</div>
            <input ng-model="iPersonal.lastname_en" class="form-control form-input lastname_en" />
        </div>
    </div>
    <div class="row">
        <div class="col-sm-3 mb-3">
            <div>วันเกิด <span class="text-danger">*</span></div>
            <input class="form-control form-input date birth_date icon-calendar"
                   ng-model="iPersonal.birth_date_select"
                   ng-model-options="{ updateOn: 'blur' }"
                   moment-picker="iPersonal.birth_date_select"
                   locale="th"
                   format="DD/MM/YYYY"
                   min-view="month"
                   max-view="month" required change="CalcAge()" />
        </div>
        <div class="col-sm-3 mb-3">
            <div>อายุ</div>
            <input ng-model="iPersonal.age" class="form-control form-input age" maxlength="50" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>เพศ <span class="text-danger">*</span></div>
            <select ng-model="iPersonal.sex" class="form-select form-input sex" ng-options="x.value as x.key for x in lSex"></select>
        </div>
        <div class="col-sm-3 mb-3">
            <div>สถานภาพการสมรส <span class="text-danger">*</span></div>
            <select ng-model="iPersonal.maritalStatus" class="form-select form-input maritalStatus" ng-options="x.code as x.desc_th for x in lMarital"></select>
        </div>
        <div class="col-sm-3 mb-3">
            <div>สถานะทางการทหาร</div>
            <select ng-model="iPersonal.militaryStatus" class="form-select form-input militaryStatus" ng-options="x.code as x.desc_th for x in lMilitary"></select>
        </div>
        <div class="col-sm-3 mb-3">
            <div>สถานะความพิการ</div>
            <select ng-model="iPersonal.disabilityStatus" class="form-select form-input disabilityStatus" ng-options="x.code as x.desc_th for x in lDisability"></select>
        </div>
    </div>
</div>
<div class="rounded-4 border shadow-sm p-3 bg-white text-dark mb-3">
    <div class="fs-4 fw-bolder">ข้อมูลที่อยู่</div>
    @* Address *@
    <div class="fw-bolder fs-6">ที่อยู่ทะเบียนบ้าน</div>
    <div class="row">
        <div class="col-sm-6 mb-3">
            <div>บ้านเลขที่</div>
            <input ng-model="iAddress.registered_home" class="form-control form-input" maxlength="100" />
        </div>
        <div class="col-sm-6 mb-3">
            <div>ถนน</div>
            <input ng-model="iAddress.registered_road" class="form-control form-input" maxlength="100" />
        </div>
        <div class="col-sm-3 mb-3">
            <div>แขวง/ตำบล</div>
            <input ng-model="iAddress.registered_subDistrictName" class="form-control form-input icon-search" maxlength="50" ng-click="ShowAddress('registered')" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>เขต/อำเภอ</div>
            <input ng-model="iAddress.registered_districtName" class="form-control form-input icon-search" maxlength="50" ng-click="ShowAddress('registered')" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>จังหวัด <span class="text-danger">*</span></div>
            <input ng-model="iAddress.registered_provinceName" class="form-control form-input icon-search" maxlength="50" ng-click="ShowAddress('registered')" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>ไปรษณีย์</div>
            <input ng-model="iAddress.registered_postcode" class="form-control form-input" maxlength="5" />
        </div>
    </div>
    <div class="fw-bolder fs-6">ที่อยู่ตามบัตรประชาชน</div>
    <div class="row">
        <div class="col-sm-6 mb-3">
            <div>บ้านเลขที่</div>
            <input ng-model="iAddress.card_home" class="form-control form-input" maxlength="100" />
        </div>
        <div class="col-sm-6 mb-3">
            <div>ถนน</div>
            <input ng-model="iAddress.card_road" class="form-control form-input" maxlength="100" />
        </div>
        <div class="col-sm-3 mb-3">
            <div>แขวง/ตำบล</div>
            <input ng-model="iAddress.card_subDistrictName" class="form-control form-input icon-search" maxlength="50" ng-click="ShowAddress('card')" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>เขต/อำเภอ</div>
            <input ng-model="iAddress.card_districtName" class="form-control form-input icon-search" maxlength="50" ng-click="ShowAddress('card')" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>จังหวัด <span class="text-danger">*</span></div>
            <input ng-model="iAddress.card_provinceName" class="form-control form-input icon-search" maxlength="50" ng-click="ShowAddress('card')" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>ไปรษณีย์</div>
            <input ng-model="iAddress.card_postcode" class="form-control form-input" maxlength="5" />
        </div>
    </div>
    <div class="fw-bolder fs-6">ที่อยู่พักอาศัย</div>
    <div class="row">
        <div class="col-sm-6 mb-3">
            <div>บ้านเลขที่</div>
            <input ng-model="iAddress.live_home" class="form-control form-input" maxlength="100" />
        </div>
        <div class="col-sm-6 mb-3">
            <div>ถนน</div>
            <input ng-model="iAddress.live_road" class="form-control form-input" maxlength="100" />
        </div>
        <div class="col-sm-3 mb-3">
            <div>แขวง/ตำบล</div>
            <input ng-model="iAddress.live_subDistrictName" class="form-control form-input icon-search" maxlength="50" ng-click="ShowAddress('live')" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>เขต/อำเภอ</div>
            <input ng-model="iAddress.live_districtName" class="form-control form-input icon-search" maxlength="50" ng-click="ShowAddress('live')" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>จังหวัด <span class="text-danger">*</span></div>
            <input ng-model="iAddress.live_provinceName" class="form-control form-input icon-search" maxlength="50" ng-click="ShowAddress('live')" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>ไปรษณีย์</div>
            <input ng-model="iAddress.live_postcode" class="form-control form-input" maxlength="5" />
        </div>
    </div>
</div>
<div class="rounded-4 border shadow-sm p-3 bg-white text-dark mb-3">
    @* Contact *@
    <div class="fw-bolder fs-4">
        ข้อมูลการติดต่อ
    </div>
    <div class="row">
        <div class="col-sm-3 mb-3">
            <div>โทรศัพท์</div>
            <input ng-model="iPersonal.phoneNo" class="form-control form-input" maxlength="50" />
        </div>
        <div class="col-sm-3 mb-3">
            <div>มือถือ</div>
            <input ng-model="iPersonal.mobile" class="form-control form-input" maxlength="50" />
        </div>
        <div class="col-sm-3 mb-3">
            <div>อีเมล์ส่วนตัว</div>
            <input ng-model="iPersonal.email" class="form-control form-input" maxlength="50" />
        </div>
        <div class="col-sm-3"></div>
        <div class="col-sm-3 mb-3">
            <div>เบอร์โทรศัพท์ที่ทำงาน</div>
            <input ng-model="iEmployee.phone_office" class="form-control form-input" maxlength="50" />
        </div>
        <div class="col-sm-3 mb-3">
            <div>อีเมล์ที่ใช้ในบริษัท</div>
            <input ng-model="iEmployee.email_office" class="form-control form-input" maxlength="50" />
        </div>
    </div>
</div>
<div class="rounded-4 border shadow-sm p-3 bg-white text-dark mb-3">
    <div class="fw-bolder fs-4">
        ข้อมูลพนักงาน
    </div>
    <div class="row">
        <div class="col-sm-3 mb-3">
            <div>วันเข้างาน <span class="text-danger">*</span></div>
            <input class="form-control form-input date join_date icon-calendar"
                   ng-model="iEmployee.join_date_select"
                   ng-model-options="{ updateOn: 'blur' }"
                   moment-picker="iEmployee.join_date_select"
                   locale="th"
                   format="DD/MM/YYYY"
                   max-date="iEmployee.probation_end_date_select"
                   min-view="month"
                   max-view="month" />
        </div>
        <div class="col-sm-3 mb-3">
            <div>วันผ่านการทดลองงาน</div>
            <input class="form-control form-input date probation_end_date icon-calendar"
                   ng-model="iEmployee.probation_end_date_select"
                   ng-model-options="{ updateOn: 'blur' }"
                   moment-picker="iEmployee.probation_end_date_select"
                   locale="th"
                   min-date="iEmployee.join_date_select"
                   format="DD/MM/YYYY"
                   min-view="month"
                   max-view="month" change="calcProbationDay()" />
        </div>
        <div class="col-sm-3 mb-3">
            <div>ระยะเวลาทดลองงาน (วัน)</div>
            <input ng-model="iEmployee.probation_day" class="form-control form-input probation_day" maxlength="50" readonly />
        </div>
    </div>
    <div class="row">
        <div class="col-sm-3 mb-3">
            <div>หน่วยงานเชิงธุรกิจ <span class="text-danger">*</span></div>
            <select ng-model="iEmployee.departmentCode" class="form-select form-input disabilityStatus" ng-options="x.code as x.desc_th for x in lDepartment"></select>
        </div>
        <div class="col-sm-3 mb-3">
            <div>ตำแหน่งงาน <span class="text-danger">*</span></div>
            <select ng-model="iEmployee.positionCode" class="form-select form-input disabilityStatus" ng-options="x.code as x.desc_th for x in lPosition"></select>
        </div>
        <div class="col-sm-3 mb-3">
            <div>ประเภทพนักงาน <span class="text-danger">*</span></div>
            <input ng-model="iEmployee.employeeType" class="form-control form-input" maxlength="50" />
        </div>
        <div class="col-sm-3 mb-3">
            <div>ระดับพนักงาน <span class="text-danger">*</span></div>
            <input ng-model="iEmployee.levelCode" class="form-control form-input" maxlength="50" />
        </div>
        <div class="col-sm-3 mb-3">
            <div>เกรด</div>
            <input ng-model="iEmployee.grade" class="form-control form-input" maxlength="50" />
        </div>
        <div class="col-sm-3 mb-3">
            <div>หัวหน้างาน</div>
            <input ng-model="iEmployee.supervisorName" class="form-control form-input icon-search" maxlength="50" readonly ng-click="ShowSupervisor()" />
        </div>
        <div class="col-sm-3 mb-3">
            <div>สถานที่</div>
            <input ng-model="iEmployee.location" class="form-control form-input" maxlength="50" />
        </div>
        <div class="col-sm-3 mb-3">
            <div>สาขาประกันสังคม</div>
            <input ng-model="iEmployee.sso" class="form-control form-input" maxlength="50" />
        </div>
    </div>
    <div class="fw-bolder">เงื่อนไขการทำงาน</div>
    <div class="row">
        <div class="col-sm-3 mb-3">
            <div>รูปแบบการทำงาน</div>
            <select ng-model="iEmployee.workMode" class="form-select form-input disabilityStatus" ng-options="x.code as x.desc_th for x in lWorkMode" ng-change="SelectWorkMode()"></select>
        </div>
        <div class="col-sm-3 mb-3">
            <div>บันทึกเวลาเข้าออก</div>
            <input ng-model="iEmployee.workTime" class="form-control form-input" maxlength="50" readonly />
        </div>
        <div class="col-sm-3 mb-3">
            <div>ได้รับค่าล่วงเวลา</div>
            <select ng-model="iEmployee.otMode" class="form-select form-input disabilityStatus" ng-options="x.code as x.desc_th for x in lOTMode"></select>
        </div>
    </div>
    <div class="fw-bolder">ข้อมูลการจ่ายเงิน</div>
    <div class="row">
        <div class="col-sm-3 mb-3">
            <div>ประเภทการจ้างงาน <span class="text-danger">*</span></div>
            <input ng-model="iEmployee.employeeMode" class="form-control form-input" maxlength="50" />
        </div>
        <div class="col-sm-3 mb-3">
            <div>รหัสปฏิทิน</div>
            <input ng-model="iEmployee.calendarCode" class="form-control form-input" maxlength="50" />
        </div>
        <div class="col-sm-3 mb-3">
            <div>เงินเดือน</div>
            <input ng-model="iEmployee.salary" class="form-control form-input" maxlength="50" />
        </div>
        <div class="col-sm-3 mb-3">
            <div>ตัวเลือกในการจ่าย</div>
            <input ng-model="iEmployee.paymentChannel" class="form-control form-input" maxlength="50" />
        </div>
        <div class="col-sm-3 mb-3">
            <div>รหัสธนาคาร</div>
            <input ng-model="iEmployee.bankCode" class="form-control form-input" maxlength="50" />
        </div>
        <div class="col-sm-3 mb-3">
            <div>เลขที่บัญชี</div>
            <input ng-model="iEmployee.bookNo" class="form-control form-input" maxlength="50" />
        </div>
    </div>
    @* modal *@
    <div id="addressModal" class="modal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-body">
                    <div>
                        <div class="mb-2">
                            <input ng-model="filter_name" class="form-control" placeholder="ค้นหาที่อยู่" />
                            <div class="list-group list-group-flush overflow-auto" style="max-height: 400px;">
                                <div class="list-group-item list-group-item-action d-flex align-items-center justify-content-between" ng-repeat="x in lAddress | filter : filter_name | limitTo : 50">
                                    <div class="p-2">
                                        <nav aria-label="breadcrumb">
                                            <ol class="breadcrumb mb-0">
                                                <li class="breadcrumb-item active">{{ x.subDistrictName }}</li>
                                                <li class="breadcrumb-item active">{{ x.districtName }}</li>
                                                <li class="breadcrumb-item active">{{ x.provinceName }}</li>
                                                <li class="breadcrumb-item active">{{ x.postcode }}</li>
                                            </ol>
                                        </nav>
                                    </div>
                                    <div>
                                        <button ng-click="SelectAddress(x)" class="btn btn-circle">
                                            <i class="fas fa-plus"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="text-end">
                            <button class="btn btn-light" data-bs-dismiss="modal" aria-label="Close">
                                ปิด
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    @* supervisorModal *@
    <div id="supervisorModal" class="modal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-body">
                    <div>
                        <div class="mb-2">
                            <input ng-model="filter_name" class="form-control" />
                            <div class="list-group list-group-flush overflow-auto" style="max-height: 400px;">
                                <div class="list-group-item list-group-item-action d-flex align-items-center justify-content-between" ng-repeat="x in lEmployee | filter : filter_name">
                                    <div>
                                        <div class="text-dark fs-5 text-secondary">
                                            {{ x.firstname_th + ' ' + x.lastname_th }} <span ng-show="x.nickname != ''">({{ x.nickname }})</span>
                                        </div>
                                        <div class="text-dark fs-5 text-secondary">
                                            {{ x.firstname + ' ' + x.lastname }}
                                        </div>
                                        <small class="text-dark">
                                            {{ x.positionDesc }} {{ x.departmentDesc }}
                                        </small>
                                    </div>
                                    <div>
                                        <button ng-click="SelectSupervisor(x)" class="btn btn-circle">
                                            <i class="fas fa-plus"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="text-end">
                            <button class="btn btn-light" data-bs-dismiss="modal" aria-label="Close">
                                ปิด
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    $(".employeeCode").mask("000000");
    $(".idcard").mask("0000000000000");
    $(".date").mask("00/00/0000");
</script>
