        <div class="d-sm-flex g-3 align-items-center">
            <div class="flex-fill mb-2">
                <div class="home-muted mb-1">Core HR</div>
                <div class="home-title">สวัสดี, @displayName</div>
                <div class="home-subtitle mt-2">
                    รวมงานบริการ HR ข้อมูลพนักงาน แบบสอบถาม และการแจ้งเตือนที่เกี่ยวข้องกับคุณไว้ในหน้าเดียว
                </div>
            </div>
            <div class="col-lg-5">
                <div class="d-flex flex-wrap gap-2 justify-content-lg-end">
                    <a class="btn btn-primary" href="@Url.Page("/Service/New")" style="z-index:2;">
                        <i class="bi bi-plus-lg me-2"></i>สร้างคำขอ HR
                    </a>
                    <a class="btn btn-light border" href="@Url.Page("/Profile/Index")" style="z-index:2;">
                        <i class="bi bi-person-badge me-2"></i>ดูโปรไฟล์
                    </a>
                 @*    <a class="btn btn-light border" href="@Url.Page("/Survey/Index")" style="z-index:2;">
                        <i class="bi bi-clipboard-check me-2"></i>แบบสอบถามของฉัน
                    </a> *@
                </div>
            </div>
        </div>
        <div class="welcome-bg">
            <svg viewBox="0 0 1440 390" preserveAspectRatio="none">
                <defs>
                    <linearGradient id="welcomeGradient" x1="21%" y1="10%" x2="79%" y2="90%">
                        <stop offset="5%" stop-color="#8ed1fc"></stop>
                        <stop offset="95%" stop-color="#0693e3"></stop>
                    </linearGradient>
                </defs>

                <path d="M0,390 L0,100 C110,85 220,70 355,82 C490,94 651,132 776,137 C901,143 991,116 1096,104 C1201,92 1320,96 1440,100 L1440,390 L0,390 Z"
                      fill="url(#welcomeGradient)"
                      fill-opacity="0.35"></path>

                <path d="M0,390 L0,233 C127,222 253,211 391,217 C529,223 678,246 777,238 C877,230 927,190 1029,184 C1131,178 1286,205 1440,233 L1440,390 L0,390 Z"
                      fill="url(#welcomeGradient)"
                      fill-opacity="0.75"></path>
            </svg>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <a class="summary-tile" href="@Url.Page("/Notify/Index")">
                <div class="d-flex align-items-start justify-content-between gap-3">
                    <div>
                        <div class="summary-value">{{ summary.notifyUnread | number }}</div>
                        <div class="summary-label mt-2">แจ้งเตือนใหม่</div>
                    </div>
                    <div class="summary-icon bg-soft-rose"><i class="bi bi-bell"></i></div>
                </div>
            </a>
        </div>
        <div class="col-xl-3 col-md-6">
            <a class="summary-tile" href="@Url.Page("/Service/Index")">
                <div class="d-flex align-items-start justify-content-between gap-3">
                    <div>
                        <div class="summary-value">{{ summary.myRequestOpen | number }}</div>
                        <div class="summary-label mt-2">คำขอ HR ที่กำลังดำเนินการ</div>
                    </div>
                    <div class="summary-icon bg-soft-blue"><i class="bi bi-file-earmark-text"></i></div>
                </div>
            </a>
        </div>
        <div class="col-xl-3 col-md-6">
            <a class="summary-tile" href="@Url.Page("/Service/Approve")">
                <div class="d-flex align-items-start justify-content-between gap-3">
                    <div>
                        <div class="summary-value">{{ summary.waitApprove | number }}</div>
                        <div class="summary-label mt-2">รายการรออนุมัติ</div>
                    </div>
                    <div class="summary-icon bg-soft-orange"><i class="bi bi-check2-square"></i></div>
                </div>
            </a>
        </div>
        <div class="col-xl-3 col-md-6">
            <a class="summary-tile" href="@Url.Page("/Survey/Index")">
                <div class="d-flex align-items-start justify-content-between gap-3">
                    <div>
                        <div class="summary-value">{{ summary.surveyWaiting | number }}</div>
                        <div class="summary-label mt-2">แบบสอบถามที่รอตอบ</div>
                    </div>
                    <div class="summary-icon bg-soft-green"><i class="bi bi-ui-checks"></i></div>
                </div>
            </a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-xl-4 col-md-6">
            <a class="quick-link" href="@Url.Page("/Service/New")">
                <div class="quick-link-icon bg-soft-blue"><i class="bi bi-headset"></i></div>
                <div>
                    <div class="quick-link-title">บริการ HR</div>
                    <div class="quick-link-desc">สร้างคำขอ ติดตามสถานะ และดูประวัติการขอใช้บริการ</div>
                </div>
            </a>
        </div>
        <div class="col-xl-4 col-md-6">
            <a class="quick-link" href="@Url.Page("/Profile/Index")">
                <div class="quick-link-icon bg-soft-purple"><i class="bi bi-person-lines-fill"></i></div>
                <div>
                    <div class="quick-link-title">ข้อมูลพนักงาน</div>
                    <div class="quick-link-desc">ตรวจสอบข้อมูลพนักงาน ประวัติส่วนตัว และเอกสารที่เกี่ยวข้อง</div>
                </div>
            </a>
        </div>
        <div class="col-xl-4 col-md-6">
            <a class="quick-link" href="@Url.Page("/Survey/Index")">
                <div class="quick-link-icon bg-soft-green"><i class="bi bi-clipboard-data"></i></div>
                <div>
                    <div class="quick-link-title">แบบสำรวจ</div>
                    <div class="quick-link-desc">ตอบแบบสอบถาม และติดตามแบบสอบถามที่ได้รับมอบหมาย</div>
                </div>
            </a>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-xl-7 mb-3">
            <div class="home-panel">
                <div class="home-panel-header">
                    <div>
                        <div class="home-panel-title">สิ่งที่ต้องติดตาม</div>
                        <div class="home-muted">คำขอ HR และแบบสอบถามล่าสุดของคุณ</div>
                    </div>
                    <a class="btn btn-light border btn-sm" href="@Url.Page("/Service/Index")" title="ดูคำขอทั้งหมด">
                        <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
                <div class="home-list" ng-show="tasks.length > 0">
                    <div class="home-list-item" ng-repeat="x in tasks | limitTo:8" ng-click="openItem(x)">
                        <div class="d-flex align-items-center gap-3">
                            <div class="summary-icon {{ x.iconClass }}"><i class="{{ x.icon }}"></i></div>
                            <div class="flex-fill">
                                <div class="home-list-title text-truncate">{{ x.title }}</div>
                                <div class="home-muted mt-1 text-truncate">{{ x.detail }}</div>
                            </div>
                            <span class="status-pill {{ x.statusClass }}">{{ x.statusText }}</span>
                        </div>
                    </div>
                </div>
                <div class="home-empty" ng-show="tasks.length == 0">
                    ยังไม่มีรายการที่ต้องติดตามในตอนนี้
                </div>
            </div>
        </div>

        <div class="col-xl-5 mb-3">
            <div class="home-panel mb-3">
                <div class="home-panel-header">
                    <div>
                        <div class="home-panel-title">การแจ้งเตือน</div>
                        <div class="home-muted">รายการล่าสุดจากระบบ</div>
                    </div>
                    <a class="btn btn-light border btn-sm" href="@Url.Page("/Notify/Index")" title="ดูการแจ้งเตือนทั้งหมด">
                        <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
                <div class="home-list" ng-show="notifications.length > 0">
                    <div class="home-list-item" ng-repeat="x in notifications | limitTo:5" ng-click="openNotification(x)">
                        <div class="d-flex align-items-center gap-3">
                            <div class="quick-link-icon {{ x.is_read == 1 ? 'bg-soft-blue' : 'bg-soft-slate' }}">
                                <i class="bi bi-bell"></i>
                            </div>
                            <div class="flex-fill min-width-0">
                                <div class="home-list-title" ng-bind-html="x.detail"></div>
                                <div class="home-muted mt-1">{{ shortDate(x.actionDate) }}</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="home-empty" ng-show="notifications.length == 0">
                    ไม่มีการแจ้งเตือนใหม่
                </div>
            </div>

            @* <div class="home-panel">
                <div class="home-panel-header">
                    <div>
                        <div class="home-panel-title">ข้อมูลพนักงาน</div>
                        <div class="home-muted">สถานะข้อมูลในโปรไฟล์ของคุณ</div>
                    </div>
                    <a class="btn btn-light border btn-sm" href="@Url.Page("/Profile/Index")" title="เปิดโปรไฟล์">
                        <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
                <div class="p-3">
                    <div class="d-flex align-items-center justify-content-between gap-3 mb-2">
                        <div>
                            <div class="home-list-title">{{ displayName() }}</div>
                            <div class="home-muted">{{ valueOrDash(employee.positionDesc) }} / {{ valueOrDash(employee.departmentDesc) }}</div>
                        </div>
                        <span class="status-pill bg-soft-green">{{ profileScore() }}%</span>
                    </div>
                    <div class="home-progress mb-3">
                        <div class="home-progress-bar" ng-style="{ width: profileScore() + '%' }"></div>
                    </div>
                    <div class="row g-2">
                        <div class="col-6">
                            <div class="p-2 border rounded-3">
                                <div class="home-muted">รหัสพนักงาน</div>
                                <div class="fw-bold text-dark text-truncate">{{ valueOrDash(employee.employeeCode || employee.empCode || employee.userId) }}</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-2 border rounded-3">
                                <div class="home-muted">ประเภทพนักงาน</div>
                                <div class="fw-bold text-dark text-truncate">{{ valueOrDash(employee.employeeTypeDesc || employee.employeeType) }}</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div> *@
        </div>
    </div>
</div>

<div class="d-none" aria-hidden="true">
    <div id="payment-records-chart"></div>
    <div id="total-sales-color-graph"></div>
    <div id="task-completed-area-chart"></div>
    <div id="new-tasks-area-chart"></div>
    <div id="project-done-area-chart"></div>
    <div id="leads-overview-donut"></div>
</div>

<script>
    app.controller('HomeCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.userId = '@User.UserId()';
        $scope.notifications = [];
        $scope.requests = [];
        $scope.surveys = [];
        $scope.tasks = [];
        $scope.personal = {};
        $scope.employee = {};
        $scope.summary = {
            notifyUnread: 0,
            myRequestOpen: 0,
            waitApprove: 0,
            surveyWaiting: 0
        };

        const authHeaders = { 'authorization': 'Bearer @token' };

        $scope.valueOrDash = function (value) {
            return value === undefined || value === null || value === '' ? '-' : value;
        };

        $scope.displayName = function () {
            const firstName = $scope.personal.firstname_th || $scope.personal.firstnameTh || '';
            const lastName = $scope.personal.lastname_th || $scope.personal.lastnameTh || '';
            const fullName = (firstName + ' ' + lastName).trim();
            return fullName || '@displayName';
        };

        $scope.profileScore = function () {
            const checks = [
                $scope.displayName() && $scope.displayName() !== '-',
                $scope.employee.positionDesc,
                $scope.employee.departmentDesc,
                $scope.employee.employeeCode || $scope.employee.empCode || $scope.employee.userId,
                $scope.personal.mobile || $scope.personal.phone || $scope.personal.email
            ];
            const completed = checks.filter(Boolean).length;
            return Math.round((completed / checks.length) * 100);
        };

        $scope.shortDate = function (value) {
            if (!value) {
                return '';
            }
            if (typeof ShortDT === 'function') {
                return ShortDT(value);
            }
            return value;
        };

        $scope.postApi = function (url, data, success) {
            $.ajax({
                url: url,
                headers: authHeaders,
                type: 'POST',
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify(data),
                success: function (result) {
                    $timeout(function () {
                        success(result || {});
                        $scope.buildTasks();
                    }, 0);
                },
                error: function () {
                    $timeout(function () {
                        success({});
                        $scope.buildTasks();
                    }, 0);
                }
            });
        };

        $scope.findTotal = function (items, status) {
            if (!Array.isArray(items)) {
                return 0;
            }
            const item = items.find(x => x.status == status);
            return item ? Number(item.total || 0) : 0;
        };

        $scope.loadNotifications = function () {
            $scope.postApi('@webAPI.CurrentValue.APIEmpHub/api/Notify/DataList', {
                page: 1,
                row: 5,
                userId: $scope.userId
            }, function (result) {
                $scope.notifications = result.data || [];
                $scope.summary.notifyUnread = Number(result.total_read || 0);
            });
        };

        $scope.loadRequestSummary = function () {
            $scope.postApi('@webAPI.CurrentValue.APIEmpHub/api/Service/RequestSummary', {
                sysId: 'HR',
                userBy: $scope.userId
            }, function (result) {
                const data = Array.isArray(result) ? result : [];
                $scope.summary.myRequestOpen =
                    $scope.findTotal(data, 'Request') +
                    $scope.findTotal(data, 'Approve') +
                    $scope.findTotal(data, 'Work');
            });
        };

        $scope.loadApproveSummary = function () {
            $scope.postApi('@webAPI.CurrentValue.APIEmpHub/api/Service/ApproveSummary', {
                sysId: 'HR',
                userBy: $scope.userId
            }, function (result) {
                const data = Array.isArray(result) ? result : [];
                $scope.summary.waitApprove = $scope.findTotal(data, 'Approve');
            });
        };

        $scope.loadRecentRequests = function () {
            $scope.postApi('@webAPI.CurrentValue.APIEmpHub/api/Service/RequestList', {
                sysId: 'HR',
                userBy: $scope.userId,
                page: 1,
                row: 5,
                is_not_read: 99,
                stauts: 'Uncomplete'
            }, function (result) {
                $scope.requests = result.data || [];
            });
        };

        $scope.loadSurveys = function () {
            $scope.postApi('@webAPI.CurrentValue.APIEmpHub/api/Survey/MyList', {
                page: 1,
                row: 5,
                status: 'Waiting',
                userId: $scope.userId
            }, function (result) {
                $scope.surveys = result.data || [];
                $scope.summary.surveyWaiting = Number(result.total || 0);
            });
        };

        $scope.loadProfile = function () {
            const data = {
                userId: $scope.userId,
                create_by: $scope.userId
            };

            $scope.postApi('@webAPI.CurrentValue.APIEmpHub/api/User/UserPersonal', data, function (result) {
                $scope.personal = result.data || {};
            });

            $scope.postApi('@webAPI.CurrentValue.APIEmpHub/api/User/UserEmployee', data, function (result) {
                $scope.employee = result.data || {};
            });
        };

        $scope.buildTasks = function () {
            const requestTasks = ($scope.requests || []).map(function (x) {
                return {
                    type: 'request',
                    id: x.id,
                    title: x.title || x.subject || x.requestNo || 'คำขอ HR',
                    detail: (x.categoryDesc || x.subCategoryDesc || x.detail || '') + (x.create_date ? ' / ' + x.create_date : ''),
                    statusText: x.statusDesc || x.status || 'กำลังดำเนินการ',
                    statusClass: 'bg-soft-blue',
                    icon: 'bi bi-file-earmark-text',
                    iconClass: 'bg-soft-blue',
                    url: '@Url.Page("/Service/Detail")/' + x.id
                };
            });

            const surveyTasks = ($scope.surveys || []).map(function (x) {
                return {
                    type: 'survey',
                    id: x.id,
                    title: x.title || 'แบบสอบถาม',
                    detail: [x.start_date, x.end_date].filter(Boolean).join(' - '),
                    statusText: 'รอตอบ',
                    statusClass: 'bg-soft-green',
                    icon: 'bi bi-ui-checks',
                    iconClass: 'bg-soft-green',
                    url: '@Url.Page("/Survey/Detail")?id=' + x.id
                };
            });

            $scope.tasks = requestTasks.concat(surveyTasks);
        };

        $scope.openItem = function (x) {
            if (x && x.url) {
                window.open(x.url, '_blank');
            }
        };

        $scope.openNotification = function (x) {
            if (x && x.link) {
                x.is_read = 0;
                window.open(x.link, '_blank');
            }
        };

        $scope.init = function () {
            $scope.loadNotifications();
            $scope.loadRequestSummary();
            $scope.loadApproveSummary();
