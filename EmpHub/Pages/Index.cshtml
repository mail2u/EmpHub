@page
@model IndexModel
@{
    ViewData["Title"] = "หน้าหลัก";
    var token = User.AccessToken(HttpContext);
    var displayName = User.GetClaimsValue("given_name");
    if (String.IsNullOrWhiteSpace(displayName))
    {
        displayName = User.Identity?.Name ?? "พนักงาน";
    }
}

<style>
    .home-page {
        color: #1f2937;
    }

    .home-page .card,
    .home-page .home-panel,
    .home-page .quick-link,
    .home-page .summary-tile {
        border-radius: 8px;
    }

    .home-welcome {
        position: relative;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-left: 5px solid var(--tip-blue);
        border-radius: 8px;
        padding: 22px;
    }

    .welcome-bg {
        position: absolute;
        inset: 0;
        pointer-events: none;
    }

    .welcome-bg svg {
        position: absolute;
        right: 0;
        bottom: 0;
        width: 100%;
        height: 100%;
        display: block;
        opacity: .22;
    }


    .home-title {
        font-size: 26px;
        font-weight: 800;
        color: #111827;
        line-height: 1.25;
    }

    .home-subtitle {
        color: #6b7280;
        font-size: 14px;
    }

    .summary-tile {
        display: block;
        height: 100%;
        padding: 18px;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        color: #111827;
        text-decoration: none;
        transition: border-color .15s ease, box-shadow .15s ease, transform .15s ease;
    }

    .summary-tile:hover,
    .quick-link:hover,
    .home-list-item:hover {
        border-color: #bfd6ff;
        box-shadow: 0 10px 28px rgba(31, 41, 55, .08);
        transform: translateY(-1px);
        color: #111827;
    }

    .summary-icon {
        width: 42px;
        height: 42px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex: 0 0 auto;
    }

    .summary-value {
        font-size: 30px;
        line-height: 1;
        font-weight: 800;
        color: #111827;
    }

    .summary-label {
        color: #6b7280;
        font-size: 13px;
        font-weight: 600;
    }

    .quick-link {
        display: flex;
        align-items: center;
        gap: 14px;
        height: 100%;
        min-height: 86px;
        padding: 16px;
        border: 1px solid #e5e7eb;
        background: #ffffff;
        color: #111827;
        text-decoration: none;
        transition: border-color .15s ease, box-shadow .15s ease, transform .15s ease;
    }

    .quick-link-icon {
        width: 40px;
        height: 40px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        flex: 0 0 auto;
    }

    .quick-link-title {
        font-weight: 800;
        color: #111827;
        line-height: 1.25;
    }

    .quick-link-desc,
    .home-muted {
        color: #6b7280;
        font-size: 13px;
    }

    .home-panel {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        height: 100%;
    }

    .home-panel-header {
        padding: 16px 18px;
        border-bottom: 1px solid #eef2f7;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .home-panel-title {
        font-size: 16px;
        font-weight: 800;
        color: #111827;
    }

    .home-list {
        padding: 8px;
    }

    .home-list-item {
        border: 1px solid transparent;
        border-radius: 8px;
        padding: 12px;
        cursor: pointer;
        transition: border-color .15s ease, box-shadow .15s ease, transform .15s ease;
    }

    .home-list-item + .home-list-item {
        margin-top: 6px;
    }

    .home-list-title {
        font-weight: 700;
        color: #111827;
        line-height: 1.35;
    }

    .home-empty {
        min-height: 130px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        color: #9ca3af;
        padding: 18px;
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 9px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .bg-soft-blue { background: #eaf3ff; color: #1769c2; }
    .bg-soft-green { background: #eaf8ef; color: #198754; }
    .bg-soft-orange { background: #fff4e6; color: #c76500; }
    .bg-soft-purple { background: #f1ecff; color: #6f42c1; }
    .bg-soft-rose { background: #fff0f3; color: #c2255c; }
    .bg-soft-slate { background: #f3f4f6; color: #4b5563; }

    .home-progress {
        height: 7px;
        background: #eef2f7;
        border-radius: 999px;
        overflow: hidden;
    }

    .home-progress-bar {
        height: 100%;
        border-radius: 999px;
        background: linear-gradient(90deg, #0d6efd, #20c997);
    }

    @@media (max-width: 767.98px) {
        .home-title {
            font-size: 22px;
        }

        .summary-value {
            font-size: 26px;
        }

        .home-welcome {
            padding: 18px;
        }
    }
</style>

<div class="home-page" ng-controller="HomeCtrl">
