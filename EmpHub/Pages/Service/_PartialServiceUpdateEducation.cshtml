@{
    var token = User.AccessToken(Context);
}
<style>
    input[type="radio"]:disabled {
        background-color: #0d6efd !important;
        border-color: #0d6efd !important;
        background-image: none !important;
        opacity: 1 !important;
    }
</style>
<div ng-controller="ServiceUpdateEducationCtrl">
    <div class="bg-white rounded-4 border mb-4 overflow-hidden p-4">
        <div class="px-4 py-3 border-bottom d-flex align-items-center">
            <div class="fs-5 fw-bolder text-dark flex-fill">
                ปรับปรุงข้อมูลการศึกษา
            </div>
        </div>
        <div class="p-4 fs-6 text-dark">
            <div class="list-group list-group-flush">
                <div class="list-group-item px-0" ng-repeat="x in lEducation">
                    <div class="d-flex mb-3">
                        <div class="flex-fill me-3">
                            <div class="text-dark fw-bolder">
                                หลักสูตรหรือวุฒิการศึกษา
                            </div>
                            <div class="text-gray">{{ x.levelName != '' ? x.levelName : '-' }}</div>
                        </div>
                        <div class="">
                            <div class="text-dark fw-bolder">
                                ปีที่สำเร็จการศึกษา
                            </div>
                            <div class="text-gray">{{ x.year != '' ? x.year : '-' }}</div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="text-dark fw-bolder">
                            สถาบันการศึกษา
                        </div>
                        <div class="text-gray">{{ x.institution != '' ? x.institution : '-' }}</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    app.controller('ServiceUpdateEducationCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.LoadDetail = function () {
            return new Promise((resolve) => {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/ServiceEducation/Detail',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    dataType: 'json',
                    cache: false,
                    data: JSON.stringify({
                        refId: $scope.refId
                    }),
                    success: function (result) {
                        $timeout(async function () {
                            $scope.lEducation = result;
                            resolve(true);
                        }, 0);
                    }, error: function () {
                        resolve(false);
                    }
                });
            });
        }

        $scope.$parent.LoadFormUpdateEducation = async function (x) {
            $scope.refId = x.id;
            $scope.userId = x.userId;
            $scope.status = x.status;

            await $scope.LoadDetail();
        }
    });
</script>