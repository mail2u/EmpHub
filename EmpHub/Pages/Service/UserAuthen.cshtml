@page
@model EmpHub.Pages.Service.UserAuthenModel
@{
    ViewData["Title"] = "ดูแลระบบ";
    var token = User.AccessToken(HttpContext);
}

@section PageHeader {
    <!-- [ page-header ] start -->
    <div class="page-header">
        <div class="page-header-left d-flex align-items-center">
            <div class="page-header-title">
                <h5 class="m-b-10">บริการ HR</h5>
            </div>
            <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Page("Index")">หน้าแรก</a></li>
                <li class="breadcrumb-item">มอบหมายสิทธิ</li>
            </ul>
        </div>
    </div>
}

<div ng-controller="ManageCtrl">
    <div class="mb-3">
        <div class="fs-4">ตั้งค่ากลุ่มสิทธิ</div>
    </div>
    <div class="d-flex">
        @* Roles *@
        <div class="rounded-4 border shadow-sm p-3 bg-white" style="width:400px; min-width:400px;">
            <div class="d-flex mb-2">
                <div class="fs-5 flex-fill">กลุ่มสิทธิ</div>
                <a class="btn btn-circle" href="@Url.Page("Role")" title="Config Role">
                    <i class="fas fa-sliders-h"></i>
                </a>
            </div>
            <div class="list-group list-group-flush">
                <div class="list-group-item list-group-item-action {{ x.roleId == roleId ? 'active' : '' }}" ng-repeat="x in lRole" ng-click="SelectRole(x)">
                    {{ x.title }}
                </div>
            </div>
        </div>
        @* Users *@
        <div class="rounded-4 border shadow-sm p-3 bg-white ms-3 flex-fill">
            <div class="d-flex mb-2">
                <div class="fs-5 mb-2 flex-fill">จำนวน <b class="text-primary">{{ lData.length | number }}</b></div>
                <div class="btn btn-sm btn-light" ng-click="ShowCreate()">
                    เพิ่มผู้ใช้งาน
                </div>
            </div>
            <div style="height: calc(100vh - 375px);" class="overflow-auto position-relative">
                <table class="table table-tip mb-0">
                    <thead>
                        <tr>
                            <th>กลุ่มสิทธิ</th>
                            <th>ผู้ใช้งาน</th>
                            <th>ตำแหน่ง</th>
                            <th>ฝ่าย</th>
                            <th width="50"></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="x in lData">
                            <td>
                                {{ x.roleName }}
                            </td>
                            <td>
                                {{ x.fullname }}
                            </td>
                            <td>
                                {{ x.position }}
                            </td>
                            <td>
                                {{ x.department }}
                            </td>
                            <td class="text-end">
                                <button class="btn btn-circle" ng-click="Delete(x)" title="Remove User">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <div ng-show="lData.length == 0">
                    <div class="text-gray fs-4 position-absolute top-50 start-50 translate-middle">
                        ไม่พบข้อมูล
                    </div>
                </div>
            </div>
        </div>
    </div>
    @* Modify Modal *@
    <div id="CreateModal" class="modal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">User List</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-sm-6 mb-2">
                            <div class="position-relative">
                                <input ng-model="filter_name" class="form-control mb-2" placeholder="ค้นหา" />
                                <span class="position-absolute top-50 end-0 me-2 translate-middle-y">
                                    <i class="fas fa-search"></i>
                                </span>

                            </div>
                            <div class="list-group list-group-flush overflow-auto" style="height: calc(100vh - 370px);">
                                <div class="list-group-item d-flex align-items-center justify-content-between" ng-repeat="x in lUser | filter : filter_name">
                                    <div>
                                        <div class="fw-bolder text-secondary">
                                            {{ x.firstname_en + ' ' + x.lastname_en }}
                                        </div>
                                        <div>
                                            {{ x.firstname_th + ' ' + x.lastname_th }} <span ng-show="x.nickname != ''">({{ x.nickname }})</span>
                                        </div>
                                        <small class="text-dark">
                                            {{ x.positionDesc }} {{ x.departmentDesc }}
                                        </small>
                                    </div>
                                    <div>
                                        <button ng-click="Create(x)" class="btn btn-circle" ng-show="x.is_add != 1">
                                            <i class="fas fa-plus"></i>
                                        </button>
                                        <button ng-click="DeleteUser(x)" class="btn btn-circle" ng-show="x.is_add == 1">
                                            <i class="fas fa-check-circle text-success"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6 mb-2">
                            <div class="position-relative">
                                <input ng-model="filter_department" class="form-control mb-2" placeholder="ค้นหา" />
                                <span class="position-absolute top-50 end-0 me-2 translate-middle-y">
                                    <i class="fas fa-search"></i>
                                </span>
                            </div>
                            <div class="list-group list-group-flush overflow-auto" style="max-height: 400px;">
                                <div class="list-group-item d-flex align-items-center justify-content-between" ng-repeat="x in lDepartment | filter : filter_department">
                                    <div>
                                        <div class="fw-bolder text-secondary">
                                            {{ x.desc_th }}
                                        </div>
                                    </div>
                                    <div>
                                        <button ng-click="CreateDepartment(x)" class="btn btn-circle" ng-show="x.is_add != 1">
                                            <i class="fas fa-plus"></i>
                                        </button>
                                        <button ng-click="DeleteDepartment(x)" class="btn btn-circle" ng-show="x.is_add == 1">
                                            <i class="fas fa-check-circle text-success"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="text-end">
                        <button class="btn btn-light" data-bs-dismiss="modal" aria-label="Close">
                            ปิด
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    app.controller('ManageCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.page = 1
        $scope.row = 10;
        $scope.roleId = '';
        $scope.roleType = 'ServiceCategory';

        $scope.LoadUser = function () {
            return new Promise((resolve) => {
                if ($scope.lUser == null) {
                    $.ajax({
                        url: '@webAPI.CurrentValue.APIEmpHub/api/User/DataList'
                        , headers: { 'authorization': 'Bearer @token' }
                        , type: 'post'
                        , contentType: 'application/json'
                        , dataType: 'json'
                        , cache: false
                        , data: JSON.stringify({
                            page: 1
                            , row: 1000
                        })
                        , success: function (result) {
                            $timeout(function () {
                                $scope.lUser = result.data;
                                resolve(true);
                            }, 0);
                        }
                        , error: function () {
                            resolve(false);
                        }
                    });
                } else {
                    resolve(true);
                }
            });
        }

        $scope.LoadRole = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Role/DataList'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    roleType: $scope.roleType
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lRole = result;
                        if ($scope.lRole.length > 0) {
                            $scope.roleId = $scope.lRole[0].roleId;
                        }
                        $scope.LoadData();
                    }, 0);
                }
                , error: AjaxError
            });
        }
        $scope.LoadRole();

        $scope.LoadDepartment = function () {
            return new Promise((resolve) => {
                if ($scope.lDepartment == null) {
                    $.ajax({
                        url: '@webAPI.CurrentValue.APIEmpHub/api/MasterCode/DataList'
                        , headers: { 'authorization': 'Bearer @token' }
                        , type: 'post'
                        , contentType: 'application/json'
                        , dataType: 'json'
                        , cache: false
                        , data: JSON.stringify({
                            groupName: 'departmentCode'
                        })
                        , success: function (result) {
                            $timeout(function () {
                                $scope.lDepartment = result;
                                resolve(true);
                            }, 0);
                        }
                        , error: function () {
                            resolve(false);
                        }
                    });
                } else {
                    resolve(true);
                }
            });
        }

        $scope.LoadData = function (page = 1) {
            $scope.page = page;

            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/UserInRole/DataList'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    roleType: $scope.roleType
                    , roleId: $scope.roleId
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.tempData = result;
                        $scope.Paging();
                    }, 0);
                }
                , error: AjaxError
            });
        }

        $scope.SelectRole = function (x) {
            $scope.roleId = x.roleId;
            $scope.LoadData();
        }

        $scope.Paging = function () {
            $scope.lData = $filter('filter')($scope.tempData, $scope.name);
            $scope.total = $scope.lData.length;
        }

        $scope.SetPage = function (p) {
            $scope.page = p;
        }

        $scope.ShowCreate = async function () {
            $scope.iData = { rn: 0 };
            await $scope.LoadUser();
            await $scope.LoadDepartment();

            $scope.lUser = $scope.lUser.map(item => {
                var find = $scope.lData.find(d => d.userId == item.userId);
                item.is_add = 0;

                if (find) {
                    item.is_add = 1;
                }

                return item;
            });

            $scope.lDepartment = $scope.lDepartment.map(item => {
                var find = $scope.lData.find(d => d.userId == item.code);
                item.is_add = 0;

                if (find) {
                    item.is_add = 1;
                }

                return item;
            });

            $("#CreateModal").modal('show');
        }

        $scope.Create = function (x) {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/UserInRole/Create'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , cache: false
                , data: JSON.stringify({
                    roleId: $scope.roleId
                    , userId: x.userId
                    , fullname: x.firstname_th + ' ' + x.lastname_th
                })
                , success: function () {
                    $timeout(function () {
                        x.is_add = 1;
                        $scope.LoadData($scope.page);
                    }, 0);
                }
                , error: AjaxError
            });
        }

        $scope.CreateDepartment = function (x) {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/UserInRole/Create'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , cache: false
                , data: JSON.stringify({
                    roleId: $scope.roleId
                    , userId: x.code
                    , fullname: x.desc_th
                })
                , success: function () {
                    $timeout(function () {
                        x.is_add = 1;
                        $scope.LoadData($scope.page);
                    }, 0);
                }
                , error: AjaxError
            });
        }

        $scope.Delete = function (x) {
            alertConfirm("ลบสิทธิ์", "ต้องการยืนยันการทำรายการ", () => {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/UserInRole/Delete'
                    , headers: { 'authorization': 'Bearer @token' }
                    , type: 'post'
                    , contentType: 'application/json'
                    , cache: false
                    , data: JSON.stringify({
                        roleId: x.roleId
                        , userId: x.userId
                        , update_by: '@User.UserId()'
                    })
                    , success: function () {
                        $timeout(function () {
                            $scope.LoadData();
                        }, 0);
                    }
                    , error: AjaxError
                });
            });
        }

        $scope.DeleteUser = function (x) {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/UserInRole/Delete'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , cache: false
                , data: JSON.stringify({
                    roleId: $scope.roleId
                    , userId: x.userId
                    , update_by: '@User.UserId()'
                })
                , success: function () {
                    $timeout(function () {
                        x.is_add = 0;
                        $scope.LoadData();
                    }, 0);
                }
                , error: AjaxError
            });
        }

        $scope.DeleteDepartment = function (x) {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/UserInRole/Delete'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , cache: false
                , data: JSON.stringify({
                    roleId: $scope.roleId
                    , userId: x.code
                    , update_by: '@User.UserId()'
                })
                , success: function () {
                    $timeout(function () {
                        x.is_add = 0;
                        $scope.LoadData();
                    }, 0);
                }
                , error: AjaxError
            });
        }

        $scope.Download = function () {
            var JSData = [[
                { 'text': 'Role' }
                , { 'text': 'User' }
            ]];

            if ($scope.tempData.length > 0) {
                for (var i = 0; i < $scope.tempData.length; i++) {
                    var iData = $scope.tempData[i];

                    JSData.splice(JSData.length, 0, [
                        { 'text': iData.roleName }
                        , { 'text': iData.fullname }
                    ]);
                }

                ExportFile(JSData, 'RoleList');
            }
        }

    });
</script>