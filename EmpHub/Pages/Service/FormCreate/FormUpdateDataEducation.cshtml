@page
@model EmpHub.Pages.Service.FormCreate.FormUpdateDataEducationModel
@{
    var token = User.AccessToken(HttpContext);
}
<style>
    .main-content{
        min-height:calc(100vh - 150px) !important;
    }

    .list-item-box{
        border: 2px solid white;
        background-color: var(--bs-light);
    }

    .list-item-box:hover{
        border: 2px solid var(--bs-blue);
    }
</style>
<style>
    .form-input {
        padding: 5px;
        border: 0px;
        border-radius: 0;
        border-bottom: 2px solid var(--bs-gray-400);
        background-color: #fcfcfc;
    }

    .form-input:focus {
        border-bottom: 2px solid var(--tip-blue);
    }

    input.form-input:read-only {
        background-color: var(--bs-gray-200);
    }

    .btn-box-dash {
        border: 2px dashed var(--bs-gray-300);
    }

    .btn-box-dash:hover {
        border: 2px dashed var(--bs-blue);
        color: var(--bs-blue) !important;
    }
</style>
<div ng-controller="ServiceEducationCtrl" id="tab_education">
    @* Header *@
    <partial name="_PartialFormHeader" />
    @* View *@
    <div class="rounded-4 mb-3 bg-white shadow-sm p-4">
        <div class="list-group list-group-flush">
            <div class="list-group-item p-0" ng-repeat="x in lData | filter : {mode:'modify'}">
                <div class="list-item-box p-4 mb-3 rounded-3">
                    <div class="fw-bolder">
                        {{ indexDesc($index) }}
                    </div>
                    <div class="d-flex mb-3">
                        <div class="flex-fill me-3">
                            <div class="text-gray">
                                วุฒิการศึกษา
                            </div>
                            <select ng-model="x.degreeCode" class="form-select form-input" ng-options="d.code as d.desc_th for d in lDegree"></select>
                        </div>
                        <div class="me-3" style="width:150px;">
                            <div class="text-gray">
                                ปีที่สำเร็จการศึกษา
                            </div>
                            <input ng-model="x.year" class="form-control form-input" year />
                        </div>
                    </div>
                    <div class="d-flex flex-fill mb-3">
                        <div class="flex-fill me-3">
                            <div class="text-gray">
                                สถาบันการศึกษา
                            </div>
                            <div class="dropdown">
                                <input ng-model="x.institutionDesc" class="form-control form-input bg-white icon-search dropdown-toggle" readonly data-bs-toggle="dropdown" />
                                <div class="dropdown-menu p-2 rounded-3" style="width:400px;">
                                    <input ng-model="find_institution" class="form-control mb-2" />
                                    <div class="overflow-auto list-group list-group-flush" style="height:400px">
                                        <div class="list-group-item list-group-item-action" ng-repeat="d in lInstitution | filter : find_institution" ng-click="SelectInstitution(d, x)">
                                            {{ d.desc_th }}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="flex-fill me-3">
                            <div class="text-gray">
                                หลักสูตร
                            </div>
                            <select ng-model="x.programCode" class="form-select form-input" ng-options="d.code as d.desc_th for d in lProgram"></select>
                        </div>
                    </div>
                    <div class="d-flex flex-fill mb-3">
                        <div class="flex-fill me-3">
                            <div class="text-gray">
                                สาขาวิชา
                            </div>
                            <input ng-model="x.major" class="form-control form-input" maxlength="200" />
                        </div>
                        <div class="" style="width:150px;">
                            <div class="text-gray">
                                เกรดเฉลี่ย
                            </div>
                            <input ng-model="x.grade" amount="x.grade" class="form-control form-input grade" format-to-currency maxlength="4" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="text-gray">
                            เพิ่มกิจกรรม เกียรตินิยม รางวัล หรือโครงการพิเศษที่ประสบความสำเร็จระหว่างการศึกษา
                        </div>
                        <textarea ng-model="x.description" class="form-control form-input" rows="5" maxlength="4000"></textarea>
                    </div>
                    <div class="mb-3">
                        <div class="text-gray">
                            เอกสารหลักฐานวุฒิการศึกษา (ใบปริญญาบัตร / ใบรับรอง / ทรานสคริปต์)
                            <span class="text-danger" ng-show="x.is_new">*</span>
                        </div>
                        <div class="text-gray small mb-2">
                            แนบไฟล์ PDF, JPG หรือ PNG ขนาดไม่เกิน 10 MB ต่อไฟล์ เพื่อให้ผู้อนุมัติตรวจสอบ
                            <span ng-show="x.is_new">(รายการที่เพิ่มใหม่ต้องแนบเอกสาร)</span>
                        </div>
                        <label for="edufile_{{$index}}" class="btn btn-box-dash select">
                            <i class="fas fa-paperclip me-2"></i> เลือกไฟล์
                        </label>
                        <input class="d-none" base-sixty-four-input id="edufile_{{$index}}" type="file" accept=".pdf,.jpg,.jpeg,.png" ng-model="x.fileModel" ng-change="AddAttach(x)" />
                        <div class="list-group list-group-flush mt-2">
                            <div class="list-group-item bg-gray rounded-3 mb-1" ng-repeat="a in x.lAttachFile" title="{{ a.filename }}">
                                <div class="d-flex align-items-center">
                                    <div>
                                        <i class="bi bi-file-earmark-check text-green"></i>
                                    </div>
                                    <div class="text-truncate mx-2 flex-fill" style="min-width: 0;">
                                        {{ a.filename }}
                                    </div>
                                    <div class="text-gray small me-2 text-nowrap">
                                        {{ FileSizeText(a.filesize) }}
                                    </div>
                                    <div>
                                        <div class="btn btn-circle" ng-click="DeleteAttach(x, a)">
                                            <i class="bi bi-trash"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center justify-content-end">
                        <div class="text-gray small" ng-show="!x.is_new">
                            <i class="bi bi-lock-fill me-1"></i>ข้อมูลนี้บันทึกในระบบแล้ว จึงไม่สามารถลบได้
                        </div>
                        <div class="btn btn-warning-invert bg-white" ng-show="x.is_new" ng-click="Delete(x)">
                            <i class="far fa-trash-alt me-2"></i>ยกเลิกรายการนี้
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="btn btn-light" ng-click="New()">
            เพิ่มข้อมูลการศึกษา
        </div>
    </div>
    <div class="d-flex justify-content-end">
        <div class="btn btn-primary" ng-click="Save()">
            <i class="far fa-paper-plane me-2"></i> ส่งใบคำขอ
        </div>
    </div>
</div>
<script>
    app.controller('ServiceEducationCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.mode = '@Model.mode';
        $scope.userId = '@Model.id';

        // $scope.lStatus = [{ value: 'modify', key: 'เพิ่ม/แก้ไข' }, { value: 'delete', key: 'ลบข้อมูล' }]

        $scope.LoadMaster = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/MasterCode/DataList'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    groupName: 'educationCode'
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lEduction = result;
                    }, 0);
                }
                , error: AjaxError
            });

            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/MasterCode/DataList'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    groupName: 'institution'
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lInstitution = result;
                    }, 0);
                }
                , error: AjaxError
            });

            
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/MasterCode/DataList'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    groupName: 'Degree'
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lDegree = $filter('orderBy')(result, 'condition_1');
                    }, 0);
                }
                , error: AjaxError
            });
        }
        $scope.LoadMaster();

        $scope.indexDesc = function (index) {
            if (index == 0) {
                return 'วุฒิการศึกษาสูงสุด';
            } else if (index == 1) {
                return 'วุฒิการศึกษารองลงมา';
            } else {
                return 'วุฒิการศึกษาลำดับที่ ' + (index + 1);
            }
        }

        $scope.LoadData = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/UserEducation',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    userId: $scope.userId
                    , create_by: '@User.UserId()'
                }),
                success: function (result) {
                    $timeout(async function () {
                        $scope.iData = {id:''};
                        $scope.lData = result.data;

                        if(result.can_edit != 1){
                            alertWarning("ท่านไม่ได้สิทธิ์ให้เข้าถึงหน้านี้","กรุณาตรวจสอบ",function(){
                                location.href = '@Url.Page("/Service/Index")';
                            })
                        }else{

                            if($scope.lData.length == 0){
                                $scope.New();
                            }else{
                                $scope.lData = $scope.lData.map(item=>{
                                    item.mode = "modify";
                                    item.educationId = item.educationId || NewGuid();
                                    item.lAttachFile = [];
                                    item.is_new = false;

                                    return item;
                                });
                            }
                        }
                    }, 0);
                }, error: AjaxError
            });
        }
        $scope.LoadData();

        $scope.SelectInstitution = function(d, x){
            x.institution = d.code;
            x.institutionDesc = d.desc_th;
        }

        // is_new = true คือรายการที่ยังไม่ถูกบันทึกในระบบ ต้องแนบเอกสาร และยกเลิกออกได้
        $scope.New = function(){
            $timeout(function () {
                $scope.lData.splice($scope.lData.length, 0, { educationId: NewGuid(), institution:'', grade: 0, mode: "modify", lAttachFile: [], is_new: true });
            }, 0);
        }

        $scope.MAX_FILE_SIZE = 10485760;
        $scope.ALLOW_FILE_TYPE = ['pdf', 'jpg', 'jpeg', 'png'];

        $scope.FileSizeText = function (size) {
            size = size || 0;

            if (size >= 1048576) {
                return (size / 1048576).toFixed(2) + ' MB';
            }

            return Math.max(Math.round(size / 1024), 1) + ' KB';
        }

        $scope.AddAttach = function (x) {
            var iFile = x.fileModel;
            x.fileModel = null;

            if (!iFile || !iFile.filename) {
                return;
            }

            var ext = iFile.filename.split('.').pop().toLowerCase();

            if ($scope.ALLOW_FILE_TYPE.indexOf(ext) < 0) {
                alertWarning("ปัญหาการแนบไฟล์", "รองรับเฉพาะไฟล์ PDF, JPG และ PNG");
                return;
            }

            if (iFile.filesize > $scope.MAX_FILE_SIZE) {
                alertWarning("ปัญหาการแนบไฟล์", "ไฟล์ " + iFile.filename + " มีขนาดเกิน 10 MB");
                return;
            }

            x.lAttachFile = x.lAttachFile || [];

            if (x.lAttachFile.find(a => a.filename == iFile.filename)) {
                alertWarning("ปัญหาการแนบไฟล์", "มีไฟล์ชื่อนี้แนบอยู่แล้ว");
                return;
            }

            x.lAttachFile.splice(x.lAttachFile.length, 0, iFile);
        }

        $scope.DeleteAttach = function (x, a) {
            var index = x.lAttachFile.indexOf(a);

            if (index > -1) {
                x.lAttachFile.splice(index, 1);
            }
        }

        // ลบได้เฉพาะรายการที่ยังไม่บันทึกในระบบ ข้อมูลที่บันทึกแล้วห้ามลบผ่านใบคำขอนี้
        $scope.Delete = function(x){
            if (!x.is_new) {
                return;
            }

            var Remove = function () {
                $timeout(function () {
                    var index = $scope.lData.indexOf(x);

                    if (index > -1) {
                        $scope.lData.splice(index, 1);
                    }
                }, 0);
            }

            if ((x.lAttachFile || []).length > 0) {
                alertConfirm("ยืนยันการยกเลิกรายการ", "เอกสารที่แนบไว้ในรายการนี้จะถูกนำออกด้วย", Remove);
                return;
            }

            Remove();
        }

        // ตรวจเข้มเฉพาะรายการที่เพิ่มใหม่ ข้อมูลเดิมในระบบที่ไม่สมบูรณ์จะไม่บล็อกการส่ง (EducationPayload คัดออกให้)
        $scope.Validate = function(){
            var lRow = $scope.lData.filter(item => item.mode == 'modify');
            var lMissingData = [];
            var lMissingFile = [];

            lRow.forEach(function (x, index) {
                if (!x.is_new) {
                    return;
                }

                var label = $scope.indexDesc(index);

                if (!x.institution) {
                    lMissingData.push(label);
                    return;
                }

                if ((x.lAttachFile || []).length == 0) {
                    lMissingFile.push(label);
                }
            });

            if (lMissingData.length > 0) {
                alertWarning("ข้อมูลไม่ครบ", "กรุณาเลือกสถาบันการศึกษาของ " + lMissingData.join(', '));
                return false;
            }

            if (lMissingFile.length > 0) {
                alertWarning("ต้องแนบเอกสาร", "รายการที่เพิ่มใหม่ต้องแนบเอกสารหลักฐานวุฒิการศึกษา : " + lMissingFile.join(', '));
                return false;
            }

            if (lRow.filter(item => item.institution).length == 0) {
                alertWarning("แจ้งเตือน", "กรุณาเพิ่มข้อมูลการศึกษาอย่างน้อย 1 รายการ");
                return false;
            }

            return true;
        }

        $scope.Save = async function () {
            if($scope.Validate()){
                alertConfirm("ยืนยันการทำรายการ","ท่านต้องการส่งใบคำขอ", async function(){
                    var id = await $scope.CreateService();

                    if(id){
                        $scope.iData.id = id;
                        $scope.lData = $scope.lData.map(item => {
                            item.id = id;
                            item.refId = id;

                            return item;
                        });

                        var flag = await $scope.CreateEducation();

                        if(flag){
                            flag = await $scope.UploadAttachFile(id);
                        }

                        if(flag){
                            var serviceNo = await $scope.ServiceRequest();

                            if(serviceNo){
                                alertSuccess("ทำรายการสำเร็จ","ระบบบันทึกใบคำขอของท่านเรียบร้อย", function(){
                                    location.href = '@Url.Page("/Service/Index")';
                                });
                            }else{
                                $scope.CancelService();
                            }
                        }else{
                            $scope.CancelService();
                        }
                    }
                });
            }
        }

        // ไฟล์แนบส่งแยกทาง api/File/Create จึงตัด lAttachFile/fileModel ออก ไม่ให้ base64 ติดไปกับ payload
        $scope.EducationPayload = function () {
            return $scope.lData.filter(item => item.institution).map(function (item) {
                var iSave = {};

                Object.keys(item).forEach(function (key) {
                    if (key != 'lAttachFile' && key != 'fileModel' && key != 'is_new') {
                        iSave[key] = item[key];
                    }
                });

                return iSave;
            });
        }

        $scope.CreateEducation = function () {
            return new Promise((resolve)=>{
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/ServiceEducation/Save',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    cache: false,
                    data: JSON.stringify($scope.EducationPayload()),
                    success: function () {
                        $timeout(async function () {
                           resolve(true);
                        }, 0);
                    }, error: function(jqXHR, error, errorThrown) {
                        resolve(null);
                        Swal.fire({
                            title: "ระบบเกิดข้อผิดพลาด",
                            text: jqXHR.responseText,
                            icon: "error",
                            confirmButtonColor: '#1e3b92',
                        });
                    }
                });
            });
        }

        // attachCode = educationId ทำให้ใบงานจับคู่ไฟล์กับวุฒิแต่ละรายการได้
        $scope.UploadAttachFile = async function (refId) {
            var flag = true;
            var fileindex = 0;
            var lRow = $scope.lData.filter(item => item.mode == 'modify' && item.institution && (item.lAttachFile || []).length > 0);

            for (var i = 0; i < lRow.length; i++) {
                var iRow = lRow[i];

                for (var a = 0; a < iRow.lAttachFile.length; a++) {
                    var iFile = iRow.lAttachFile[a];
                    fileindex++;

                    var upload = await $scope.UploadFile({
                        refId: refId
                        , attachCode: iRow.educationId
                        , callerId: 'EDIT_EDUCATION'
                        , filename: iFile.filename
                        , filetype: iFile.filetype
                        , filesize: iFile.filesize
                        , base64: iFile.base64
                        , fileindex: fileindex
                        , userId: $scope.userId
                        , create_by: '@User.UserId()'
                    });

                    flag = upload ? flag : false;
                }
            }

            return flag;
        }

        $scope.UploadFile = function (x) {
            return new Promise((resolve) => {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/File/Create',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    dataType: 'json',
                    cache: false,
                    data: JSON.stringify(x),
                    success: function () {
                        $timeout(function () {
                            resolve(true);
                        }, 0);
                    },
                    error: function (jqXHR) {
                        resolve(false);
                        Swal.fire({
                            title: "แนบไฟล์ไม่สำเร็จ",
                            text: x.filename + ' : ' + jqXHR.responseText,
                            icon: "error",
                            confirmButtonColor: '#1e3b92',
                        });
                    }
                });
            });
        }
    });
</script>