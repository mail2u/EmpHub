@page
@model EmpHub.Pages.Service.FormCreate.FormUpdateDataPersonalModel
@{
    var token = User.AccessToken(HttpContext);
}
<style>
    .main-content{
        min-height:calc(100vh - 150px) !important;
    }

    .form-input {
        padding: 5px;
        border: 0px;
        border-radius: 0;
        border-bottom: 2px solid var(--bs-gray-400);
        background-color: #fcfcfc;
    }

    .form-input:focus {
        border-bottom: 2px solid var(--tip-blue);
    }

    input.form-input:read-only {
        background-color: var(--bs-gray-200);
    }
</style>
<div ng-controller="ServicePersonalCtrl" id="tab_personal">
    @* Header *@
    <partial name="_PartialFormHeader" />
    @* View *@
    <div class="rounded-4 mb-3 bg-white shadow-sm p-4">
        <div class="d-flex">
            <div class="row text-dark">
                <div class="col-sm-4 mb-3">
                    <div>คำนำหน้า (ภาษาไทย) <span class="text-danger">*</span></div>
                    <select ng-model="iData.prefix_th" class="form-select form-input prefix_th" ng-options="x.desc_th as x.desc_th for x in lPrefix" ng-change="SelectPrefixTH()"></select>
                </div>
                <div class="col-sm-4 mb-3">
                    <div>ชื่อ (ภาษาไทย) <span class="text-danger">*</span></div>
                    <input ng-model="iData.firstname_th" class="form-control form-input firstname_th" />
                </div>
                <div class="col-sm-4 mb-3">
                    <div>นามสกุล (ภาษาไทย) <span class="text-danger">*</span></div>
                    <input ng-model="iData.lastname_th" class="form-control form-input lastname_th" />
                </div>
                <div class="col-sm-4 mb-3">
                    <div>คำนำหน้า (ภาษาอังกฤษ) </div>
                    <select ng-model="iData.prefix_en" class="form-select form-input prefix_en" ng-options="x.desc_en as x.desc_en for x in lPrefix" ng-change="SelectPrefixEN()"></select>
                </div>
                <div class="col-sm-4 mb-3">
                    <div>ชื่อ (ภาษาอังกฤษ) </div>
                    <input ng-model="iData.firstname_en" class="form-control form-input firstname_en" />
                </div>
                <div class="col-sm-4 mb-3">
                    <div>นามสกุล (ภาษาอังกฤษ) </div>
                    <input ng-model="iData.lastname_en" class="form-control form-input lastname_en" />
                </div>
                <div class="col-sm-4 mb-3">
                    <div class="text-dark fw-bolder">ชื่อเล่น</div>
                    <input ng-model="iData.nickname" class="form-control form-input nickname" />
                </div>
                <div class="col-sm-4 mb-3">
                    <div class="text-dark fw-bolder">วันเกิด</div>
                    <input ng-model="iData.birth_date" class="form-control form-input date birth_date" />
                    @* <input class="form-control form-input date birth_date icon-calendar"
                           ng-model="iData.birth_date_select"
                           moment-picker="iData.birth_date_select"
                           locale="th"
                           format="DD/MM/YYYY"
                           min-view="month"
                           max-view="month" required /> *@
                </div>
                <div class="col-sm-4 mb-3">
                    <div class="text-dark fw-bolder">เพศ</div>
                    <select ng-model="iData.sex" class="form-select form-input sex" ng-options="x.value as x.key for x in lSex"></select>
                </div>
                <div class="col-sm-4 mb-3">
                    <div class="text-dark fw-bolder">น้ำหนัก</div>
                    <input ng-model="iData.weight" class="form-control form-input weight" />
                </div>
                <div class="col-sm-4 mb-3">
                    <div class="text-dark fw-bolder">ส่วนสูง</div>
                    <input ng-model="iData.height" class="form-control form-input height" />
                </div>
                <div class="col-sm-4 mb-3">
                    <div class="text-dark fw-bolder">กรุ๊ปเลือด</div>
                    <select ng-model="iData.blood" class="form-select form-input blood" ng-options="x as x for x in lBlood"></select>
                </div>
                <div class="col-sm-4 mb-3">
                    <div class="text-dark fw-bolder">สัญชาติ</div>
                    <select ng-model="iData.nationality" class="form-select form-input nationality" ng-options="x.code as x.desc_th for x in lNationality"></select>
                </div>
                <div class="col-sm-4 mb-3">
                    <div class="text-dark fw-bolder">เชื้อชาติ</div>
                    <select ng-model="iData.ethnicity" class="form-select form-input ethnicity" ng-options="x.code as x.desc_th for x in lEthnicity"></select>
                </div>
                <div class="col-sm-4 mb-3">
                    <div class="text-dark fw-bolder">ศาสนา</div>
                    <select ng-model="iData.religion" class="form-select form-input religion" ng-options="x.code as x.desc_th for x in lReligion"></select>
                </div>
                <div class="col-sm-4 mb-3">
                    <div class="text-dark fw-bolder">สถานภาพการสมรส</div>
                    <select ng-model="iData.maritalStatus" class="form-select form-input maritalStatus" ng-options="x.code as x.desc_th for x in lMarital"></select>
                </div>
                <div class="col-sm-4 mb-3">
                    <div class="text-dark fw-bolder">สถานะทางการทหาร</div>
                    <select ng-model="iData.militaryStatus" class="form-select form-input militaryStatus" ng-options="x.code as x.desc_th for x in lMilitary"></select>
                </div>
                <div class="col-sm-4 mb-3">
                    <div class="text-dark fw-bolder">สถานะความพิการ</div>
                    <select ng-model="iData.disabilityStatus" class="form-select form-input disabilityStatus" ng-options="x.code as x.desc_th for x in lDisability"></select>
                </div>
            </div>
        </div>
    </div>
    <div class="d-flex justify-content-end">
        <div class="btn btn-primary" ng-click="Save()">
            <i class="far fa-paper-plane me-2"></i> Send Request
        </div>
    </div>
</div>
<script>
    $(".weight").mask("000");
    $(".height").mask("000");
    $(".date").mask("00/00/0000");
    $(".phone").mask("000-000-0000");
    app.controller('ServicePersonalCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.mode = '@Model.mode';
        $scope.userId = '@Model.id';

        $scope.lSex = [
            { key: 'ชาย', value: 'M' }
            , { key: 'หญิง', value: 'F' }
        ];
        $scope.lBlood = ['A', 'B', 'AB', 'O'];

        $scope.LoadInit = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/MasterCode/DataList'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    groupName: 'Disability'
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lDisability = result;
                    }, 0);
                }
                , error: AjaxError
            });
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/MasterCode/DataList'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    groupName: 'Ethnicity'
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lEthnicity = result;
                    }, 0);
                }
                , error: AjaxError
            });
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/MasterCode/DataList'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    groupName: 'Marital'
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lMarital = result;
                    }, 0);
                }
                , error: AjaxError
            });
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/MasterCode/DataList'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    groupName: 'Military'
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lMilitary = result;
                    }, 0);
                }
                , error: AjaxError
            });
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/MasterCode/DataList'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    groupName: 'Nationality'
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lNationality = result;
                    }, 0);
                }
                , error: AjaxError
            });
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/MasterCode/DataList'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    groupName: 'Religion'
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lReligion = result;
                    }, 0);
                }
                , error: AjaxError
            });
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/MasterCode/DataList'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    groupName: 'Prefix'
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lPrefix = result;
                    }, 0);
                }
                , error: AjaxError
            });
        }
        $scope.LoadInit();

        $scope.LoadData = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/UserPersonal',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    userId: $scope.userId
                    , create_by: '@User.UserId()'
                }),
                success: function (result) {
                    $timeout(async function () {
                        $scope.iData = result.data;

                        if(result.can_edit != 1){
                            alertWarning("ท่านไม่ได้สิทธิ์ให้เข้าถึงหน้านี้","กรุณาตรวจสอบ",function(){
                                location.href = '@Url.Page("/Service/Index")';
                            })
                        }
                        
                        if ($scope.iData.birth_date != '' && $scope.iData.birth_date != undefined) {
                            var date = ConvertToDate($scope.iData.birth_date);
                            $scope.iData.birth_date_select = new moment(date);
                        }
                    }, 0);
                }, error: AjaxError
            });
        }
        $scope.LoadData();

        $scope.SelectPrefixTH = function () {
            var find = $scope.lPrefix.find(item => item.desc_th == $scope.iData.prefix_th);

            if(find){
                $scope.iData.prefix_en = find.desc_en;
            }
        }

        $scope.SelectPrefixEN = function () {
            var find = $scope.lPrefix.find(item => item.desc_en == $scope.iData.prefix_en);

            if (find) {
                $scope.iData.prefix_th = find.desc_th;
            }
        }

        $scope.Validate = function(){
            var flag = true;
            JS_Reset($(".prefix_th"));
            JS_Reset($(".firstname_th"));
            JS_Reset($(".lastname_th"));

            if ($scope.iData.prefix_th == '') {
                flag = false;
                JS_Require($(".prefix_th"));
            }
            if ($scope.iData.firstname_th == '') {
                flag = false;
                JS_Require($(".firstname_th"));
            }
            if ($scope.iData.lastname_th == '') {
                flag = false;
                JS_Require($(".lastname_th"));
            }

            return flag;
        }

        $scope.Save = async function () {
            if($scope.Validate()){
                alertConfirm("ยืนยันการทำรายการ","ท่านต้องการส่งใบคำขอ", async function(){
                    var id = await $scope.CreateService();

                    if(id){
                        $scope.iData.id = id;
                        $scope.iData.refId = id;
                        
                        var flag = await $scope.CreatePersonal();

                        if(flag){
                            var serviceNo = await $scope.ServiceRequest();

                            if(serviceNo){
                                alertSuccess("ทำรายการสำเร็จ","ระบบบันทึกใบคำขอของท่านเรียบร้อย", function(){
                                    location.href = '@Url.Page("/Service/Index")';
                                });
                            }else{
                                $scope.CancelService();
                            }
                        }else{
                            $scope.CancelService();
                        }
                    }
                });
            }else{
                alertWarning("แจ้งเตือน","กรุณากรอกข้อมูลให้ครบ");
            }
        }
        
        $scope.CreatePersonal = function(){
            return new Promise((resolve)=>{
                if ($scope.iData.birth_date_select) {
                    $scope.iData.birth_date = $scope.iData.birth_date_select.format("DD/MM/YYYY");
                }

                $scope.iData.weight = parseInt($scope.iData.weight);
                $scope.iData.height = parseInt($scope.iData.height);

                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/Form/FormUpdatePersonalCreate',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    cache: false,
                    data: JSON.stringify($scope.iData),
                    success: function () {
                        $timeout(async function () {
                           resolve(true);
                        }, 0);
                    }, error: function(jqXHR, error, errorThrown) {
                        resolve(null);
                        Swal.fire({
                            title: "ระบบเกิดข้อผิดพลาด",
                            text: jqXHR.responseText,
                            icon: "error",
                            confirmButtonColor: '#1e3b92',
                        });
                    }
                });
            });
        }
    });
</script>