@page
@model EmpHub.Pages.Service.FormCreate.FormUpdateDataDocumentModel

@{
    var token = User.AccessToken(HttpContext);
}
<style>
    .main-content{
        min-height:calc(100vh - 150px) !important;
    }

    .list-item-box{
        border: 2px solid white;
        background-color: var(--bs-light);
    }

    .list-item-box:hover{
        border: 2px solid var(--bs-blue);
    }

    .form-input {
        padding: 5px;
        border: 0px;
        border-radius: 0;
        border-bottom: 2px solid var(--bs-gray-400);
        background-color: #fcfcfc;
    }

    .form-input:focus {
        border-bottom: 2px solid var(--tip-blue);
    }

    input.form-input:read-only {
        background-color: var(--bs-gray-200);
    }

    .btn-box-dash{
        border:2px dashed var(--bs-gray-300);
    }

    .btn-box-dash:hover {
        border: 2px dashed var(--bs-blue);
            color: var(--bs-blue) !important;
    }
</style>
<div ng-controller="ServiceDocumentCtrl">
    @* Header *@
    <partial name="_PartialFormHeader" />
    @* View *@
    <div class="">
        <div class="row">
            <div class="col-sm-6 mb-3" ng-repeat="x in lForm">
                <div class="rounded-4 mb-3 bg-white border shadow-sm p-4">
                    <div class="fw-bolder mb-3 fs-6 text-dark">
                        {{ x.title }}
                    </div>
                    <label for="file_{{$index}}" class="btn btn-box-dash select" ng-click="SelectBox(x)" ng-show="x.lAttachFile.length == 0">
                        <i class="fas fa-paperclip me-2"></i> เลือกไฟล์
                    </label>
                    <input class="d-none" base-sixty-four-input id="file_{{$index}}" type="file" ng-model="x.fileModel" ng-change="AddAttach(x)">
                    <div class="list-group list-group-flush">
                        <div class="list-group-item list-group-item-action bg-gray rounded-3" ng-repeat="a in x.lAttachFile" title="{{ a.filename }}">
                            <div class="d-flex align-items-center">
                                <div>
                                    <i class="bi bi-file-earmark-check text-green"></i>
                                </div>
                                <div class="text-truncate mx-2 flex-fill" style="min-width: 0;">
                                    {{a.filename }}
                                </div>
                                <div>
                                    <div class="btn btn-circle" ng-click="DeleteAttach(x, a)">
                                        <i class="bi bi-trash"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="d-flex justify-content-end">
        <div class="btn btn-primary" ng-click="Save()">
            <i class="far fa-paper-plane me-2"></i> ส่งใบคำขอ
        </div>
    </div>
</div>
<script>
    app.controller('ServiceDocumentCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.mode = '@Model.mode';
        $scope.userId = '@Model.id';
        $scope.iData = {};
        $scope.lForm = [];

        $scope.LoadMaster = function () {
            if (!$scope.lDocumentType) {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/MasterCode/DataList'
                    , headers: { 'authorization': 'Bearer @token' }
                    , type: 'post'
                    , contentType: 'application/json'
                    , dataType: 'json'
                    , cache: false
                    , data: JSON.stringify({
                        groupName: 'DocumentType'
                    })
                    , success: function (result) {
                        $timeout(function () {
                            $scope.lDocumentType = result;
                            $scope.lForm = $scope.lDocumentType.map(item => ({
                                documentType: item.code
                                , title: item.desc_th
                                , lAttachFile: []
                            }));
                        }, 0);
                    }
                    , error: AjaxError
                });
            }
        }
        $scope.LoadMaster();

        $scope.AddAttach = function (x) {
            var is_file_size_over = 0;
            var find = x.lAttachFile.find(a => a.filename == x.fileModel.filename);

            if (!find) {
                if (x.fileModel.filesize <= 20971520) {
                    x.lAttachFile.splice(x.lAttachFile.length, 0, x.fileModel);
                } else {
                    is_file_size_over = 1;
                }
            }

            if (is_file_size_over == 1) {
                alertWarning("ปัญหาการแนบไฟล์", "พบบางไฟล์มีเกิน 20 MB");
            }

            x.fileModel = null;
        }

        $scope.DeleteAttach = function (x, a) {
            var index = x.lAttachFile.indexOf(a);
            x.lAttachFile.splice(index, 1);
        }

        $scope.Delete = function(x){
            $timeout(function () {
                x.mode = "delete";
            }, 0);
        }

        $scope.Validate = function(){
            var flag = true;

            var check_have = $scope.lForm.find(item => item.lAttachFile.length > 0);

            if (!check_have){
                flag = false;
            }

            return flag;
        }

        $scope.Save = async function () {
            if($scope.Validate()){
                alertConfirm("ยืนยันการทำรายการ","ท่านต้องการส่งใบคำขอ", async function(){
                    var id = await $scope.CreateService();

                    if(id){
                        $scope.iData.id = id;
                        var lForm = $scope.lForm.filter(item => item.lAttachFile.length > 0).map(item => ({
                            refId : id
                            ,
                            userId : $scope.userId
                            ,
                            documentType: item.documentType
                            ,
                            lAttachFile: item.lAttachFile
                        }));

                        var flag = true;

                        for (var i = 0; i < lForm.length; i++) {
                            var iForm = lForm[i];
                            var create_document = await $scope.CreateDocument(iForm);
                            flag = create_document ? flag : false;

                            for (var a = 0; a < iForm.lAttachFile.length; a++) {
                                var iAttach = iForm.lAttachFile[a];
                                iAttach.refId = iForm.documentId;

                                var upload_file = await $scope.UploadFile(iAttach);
                                flag = upload_file ? flag : false;
                            }
                        }

                        if(flag){
                            var serviceNo = await $scope.ServiceRequest();

                            if(serviceNo){
                                alertSuccess("ทำรายการสำเร็จ","ระบบบันทึกใบคำขอของท่านเรียบร้อย", function(){
                                    location.href = '@Url.Page("/Service/Index")';
                                });
                            }else{
                                $scope.CancelService();
                            }
                        }else{
                            $scope.CancelService();
                        }
                    }
                });
            }else{
                alertWarning("แจ้งเตือน","ไม่พบเอกสารอัพโหลด");
            }
        }

        $scope.CreateDocument = function (x) {
            return new Promise((resolve)=>{
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/Form/FormUpdateDocumentCreate',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    dataType: 'json',
                    cache: false,
                    data: JSON.stringify(x),
                    success: function (result) {
                        $timeout(async function () {
                            x.documentId = result.documentId;
                           resolve(true);
                        }, 0);
                    }, error: function(jqXHR, error, errorThrown) {
                        resolve(null);
                        Swal.fire({
                            title: "ระบบเกิดข้อผิดพลาด",
                            text: jqXHR.responseText,
                            icon: "error",
                            confirmButtonColor: '#1e3b92',
                        });
                    }
                });
            });
        }

        $scope.UploadFile = function (x) {
            return new Promise((resolve) => {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/File/Create',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    dataType: 'json',
                    cache: false,
                    data: JSON.stringify(x),
                    success: function (result) {
                        $timeout(function () {
                            resolve(true);
                        }, 0);
                    },
                    error: function () {
                        resolve(false);
                    }
                });
            });
        }
    });
</script>