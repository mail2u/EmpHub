@page
@model EmpHub.Pages.Service.FormCreate.FormEmployeeCertificateModel
@{
    var token = User.AccessToken(HttpContext);
}
<style>
    .main-content {
        min-height: calc(100vh - 150px) !important;
    }

    .input-error{
        color: red;
        border-color: red;
    }
</style>
<div ng-controller="FormCtrl" id="tab_education">
    @* Header *@
    <partial name="_PartialFormHeader" />
    @* View *@
    <div class="d-flex justify-content-center">
        <div class="rounded-4 mb-3 bg-white shadow-sm p-4" style="width:600px;">
            <div class="text-center fs-4 fw-bolder mb-4 text-dark">
                ขอหนังสือรับรองการทำงาน
            </div>
            <table class="table table-borderless">
                <tbody>
                    <tr>
                        <td>
                            <div class="text-dark text-nowrap fw-bolder">ภาษาที่ขอ</div>
                            <div class="text-dark text-nowrap">Language</div>
                        </td>
                        <td>
                            <div class="d-flex lang">
                                <div class="me-3">
                                    <input ng-model="iForm.lang_th" ng-true-value="1" ng-false-value="0" id="lang_th" type="checkbox">
                                    <label for="lang_th">ภาษาไทย</label>
                                </div>
                                <div class="">
                                    <input ng-model="iForm.lang_en" ng-true-value="1" ng-false-value="0" id="lang_en" type="checkbox">
                                    <label for="lang_en">ภาษาอังกฤษ</label>
                                </div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <div class="text-dark text-nowrap fw-bolder">หมายเหตุ</div>
                            <div class="text-dark text-nowrap">Description</div>
                        </td>
                        <td>
                            <textarea ng-model="iForm.description" class="form-control description" rows=5 maxlength="2000"></textarea>
                        </td>
                    </tr>
                </tbody>
            </table>
            <div class="d-flex justify-content-end">
                <div class="btn btn-primary" ng-click="Save()">
                    <i class="far fa-paper-plane me-2"></i> Send Request
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    app.controller('FormCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.mode = '@Model.mode';
        $scope.iData = {};
        $scope.iForm = { lang_th: 0, lang_en: 0, description: '' };

        $scope.Validate = function () {
            var flag = true;
            JS_Reset($(".description"));
            JS_Reset($(".lang"));

            if ($scope.iForm.lang_th == 0 && $scope.iForm.lang_en == 0) {
                flag = false;
                JS_Require($(".lang"));
            }
            if ($scope.iForm.description == '') {
                flag = false;
                JS_Require($(".description"));
            }

            return flag;
        }

        $scope.Save = async function () {
            if ($scope.Validate()) {
                alertConfirm("ยืนยันการทำรายการ", "ท่านต้องการส่งใบคำขอ", async function () {
                    var id = await $scope.CreateService();

                    if (id) {
                        $scope.iData.id = id;
                        $scope.iForm.refId = id;

                        var flag = await $scope.CreateForm();

                        if (flag) {
                            var serviceNo = await $scope.ServiceRequest();

                            if (serviceNo) {
                                alertSuccess("ทำรายการสำเร็จ", "ระบบบันทึกใบคำขอของท่านเรียบร้อย", function () {
                                    location.href = '@Url.Page("/Service/Index")';
                                });
                            } else {
                                $scope.CancelService();
                            }
                        } else {
                            $scope.CancelService();
                        }
                    }
                });
            } else {
                alertWarning("แจ้งเตือน", "กรุณากรอกข้อมูลให้ครบ");
            }
        }

        $scope.CreateForm = function () {
            return new Promise((resolve) => {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/Form/FormEmployeeCertificateCreate',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    cache: false,
                    data: JSON.stringify($scope.iForm),
                    success: function () {
                        $timeout(async function () {
                            resolve(true);
                        }, 0);
                    }, error: function (jqXHR, error, errorThrown) {
                        resolve(null);
                        Swal.fire({
                            title: "ระบบเกิดข้อผิดพลาด",
                            text: jqXHR.responseText,
                            icon: "error",
                            confirmButtonColor: '#1e3b92',
                        });
                    }
                });
            });
        }
    });
</script>