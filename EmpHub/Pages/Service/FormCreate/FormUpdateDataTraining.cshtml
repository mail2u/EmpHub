@page
@model EmpHub.Pages.Service.FormCreate.FormUpdateDataTrainingModel

@{
    var token = User.AccessToken(HttpContext);
}
<style>
    .main-content{
        min-height:calc(100vh - 150px) !important;
    }

    .list-item-box{
        border: 2px solid white;
        background-color: var(--bs-light);
    }

    .list-item-box:hover{
        border: 2px solid var(--bs-blue);
    }

    .form-input {
        padding: 5px;
        border: 0px;
        border-radius: 0;
        border-bottom: 2px solid var(--bs-gray-400);
        background-color: #fcfcfc;
    }

    .form-input:focus {
        border-bottom: 2px solid var(--tip-blue);
    }

    input.form-input:read-only {
        background-color: var(--bs-gray-200);
    }
</style>
<div ng-controller="ServiceTrainingCtrl">
    @* Header *@
    <partial name="_PartialFormHeader" />
    @* View *@
    <div class="rounded-4 mb-3 bg-white shadow-sm p-4">
        <div class="list-group list-group-flush">
            <div class="list-group-item p-0" ng-repeat="x in lData | filter : {mode:'modify'}">
                <div class="list-item-box p-4 mb-3 rounded-3">
                    <div class="fw-bolder">
                        #{{ $index + 1 }}
                    </div>
                    <div class="d-flex flex-fill mb-3">
                        <div class="flex-fill me-3">
                            <div class="text-dark fs-5">ชื่อใบอนุญาต</div>
                            <input ng-model="x.license" class="form-control" />
                        </div>
                        <div class="flex-fill me-3">
                            <div class="text-dark fs-5">องค์กรที่ออกเอกสาร</div>
                            <input ng-model="x.organization" class="form-control" />
                        </div>
                        <div class="me-3" style="width:150px;">
                            <div class="text-dark fs-5">วันที่ออกเอกสาร</div>
                            <input class="form-control icon-calendar target"
                                   ng-model="x.issue_date_select"
                                   ng-model-options="{ updateOn: 'blur' }"
                                   moment-picker="x.issue_date_select"
                                   locale="th"
                                   format="DD/MM/YYYY"
                                   min-view="month"
                                   max-view="month" required />
                        </div>
                        <div class="" style="width:150px;">
                            <div class="text-dark fs-5">วันที่หมดอายุ</div>
                            <input class="form-control icon-calendar target"
                                   ng-model="x.expire_date_select"
                                   ng-model-options="{ updateOn: 'blur' }"
                                   moment-picker="x.expire_date_select"
                                   locale="th"
                                   format="DD/MM/YYYY"
                                   min-view="month"
                                   max-view="month" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="text-dark fs-5">รายละเอียด</div>
                        <textarea ng-model="x.description" class="form-control" rows="5" maxlength="4000"></textarea>
                    </div>
                   @*  <div class="text-end">
                        <div class="btn btn-warning-invert bg-white" ng-click="Delete(x)">
                            <i class="far fa-trash-alt me-2"></i>ลบรายการ
                        </div>
                    </div> *@
                </div>
            </div>
        </div>
        <div class="btn btn-light" ng-click="New()">
            เพิ่มข้อมูลการศึกษา
        </div>
    </div>
    <div class="d-flex justify-content-end">
        <div class="btn btn-primary" ng-click="Save()">
            <i class="far fa-paper-plane me-2"></i> Send Request
        </div>
    </div>
</div>
<script>
    app.controller('ServiceTrainingCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.mode = '@Model.mode';
        $scope.userId = '@Model.id';

        $scope.LoadMaster = function () {
            if (!$scope.lEduction) {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/MasterCode/DataList'
                    , headers: { 'authorization': 'Bearer @token' }
                    , type: 'post'
                    , contentType: 'application/json'
                    , dataType: 'json'
                    , cache: false
                    , data: JSON.stringify({
                        groupName: 'educationCode'
                    })
                    , success: function (result) {
                        $timeout(function () {
                            $scope.lEduction = result;
                        }, 0);
                    }
                    , error: AjaxError
                });
            }
        }

        $scope.LoadData = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/UserTraining',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    userId: $scope.userId
                    , create_by: '@User.UserId()'
                }),
                success: function (result) {
                    $timeout(async function () {
                        $scope.iData = {};
                        $scope.lData = result.data;

                        if(result.can_edit != 1){
                            alertWarning("ท่านไม่ได้สิทธิ์ให้เข้าถึงหน้านี้","กรุณาตรวจสอบ",function(){
                                location.href = '@Url.Page("/Service/Index")';
                            })
                        }else{
                            $scope.LoadMaster();

                            if($scope.lData.length == 0){
                                $scope.New();
                            }else{
                                $scope.lData = $scope.lData.map(item=>{
                                    item.mode = "modify";

                                    return item;
                                });
                            }
                        }
                    }, 0);
                }, error: AjaxError
            });
        }
        $scope.LoadData();

        $scope.New = function(){
            $timeout(function () {
                $scope.lData.splice($scope.lData.length, 0, { mode: "modify" });
            }, 0);
        }

        $scope.Delete = function(x){
            $timeout(function () {
                x.mode = "delete";
            }, 0);
        }

        $scope.Validate = function(){
            var flag = true;
            // JS_Reset($(".firstname_th"));
            // JS_Reset($(".lastname_th"));

            // if($scope.iData.firstname_th == ''){
            //     flag = false;
            //     JS_Require($(".firstname_th"));
            // }
            // if($scope.iData.lastname_th == ''){
            //     flag = false;
            //     JS_Require($(".lastname_th"));
            // }

            return flag;
        }

        $scope.Save = async function () {
            if($scope.Validate()){
                alertConfirm("ยืนยันการทำรายการ","ท่านต้องการส่งใบคำขอ", async function(){
                    var id = await $scope.CreateService();

                    if(id){
                        $scope.iData.id = id;
                        $scope.lData = $scope.lData.map(item => {
                            item.id = id;
                            item.refId = id;

                            if (item.issue_date_select) {
                                item.issueDate = item.issue_date_select.format("DD/MM/YYYY");
                            }
                            if (item.expire_date_select) {
                                item.expireDate = item.expire_date_select.format("DD/MM/YYYY");
                            }

                            return item;
                        });

                        var flag = await $scope.CreateTraining();

                        if(flag){
                            var serviceNo = await $scope.ServiceRequest();

                            if(serviceNo){
                                alertSuccess("ทำรายการสำเร็จ","ระบบบันทึกใบคำขอของท่านเรียบร้อย", function(){
                                    location.href = '@Url.Page("/Service/Index")';
                                });
                            }else{
                                $scope.CancelService();
                            }
                        }else{
                            $scope.CancelService();
                        }
                    }
                });
            }else{
                alertWarning("แจ้งเตือน","กรุณากรอกข้อมูลให้ครบ");
            }
        }

        $scope.CreateTraining = function () {
            return new Promise((resolve)=>{
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/ServiceTraining/Save',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    cache: false,
                    data: JSON.stringify($scope.lData),
                    success: function () {
                        $timeout(async function () {
                           resolve(true);
                        }, 0);
                    }, error: function(jqXHR, error, errorThrown) {
                        resolve(null);
                        Swal.fire({
                            title: "ระบบเกิดข้อผิดพลาด",
                            text: jqXHR.responseText,
                            icon: "error",
                            confirmButtonColor: '#1e3b92',
                        });
                    }
                });
            });
        }
    });
</script>