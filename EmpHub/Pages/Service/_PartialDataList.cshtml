<style>
    tr.cancel > td {
        color: var(--bs-gray);
    }

    tr.reject > td {
        color: var(--bs-danger);
    }

    tr.complete > td {
        color: var(--bs-green);
    }

    tr.alert > td {
        background-color: var(--light-blue);
        font-weight: bolder;
        color: var(--tip-blue);
    }

    .box-list.cancel {
        color: var(--bs-gray);
    }

    .box-list.reject {
        color: var(--bs-danger);
        background-color: var(--light-red);
    }

    .box-list.complete {
        color: var(--bs-green);
        background-color: var(--light-green);
    }

    .box-list.alert {
        background-color: var(--light-blue);
        font-weight: bolder;
        color: var(--tip-blue);
    }

    .box-list.request {
        background-color: var(--light-gray);
    }
</style>
@* Web View *@
<div class="overflow-auto d-none d-lg-block">
    <div style="min-height: 470px;" class="position-relative">
        <table class="table table-tip">
            <thead>
                <tr>
                    <th width="40"></th>
                    <th class="select" width="120" ng-click="SetSort('serviceNo')">
                        เลขบริการ
                        <i ng-show="sortBy.indexOf('serviceNo') > -1" ng-class="sortBy.indexOf('-') > - 1 ? 'bi bi-arrow-up-short' : 'bi bi-arrow-down-short'"></i>
                    </th>
                    <th class="select" ng-click="SetSort('subCategoryDesc')">
                        มีความประสงค์
                        <i ng-show="sortBy.indexOf('subCategoryDesc') > -1" ng-class="sortBy.indexOf('-') > - 1 ? 'bi bi-arrow-up-short' : 'bi bi-arrow-down-short'"></i>
                    </th>
                    <th class="select" ng-click="SetSort('status')">
                        สถานะ
                        <i ng-show="sortBy.indexOf('status') > -1" ng-class="sortBy.indexOf('-') > - 1 ? 'bi bi-arrow-up-short' : 'bi bi-arrow-down-short'"></i>
                    </th>
                    <th class="select" ng-click="SetSort('createBy')">
                        คำขอโดย
                        <i ng-show="sortBy.indexOf('createBy') > -1" ng-class="sortBy.indexOf('-') > - 1 ? 'bi bi-arrow-up-short' : 'bi bi-arrow-down-short'"></i>
                    </th>
                    <th class="select" ng-click="SetSort('orderDate1')">
                        วันที่ขอรับบริการ
                        <i ng-show="sortBy.indexOf('orderDate1') > -1" ng-class="sortBy.indexOf('-') > - 1 ? 'bi bi-arrow-up-short' : 'bi bi-arrow-down-short'"></i>
                    </th>
                    <th class="select text-nowrap" ng-click="SetSort('orderDate2')">
                        วันที่ดำเนินการ
                        <i ng-show="sortBy.indexOf('orderDate2') > -1" ng-class="sortBy.indexOf('-') > - 1 ? 'bi bi-arrow-up-short' : 'bi bi-arrow-down-short'"></i>
                    </th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="x in lData" class="{{ x.statusCss }} {{ x.is_not_read == 1 ? 'fw-bolder' : '' }}">
                    <td>
                        <span ng-show="x.status == 'Reject'" class="text-danger" title="ปฏิเสธ">
                            <i class="bi bi-x-circle"></i>
                        </span>
                        <span ng-show="x.status.includes('Approve')" class="text-blue" title="รออนุม้ติ">
                            <i class="bi bi-record-circle"></i>
                        </span>
                        <span ng-show="x.status == 'Complete'" class="text-green" title="อนุมัติ">
                            <i class="bi bi-check2-circle"></i>
                        </span>
                    </td>
                    <td class="select text-nowrap position-relative" ng-click="ShowDetail(x)">
                        <span ng-show="x.is_alert > 0" class="positionposition-absolute top-50 start-0 translate-middle badge rounded-circle bg-danger p-1">
                            <span class="visually-hidden">unread messages</span>
                        </span>
                        {{ x.serviceNo != '' ? x.serviceNo : 'แบบร่าง' }}
                    </td>
                    <td class="select text-nowrap" ng-click="ShowDetail(x)">
                        {{ x.categoryDesc }}
                    </td>
                    <td class="select text-nowrap" ng-click="ShowDetail(x)">
                        {{ x.statusDesc }}
                    </td>
                    <td class="select text-nowrap" ng-click="ShowDetail(x)">
                        {{ x.createName }}
                    </td>
                    <td class="select text-nowrap" ng-click="ShowDetail(x)">
                        {{ x.createDate }}
                    </td>
                    <td class="select text-nowrap" ng-click="ShowDetail(x)">
                        {{ x.actionDate }}
                    </td>
                </tr>
            </tbody>
        </table>
        <div ng-show="lData.length == 0" class="position-absolute top-50 start-50 translate-middle text-center opacity-75 text-gray">
            <img src="~/Images/empty.png" width="100" />
            <div>
                ไม่พบรายการคำขอ
            </div>
        </div>
    </div>
</div>
@* Mobile View *@
<div class="overflow-auto d-lg-none">
    <div style="height: calc(100vh - 300px);" class="position-relative">
        <div ng-repeat="x in lData" class="p-2 rounded mb-2 box-list {{ x.statusCss }}" ng-click="ShowDetail(x)">
            <div class="d-flex justify-content-between mb-1">
                <div class="fw-bolder">
                    <span class="text-green" ng-show="x.status == 'Complete'">
                        <i class="bi bi-check-circle"></i>
                    </span>
                    <span class="text-danger" ng-show="x.status == 'Reject'">
                        <i class="bi bi-x-circle"></i>
                    </span>
                    [{{ x.serviceNo != '' ? x.serviceNo : 'แบบร่าง' }}]
                </div>
                <div class="">{{ x.createDate }}</div>
            </div>
            <div class="fw-bolder">
                {{ x.subCategoryDesc }} {{ x.systemDesc }}
            </div>
            <div class="mb-2">
                {{ x.title }}
            </div>
            <div class="text-end">
                <i class="bi bi-person"></i> {{ x.createBy }}
            </div>
        </div>
        <div ng-show="lData.length == 0" class="position-absolute top-50 start-50 translate-middle text-center opacity-75 text-gray">
            <img src="~/Images/empty.png" width="100" />
            <div>
                ไม่พบรายการคำขอ
            </div>
        </div>
    </div>
</div>