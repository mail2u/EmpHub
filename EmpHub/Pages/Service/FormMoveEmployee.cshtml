@page
@model EmpHub.Pages.Service.FormMoveEmployeeModel
@{
    var token = User.AccessToken(HttpContext);
}
<style>
    .main-content {
        min-height: calc(100vh - 150px) !important;
    }

    .box-group{
        padding: 15px;
        border: 1px solid white;
        border-radius: 15px;
    }

    .box-group.input-error {
        border: 1px solid red;
    }
</style>
<div ng-controller="FormCtrl" id="tab_education">
    @* Header *@
    <partial name="_PartialFormHeader" />
    @* View *@
    <div class="rounded-4 mb-3 bg-white shadow-sm p-4">
        <div class="text-center fs-4 fw-bolder mb-4 text-dark">
            แบบฟอร์มโอนย้ายฝ่ายงาน
        </div>
        <div class="text-dark fs-6">
            <div class="row">
                <div class="col-sm-2 mb-3">
                    ชื่อ-นามสกุล
                </div>
                <div class="col-sm-4 mb-3">
                    <input ng-model="iForm.fullname" class="form-control fullname" maxlength="100" />
                </div>
                <div class="col-sm-2 mb-3">
                    ตำแหน่ง
                </div>
                <div class="col-sm-4 mb-3">
                    <input ng-model="iForm.position" class="form-control position" maxlength="50" />
                </div>
            </div>
            <div class="row">
                <div class="col-sm-2 mb-3">
                    สังกัดฝ่ายงาน
                </div>
                <div class="col-sm-4 mb-3">
                    <input ng-model="iForm.department" class="form-control department" maxlength="50" />
                </div>
                <div class="col-sm-2 mb-3">
                    สายงาน
                </div>
                <div class="col-sm-4 mb-3">
                    <input ng-model="iForm.section" class="form-control section" maxlength="100" />
                </div>
            </div>
            <div class="row">
                <div class="col-sm-2 mb-3">
                    วันเริ่มงาน
                </div>
                <div class="col-sm-4 mb-3">
                    <input class="form-control date join_date"
                        placeholder="__/__/____"
                        ng-model="iForm.join_date_select"
                        ng-model-options="{ updateOn: 'blur' }"
                        moment-picker="iForm.join_date_select"
                        locale="th"
                        format="DD/MM/YYYY"
                        min-view="month"
                        max-view="month" required />
                </div>
                <div class="col-sm-2 mb-3">
                    อายุงาน
                </div>
                <div class="col-sm-4 mb-3">
                    <input ng-model="iForm.age" class="form-control" readonly disabled />
                </div>
            </div>
            <div class="mb-3">
                <div class="fw-bolder">หน้าที่ความรับผิดชอบปัจจุบัน</div>
                <textarea ng-model="iForm.job_description" class="form-control job_description" rows=5 maxlength="2000"></textarea>
            </div>
            <div class="row">
                <div class="col-sm-6 mb-3">
                    มีความประสงค์ขอโอนย้ายไปยังฝ่ายงาน ดังนี้
                </div>
                <div class="col-sm-6 mb-3">
                    <input ng-model="iForm.new_department" class="form-control new_department" maxlength="50" />
                </div>
            </div>
            <div class="mb-3">
                <div class="fw-bolder">เหตุผลที่ขอโอนย้าย</div>
                <textarea ng-model="iForm.description" class="form-control description" rows=5 maxlength="2000"></textarea>
            </div>
        </div>
    </div>
    <div class="d-flex justify-content-end">
        <div class="btn btn-primary" ng-click="Save()">
            <i class="far fa-paper-plane me-2"></i> Send Request
        </div>
    </div>
</div>
<script>
    $(".day").mask("00");
    $(".score").mask("00");
    $(".date").mask("00/00/0000");
    app.controller('FormCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.mode = '@Model.mode';
        $scope.iData = {};
        $scope.iForm = {
            fullname:''
            , position:''
            , section:''
            , department:''
            , join_date: ''
            , age: 0
            , job_description: ''
            , new_department: ''
            , description: ''
            , create_by:'@User.UserId()'
        }

        $scope.Validate = function () {
            var flag = true;
            JS_Reset($(".fullname"));
            JS_Reset($(".position"));
            JS_Reset($(".section"));
            JS_Reset($(".department"));
            JS_Reset($(".join_date"));
            JS_Reset($(".job_description"));
            JS_Reset($(".new_department"));
            JS_Reset($(".description"));

            if($scope.iForm.join_date_select){
                $scope.iForm.join_date = $scope.iForm.join_date_select.format("DD/MM/YYYY");
            }

            if ($scope.iForm.fullname == '') {
                flag = false;
                JS_Require($(".fullname"));
            }
            if ($scope.iForm.position == '') {
                flag = false;
                JS_Require($(".position"));
            }
            if ($scope.iForm.section == '') {
                flag = false;
                JS_Require($(".section"));
            }
            if ($scope.iForm.department == '') {
                flag = false;
                JS_Require($(".department"));
            }
            if ($scope.iForm.join_date == '') {
                flag = false;
                JS_Require($(".join_date"));
            }
            if ($scope.iForm.job_description == '') {
                flag = false;
                JS_Require($(".job_description"));
            }
            if ($scope.iForm.new_department == '') {
                flag = false;
                JS_Require($(".new_department"));
            }
            if ($scope.iForm.description == '') {
                flag = false;
                JS_Require($(".description"));
            }

            return flag;
        }

        $scope.Save = async function () {
            if ($scope.Validate()) {
                alertConfirm("ยืนยันการทำรายการ", "ท่านต้องการส่งใบคำขอ", async function () {
                    var id = await $scope.CreateService();

                    if (id) {
                        $scope.iData.id = id;
                        $scope.iForm.refId = id;

                        var flag = await $scope.CreateForm();

                        if (flag) {
                            var serviceNo = await $scope.ServiceRequest();

                            if (serviceNo) {
                                alertSuccess("ทำรายการสำเร็จ", "ระบบบันทึกใบคำขอของท่านเรียบร้อย", function () {
                                    location.href = '@Url.Page("/Service/Index")';
                                });
                            } else {
                                $scope.CancelService();
                            }
                        } else {
                            $scope.CancelService();
                        }
                    }
                });
            } else {
                alertWarning("แจ้งเตือน", "กรุณากรอกข้อมูลให้ครบ");
            }
        }

        $scope.CreateForm = function () {
            return new Promise((resolve) => {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/Form/FormMoveEmployeeCreate',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    cache: false,
                    data: JSON.stringify($scope.iForm),
                    success: function () {
                        $timeout(async function () {
                            resolve(true);
                        }, 0);
                    }, error: function (jqXHR, error, errorThrown) {
                        resolve(null);
                        Swal.fire({
                            title: "ระบบเกิดข้อผิดพลาด",
                            text: jqXHR.responseText,
                            icon: "error",
                            confirmButtonColor: '#1e3b92',
                        });
                    }
                });
            });
        }
    });
</script>