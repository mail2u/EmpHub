@page
@model EmpHub.Pages.Service.CategoryModel
@{
    ViewData["Title"] = "Config System";
    var token = User.AccessToken(HttpContext);
}

@section PageHeader {
    <!-- [ page-header ] start -->
    <div class="page-header">
        <div class="page-header-left d-flex align-items-center">
            <div class="page-header-title">
                <h5 class="m-b-10">HR Service</h5>
            </div>
            <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Page("/Index")">Home</a></li>
                <li class="breadcrumb-item">Service Category</li>
            </ul>
        </div>
    </div>
}

<div ng-controller="ManageCtrl">
    <div class="d-flex mb-2">
        <div class="flex-fill fs-4">Service Category</div>
    </div>
    <div class="d-flex">
        <div class="rounded-4 border shadow-sm bg-white p-3 me-3">
            <div class="d-flex  align-items-center mb-2">
                <div class="flex-fill fw-bolder">Main Category</div>
                <button class="btn btn-circle" ng-click="CreateCategory()">
                    <i class="fas fa-plus"></i>
                </button>
            </div>
            <div class="list-group list-group-flush connected-apps-container overflow-auto" ui-sortable="sortableOptions" ng-model="lCategory" style="height:calc(100vh - 380px);">
                <div class="list-group-item list-group-item-action rounded {{ x.categoryDesc == iCategory.categoryDesc ? 'active' : '' }}" ng-repeat="x in lCategory" ng-click="SelectCategory(x)">
                    <div class="d-flex align-items-center">
                        <div class="d-flex align-items-center flex-fill me-2">
                            <div style="width:30px" class="sort-handle select">
                                <i class="bi bi-grip-vertical"></i>
                            </div>
                            <div>
                                <div class="fw-bolder">{{ x.categoryDesc }}</div>
                                <div class="text-primary">{{ x.categoryCode }}</div>
                                <div ng-show="x.allow_every==1" class="small text-success">
                                    อนุญาติให้ใช้งานได้ทุกคน
                                </div>
                                <div ng-show="x.allow_every!=1" class="small text-warning">
                                    ใช้งานได้ตามสิทธิ์
                                </div>
                            </div>
                        </div>
                        <button class="btn btn-circle me-1" ng-click="EditCategory(x)">
                            <i class="fas fa-pen"></i>
                        </button>
                        <button class="btn btn-circle" ng-click="DeleteCategory(x)">
                            <i class="fas fa-trash-alt"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="rounded-4 border shadow-sm bg-white p-3 flex-fill">
            <div class="d-flex justify-content-between mb-2 ps-2">
                <div class="d-flex align-items-center fw-bolder"> Sub Category</div>
                <div>
                    <button class="btn btn-circle" ng-click="CreateSubCategory()" ng-disabled="iCategory == null">
                        <i class="fas fa-plus"></i>
                    </button>
                </div>
            </div>
            <div class="position-relative overflow-auto" style="height:calc(100vh - 380px);">
                <table class="table table-hover">
                    <tbody>
                        <tr ng-repeat="x in lSubCategory">
                            <td>
                                {{ x.subCategoryDesc }}
                                <div ng-show="x.allow_every==1" class="small text-success">
                                    อนุญาติให้ใช้งานได้ทุกคน
                                </div>
                                <div ng-show="x.allow_every!=1" class="small text-warning">
                                    ใช้งานได้ตามสิทธิ์
                                </div>
                                <div class="text-primary" ng-show="x.subCategoryCode != ''">
                                    <i class="fas fa-code me-1"></i> {{ x.subCategoryCode }}
                                </div>
                            </td>
                            <td width="50">
                                <button class="btn btn-circle p-0" ng-click="EditSubCategory(x)">
                                    <i class="fas fa-pen"></i>
                                </button>
                            </td>
                            <td width="50">
                                <button class="btn btn-circle p-0" ng-click="DeleteSubCategory(x)">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    @* Modify Category Modal *@
    <div id="CategoryModal" class="modal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Main Category</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <div>Title</div>
                        <input ng-model="iCategory.categoryDesc" class="form-control categoryDesc" maxlength="200" />
                    </div>
                    <div class="mb-3">
                        <div>Category Code</div>
                        <input ng-model="iCategory.categoryCode" class="form-control categoryCode" maxlength="50" />
                    </div>
                    @*  <div class="mb-3">
                    <div>Description</div>
                    <textarea ng-model="iCategory.description" class="form-control" maxlength="400" rows="4"></textarea>
                    </div> *@
                    <div class="mb-3">
                        <div><input id="allow_every_sub" ng-model="iCategory.allow_every" type="checkbox" ng-true-value=1 ng-false-value=0 /> <label for="allow_every_sub">อนุญาติให้ใช้งาน (ทุกคน)</label></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" ng-click="UpdateCategory()">Create</button>
                </div>
            </div>
        </div>
    </div>
    @* Modify SubCategory Modal *@
    <div id="SubCategoryModal" class="modal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Sub Category</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <div>Main Category</div>
                        <select ng-model="iSubCategory.parentId" class="form-select" ng-options="a.cateId as a.categoryDesc for a in lCategory"></select>
                    </div>
                    <div class="mb-3">
                        <div>Title</div>
                        <input ng-model="iSubCategory.subCategoryDesc" class="form-control subCategoryDesc" maxlength="200" />
                    </div>
                    <div class="mb-3">
                        <div>Process Code</div>
                        <input ng-model="iSubCategory.subCategoryCode" class="form-control" maxlength="50" />
                    </div>
                    <div class="mb-3">
                        <div><input id="allow_every_sub" ng-model="iSubCategory.allow_every" type="checkbox" ng-true-value=1 ng-false-value=0 /> <label for="allow_every_sub">อนุญาติให้ใช้งาน (ทุกคน)</label></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-danger-invert" ng-click="DeleteSubCategory()" ng-show="iCategory.id > 0">ลบข้อมูล</button>
                    <button type="button" class="btn btn-primary" ng-click="UpdateSubCategory()">บันทึกรายการ</button>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    app.controller('ManageCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.sysId = 'HR'
        $scope.page = 1
        $scope.row = 10;

        $scope.LoadCategory = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Category/DataList'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , data: JSON.stringify({
                    sysId: $scope.sysId
                })
                , cache: false
                , success: function (result) {
                    $timeout(function () {
                        $scope.lCategory = result;

                        if ($scope.lCategory.length > 0) {
                            $scope.SelectCategory($scope.lCategory[0]);
                        }
                    }, 0);
                }
                , error: AjaxError
            });
        }
        $scope.LoadCategory();

        /* Category */
        $scope.CreateCategory = function () {
            $scope.iCategory = { sysId: $scope.sysId, cateId: '', categoryCode: '', categoryDesc: '', allow_every: 1 };
            $("#CategoryModal").modal('show');
        }

        $scope.EditCategory = function (x) {
            $scope.iCategory = x;
            $("#CategoryModal").modal('show');
        }

        $scope.UpdateCategory = function () {
            var flag = true;

            JS_Reset($(".categoryDesc"));

            if ($scope.iCategory.categoryDesc == '') {
                flag = false;
                JS_Require($(".categoryDesc"));
            }

            if (flag) {
                $("#CategoryModal").modal('hide');

                var url = '@webAPI.CurrentValue.APIEmpHub/api/Category/Create';

                if ($scope.iCategory.cateId != '') {
                    var url = '@webAPI.CurrentValue.APIEmpHub/api/Category/Update';
                }

                $.ajax({
                    url: url
                    , headers: { 'authorization': 'Bearer @token' }
                    , type: 'post'
                    , contentType: 'application/json'
                    , cache: false
                    , data: JSON.stringify($scope.iCategory)
                    , success: function () {
                        $timeout(function () {
                            $scope.LoadCategory();
                        }, 0);
                    }
                    , error: AjaxError
                });
            }
        }

        $scope.DeleteCategory = function (x) {
            $("#CategoryModal").modal('hide');

            alertConfirm("Delete Main Category", "คุณต้องการลบรายการ \"" + x.categoryDesc + "\"", function () {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/Category/Delete'
                    , headers: { 'authorization': 'Bearer @token' }
                    , type: 'post'
                    , contentType: 'application/json'
                    , cache: false
                    , data: JSON.stringify(x)
                    , success: function () {
                        $timeout(function () {
                            $scope.LoadCategory();
                        }, 0);
                    }
                    , error: AjaxError
                });
            });
        }

        $scope.SelectCategory = function (x) {
            $scope.iCategory = x;
            $scope.LoadSubCategory();
        }

        /* SubCategory */
        $scope.CreateSubCategory = function () {
            $scope.iSubCategory = { subCateId: '', parentId: $scope.iCategory.cateId, subCategoryCode: '', subCategoryDesc: '', allow_every: 1 };
            $("#SubCategoryModal").modal('show');
        }

        $scope.EditSubCategory = function (x) {
            $scope.iSubCategory = x;
            $("#SubCategoryModal").modal('show');
        }

        $scope.UpdateSubCategory = function () {
            var flag = true;

            JS_Reset($(".subCategoryDesc"));

            if ($scope.iSubCategory.subCategoryDesc == '') {
                flag = false;
                JS_Require($(".subCategoryDesc"));
            }

            if (flag) {
                var url = '@webAPI.CurrentValue.APIEmpHub/api/SubCategory/Create';
                $("#SubCategoryModal").modal('hide');

                if ($scope.iSubCategory.subCateId != '') {
                    var url = '@webAPI.CurrentValue.APIEmpHub/api/SubCategory/Update';
                }

                $.ajax({
                    url: url
                    , headers: { 'authorization': 'Bearer @token' }
                    , type: 'post'
                    , contentType: 'application/json'
                    , cache: false
                    , data: JSON.stringify($scope.iSubCategory)
                    , success: function () {
                        $timeout(function () {
                            $scope.LoadSubCategory();
                        }, 0);
                    }
                    , error: AjaxError
                });
            }
        }

        $scope.DeleteSubCategory = function (x) {

            alertConfirm("Delete Sub Category", "ต้องการลบรายการ \"" + x.subCategoryDesc + "\"", function () {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/SubCategory/Delete'
                    , headers: { 'authorization': 'Bearer @token' }
                    , type: 'post'
                    , contentType: 'application/json'
                    , cache: false
                    , data: JSON.stringify(x)
                    , success: function () {
                        $timeout(function () {
                            $scope.LoadSubCategory();
                        }, 0);
                    }
                    , error: AjaxError
                });
            });
        }

        $scope.LoadSubCategory = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/SubCategory/DataList'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({ parentId: $scope.iCategory.cateId })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lSubCategory = result;
                    }, 0);
                }
                , error: AjaxError
            });
        }

        /* Sort  */
        $scope.sortableOptions = {
            handle: '.sort-handle',
            connectWith: ".connected-apps-container",
            update: function (event, ui) {
                if ( // ensure we are in the first update() callback
                    !ui.item.sortable.received &&
                    // check that it's an actual moving between the two lists
                    ui.item.sortable.source[0] !== ui.item.sortable.droptarget[0]) {
                    ui.item.sortable.cancel(); // cancel drag and drop

                    var newObj = jQuery.extend({}, ui.item.sortable.model.content_to_drop);
                    $scope.column.push(newObj);
                }

                $scope.UpdateSort();
            }
        };

        $scope.UpdateSort = function () {
            $timeout(function () {
                for (var i = 0; i < $scope.lCategory.length; i++) {
                    var iCate = $scope.lCategory[i];
                    $scope.UpdateOrder(iCate, i);
                }
            }, 0);
        }

        $scope.UpdateOrder = function (x, order_index) {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Category/Sort'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , cache: false
                , data: JSON.stringify({
                    cateId: x.cateId
                    , order_index: order_index
                })
                , success: function () {
                    $timeout(function () {
                    }, 0);
                }
                , error: AjaxError
            });
        }

        $scope.Download = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Category/Report',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    sysId: 'PR'
                }),
                success: function (result) {
                    $timeout(function () {
                        var lData = JSON.parse(result.data);
                        var JSData = [[
                            { 'text': 'CategoryDesc' }
                            , { 'text': 'SubCategoryDesc' }
                            , { 'text': 'Condition' }
                            , { 'text': 'Min' }
                            , { 'text': 'Max' }
                        ]];

                        if (lData.length > 0) {
                            for (var i = 0; i < lData.length; i++) {
                                var iData = lData[i];

                                JSData.splice(JSData.length, 0, [
                                    { 'text': iData.categoryDesc }
                                    , { 'text': iData.subCategoryDesc }
                                    , { 'text': iData.condition }
                                    , { 'text': $filter('currency')(iData.min, '') }
                                    , { 'text': $filter('currency')(iData.max, '') }
                                ]);
                            }


                            var dt = new Date().toISOString().slice(0, 10).replace(/-/g, "");
                            ExportFile(JSData, 'CategoryPR_' + dt);
                        }
                    }, 0);
                },
                error: AjaxError
            });
        }
    });
</script>