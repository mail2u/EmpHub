@page
@model EmpHub.Pages.Service.NewModel
@{
    var token = User.AccessToken(HttpContext);
}

@section PageHeader {
    <!-- [ page-header ] start -->
    <div class="page-header">
        <div class="page-header-left d-flex align-items-center">
            <div class="page-header-title">
                <h5 class="m-b-10">HR Service</h5>
            </div>
            <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Page("/Index")">Home</a></li>
                <li class="breadcrumb-item">New Request</li>
            </ul>
        </div>
    </div>
}

<div ng-controller="ServiceCtrl">
    <div class="rounded-4 p-3 bg-white shadow-sm border mb-4">
        <input ng-model="search" class="form-control" placeholder="Find..." />
    </div>
    <div class="row">
        <div class="col-sm-4 mb-3" ng-repeat="c in lCategory" ng-show="(c.lSub | filter : search).length > 0">
            <div class="rounded-4 p-3 bg-white shadow-sm border h-100">
                <div class="fs-5 text-dark fw-bolder mb-2">{{ c.cateDesc }}</div>
                <div class="list-group list-group-flush">
                    <div class="list-group-item list-group-item-action text-dark select" ng-repeat="s in c.lSub | filter : search" ng-click="Create(s)">
                        {{ s.cateDesc }}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    app.controller('ServiceCtrl', function ($scope, $http, $timeout, $filter) {

        $scope.LoadCategory = function(){
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Category/AuthenList',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    userId: '@User.UserId()'
                    , sysId: 'HR'
                }),
                success: function (result) {
                    $timeout(function () {
                        $scope.lCategory = result;
                    }, 0);
                },
                error: AjaxError
            });
        }
        $scope.LoadCategory();
        
        $scope.Create = function(x){
            if (x.cateCode == "FORM_REQUEST_MANPOWER") {
                location.href = '@Url.Page("/Service/FormCreate/FormManpower")?mode=FORM_REQUEST_MANPOWER';
            } else if (x.cateCode == "FORM_NEED_NEW_CARD") {
                location.href = '@Url.Page("/Service/FormCreate/FormNewCard")?mode=FORM_NEED_NEW_CARD';
            } else if (x.cateCode == "FORM_PARKING_STICKER") {
                location.href = '@Url.Page("/Service/FormCreate/FormParkingSticker")?mode=FORM_PARKING_STICKER';
            } else if (x.cateCode == "FORM_BUY_UNIFORM") {
                location.href = '@Url.Page("/Service/FormCreate/FormBuyUniform")?mode=FORM_BUY_UNIFORM';
            } else if (x.cateCode == "FORM_RESET_PASSWORD") {
                location.href = '@Url.Page("/Service/FormCreate/FormResetPassword")?mode=FORM_RESET_PASSWORD';
            } else if (x.cateCode == "FORM_SALARY_CERTIFICATE") {
                location.href = '@Url.Page("/Service/FormCreate/FormSalaryCertificate")?mode=FORM_SALARY_CERTIFICATE';
            } else if (x.cateCode == "FORM_EMPLOYEE_CERTIFICATE") {
                location.href = '@Url.Page("/Service/FormCreate/FormEmployeeCertificate")?mode=FORM_EMPLOYEE_CERTIFICATE';
            } else if (x.cateCode == "FORM_REQUEST_TRAINING") {
                location.href = '@Url.Page("/Service/FormCreate/FormRequestTraining")?mode=FORM_REQUEST_TRAINING';
            } else if (x.cateCode == "FORM_BENEFIT_FUND") {
                location.href = '@Url.Page("/Service/FormCreate/FormBenefitFund")?mode=FORM_BENEFIT_FUND';
            } else if (x.cateCode == "FORM_BENEFIT_INSURANCE") {
                location.href = '@Url.Page("/Service/FormCreate/FormBenefitInsurance")?mode=FORM_BENEFIT_INSURANCE';
            } else if (x.cateCode == "FORM_PERFORMANCE_LV1") {
                location.href = '@Url.Page("/Service/FormCreate/FormPerformanceLv1")?mode=FORM_PERFORMANCE_LV1';
            } else if (x.cateCode == "FORM_PERFORMANCE_LV2") {
                location.href = '@Url.Page("/Service/FormCreate/FormPerformanceLv2")?mode=FORM_PERFORMANCE_LV2';
            } else if (x.cateCode == "FORM_MOVE_EMPLOYEE") {
                location.href = '@Url.Page("/Service/FormCreate/FormMoveEmployee")?mode=FORM_MOVE_EMPLOYEE';
            } else if (x.cateCode == "FORM_HIRING_EMPLOYEE") {
                location.href = '@Url.Page("/Service/FormCreate/FormHiringEmployee")?mode=FORM_HIRING_EMPLOYEE';
            } else if (x.cateCode == "FORM_PDPA_EMPLOYEE") {
                location.href = '@Url.Page("/Service/FormCreate/FormPdpaEmployee")?mode=FORM_PDPA_EMPLOYEE';
            } else if (x.cateCode == "FORM_WFH_EMPLOYEE") {
                location.href = '@Url.Page("/Service/FormCreate/FormWfhEmployee")?mode=FORM_WFH_EMPLOYEE';
            } else if (x.cateCode == "FORM_AGREEMENT_EMPLOYEE") {
                location.href = '@Url.Page("/Service/FormCreate/FormAgreementEmployee")?mode=FORM_AGREEMENT_EMPLOYEE';
            } else if (x.cateCode == "FORM_PREPARE_EMPLOYEE") {
                location.href = '@Url.Page("/Service/FormCreate/FormPrepareEmployee")?mode=FORM_PREPARE_EMPLOYEE';
            } else if (x.cateCode == "FORM_PROBATION_REPORT") {
                location.href = '@Url.Page("/Service/FormCreate/FormProbationReport")?mode=FORM_PROBATION_REPORT';
            } else if (x.cateCode == "FORM_REGISTER") {
                location.href = '@Url.Page("/Service/FormCreate/FormRegister")?mode=FORM_REGISTER';
            } else if (x.cateCode == "FORM_PROMOTE_EMPLOYEE") {
                location.href = '@Url.Page("/Service/FormCreate/FormPromoteEmployee")?mode=FORM_PROMOTE_EMPLOYEE';
            } else if (x.cateCode == "FORM_IDP") {
                location.href = '@Url.Page("/Service/FormCreate/FormIDP")?mode=FORM_IDP';
            } else {
                location.href = '@Url.Page("/Service/FormCreate/Create")';
            }
            
        }

    })
</Script>