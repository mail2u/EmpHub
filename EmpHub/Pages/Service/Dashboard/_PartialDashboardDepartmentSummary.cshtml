@{
    var token = User.AccessToken(Context);
}
<div ng-controller="ChartDepartmentSummaryCtrl" class="bg-white rounded shadow-sm p-4 h-100">
    <div class="d-flex">
        <div class="flex-fill fw-bolder mb-2 border-start-tip-blue">ใบงานของแต่ละฝ่ายปี {{year}}</div>
        <div class="badge bg-gray p-2"></div>
    </div>
    <table class="table table-tsi">
        <thead>
            <tr>
                <th width="40"></th>
                <th>ฝ่ายงาน</th>
                <th width="100">จำนวน</th>
            </tr>
        </thead>
        <tbody>
            <tr ng-repeat="x in lData">
                <td>{{ $index + 1 }}</td>
                <td>{{ x.departmentDesc }}</td>
                <td>{{ x.total }}</td>
            </tr>
        </tbody>
    </table>
@*     <canvas id="chart_dashboard_department_summary"></canvas> *@
</div>
<script>
    app.controller('ChartDepartmentSummaryCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.$parent.LoadDepartmentSummary = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Service/DashboardDepartmentSummary'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data:JSON.stringify({
                    departmentCode: $scope.$parent.departmentCode
                    , year: $scope.$parent.year
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lData = result;
                        //$scope.LoadChar(result);
                    }, 0);
                }
                , error: AjaxError
            });
        }

