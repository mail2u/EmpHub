@{
    var token = User.AccessToken(Context);
}
<div ng-controller="ChartStatusSummaryCtrl" class="bg-white rounded shadow-sm p-4">
    <div class="d-flex">
        <div class="flex-fill fw-bolder mb-2 border-start-tip-blue">สถานะใบงานปี {{year}}</div>
        <div class="badge bg-gray p-2"></div>
    </div>
    <canvas id="chart_dashboard_status_summary"></canvas>
</div>
<script>
    app.controller('ChartStatusSummaryCtrl', function ($scope, $http, $timeout, $filter) {

        $scope.$parent.LoadStatusSummary = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Service/DashboardStatusSummary'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    departmentCode: $scope.$parent.departmentCode
                    , year: $scope.$parent.year
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lData = result;
                        $scope.LoadChar(result);
                    }, 0);
                }
                , error: AjaxError
            });
        }

        var chart = new Chart(
            document.getElementById('chart_dashboard_status_summary'),
            {
                type: 'pie',
                options: {
                    responsive: true,
                    aspectRatio: 2,
                    borderRadius: 5,
                    weight: 5,
                    cutout: 35,
                    plugins: {
                        legend: {
                            display: true,
                            labels: {
                                usePointStyle: true,
                                pointStyle: 'circle',
                                generateLabels(chart) {
                                    const data = chart.data;
                                    if (data.labels.length && data.datasets.length) {
                                        const { labels: { pointStyle } } = chart.legend.options;

                                        return data.labels.map((label, i) => {
                                            const meta = chart.getDatasetMeta(0);
                                            const style = meta.controller.getStyle(i);
                                            var per = 0;
                                            var find = $scope.lData.find(item => item.statusDesc == label);

                                            if(find){
                                                per = find.per;
                                            }

                                            return {
                                                text: `${label}: ${data['datasets'][0].data[i]} รายการ (${per}%)`,
                                                fillStyle: style.backgroundColor,
                                                strokeStyle: style.borderColor,
                                                lineWidth: style.borderWidth,
                                                pointStyle: pointStyle,
                                                hidden: !chart.getDataVisibility(i),

                                                // Extra data used for toggling the correct item
                                                index: i
                                            };
                                        });
                                    }
                                    return [];
                                }
                            },
                            position: 'right'
                        }
                    },
                }
            }
        );

        $scope.LoadChar = function (lData) {
            chart.data = {
                labels: lData.map(i => i.statusDesc),
                datasets: [{
                    data: lData.map(i => i.total),
                }],
            };
            chart.update();
        }

        $scope.init = function() {
            $scope.$emit('LoadStatusSummary');
        };
        $scope.init();
    });
</script>