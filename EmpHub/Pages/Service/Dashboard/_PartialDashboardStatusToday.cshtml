@{
    var token = User.AccessToken(Context);
}
<div ng-controller="ChartStatusTodayCtrl" class="mb-3 bg-white rounded shadow-sm p-3" style="height:calc(100vh - 242px);">
    <div class="fw-bolder mb-3 border-start-tip-blue">วันนี้ <span class="text-blue">{{ today }}</span></div>
    <div class="row">
        <div class="col-6 mb-3">
            <div class="rounded shadow-sm border py-2 px-3" style="background-color: #f2f2f2;">
                <div class="fw-bolder">
                    แจ้งใบงาน
                </div>
                <div class="d-flex align-items-center">
                    <div class="flex-fill fs-2" style="color:var(--dark-gray)">
                        <i class="bi bi-archive"></i>
                    </div>
                    <div class="text-end fs-2 fw-bolder">
                        {{ iRequest.total | number }}
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 mb-3">
            <div class="rounded shadow-sm py-2 px-3" style="background-color: #ffcd56;">
                <div class="fw-bolder">
                    อนุมัติรายการ
                </div>
                <div class="d-flex align-items-center">
                    <div class="flex-fill fs-2" style="color:var(--dark-yellow)">
                        <i class="bi bi-patch-check"></i>
                    </div>
                    <div class="text-end fs-2 fw-bolder">
                        {{ iApprove.total | number }}
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 mb-3">
            <div class="rounded shadow-sm py-2 px-3" style="background-color: #ff9f40;">
                <div class="fw-bolder">
                    ดำเนินรายการ
                </div>
                <div class="d-flex align-items-center">
                    <div class="flex-fill fs-2" style="color:var(--dark-orange)">
                        <i class="bi bi-person-workspace"></i>
                    </div>
                    <div class="text-end fs-2 fw-bolder">
                        {{ iWork.total | number }}
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 mb-3">
            <div class="rounded shadow-sm py-2 px-3" style="background-color: #f9538d;">
                <div class="fw-bolder">
                    ไม่อนุมัติ
                </div>
                <div class="d-flex align-items-center">
                    <div class="flex-fill fs-2" style="color:var(--dark-pink)">
                        <i class="bi bi-x-circle"></i>
                    </div>
                    <div class="text-end fs-2 fw-bolder">
                        {{ iReject.total | number }}
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6">
            <div class="rounded shadow-sm py-2 px-3" style="background-color: #db84fa;">
                <div class="fw-bolder">
                    เปลี่ยนประเภท
                </div>
                <div class="d-flex align-items-center">
                    <div class="flex-fill fs-2" style="color:var(--dark-purple)">
                        <i class="bi bi-arrow-repeat"></i>
                    </div>
                    <div class="text-end fs-2 fw-bolder">
                        {{ iChange.total | number }}
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6">
            <div class="rounded shadow-sm py-2 px-3" style="background-color: #36a2eb;">
                <div class="fw-bolder">
                    ปิดใบงาน
                </div>
                <div class="d-flex align-items-center">
                    <div class="flex-fill fs-2" style="color:var(--dark-blue)">
                        <i class="bi bi-check2-circle"></i>
                    </div>
                    <div class="text-end fs-2 fw-bolder">
                        {{ iComplete.total | number }}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    app.controller('ChartStatusTodayCtrl', function ($scope, $http, $timeout, $filter) {
        var dt = new Date();
        $scope.today = ConvertToDate103(dt);
        $scope.LoadData = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Service/DashboardStatusToday'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , dataType: 'json'
                , cache: false
                , success: function (result) {
                    $timeout(function () {
                        var lData = result;
                        $scope.iRequest = lData.find(x => x.status == 'Request');
                        $scope.iReject = lData.find(x => x.status == 'Reject');
                        $scope.iApprove = lData.find(x=>x.status == 'Approve');
                        $scope.iWork = lData.find(x => x.status == 'Work');
                        $scope.iChange = lData.find(x => x.status == 'Change');
                        $scope.iComplete = lData.find(x=>x.status == 'Complete');
                    }, 0);
                }
                , error: AjaxError
            });
        }
        $scope.LoadData();

        $scope.timer = setInterval(() => {
            $scope.LoadData();
        }, 600000);
    });
</script>