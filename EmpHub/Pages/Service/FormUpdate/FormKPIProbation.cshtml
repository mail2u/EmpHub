@page
@model EmpHub.Pages.Service.FormUpdate.FormKPIProbationModel
@{
    var token = User.AccessToken(HttpContext);
}
<style>
    .main-content {
        min-height: calc(100vh - 150px) !important;
    }

</style>
<div ng-controller="ServiceEducationCtrl" id="tab_education">
    <partial name="_PartialFormUpdate" />
    @* View *@
    <div class="rounded-4 mb-3 bg-white shadow-sm p-4">
        <div class="text-center fs-4 fw-bolder mb-4 text-dark">
            ตัวชี้วัดผลสำเร็จของการดำเนินงานในช่วงระยะเวลาทดลองงาน 90 วัน (Balanced Scorecard & KPIs)
        </div>
        <div class="d-flex">
            <div class="" style="width:33.33%">
                <div class="mb-3">
                    ชื่อ - นามสกุล : <span class="text-blue">{{ iProfile.firstname_th }} {{ iProfile.lastname_th }}</span> 
                </div>
                <div class="mb-3">
                    ตำแหน่ง : <span class="text-blue">{{ iEmployee.positionDesc }}</span>
                </div>
                <div class="mb-3">
                    สังกัดหน่วยงาน : <span class="text-blue">{{ iEmployee.departmentDesc }}</span>
                </div>
            </div>
            <div class="" style="width:33.33%">
                <div class="mb-3">
                    ปรับปรุงครั้งที่ : <span class="text-blue">1</span>
                </div>
                <div class="mb-3">
                    วันเริ่มงาน : <span class="text-blue">{{ iEmployee.join_date }}</span>
                </div>
                <div class="mb-3">
                    ระยะเวลาประเมินผล : <span class="text-blue">90 วัน</span>
                </div>
            </div>
            <div class="" style="width:33.33%">
                <div class="mb-3">
                    วันที่จัดทำ : <span class="text-blue">{{ create_date}}</span> 
                </div>
                <div class="mb-3">
                    ชื่อผู้บังคับบัญชา : <span class="text-blue">{{ iEmployee.supervisorName }}</span> 
                </div>
                <div class="mb-3">
                    ตำแหน่งผู้บังคับบัญชา : <span class="text-blue">{{ iEmployee.supervisorPosition}}</span> 
                </div>
            </div>
        </div>
        <div>
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th rowspan="2" class="text-center">
                            <div class="mb-2">
                                ตัวชี้วัดความสำเร็จของงาน<br />(Key Performance Indicator - KPI)
                            </div>
                        </th>
                        <th rowspan="2" class="text-center" width="100">
                            <div class="mb-2">เป้าหมาย<br />(Target)</div>
                        </th>
                        <th rowspan="2" class="text-center" width="100">
                            <div class="mb-2">นน.คะแนน<br />(Weight)</div>
                        </th>
                        <th rowspan="2" class="text-center">
                            <div class="mb-2">ผลการปฏิบัติงานเทียบกับเป้าหมาย<br />(Performance Result)</div>
                        </th>
                        <th colspan="5" class="text-center">
                            เกณฑ์การให้คะแนน
                        </th>
                    </tr>
                    <tr>
                        <th class="text-center">
                            <div>5</div>
                        </th>
                        <th class="text-center">
                            <div>4</div>
                        </th>
                        <th class="text-center">
                            <div>3</div>
                        </th>
                        <th class="text-center">
                            <div>2</div>
                        </th>
                        <th class="text-center">
                            <div>1</div>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="x in lData">
                        <td>
                            <textarea ng-model="x.performance_indicator" class="form-control form-control-input performance_indicator" maxlength="2000" rows="3" ng-show="can_edit == 1"></textarea>
                            <span class="text-blue" ng-show="can_edit == 0">{{ x.performance_indicator }}</span>
                        </td>
                        <td>
                            <input ng-model="x.target" amount="x.target" class="form-control form-control-input target" maxlength="3" format-to-number ng-show="can_edit == 1" />
                            <span class="text-blue" ng-show="can_edit == 0">{{ x.target }}</span>
                        </td>
                        <td>
                            <input ng-model="x.weight" amount="x.weight" class="form-control form-control-input weight" maxlength="3" format-to-number ng-show="can_edit == 1" />
                            <span class="text-blue" ng-show="can_edit == 0">{{ x.weight }}</span>
                        </td>
                        <td>
                            <textarea ng-model="x.performance_result" class="form-control form-control-input performance_result" maxlength="2000" rows="3" ng-show="can_edit == 1"></textarea>
                            <span class="text-blue" ng-show="can_edit == 0">{{ x.performance_result }}</span>
                        </td>
                        <td class="text-center">
                            <input type="radio" ng-model="x.answer" ng-value="5" ng-show="can_edit == 1" />
                            <i class="fas fa-check text-success" ng-show="can_edit != 1 && x.answer == 5"></i>
                        </td>
                        <td class="text-center">
                            <input type="radio" ng-model="x.answer" ng-value="4" ng-show="can_edit == 1" />
                            <i class="fas fa-check text-success" ng-show="can_edit != 1 && x.answer == 4"></i>
                        </td>
                        <td class="text-center">
                            <input type="radio" ng-model="x.answer" ng-value="3" ng-show="can_edit == 1" />
                            <i class="fas fa-check text-success" ng-show="can_edit != 1 && x.answer == 3"></i>
                        </td>
                        <td class="text-center">
                            <input type="radio" ng-model="x.answer" ng-value="2" ng-show="can_edit == 1" />
                            <i class="fas fa-check text-success" ng-show="can_edit != 1 && x.answer == 2"></i>
                        </td>
                        <td class="text-center">
                            <input type="radio" ng-model="x.answer" ng-value="1" ng-show="can_edit == 1" />
                            <i class="fas fa-check text-success" ng-show="can_edit != 1 && x.answer == 1"></i>
                        </td>
                    </tr>
                </tbody>
            </table>
            <div class="btn btn-light-dash" ng-click="AddRow()">
                เพิ่มแถว
            </div>
        </div>
    </div>
    <div class="d-flex justify-content-end" ng-show="can_edit == 1">
        <div class="btn btn-primary" ng-click="Save()">
            <i class="far fa-save me-2"></i> Save
        </div>
    </div>
</div>
<script>
    app.controller('ServiceEducationCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.id = '@Model.refId';

        $scope.LoadForm = function(){
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Form/FormRequestTrainingDetail',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                cache: false,
                data: JSON.stringify({
                    refId: $scope.id
                }),
                success: function (result) {
                    $timeout(async function () {
                        $scope.iForm = result
                    }, 0);
                }, error: AjaxError
            });
        }
        
        $scope.$on('FORM_LOAD', function (e) {
            $scope.LoadForm();
        });

        $scope.Init = function () {
            if ($scope.refId == '') {
                alertWarning("แจ้งเตือน", "ไม่พบเลขอ้างอิง", function () {
                    location.href = '@Url.Page("/Service/Index")';
                });
            }

            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/UserPersonal',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    userId: $scope.refId
                }),
                success: function (result) {
                    $timeout(async function () {
                        $scope.iProfile = result.data;
                    }, 0);
                }, error: AjaxError
            });

            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/UserEmployee',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    userId: $scope.refId
                }),
                success: function (result) {
                    $timeout(async function () {
                        $scope.iEmployee = result.data;
                    }, 0);
                }, error: AjaxError
            });

            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/ServiceKPIProbation/Detail',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    refId: $scope.refId
                    , userId: '@User.UserId()'
                }),
                success: function (result) {
                    $timeout(async function () {
                        $scope.lData = result.data;

                        if ($scope.lData.length == 0) {
                            $scope.lData = [{}];
                        }else{
                            $scope.create_date = $scope.lData[0].create_date;
                        }

                        $scope.can_edit = result.can_edit;
                    }, 0);
                }, error: function(jqXHR, error, errorThrown) {
                    alertWarning("รับอนุญาติให้เข้าถึงหน้านี้", jqXHR.responseText, function(){
                        location.href = '@Url.Page("/Index")';
                    })
                }
            });
        }
        $scope.Init();

        $scope.AddRow = function () {
            $timeout(async function () {
                $scope.lData.splice($scope.lData.length, 0, {});
            }, 0);
        }

        $scope.Validate = function () {
            var flag = true;
            // JS_Reset($(".firstname_th"));
            // JS_Reset($(".lastname_th"));

            // if($scope.iData.firstname_th == ''){
            //     flag = false;
            //     JS_Require($(".firstname_th"));
            // }
            // if($scope.iData.lastname_th == ''){
            //     flag = false;
            //     JS_Require($(".lastname_th"));
            // }

            return flag;
        }

        $scope.Save = async function () {
            if ($scope.Validate()) {
                alertConfirm("ยืนยันการทำรายการ", "ท่านต้องการส่งใบคำขอ", async function () {
                    var flag = await $scope.CreateForm();

                    if (flag) {
                        var serviceNo = await $scope.ServiceRequest();

                        if (serviceNo) {
                            alertSuccess("ทำรายการสำเร็จ", "ระบบบันทึกใบคำขอของท่านเรียบร้อย", function () {
                                location.href = '@Url.Page("/Service/Index")';
                            });
                        }
                    }
                });
            } else {
                alertWarning("แจ้งเตือน", "กรุณากรอกข้อมูลให้ครบ");
            }
        }

        $scope.CreateForm = function () {
            return new Promise((resolve) => {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/ServiceKPIProbation/Save',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    cache: false,
                    data: JSON.stringify($scope.lData),
                    success: function () {
                        $timeout(async function () {
                            resolve(true);
                        }, 0);
                    }, error: function (jqXHR, error, errorThrown) {
                        resolve(null);
                        Swal.fire({
                            title: "ระบบเกิดข้อผิดพลาด",
                            text: jqXHR.responseText,
                            icon: "error",
                            confirmButtonColor: '#1e3b92',
                        });
                    }
                });
            });
        }
    });
</script>