@page
@model EmpHub.Pages.Service.FormUpdate.FormUpdateDataTrainingModel

@{
    var token = User.AccessToken(HttpContext);
}
<style>
    .main-content{
        min-height:calc(100vh - 150px) !important;
    }

    .list-item-box{
        border: 2px solid white;
        background-color: var(--bs-light);
    }

    .list-item-box:hover{
        border: 2px solid var(--bs-blue);
    }

    .form-input {
        padding: 5px;
        border: 0px;
        border-radius: 0;
        border-bottom: 2px solid var(--bs-gray-400);
        background-color: #fcfcfc;
    }

    .form-input:focus {
        border-bottom: 2px solid var(--tip-blue);
    }

    input.form-input:read-only {
        background-color: var(--bs-gray-200);
    }

    .btn-box-dash {
        border: 2px dashed var(--bs-gray-300);
    }

    .btn-box-dash:hover {
        border: 2px dashed var(--bs-blue);
        color: var(--bs-blue) !important;
    }
</style>
<div ng-controller="ServiceTrainingCtrl">
    @* Header *@
    <partial name="_PartialFormUpdate" />
    @* View *@
    <div class="rounded-4 mb-3 bg-white shadow-sm p-4">
        <div class="list-group list-group-flush">
            <div class="list-group-item p-0" ng-repeat="x in lData | filter : {mode:'modify'}">
                <div class="list-item-box p-4 mb-3 rounded-3">
                    <div class="fw-bolder">
                        ใบรับรอง / ใบอนุญาต {{ $index + 1 }}
                    </div>
                    <div class="d-flex flex-fill mb-3">
                        <div class="flex-fill me-3">
                            <div class="text-dark fs-5">ชื่อใบรับรอง / ใบอนุญาต</div>
                            <input ng-model="x.license" class="form-control" />
                        </div>
                        <div class="flex-fill me-3">
                            <div class="text-dark fs-5">เลขที่ใบรับรอง</div>
                            <input ng-model="x.certificateNo" class="form-control" maxlength="100" />
                        </div>
                        <div class="flex-fill me-3">
                            <div class="text-dark fs-5">หน่วยงานที่ออกใบรับรอง / ใบอนุญาต</div>
                            <input ng-model="x.organization" class="form-control" />
                        </div>
                        <div class="me-3" style="width:150px;">
                            <div class="text-dark fs-5">วันที่ได้รับ</div>
                            <input class="form-control icon-calendar target"
                                   ng-model="x.issue_date_select"
                                   ng-model-options="{ updateOn: 'blur' }"
                                   moment-picker="x.issue_date_select"
                                   locale="th"
                                   format="DD/MM/YYYY"
                                   min-view="month"
                                   max-view="month" required />
                        </div>
                        <div class="" style="width:150px;">
                            <div class="text-dark fs-5">วันที่หมดอายุ</div>
                            <input class="form-control icon-calendar target"
                                   ng-model="x.expire_date_select"
                                   ng-model-options="{ updateOn: 'blur' }"
                                   moment-picker="x.expire_date_select"
                                   locale="th"
                                   format="DD/MM/YYYY"
                                   min-view="month"
                                   max-view="month" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="text-dark fs-5">รายละเอียด</div>
                        <textarea ng-model="x.description" class="form-control" rows="5" maxlength="4000"></textarea>
                    </div>
                    <div class="mb-3">
                        <div class="text-dark fs-5">
                            เอกสารหลักฐานการฝึกอบรม (ใบรับรอง / ใบอนุญาต / ใบประกาศนียบัตร)
                            <span class="text-danger" ng-show="x.is_new">*</span>
                        </div>
                        <div class="text-gray small mb-2">
                            แนบไฟล์ PDF, JPG หรือ PNG ขนาดไม่เกิน 10 MB ต่อไฟล์ เพื่อให้ผู้อนุมัติตรวจสอบ
                            <span ng-show="x.is_new">(รายการที่เพิ่มใหม่ต้องแนบเอกสาร)</span>
                        </div>
                        <label for="trainfile_{{$index}}" class="btn btn-box-dash select">
                            <i class="fas fa-paperclip me-2"></i> เลือกไฟล์
                        </label>
                        <input class="d-none" base-sixty-four-input id="trainfile_{{$index}}" type="file" accept=".pdf,.jpg,.jpeg,.png" ng-model="x.fileModel" ng-change="AddAttach(x)" />
                        <div class="list-group list-group-flush mt-2">
                            <div class="list-group-item bg-gray rounded-3 mb-1" ng-repeat="a in x.lAttachFile" title="{{ a.filename }}">
                                <div class="d-flex align-items-center">
                                    <div>
                                        <i class="bi bi-file-earmark-check text-green"></i>
                                    </div>
                                    <div class="text-truncate mx-2 flex-fill" style="min-width: 0;">
                                        {{ a.outputname || a.filename }}
                                    </div>
                                    <div class="text-gray small me-2 text-nowrap">
                                        {{ FileSizeText(a.filesize) }}
                                    </div>
                                    <div>
                                        <div class="btn btn-circle" ng-click="DeleteAttach(x, a)">
                                            <i class="bi bi-trash"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center justify-content-end">
                        <div class="text-gray small" ng-show="!x.is_new">
                            <i class="bi bi-lock-fill me-1"></i>ข้อมูลนี้บันทึกในระบบแล้ว จึงไม่สามารถลบได้
                        </div>
                        <div class="btn btn-warning-invert bg-white" ng-show="x.is_new" ng-click="Delete(x)">
                            <i class="far fa-trash-alt me-2"></i>ยกเลิกรายการนี้
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="btn btn-light" ng-click="New()">
            เพิ่มข้อมูลการฝึกอบรม
        </div>
    </div>
    <div class="d-flex justify-content-end">
        <div class="btn btn-primary" ng-click="Save()">
            <i class="far fa-paper-plane me-2"></i> ส่งใบคำขอ
        </div>
    </div>
</div>
<script>
    app.controller('ServiceTrainingCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.id = '@Model.refId';

        $scope.LoadForm = function(){
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Form/FormRequestTrainingDetail',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                cache: false,
                data: JSON.stringify({
                    refId: $scope.id
                }),
                success: function (result) {
                    $timeout(async function () {
                        $scope.iForm = result
                    }, 0);
                }, error: AjaxError
            });
        }
        
        // iData ถูกเซ็ตโดย _PartialFormUpdate (api/Service/Detail) จึงต้องรอ FORM_LOAD ก่อนจะรู้ userId
        $scope.$on('FORM_LOAD', function (e) {
            $scope.LoadForm();

            $scope.userId = $scope.iData.userId;
            $scope.LoadData();
        });

        $scope.LoadMaster = function () {
            if (!$scope.lEduction) {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/MasterCode/DataList'
                    , headers: { 'authorization': 'Bearer @token' }
                    , type: 'post'
                    , contentType: 'application/json'
                    , dataType: 'json'
                    , cache: false
                    , data: JSON.stringify({
                        groupName: 'educationCode'
                    })
                    , success: function (result) {
                        $timeout(function () {
                            $scope.lEduction = result;
                        }, 0);
                    }
                    , error: AjaxError
                });
            }
        }

        $scope.LoadData = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/UserTraining',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    userId: $scope.userId
                    , create_by: '@User.UserId()'
                }),
                success: function (result) {
                    $timeout(async function () {
                        // ห้าม reset iData ที่นี่ เพราะเป็นข้อมูลใบงานที่ ServiceRequest() ต้องใช้ตอนส่งกลับ
                        $scope.lData = result.data;

                        if(result.can_edit != 1){
                            alertWarning("ท่านไม่ได้สิทธิ์ให้เข้าถึงหน้านี้","กรุณาตรวจสอบ",function(){
                                location.href = '@Url.Page("/Service/Index")';
                            })
                        }else{
                            $scope.LoadMaster();

                            if($scope.lData.length == 0){
                                $scope.New();
                            }else{
                                $scope.lData = $scope.lData.map(item=>{
                                    item.mode = "modify";
                                    item.trainingId = item.trainingId || NewGuid();
                                    item.lAttachFile = [];
                                    item.is_new = false;

                                    return item;
                                });

                                $scope.LoadAttachFile();
                            }
                        }
                    }, 0);
                }, error: AjaxError
            });
        }

        // is_new = true คือรายการที่ยังไม่ถูกบันทึกในระบบ ต้องแนบเอกสาร และยกเลิกออกได้
        $scope.New = function(){
            $timeout(function () {
                $scope.lData.splice($scope.lData.length, 0, { trainingId: NewGuid(), mode: "modify", lAttachFile: [], is_new: true });
            }, 0);
        }

        // ลบได้เฉพาะรายการที่ยังไม่บันทึกในระบบ ข้อมูลที่บันทึกแล้วห้ามลบผ่านใบคำขอนี้
        $scope.Delete = function(x){
            if (!x.is_new) {
                return;
            }

            var Remove = function () {
                $timeout(function () {
                    var index = $scope.lData.indexOf(x);

                    if (index > -1) {
                        $scope.lData.splice(index, 1);
                    }
                }, 0);
            }

            if ((x.lAttachFile || []).length > 0) {
                alertConfirm("ยืนยันการยกเลิกรายการ", "เอกสารที่แนบไว้ในรายการนี้จะถูกนำออกด้วย", Remove);
                return;
            }

            Remove();
        }

        $scope.MAX_FILE_SIZE = 10485760;
        $scope.ALLOW_FILE_TYPE = ['pdf', 'jpg', 'jpeg', 'png'];

        $scope.FileSizeText = function (size) {
            size = size || 0;

            if (size >= 1048576) {
                return (size / 1048576).toFixed(2) + ' MB';
            }

            return Math.max(Math.round(size / 1024), 1) + ' KB';
        }

        // โหลดไฟล์ที่แนบไว้ตอนยื่นครั้งก่อน แล้วจับคู่กลับเข้ารายการฝึกอบรมด้วย attachCode
        $scope.LoadAttachFile = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/File/DataList',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    refId: $scope.id
                }),
                success: function (result) {
                    $timeout(function () {
                        var lFile = result || [];

                        ($scope.lData || []).forEach(function (x) {
                            x.lAttachFile = lFile.filter(function (a) {
                                return a.attachCode && a.attachCode == x.trainingId;
                            });
                        });
                    }, 0);
                }, error: function () {
                    console.log('Load File Error');
                }
            });
        }

        $scope.AddAttach = function (x) {
            var iFile = x.fileModel;
            x.fileModel = null;

            if (!iFile || !iFile.filename) {
                return;
            }

            var ext = iFile.filename.split('.').pop().toLowerCase();

            if ($scope.ALLOW_FILE_TYPE.indexOf(ext) < 0) {
                alertWarning("ปัญหาการแนบไฟล์", "รองรับเฉพาะไฟล์ PDF, JPG และ PNG");
                return;
            }

            if (iFile.filesize > $scope.MAX_FILE_SIZE) {
                alertWarning("ปัญหาการแนบไฟล์", "ไฟล์ " + iFile.filename + " มีขนาดเกิน 10 MB");
                return;
            }

            x.lAttachFile = x.lAttachFile || [];

            if (x.lAttachFile.find(a => (a.outputname || a.filename) == iFile.filename)) {
                alertWarning("ปัญหาการแนบไฟล์", "มีไฟล์ชื่อนี้แนบอยู่แล้ว");
                return;
            }

            x.lAttachFile.splice(x.lAttachFile.length, 0, iFile);
        }

        // ไฟล์ที่มี id คือไฟล์ที่อยู่บนเซิร์ฟเวอร์แล้ว ต้องสั่งลบจริง ส่วนไฟล์ที่เพิ่งเลือกแค่เอาออกจากรายการ
        $scope.DeleteAttach = function (x, a) {
            var index = x.lAttachFile.indexOf(a);

            if (index < 0) {
                return;
            }

            if (!a.id) {
                x.lAttachFile.splice(index, 1);
                return;
            }

            alertConfirm("ยืนยันการลบเอกสาร", "ต้องการลบ " + (a.outputname || a.filename), async function () {
                var flag = await $scope.DeleteFile(a);

                if (flag) {
                    $timeout(function () {
                        x.lAttachFile.splice(index, 1);
                    }, 0);
                } else {
                    alertWarning("ลบเอกสารไม่สำเร็จ", "กรุณาลองอีกครั้ง");
                }
            });
        }

        $scope.DeleteFile = function (a) {
            return new Promise((resolve) => {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/File/Delete',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    cache: false,
                    data: JSON.stringify({
                        id: a.id
                        , refId: a.refId
                    }),
                    success: function () {
                        resolve(true);
                    },
                    error: function () {
                        resolve(false);
                    }
                });
            });
        }

        $scope.indexDesc = function (index) {
            return 'ใบรับรอง / ใบอนุญาต ' + (index + 1);
        }

        // ตรวจเข้มเฉพาะรายการที่เพิ่มใหม่ ข้อมูลเดิมในระบบที่ไม่สมบูรณ์จะไม่บล็อกการส่ง (TrainingPayload คัดออกให้)
        $scope.Validate = function(){
            var lRow = $scope.lData.filter(item => item.mode == 'modify');
            var lMissingData = [];
            var lMissingFile = [];

            lRow.forEach(function (x, index) {
                if (!x.is_new) {
                    return;
                }

                var label = $scope.indexDesc(index);

                if (!x.license) {
                    lMissingData.push(label);
                    return;
                }

                if ((x.lAttachFile || []).length == 0) {
                    lMissingFile.push(label);
                }
            });

            if (lMissingData.length > 0) {
                alertWarning("ข้อมูลไม่ครบ", "กรุณากรอกชื่อใบรับรอง / ใบอนุญาตของ " + lMissingData.join(', '));
                return false;
            }

            if (lMissingFile.length > 0) {
                alertWarning("ต้องแนบเอกสาร", "รายการที่เพิ่มใหม่ต้องแนบเอกสารหลักฐานการฝึกอบรม : " + lMissingFile.join(', '));
                return false;
            }

            if (lRow.filter(item => item.license).length == 0) {
                alertWarning("แจ้งเตือน", "กรุณาเพิ่มข้อมูลการฝึกอบรมอย่างน้อย 1 รายการ");
                return false;
            }

            return true;
        }

        $scope.Save = async function () {
            if ($scope.Validate()) {
                alertConfirm("ยืนยันการทำรายการ", "ท่านต้องการส่งใบคำขอ", async function () {
                    // ผูกทุกรายการกับใบงานใบนี้ ให้ ServiceTraining/Detail บนใบงานอ่านเจอ
                    $scope.lData = $scope.lData.map(item => {
                        item.refId = $scope.id;

                        if (item.issue_date_select) {
                            item.issueDate = item.issue_date_select.format("DD/MM/YYYY");
                        }
                        if (item.expire_date_select) {
                            item.expireDate = item.expire_date_select.format("DD/MM/YYYY");
                        }

                        return item;
                    });

                    var flag = await $scope.CreateForm();

                    if (flag) {
                        flag = await $scope.UploadAttachFile($scope.id);
                    }

                    if (flag) {
                        var serviceNo = await $scope.ServiceRequest();

                        if (serviceNo) {
                            alertSuccess("ทำรายการสำเร็จ", "ระบบบันทึกใบคำขอของท่านเรียบร้อย", function () {
                                location.href = '@Url.Page("/Service/Index")';
                            });
                        }
                    }
                });
            }
        }

        // ไฟล์แนบส่งแยกทาง api/File/Create จึงตัด lAttachFile/fileModel ออก ไม่ให้ base64 ติดไปกับ payload
        // ส่วน *_date_select เป็น moment object ที่ถูกแปลงเป็น issueDate/expireDate แล้ว จึงไม่ต้องส่งซ้ำ
        $scope.TrainingPayload = function () {
            var lSkip = ['lAttachFile', 'fileModel', 'is_new', 'issue_date_select', 'expire_date_select'];

            return $scope.lData.filter(item => item.license).map(function (item) {
                var iSave = {};

                Object.keys(item).forEach(function (key) {
                    if (lSkip.indexOf(key) < 0) {
                        iSave[key] = item[key];
                    }
                });

                return iSave;
            });
        }

        // อัปโหลดเฉพาะไฟล์ที่เพิ่งเลือก (มี base64) ไฟล์เดิมที่มี id อยู่บนเซิร์ฟเวอร์แล้ว
        $scope.UploadAttachFile = async function (refId) {
            var flag = true;
            var fileindex = 0;
            var lRow = $scope.lData.filter(item => item.mode == 'modify' && item.license && (item.lAttachFile || []).length > 0);

            for (var i = 0; i < lRow.length; i++) {
                var iRow = lRow[i];
                var lNew = iRow.lAttachFile.filter(a => !a.id && a.base64);

                for (var a = 0; a < lNew.length; a++) {
                    var iFile = lNew[a];
                    fileindex++;

                    var upload = await $scope.UploadFile({
                        refId: refId
                        , attachCode: iRow.trainingId
                        , callerId: 'EDIT_TRAINING'
                        , filename: iFile.filename
                        , filetype: iFile.filetype
                        , filesize: iFile.filesize
                        , base64: iFile.base64
                        , fileindex: fileindex
                        , userId: $scope.userId
                        , create_by: '@User.UserId()'
                    });

                    flag = upload ? flag : false;
                }
            }

            return flag;
        }

        $scope.UploadFile = function (x) {
            return new Promise((resolve) => {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/File/Create',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    dataType: 'json',
                    cache: false,
                    data: JSON.stringify(x),
                    success: function () {
                        $timeout(function () {
                            resolve(true);
                        }, 0);
                    },
                    error: function (jqXHR) {
                        resolve(false);
                        Swal.fire({
                            title: "แนบไฟล์ไม่สำเร็จ",
                            text: x.filename + ' : ' + jqXHR.responseText,
                            icon: "error",
                            confirmButtonColor: '#1e3b92',
                        });
                    }
                });
            });
        }

        $scope.CreateForm = function () {
            return new Promise((resolve)=>{
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/ServiceTraining/Save',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    cache: false,
                    data: JSON.stringify($scope.TrainingPayload()),
                    success: function () {
                        $timeout(async function () {
                           resolve(true);
                        }, 0);
                    }, error: function(jqXHR, error, errorThrown) {
                        resolve(null);
                        Swal.fire({
                            title: "ระบบเกิดข้อผิดพลาด",
                            text: jqXHR.responseText,
                            icon: "error",
                            confirmButtonColor: '#1e3b92',
                        });
                    }
                });
            });
        }
    });
</script>
