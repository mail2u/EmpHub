@page
@model EmpHub.Pages.Service.FormUpdate.FormNeedTrainingModel
@{
    var token = User.AccessToken(HttpContext);
}
<style>
    .main-content{
        min-height:calc(100vh - 150px) !important;
    }

</style>
<div ng-controller="ServiceEducationCtrl" id="tab_education">
    @* Header *@
    <partial name="_PartialFormUpdate" />
    @* View *@
    <div class="rounded-4 mb-3 bg-white shadow-sm p-4">
        <div class="fs-5 text-warning">1. ข้อมูลตำแหน่งงาน (Position Identification)</div>
        <div class="row">
            <div class="col-sm-12 mb-3">
                <div class="text-dark fs-5">ชื่อตำแหน่งงาน</div>
                <input ng-model="iData.positionName" class="form-control" maxlength="50" />
            </div>
            <div class="col-sm-12 mb-3">
                <div class="text-dark fs-5">สายงาน</div>
                <input ng-model="iData.groupName" class="form-control" maxlength="50" />
            </div>
            <div class="col-sm-12 mb-3">
                <div class="text-dark fs-5">ฝ่ายงาน</div>
                <input ng-model="iData.departmentName" class="form-control" maxlength="50" />
            </div>
            <div class="col-sm-12 mb-3">
                <div class="text-dark fs-5">ส่วนงาน</div>
                <input ng-model="iData.partName" class="form-control" maxlength="50" />
            </div>
            <div class="col-sm-12 mb-3">
                <div class="text-dark fs-5">ความรับผิดชอบ</div>
                <textarea ng-model="iData.job_description" class="form-control" maxlength="2000" rows="5"></textarea>
            </div>
        </div>
        <div class="fs-5 text-warning">2. บทบาทหน้าที่ความรับผิดชอบหลัก (Major Role Responsibilities)</div>
        <div>
            <div class="col-sm-12 mb-3">
                <div class="text-dark fs-5">บทบาทหน้าที่ความรับผิดชอบ</div>
                <textarea ng-model="iData.majo_description" class="form-control" maxlength="2000" rows="5"></textarea>
            </div>
        </div>
        <div class="fs-5 text-warning">3. ทักษะและประสบการณ์ (Experience and Skills)</div>
        <div>ระบุประสบการณ์และทักษะในระดับขั้นต่ำที่ผู้ดำรงตำแหน่งต้องมีเพื่อให้ปฏิบัติงานได้สำเร็จ</div>
        <div class="row">
            <div class="col-sm-12 mb-3">
                <div class="text-dark fs-5">การศึกษา (Education)</div>
                <input ng-model="iData.education" class="form-control" maxlength="50" />
            </div>
            <div class="col-sm-12 mb-3">
                <div class="text-dark fs-5">ประสบการณ์ (Experience) - ระบุทั้งสาขาประสบการ์และระยะเวลา</div>
                <input ng-model="iData.experience" class="form-control" maxlength="50" />
            </div>
            <div class="col-sm-12 mb-3">
                <div class="text-dark fs-5">สมรรถนะเชิงสายงาน (Functional Competencies)</div>
                <input ng-model="iData.functional_competencies" class="form-control" maxlength="50" />
            </div>
            <div class="col-sm-12 mb-3">
                <div class="text-dark fs-5">สมรรถนะผู้นำ (Leadership Competencies)</div>
                <input ng-model="iData.leadership_competencies" class="form-control" maxlength="50" />
            </div>
        </div>
        <div class="fs-5 text-warning">4. ผลงานที่คาดหวัง (Key Result Areas)</div>
        <div class="row">
            <div class="col-sm-12 mb-3">
                <div class="text-dark fs-5">ด้านการเงิน (Financial)</div>
                <input ng-model="iData.financial" class="form-control" maxlength="50" />
            </div>
            <div class="col-sm-12 mb-3">
                <div class="text-dark fs-5">ด้านลูกค้าและตลาด (Customer and Market)</div>
                <input ng-model="iData.customer_and_market" class="form-control" maxlength="50" />
            </div>
            <div class="col-sm-12 mb-3">
                <div class="text-dark fs-5">ด้านกระบวนการ (Process)</div>
                <input ng-model="iData.process" class="form-control" maxlength="50" />
            </div>
            <div class="col-sm-12 mb-3">
                <div class="text-dark fs-5">ด้านการพัฒนาศักยภาพบุคลากร (People Development)</div>
                <input ng-model="iData.people_development" class="form-control" maxlength="50" />
            </div>
        </div>
        <div class="fs-5 text-warning">5. การติดต่อสื่อสาร (Contacts and Purpose of Contact)</div>
        <div class="row">
            <div class="col-sm-6 mb-3">
                <div class="text-dark fs-5">หน่วยงานภายใน</div>
                <textarea ng-model="iData.internal_description" class="form-control" maxlength="2000" rows="5"></textarea>
            </div>
            <div class="col-sm-6 mb-3">
                <div class="text-dark fs-5">วัตถุประสงค์ในการติดต่อสื่อสาร</div>
                <textarea ng-model="iData.internal_contact_description" class="form-control" maxlength="2000" rows="5"></textarea>
            </div>
            <div class="col-sm-6 mb-3">
                <div class="text-dark fs-5">หน่วยงานภายนอก</div>
                <textarea ng-model="iData.external_description" class="form-control" maxlength="2000" rows="5"></textarea>
            </div>
            <div class="col-sm-6 mb-3">
                <div class="text-dark fs-5">วัตถุประสงค์ในกรต่ิดต่อสื่อสาร</div>
                <textarea ng-model="iData.external_contact_description" class="form-control" maxlength="2000" rows="5"></textarea>
            </div>
        </div>
    </div>
    <div class="d-flex justify-content-end">
        <div class="btn btn-primary" ng-click="Save()">
            <i class="far fa-paper-plane me-2"></i> ส่งใบคำขอ
        </div>
    </div>
</div>
<script>
    app.controller('ServiceEducationCtrl', function ($scope, $http, $timeout, $filter) {
       $scope.id = '@Model.refId';

        $scope.LoadForm = function(){
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Form/FormRequestTrainingDetail',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                cache: false,
                data: JSON.stringify({
                    refId: $scope.id
                }),
                success: function (result) {
                    $timeout(async function () {
                        $scope.iForm = result
                    }, 0);
                }, error: AjaxError
            });
        }
        
        $scope.$on('FORM_LOAD', function (e) {
            $scope.LoadForm();
        });

        $scope.LoadMaster = function () {
            if (!$scope.lEduction) {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/MasterCode/DataList'
                    , headers: { 'authorization': 'Bearer @token' }
                    , type: 'post'
                    , contentType: 'application/json'
                    , dataType: 'json'
                    , cache: false
                    , data: JSON.stringify({
                        groupName: 'educationCode'
                    })
                    , success: function (result) {
                        $timeout(function () {
                            $scope.lEduction = result;
                        }, 0);
                    }
                    , error: AjaxError
                });
            }
        }

        $scope.Validate = function(){
            var flag = true;
            // JS_Reset($(".firstname_th"));
            // JS_Reset($(".lastname_th"));

            // if($scope.iData.firstname_th == ''){
            //     flag = false;
            //     JS_Require($(".firstname_th"));
            // }
            // if($scope.iData.lastname_th == ''){
            //     flag = false;
            //     JS_Require($(".lastname_th"));
            // }

            return flag;
        }

        $scope.Save = async function () {
            if ($scope.Validate()) {
                alertConfirm("ยืนยันการทำรายการ", "ท่านต้องการส่งใบคำขอ", async function () {
                    var flag = await $scope.CreateForm();

                    if (flag) {
                        var serviceNo = await $scope.ServiceRequest();

                        if (serviceNo) {
                            alertSuccess("ทำรายการสำเร็จ", "ระบบบันทึกใบคำขอของท่านเรียบร้อย", function () {
                                location.href = '@Url.Page("/Service/Index")';
                            });
                        }
                    }
                });
            } else {
                alertWarning("แจ้งเตือน", "กรุณากรอกข้อมูลให้ครบ");
            }
        }

        $scope.CreateForm = function () {
            return new Promise((resolve)=>{
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/ServiceNeedEmployee/Save',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    cache: false,
                    data: JSON.stringify($scope.lData),
                    success: function () {
                        $timeout(async function () {
                           resolve(true);
                        }, 0);
                    }, error: function(jqXHR, error, errorThrown) {
                        resolve(null);
                        Swal.fire({
                            title: "ระบบเกิดข้อผิดพลาด",
                            text: jqXHR.responseText,
                            icon: "error",
                            confirmButtonColor: '#1e3b92',
                        });
                    }
                });
            });
        }
    });
</script>