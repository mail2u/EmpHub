@page
@model EmpHub.Pages.Service.FormUpdate.FormBuyUniformModel
@{
    var token = User.AccessToken(HttpContext);
}
<style>
    .main-content {
        min-height: calc(100vh - 150px) !important;
    }

    .input-error{
        color: red;
        border-color: red;
    }
</style>
<div ng-controller="FormCtrl" id="tab_education">
    @* Header *@
    <partial name="_PartialFormUpdate" />
    @* View *@
    <div class="d-flex justify-content-center">
        <div class="rounded-4 mb-3 bg-white shadow-sm p-4" style="width:600px;">
            <div class="text-center fs-4 fw-bolder mb-4 text-dark">
                แจ้งขอซื้อเสื้อ Uniform
            </div>
            <table class="table table-borderless">
                <tbody>
                    <tr>
                        <td>
                            <div class="text-dark text-nowrap fw-bolder">แบบ</div>
                            <div class="text-dark text-nowrap">Style</div>
                        </td>
                        <td>
                            <select ng-model="iForm.style" class="form-select style" ng-options="x for x in lStyle">
                                <option value="">-</option>
                            </select>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <div class="text-dark text-nowrap fw-bolder">สี</div>
                            <div class="text-dark text-nowrap">Color</div>
                        </td>
                        <td>
                            <select ng-model="iForm.color" class="form-select color" ng-options="x for x in lColor">
                                <option value="">-</option>
                            </select>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <div class="text-dark text-nowrap fw-bolder">ไซซ์</div>
                            <div class="text-dark text-nowrap">Size</div>
                        </td>
                        <td>
                            <select ng-model="iForm.size" class="form-select size" ng-options="x for x in lSize">
                                <option value="">-</option>
                            </select>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <div class="text-dark text-nowrap fw-bolder">จำนวน</div>
                            <div class="text-dark text-nowrap">Quantity</div>
                        </td>
                        <td>
                            <input ng-model="iForm.quantity" class="form-control quantity" />
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <div class="text-dark text-nowrap fw-bolder">หมายเหตุ</div>
                            <div class="text-dark text-nowrap">Description</div>
                        </td>
                        <td>
                            <textarea ng-model="iForm.description" class="form-control description" rows=5 maxlength="2000"></textarea>
                        </td>
                    </tr>
                </tbody>
            </table>
            <div class="d-flex justify-content-end">
                <div class="btn btn-primary" ng-click="Save()">
                    <i class="far fa-paper-plane me-2"></i> ส่งใบคำขอ
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    $(".quantity").mask("000");
    app.controller('FormCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.lStyle = ['เสื้อโปโล', 'เสื้อแจ็คเก็ต'];
        $scope.lColor = ['ดำ', 'เหลือง'];
        $scope.lSize = ['XS', 'S', 'M', 'L', 'XL', '2XL', '3XL', '4XL', 'Other'];

        $scope.id = '@Model.refId';

        $scope.LoadForm = function(){
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Form/FormBuyUniformDetail',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                cache: false,
                data: JSON.stringify({
                    refId: $scope.id
                }),
                success: function (result) {
                    $timeout(async function () {
                        $scope.iForm = result
                    }, 0);
                }, error: AjaxError
            });
        }
        
        $scope.$on('FORM_LOAD', function (e) {
            $scope.LoadForm();
        });

        $scope.Validate = function () {
            var flag = true;
            JS_Reset($(".style"));
            JS_Reset($(".quantity"));
            JS_Reset($(".description"));

            if ($scope.iForm.style == '') {
                flag = false;
                JS_Require($(".style"));
            }
            if ($scope.iForm.quantity <= 0) {
                flag = false;
                JS_Require($(".quantity"));
            }
            // if ($scope.iForm.description == '') {
            //     flag = false;
            //     JS_Require($(".description"));
            // }

            return flag;
        }

        $scope.Save = async function () {
            if ($scope.Validate()) {
                alertConfirm("ยืนยันการทำรายการ", "ท่านต้องการส่งใบคำขอ", async function () {
                    var flag = await $scope.CreateForm();

                    if (flag) {
                        var serviceNo = await $scope.ServiceRequest();

                        if (serviceNo) {
                            alertSuccess("ทำรายการสำเร็จ", "ระบบบันทึกใบคำขอของท่านเรียบร้อย", function () {
                                location.href = '@Url.Page("/Service/Index")';
                            });
                        }
                    }
                });
            } else {
                alertWarning("แจ้งเตือน", "กรุณากรอกข้อมูลให้ครบ");
            }
        }

        $scope.CreateForm = function () {
            return new Promise((resolve) => {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/Form/FormBuyUniformCreate',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    cache: false,
                    data: JSON.stringify($scope.iForm),
                    success: function () {
                        $timeout(async function () {
                            resolve(true);
                        }, 0);
                    }, error: function (jqXHR, error, errorThrown) {
                        resolve(null);
                        Swal.fire({
                            title: "ระบบเกิดข้อผิดพลาด",
                            text: jqXHR.responseText,
                            icon: "error",
                            confirmButtonColor: '#1e3b92',
                        });
                    }
                });
            });
        }
    });
</script>