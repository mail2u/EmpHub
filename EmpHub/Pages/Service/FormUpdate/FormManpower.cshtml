@page
@model EmpHub.Pages.Service.FormUpdate.FormNeedEmployeeModel
@{
    var token = User.AccessToken(HttpContext);
}
<style>
    .main-content {
        min-height: calc(100vh - 150px) !important;
    }

    .box-group {
        border: 1px solid white;
        border-radius: 15px;
    }

        .box-group.input-error {
            padding: 15px;
        border: 1px solid red;
    }
</style>
<div ng-controller="FormCtrl" id="tab_education">
    @* Header *@
    <partial name="_PartialFormUpdate" />
    @* View *@
    <div class="rounded-4 mb-3 bg-white shadow-sm p-4">
        <div class="text-center fs-4 fw-bolder mb-4 text-dark">
            ใบขอกำลังคน / Manpower Requisition Form
        </div>
        <div class="row">
            <div class="col-sm-6 mb-3 d-lg-flex">
                <div class="me-3">
                    <div class="text-dark text-nowrap fw-bolder">ตำแหน่งที่ต้องการ</div>
                    <div class="text-dark text-nowrap">Position Required</div>
                </div>
                <div class="dropdown flex-fill">
                    <input ng-model="iForm.position" class="form-control form-control-input form-select position dropdown-toggle bg-white text-dark border" readonly data-bs-toggle="dropdown" />
                    <div class="dropdown-menu p-2 rounded-3" style="width:400px;">
                        <input ng-model="find_position" class="form-control mb-2" />
                        <div class="overflow-auto list-group list-group-flush" style="height:400px">
                            <div class="list-group-item list-group-item-action select" ng-repeat="d in lPosition | filter : find_position" ng-click="SelectPosition(d)">
                                {{ d.desc_th }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 mb-3 d-lg-flex">
                <div class="me-3">
                    <div class="text-dark text-nowrap fw-bolder">แผนก / ฝ่าย</div>
                    <div class="text-dark text-nowrap">Division / Department</div>
                </div>
                <div class="dropdown flex-fill">
                    <input ng-model="iForm.department" class="form-control form-control-input form-select department dropdown-toggle bg-white text-dark border" readonly data-bs-toggle="dropdown" />
                    <div class="dropdown-menu p-2 rounded-3" style="width:400px;">
                        <input ng-model="find_department" class="form-control mb-2" />
                        <div class="overflow-auto list-group list-group-flush" style="height:400px">
                            <div class="list-group-item list-group-item-action select" ng-repeat="d in lDepartment | filter : find_department" ng-click="SelectDepartment(d)">
                                {{ d.desc_th }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-4 mb-3 d-lg-flex">
                <div class="me-3">
                    <div class="text-dark text-nowrap fw-bolder">วันที่ต้องการ</div>
                    <div class="text-dark text-nowrap">Date Required</div>
                </div>
                <input class="form-control form-control-input icon-calendar date required_date"
                       ng-model="iForm.required_date_select"
                       ng-model-options="{ updateOn: 'blur' }"
                       moment-picker="iForm.required_date_select"
                       locale="th"
                       format="DD/MM/YYYY"
                       min-view="month"
                       max-view="month" required />
            </div>
            <div class="col-sm-4"></div>
            <div class="col-sm-4 mb-3 d-lg-flex">
                <div class="me-3">
                    <div class="text-dark text-nowrap fw-bolder">จำนวนพนักงานที่ต้องการ</div>
                    <div class="text-dark text-nowrap">Number of Employee Required</div>
                </div>
                <input ng-model="iForm.num_employee" class="form-control form-control-input num_employee" maxlength="50" />
            </div>
            <div class="col-sm-12 mb-3">
                <div class="type_employment box-group d-lg-flex align-items-center">
                    <div class="me-3">
                        <div class="text-dark text-nowrap fw-bolder">ประเภทของการจ้างงาน</div>
                        <div class="text-dark text-nowrap">Type of Employment</div>
                    </div>
                    <div class="flex-fill">
                        <div class="d-lg-flex align-items-center">
                            <div class="me-4 text-nowrap">
                                <input type="radio" ng-model="iForm.type_employment" value="permanent" /> ประจำ / Permanent
                            </div>
                            <div class="me-4 text-nowrap">
                                <input type="radio" ng-model="iForm.type_employment" value="daily" /> รายวัน / Daily
                            </div>
                            <div class="me-4 text-nowrap">
                                <input type="radio" ng-model="iForm.type_employment" value="monthly" /> รายเดือน / Monthly
                            </div>
                            <div class="me-4 text-nowrap">
                                <input type="radio" ng-model="iForm.type_employment" value="outsource" /> จ้างช่วงระยะเวลา / Temporarily, Outsource
                            </div>
                        </div>
                    </div>
                    <div class="d-lg-flex" ng-show="iForm.type_employment == 'outsource'">
                        <div class="me-3">
                            <div class="text-dark text-nowrap fw-bolder">ระยะเวลาการจ้าง</div>
                            <div class="text-dark text-nowrap">Duration</div>
                        </div>
                        <input ng-model="iForm.type_employment_desc" class="form-control form-control-input type_employment_desc" maxlength="50" />
                    </div>
                </div>
            </div>
            <div class="col-sm-12 mb-3">
                <div class="type_requirement box-group d-lg-flex">
                    <div class="me-3">
                        <div class="text-dark text-nowrap fw-bolder">ประเภทของความต้องการ</div>
                        <div class="text-dark text-nowrap">Type of Requirement</div>
                    </div>
                    <div class="d-lg-flex align-items-center flex-fill">
                        <div class="me-4">
                            <input type="radio" ng-model="iForm.type_requirement" value="external_recruit" /> สรรหาภายนอก (External Recruit)
                        </div>
                        <div>
                            <input type="radio" ng-model="iForm.type_requirement" value="internal_recruit" /> สรรหาภายใน (Internal Recruit)
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-12 mb-3">
            <div class="type_reason box-group">
                <div class="mb-2">
                    <div class="text-dark text-nowrap fw-bolder">เหตุผลการขอกำลังคนเพิ่ม</div>
                    <div class="text-dark text-nowrap">Reason of Additional Manpower Requisition</div>
                </div>
                <div>
                    <input type="radio" ng-model="iForm.type_reason" value="additional_budget" /> จ้างตามงบประมาณ / Additional Budget
                </div>
                <div>
                    <input type="radio" ng-model="iForm.type_reason" value="additional_hire" /> จ้างเพิ่ม / Additional Hire
                   @*  <input ng-model="iForm.type_reason_additional_hire_desc" class="form-control form-control-input type_reason_additional_hire_desc mb-2" ng-show="iForm.type_reason == 'additional_hire'" maxlength="200" /> *@
                </div>
                <div>
                    <input type="radio" ng-model="iForm.type_reason" value="replacement" /> ทดแทน / Replacement (Whom ?)
                    <input ng-model="iForm.type_reason_replacement_desc" class="form-control form-control-input type_reason_replacement_desc mb-2" ng-show="iForm.type_reason == 'replacement'" maxlength="200" />
                </div>
            </div>
        </div>
        <div class="col-sm-12 mb-3">
            <div class="text-dark fw-bolder">ลักษณะงานที่ทำโดยสังเขป</div>
            <div class="text-dark">Description of Work</div>
            <textarea ng-model="iForm.description_work" class="form-control form-control-input description_work" maxlength="2000" rows="5"></textarea>
        </div>
        <div class="">
            <div class="row">
                <div class="col-sm-12">
                    <div class="mb-2 ">
                        <div class="text-warning fw-bolder">คุณสมบัติ Qualification</div>
                    </div>
                    <div class="row">
                        <div class="col-sm-4 mb-3">
                            <div class="sex d-lg-flex">
                                <div class="me-3">
                                    <div class="text-dark text-nowrap fw-bolder">เพศ</div>
                                    <div class="text-dark text-nowrap">Sex</div>
                                </div>
                                <div class="d-lg-flex align-items-center flex-fill">
                                    <div class="me-3">
                                        <input type="radio" ng-model="iForm.sex" value="male" /> ชาย / Male
                                    </div>
                                    <div class="me-4">
                                        <input type="radio" ng-model="iForm.sex" value="female" /> หญิง / Female
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-2 d-lg-flex mb-3">
                            <div class="me-3">
                                <div class="text-dark text-nowrap fw-bolder">อายุ</div>
                                <div class="text-dark text-nowrap">Age</div>
                            </div>
                            <input ng-model="iForm.age" class="form-control form-control-input age" maxlength="50" />
                        </div>
                        <div class="col-sm-6 d-lg-flex mb-3">
                            <div class="me-3">
                                <div class="text-dark text-nowrap fw-bolder">การศึกษา</div>
                                <div class="text-dark text-nowrap">Education</div>
                            </div>
                            <div class="dropdown flex-fill">
                                <input ng-model="iForm.education" class="form-control form-control-input form-select education dropdown-toggle bg-white text-dark border" readonly data-bs-toggle="dropdown" />
                                <div class="dropdown-menu p-2 rounded-3" style="width:400px;">
                                    <input ng-model="find_education" class="form-control mb-2" />
                                    <div class="overflow-auto list-group list-group-flush" style="height:400px">
                                        <div class="list-group-item list-group-item-action select" ng-repeat="d in lEducation | filter : find_education" ng-click="SelectEducation(d)">
                                            {{ d.desc_th }}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-12 d-lg-flex mb-3">
                            <div class="me-3">
                                <div class="text-dark text-nowrap fw-bolder">สาขา</div>
                                <div class="text-dark text-nowrap">Major</div>
                            </div>
                            <input ng-model="iForm.major" class="form-control form-control-input major" maxlength="100" />
                        </div>
                        <div class="col-sm-12 d-lg-flex mb-3">
                            <div class="me-3">
                                <div class="text-dark text-nowrap fw-bolder">ความรู้ในงาน</div>
                                <div class="text-dark text-nowrap">Knowledge</div>
                            </div>
                            <input ng-model="iForm.knowledge" class="form-control form-control-input knowledge" maxlength="2000" />
                        </div>
                    </div>
                </div>
                <div class="col-sm-12 mb-3">
                    <div class="text-dark fw-bolder mb-2">ความสามารถพิเศษ / Speial Skill</div>
                    <div class="d-flex align-items-center">
                        <input type="checkbox" ng-model="iForm.skill_language" ng-true-value="1" ng-false-value="0" />
                        <div class="text-nowrap px-3">ภาษาต่างประเทศ / Foreign Language Command</div>
                    </div>
                    <input ng-model="iForm.skill_language_desc" class="form-control form-control-input" ng-show="iForm.skill_language == 1" maxlength="400" />
                    <div class="d-flex align-items-center mt-2">
                        <input type="checkbox" ng-model="iForm.skill_computer" ng-true-value="1" ng-false-value="0" />
                        <div class="text-nowrap px-3">ความรู้เรื่องคอมพิวเตอร์ / Computer Knowledge</div>
                    </div>
                    <input ng-model="iForm.skill_computer_desc" class="form-control form-control-input" ng-show="iForm.skill_computer == 1" maxlength="400" />
                    <div class="d-flex align-items-center mt-2">
                        <input type="checkbox" ng-model="iForm.skill_other" ng-true-value="1" ng-false-value="0" />
                        <div class="text-nowrap px-3">อื่น ๆ / Other</div>
                    </div>
                    <input ng-model="iForm.skill_other_desc" class="form-control form-control-input" ng-show="iForm.skill_other == 1" maxlength="400" />
                </div>
                <div class="col-sm-12 mb-3">
                    <div class="text-dark fw-bolder mb-2">ประสบการณ์ / Experience</div>
                    <div class="d-flex align-items-center">
                        <input type="radio" ng-model="iForm.type_experience" value="no" />
                        <div class="text-nowrap px-3">ไม่มีประสบการณ์ / Inexperience</div>
                    </div>
                    <div class="d-flex align-items-center mt-2">
                        <input type="radio" ng-model="iForm.type_experience" value="yes" />
                        <div class="text-nowrap px-3">ประสบการณ์ขั้นต่ำ / Minimum Experience</div>
                    </div>
                    <input ng-model="iForm.type_experience_yes_desc" class="form-control form-control-input" ng-show="iForm.type_experience == 'yes'" maxlength="400" />
                    <div class="d-flex align-items-center mt-2">
                        <input type="radio" ng-model="iForm.type_experience" value="other" />
                        <div class="text-nowrap px-3">อื่น ๆ / Other</div>
                    </div>
                    <input ng-model="iForm.type_experience_other_desc" class="form-control form-control-input" ng-show="iForm.type_experience == 'other'" maxlength="400" />
                </div>
            </div>
        </div>
    </div>
    <div class="d-flex justify-content-end">
        <div class="btn btn-primary" ng-click="Save()">
            <i class="far fa-paper-plane me-2"></i> ส่งใบคำขอ
        </div>
    </div>
</div>
<script>
    $(".num_employee").mask("00");
    $(".age").mask("00");
    $(".date").mask("00/00/0000")
    app.controller('FormCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.id = '@Model.refId';

        $scope.LoadForm = function(){
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Form/FormManpowerDetail',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                cache: false,
                data: JSON.stringify({
                    refId: $scope.id
                }),
                success: function (result) {
                    $timeout(async function () {
                        $scope.iForm = result

                        if($scope.iForm.required_date != ''){
                            $scope.iForm.required_date_select = moment($scope.iForm.required_date,"DD/MM/YYYY");
                        }
                    }, 0);
                }, error: AjaxError
            });
        }
        
        $scope.$on('FORM_LOAD', function (e) {
            $scope.LoadForm();
        });

        $scope.LoadMaster = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/MasterCode/DataList'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    groupName: 'Degree'
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lEducation = result;
                    }, 0);
                }
                , error: AjaxError
            });
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/MasterCode/DataList'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    groupName: 'positionCode'
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lPosition = result;
                    }, 0);
                }
                , error: AjaxError
            });
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/MasterCode/DataList'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    groupName: 'departmentCode'
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lDepartment = result.filter(item=>item.condition_4 == 'Department');
                    }, 0);
                }
                , error: AjaxError
            });
        }
        $scope.LoadMaster();

        $scope.SelectPosition = function (d) {
            $scope.iForm.position = d.desc_th;
        }

        $scope.SelectDepartment = function (d) {
            $scope.iForm.department = d.desc_th;
        }

        $scope.SelectEducation = function (d) {
            $scope.iForm.education = d.desc_th;
        }

        $scope.Validate = function () {
            var flag = true;

            JS_Reset($(".position"));
            JS_Reset($(".department"));
            JS_Reset($(".required_date"));
            JS_Reset($(".num_employee"));
            JS_Reset($(".type_employment"));
            JS_Reset($(".type_employment_desc"));
            JS_Reset($(".type_requirement"));
            JS_Reset($(".type_reason"));
            JS_Reset($(".description_work"));

            $scope.iForm.required_date = '';

            if ($scope.iForm.required_date_select){
                $scope.iForm.required_date = $scope.iForm.required_date_select.format("DD/MM/YYYY");
            }

            if ($scope.iForm.position == '') {
                flag = false;
                JS_Require($(".position"));
            }
            if ($scope.iForm.department == '') {
                flag = false;
                JS_Require($(".department"));
            }
            if ($scope.iForm.required_date == '') {
                flag = false;
                JS_Require($(".required_date"));
            }
            if ($scope.iForm.num_employee == '') {
                flag = false;
                JS_Require($(".num_employee"));
            }
            if ($scope.iForm.type_employment == '') {
                flag = false;
                JS_Require($(".type_employment"));
            }
            if ($scope.iForm.type_employment == 'outsource' && $scope.iForm.type_employment_desc == '') {
                flag = false;
                JS_Require($(".type_employment_desc"));
            }
            if ($scope.iForm.type_requirement == '') {
                flag = false;
                JS_Require($(".type_requirement"));
            }
            if ($scope.iForm.type_reason == '') {
                flag = false;
                JS_Require($(".type_reason"));
            }
            if ($scope.iForm.description_work == '') {
                flag = false;
                JS_Require($(".description_work"));
            }

            return flag;
        }

        $scope.Save = async function () {
            if ($scope.Validate()) {
                alertConfirm("ยืนยันการทำรายการ", "ท่านต้องการส่งใบคำขอ", async function () {
                    var flag = await $scope.CreateForm();

                    if (flag) {
                        var serviceNo = await $scope.ServiceRequest();

                        if (serviceNo) {
                            alertSuccess("ทำรายการสำเร็จ", "ระบบบันทึกใบคำขอของท่านเรียบร้อย", function () {
                                location.href = '@Url.Page("/Service/Index")';
                            });
                        }
                    }
                });
            } else {
                alertWarning("แจ้งเตือน", "กรุณากรอกข้อมูลให้ครบ");
            }
        }
        
        $scope.CreateForm = function () {
            return new Promise((resolve) => {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/Form/FormManpowerCreate',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    cache: false,
                    data: JSON.stringify($scope.iForm),
                    success: function () {
                        $timeout(async function () {
                            resolve(true);
                        }, 0);
                    }, error: function (jqXHR, error, errorThrown) {
                        resolve(null);
                        Swal.fire({
                            title: "ระบบเกิดข้อผิดพลาด",
                            text: jqXHR.responseText,
                            icon: "error",
                            confirmButtonColor: '#1e3b92',
                        });
                    }
                });
            });
        }
    });
</script>