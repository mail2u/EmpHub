@page
@model EmpHub.Pages.Service.FormUpdate.FormParkingStickerModel
@{
    var token = User.AccessToken(HttpContext);
}
<style>
    .main-content {
        min-height: calc(100vh - 150px) !important;
    }

    .input-error {
        color: red;
        border-color: red;
    }
</style>
<div ng-controller="FormCtrl" id="tab_education">
    @* Header *@
    <partial name="_PartialFormUpdate" />
    @* View *@
    <div class="d-flex justify-content-center">
        <div class="rounded-4 mb-3 bg-white shadow-sm p-4" style="width:600px;">
            <div class="text-center fs-4 fw-bolder mb-4 text-dark">
                แจ้งขอสติ๊กเกอร์จอดรถ
            </div>
            <table class="table table-borderless">
                <tbody>
                    <tr>
                        <td>
                            <div class="text-dark text-nowrap fw-bolder">สาเหตุ</div>
                            <div class="text-dark text-nowrap">Cause</div>
                        </td>
                        <td>
                            <select ng-model="iForm.cause" class="form-select cause" ng-options="x for x in lCause"></select>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <div class="text-dark text-nowrap fw-bolder">หมายเหตุ</div>
                            <div class="text-dark text-nowrap">Description</div>
                        </td>
                        <td>
                            <textarea ng-model="iForm.description" class="form-control description" rows=5 maxlength="2000"></textarea>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <div class="text-dark text-nowrap fw-bolder">สำเนาทะเบียนรถ</div>
                            <div class="text-dark text-nowrap">File</div>
                        </td>
                        <td>
                            <div class="d-flex" ng-show="iFile != null">
                                <a class="select d-flex align-items-center rounded-3 bg-light-gray shadow-sm p-2" href="@webAPI.CurrentValue.APIEmpHub/api/File/DownloadFile?refId={{ iFile.refId }}&id={{ iFile.id }}" target="_blank" title="Download">
                                    <div class="me-2">
                                        <img width="40" src="data:image/png;base64,{{iFile.imageBase64}}">
                                    </div>
                                    <div>
                                        <div class="fw-bolder">{{ iFile.outputname }}</div>
                                        <div class="small">{{ iFile.filetype }}</div>
                                    </div>
                                    <div>
                                        <i class="bi bi-download ms-2"></i>
                                    </div>
                                </a>
                                <div class="btn btn-circle ms-2" ng-click="DeleteAttach(iFile)" title="ลบไฟล์แนบ">
                                    <i class="bi bi-trash"></i>
                                </div>
                            </div>
                            <div ng-show="iFile == null">
                                <label for="iFile" class="btn btn-secondary-invert file">
                                    {{ iForm.filename != '' ? iForm.filename : 'เลือกไฟล์' }}
                                </label>
                                <input ng-show="1 == 2" id="iFile" data-file type="file" ng-model="iFile" base-sixty-four-input ng-change="AddFile()" />
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
            <div class="d-flex justify-content-end">
                <div class="btn btn-primary" ng-click="Save()">
                    <i class="far fa-paper-plane me-2"></i> ส่งใบคำขอ
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    app.controller('FormCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.lCause = ['บัตรใหม่', 'ชำรุด', 'สูญหาย', 'อื่นๆ'];
        $scope.id = '@Model.refId';

        $scope.LoadForm = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Form/FormParkingStickerDetail',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                cache: false,
                data: JSON.stringify({
                    refId: $scope.id
                }),
                success: function (result) {
                    $timeout(async function () {
                        $scope.iForm = result
                        $scope.LoadAttach();
                    }, 0);
                }, error: AjaxError
            });
        }

        $scope.LoadAttach = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/File/DataList',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    refId: $scope.id
                }),
                success: function (result) {
                    $timeout(async function () {
                        var lFile = result;
                        $scope.iForm.filename = '';

                        if (lFile.length > 0) {
                            $scope.iFile = lFile[0];
                            $scope.iForm.filename = $scope.iFile.filename;
                        }
                    }, 0);
                }, error: AjaxError
            });
        }

        $scope.$on('FORM_LOAD', function (e) {
            $scope.LoadForm();
        });

        $scope.AddFile = function () {
            if (iFile) {
                $timeout(async function () {
                    $scope.iFile.refId = $scope.id;
                    $scope.iFile.outputname = $scope.iFile.filename;
                    $scope.iForm.filename = $scope.iFile.filename;
                    $scope.iForm.filetype = $scope.iFile.filetype;
                    $scope.iForm.base64 = $scope.iFile.base64;
                }, 0);
            }
        }

        $scope.Validate = function () {
            var flag = true;
            JS_Reset($(".cause"));
            JS_Reset($(".description"));
            JS_Reset($(".file"));

            if ($scope.iForm.cause == '') {
                flag = false;
                JS_Require($(".cause"));
            }
            if ($scope.iForm.description == '') {
                flag = false;
                JS_Require($(".description"));
            }
            if ($scope.iForm.filename == '') {
                flag = false;
                JS_Require($(".file"));
            }

            return flag;
        }

        $scope.Save = async function () {
            if ($scope.Validate()) {
                alertConfirm("ยืนยันการทำรายการ", "ท่านต้องการส่งใบคำขอ", async function () {
                    var flag = await $scope.CreateForm();

                    if (flag) {
                        flag = await $scope.CreateAttach();

                        if (flag) {
                            var serviceNo = await $scope.ServiceRequest();

                            if (serviceNo) {
                                alertSuccess("ทำรายการสำเร็จ", "ระบบบันทึกใบคำขอของท่านเรียบร้อย", function () {
                                    location.href = '@Url.Page("/Service/Index")';
                                });
                            }
                        } else {
                            alertWarning("แจ้งเตือน", "บันทึกข้อมูลไม่สำเร็จ");
                        }
                    } else {
                        alertWarning("แจ้งเตือน", "บันทึกข้อมูลไม่สำเร็จ");
                    }
                });
            } else {
                alertWarning("แจ้งเตือน", "กรุณากรอกข้อมูลให้ครบ");
            }
        }

        $scope.CreateForm = function () {
            return new Promise((resolve) => {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/Form/FormParkingStickerCreate',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    cache: false,
                    data: JSON.stringify($scope.iForm),
                    success: function () {
                        $timeout(async function () {
                            resolve(true);
                        }, 0);
                    }, error: function (jqXHR, error, errorThrown) {
                        resolve(null);
                        Swal.fire({
                            title: "ระบบเกิดข้อผิดพลาด",
                            text: jqXHR.responseText,
                            icon: "error",
                            confirmButtonColor: '#1e3b92',
                        });
                    }
                });
            });
        }

        $scope.DeleteAttach = function (x) {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/File/Delete',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                cache: false,
                data: JSON.stringify(x),
                success: function () {
                    $timeout(async function () {
                        $scope.iFile = null;
                        $scope.iForm.filename = '';
                    }, 0);
                }, error: AjaxError
            });
        }

        $scope.CreateAttach = function () {
            return new Promise((resolve) => {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/File/Create',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    cache: false,
                    data: JSON.stringify($scope.iFile),
                    success: function () {
                        $timeout(async function () {
                            resolve(true);
                        }, 0);
                    }, error: function (jqXHR, error, errorThrown) {
                        resolve(null);
                        Swal.fire({
                            title: "ระบบเกิดข้อผิดพลาด",
                            text: jqXHR.responseText,
                            icon: "error",
                            confirmButtonColor: '#1e3b92',
                        });
                    }
                });
            });
        }
    });
</script>