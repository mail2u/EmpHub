@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
<div ng-controller="ServiceJobExperienceCtrl" class="mb-4">
    <div class="row">
        <div class="col-sm-6">
            <div class="fw-bolder text-orange">ข้อมูลที่ต้องการปรับปรุง</div>
            <div class="p-3 bg-gray rounded-4 h-100">
                <div ng-show="lData.length > 0">
                    <div class="list-group list-group-flush">
                        <div class="list-group-item bg-gray px-0" ng-repeat="x in lData">
                            <div class="row">
                                <div class="col-sm-6 mb-3">
                                    <div class="text-gray">
                                        บริษัท
                                    </div>
                                    <div class="fw-bolder">{{ x.company }}</div>
                                </div>
                                <div class="col-sm-3 mb-3">
                                    <div class="text-gray">
                                        วันที่เริ่ม
                                    </div>
                                    <div class="fw-bolder">{{ x.from_date | date:'MMM yyyy' }}</div>
                                </div>
                                <div class="col-sm-3 mb-3">
                                    <div class="text-gray">
                                        วันที่สิ้นสุด
                                    </div>
                                    <div class="fw-bolder">{{ x.end_date | date:'MMM yyyy' }}</div>
                                </div>
                                <div class="col-sm-8 mb-3">
                                    <div class="text-gray">
                                        ตำแหน่ง
                                    </div>
                                    <div class="fw-bolder">{{ x.position }}</div>
                                </div>
                                <div class="col-sm-12 mb-3">
                                    <div class="text-gray">
                                        รายละเอียดการทำงาน
                                    </div>
                                    <div class="fw-bolder">{{ x.description }}</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6" ng-show="status == 'Pending'">
            <div class="fw-bolder text-orange">ข้อมูลในระบบ</div>
            <div class="p-3 bg-gray rounded-4 h-100">
                <div ng-show="lData.length > 0">
                    <div class="list-group list-group-flush">
                        <div class="list-group-item bg-gray px-0" ng-repeat="x in lUser">
                            <div class="row">
                                <div class="col-sm-6 mb-3">
                                    <div class="text-gray">
                                        บริษัท
                                    </div>
                                    <div class="fw-bolder text-decoration-line-through">{{ x.company }}</div>
                                </div>
                                <div class="col-sm-3 mb-3">
                                    <div class="text-gray">
                                        วันที่เริ่ม
                                    </div>
                                    <div class="fw-bolder text-decoration-line-through">{{ x.from_date | date:'MMM yyyy' }}</div>
                                </div>
                                <div class="col-sm-3 mb-3">
                                    <div class="text-gray">
                                        วันที่สิ้นสุด
                                    </div>
                                    <div class="fw-bolder text-decoration-line-through">{{ x.end_date | date:'MMM yyyy' }}</div>
                                </div>
                                <div class="col-sm-8 mb-3">
                                    <div class="text-gray">
                                        ตำแหน่ง
                                    </div>
                                    <div class="fw-bolder text-decoration-line-through">{{ x.position }}</div>
                                </div>
                                <div class="col-sm-12 mb-3">
                                    <div class="text-gray">
                                        รายละเอียดการทำงาน
                                    </div>
                                    <div class="fw-bolder text-decoration-line-through">{{ x.description }}</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    app.controller('ServiceJobExperienceCtrl', function ($scope, $http, $timeout, $filter) {

        $scope.LoadData = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/ServiceJobExperience/DetailByRef',
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    refId: $scope.refId
                }),
                success: function (result) {
                    $timeout(async function () {
                        $scope.lData = result;
                    }, 0);
                }, error: AjaxError
            });
        }
        
        $scope.LoadUser = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/UserJobExperience',
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    userId: $scope.userId
                    , create_by: '@User.UserId()'
                }),
                success: function (result) {
                    $timeout(async function () {
                        $scope.lData = result;
                    }, 0);
                }, error: AjaxError
            });
        }

        $scope.$parent.LoadJobExperience = function (x) {
            $scope.refId = x.id;
            $scope.userId = x.userId;
            $scope.status = x.status;
            $scope.LoadData();
            $scope.LoadUser();
        }
    });
</script>