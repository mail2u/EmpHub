    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    var token = User.AccessToken(Context);
}
<div ng-controller="ServiceJobExperienceCtrl" class="mb-4">
    <div class="row">
        <div class="col-sm-6">
            <small class="text-orange">ข้อมูลที่ต้องการปรับปรุง</small>
            <div class="p-3 bg-soft-orange rounded-4 h-100">
                <div ng-show="lData.length > 0">
                    <div class="list-group list-group-flush">
                        <div class="list-group-item bg-soft-orange px-0 d-flex" ng-repeat="x in lData">
                            <div style="width:20px" class="me-2 fw-bolder">
                                {{ $index + 1 }}.
                            </div>
                            <div>
                                <div>
                                    <div class="badge badge-{{ x.mode }}">{{ x.mode }}</div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-6 mb-3">
                                        <small class="text-decoration-underline">
                                            บริษัท
                                        </small>
                                        <div class="fw-bolder">{{ x.company != '' ? x.company : '-' }}</div>
                                    </div>
                                    <div class="col-sm-3 mb-3">
                                        <small class="text-decoration-underline">
                                            วันที่เริ่ม
                                        </small>
                                        <div class="fw-bolder">{{ x.fromDate != '' ? x.fromDate : '-' }}</div>
                                    </div>
                                    <div class="col-sm-3 mb-3">
                                        <small class="text-decoration-underline">
                                            วันที่สิ้นสุด
                                        </small>
                                        <div class="fw-bolder">{{ x.endDate != '' ? x.endDate : '-' }}</div>
                                    </div>
                                    <div class="col-sm-8 mb-3">
                                        <small class="text-decoration-underline">
                                            ตำแหน่ง
                                        </small>
                                        <div class="fw-bolder">{{ x.position != '' ? x.position : '-' }}</div>
                                    </div>
                                    <div class="col-sm-12 mb-3">
                                        <small class="text-decoration-underline">
                                            รายละเอียดการทำงาน
                                        </small>
                                        <div class="fw-bolder">{{ x.description != '' ? x.description : '-' }}</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6" ng-show="status == 'Pending' && lUser.length > 0">
            <small class="fw-bolder text-blue">ข้อมูลในระบบ</small>
            <div class="p-3 bg-soft-blue rounded-4 h-100">
                <div ng-show="lData.length > 0">
                    <div class="list-group list-group-flush">
                        <div class="list-group-item bg-soft-blue px-0 d-flex" ng-repeat="x in lUser">
                            <div style="width:20px" class="me-2 fw-bolder">
                                {{ $index + 1 }}.
                            </div>
                            <div class="row">
                                <div class="col-sm-6 mb-3">
                                    <small class="text-decoration-underline">
                                        บริษัท
                                    </small>
                                    <div class="fw-bolder">{{ x.company != '' ? x.company : '-' }}</div>
                                </div>
                                <div class="col-sm-3 mb-3">
                                    <small class="text-decoration-underline">
                                        วันที่เริ่ม
                                    </small>
                                    <div class="fw-bolder">{{ x.fromDate != '' ? x.fromDate : '-' }}</div>
                                </div>
                                <div class="col-sm-3 mb-3">
                                    <small class="text-decoration-underline">
                                        วันที่สิ้นสุด
                                    </small>
                                    <div class="fw-bolder">{{ x.endDate != '' ? x.endDate : '-' }}</div>
                                </div>
                                <div class="col-sm-8 mb-3">
                                    <small class="text-decoration-underline">
                                        ตำแหน่ง
                                    </small>
                                    <div class="fw-bolder">{{ x.position != '' ? x.position : '-' }}</div>
                                </div>
                                <div class="col-sm-12 mb-3">
                                    <small class="text-decoration-underline">
                                        รายละเอียดการทำงาน
                                    </small>
                                    <div class="fw-bolder">{{ x.description != '' ? x.description : '-' }}</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    app.controller('ServiceJobExperienceCtrl', function ($scope, $http, $timeout, $filter) {

        $scope.LoadData = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/ServiceJobExperience/DetailByRef',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    refId: $scope.refId
                }),
                success: function (result) {
                    $timeout(async function () {
                        $scope.lData = result.filter(item => item.mode != 'original');
                        $scope.lUser = result.filter(item => item.mode == 'original');
                    }, 0);
                }, error: AjaxError
            });
        }

        $scope.$parent.LoadJobExperience = function (x) {
            $scope.refId = x.id;
            $scope.userId = x.userId;
            $scope.status = x.status;
            $scope.LoadData();
        }
    });
</script>