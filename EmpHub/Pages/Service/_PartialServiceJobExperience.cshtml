@{
    var token = User.AccessToken(Context);
}
<div ng-controller="ServiceJobExperienceCtrl">
    <div class="bg-white rounded-4 border mb-4 overflow-hidden" ng-show="lJobExperience.length > 0">
        <div class="px-4 py-3 border-bottom d-flex align-items-center">
            <div class="fs-5 fw-bolder text-dark flex-fill">Job Experience</div>
            <div>
                <div class="badge bg-light-green px-2 me-2" ng-show="total_add > 0">
                    {{ total_add }} Addition
                </div>
                <div class="badge bg-light-blue px-2 me-2" ng-show="total_modify > 0">
                    {{ total_modify }} Modification
                </div>
                <div class="badge bg-light-red px-2 me-2" ng-show="total_delete > 0">
                    {{ total_delete }} Deletion
                </div>
            </div>
        </div>
        <div class="">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th class="bg-light ps-4">PREVIOUS ROLE</th>
                        <th class="bg-light">COMPANY</th>
                        <th class="bg-light">YEAR</th>
                        <th class="bg-light">ACTION</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="x in lJobExperience">
                        <td class="ps-4 text-{{ x.mode }}">{{ x.position }}</td>
                        <td class="text-{{ x.mode }}">{{ x.company }}</td>
                        <td class="text-{{ x.mode }}">{{ x.from_date }} - {{ x.end_date }}</td>
                        <td>
                            <div class="badge bg-light-green px-2 me-2" ng-show="x.mode == 'add'">
                                Addition
                            </div>
                            <div class="badge bg-light-blue px-2 me-2" ng-show="x.mode == 'modify'">
                                Modification
                            </div>
                            <div class="badge bg-light-red px-2 me-2" ng-show="x.mode == 'delete'">
                                Deletion
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
<script>
    app.controller('ServiceJobExperienceCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.LoadModify = function () {
            return new Promise((resolve) => {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/ServiceJobExperience/Detail',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    dataType: 'json',
                    cache: false,
                    data: JSON.stringify({
                        refId: $scope.refId
                    }),
                    success: function (result) {
                        $timeout(async function () {
                            $scope.lJobExperience = result;

                            if($scope.lJobExperience.length > 0){
                                $scope.lJobExperience = $scope.lJobExperience.map(item=>{

                                    if(item.fromDate){
                                        var from_date = moment(item.fromDate, "DD/MM/YYYY");
                                        item.from_date = from_date.format('MMM YYYY');
                                    }
                                    if(item.endDate){
                                        var end_date = moment(item.endDate, "DD/MM/YYYY");
                                        item.end_date = end_date.format('MMM YYYY');
                                    }

                                    return item;
                                });
                            }
                            resolve(true);
                        }, 0);
                    }, error: function () {
                        resolve(false);
                    }
                });
            });
        }

        $scope.$parent.LoadJobExperience = async function (x) {
            $scope.refId = x.id;
            $scope.userId = x.userId;
            $scope.status = x.status;

            await $scope.LoadModify();

            $timeout(function () {
                $scope.total_add = ($scope.lJobExperience.filter(item => item.mode == "add")).length;
                $scope.total_modify = ($scope.lJobExperience.filter(item => item.mode == "modify")).length;
                $scope.total_delete = ($scope.lJobExperience.filter(item => item.mode == "delete")).length;
            }, 0);
        }
    });
</script>