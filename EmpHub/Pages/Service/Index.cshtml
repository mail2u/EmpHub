@page
@model EmpHub.Pages.Service.IndexModel
@{
    var token = User.AccessToken(HttpContext);
}

@section PageHeader {
    <!-- [ page-header ] start -->
    <div class="page-header">
        <div class="page-header-left d-flex align-items-center">
            <div class="page-header-title">
                <h5 class="m-b-10">HR Service</h5>
            </div>
            <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Page("/Index")">Home</a></li>
                <li class="breadcrumb-item">My Request</li>
            </ul>
        </div>
    </div>
}

<div ng-controller="ServiceCtrl">
    <div class="d-md-flex">
        <div class="fs-4 me-3">My Request</div>
        <div class="overflow-auto flex-fill">
            <div class="flex-fill d-flex flex-nowrap align-items-center">
                <div class="btn btn-link text-nowrap {{ iStatus == '' ? 'active' : '' }}" ng-click="SelectStatus('')">
                    All <span class="badge ms-1" ng-show="sum_all > 0">{{ sum_all | number }}</span>
                </div> |
                <div class="btn btn-link border-0 text-nowrap {{ iStatus == 'Approve' ? 'active' : '' }}" ng-click="SelectStatus('Approve')">
                    Await Approval <span class="badge ms-1" ng-show="sum_approve > 0">{{ sum_approve | number }}</span>
                </div>
                <div class="btn btn-link border-0 text-nowrap {{ iStatus == 'Reject' ? 'active' : '' }}" ng-click="SelectStatus('Reject')">
                    <span ng-show="alert_reject > 0" class="ms-1 badge rounded-circle bg-danger p-1">
                        <span class="visually-hidden">unread messages</span>
                    </span>
                    Reject <span class="badge ms-1" ng-show="sum_reject > 0">{{ sum_reject | number }}</span>
                </div>
                <div class="btn btn-link border-0 text-nowrap {{ iStatus == 'Work' ? 'active' : '' }}" ng-click="SelectStatus('Work')">
                    <span ng-show="alert_work > 0" class="ms-1 badge rounded-circle bg-danger p-1">
                        <span class="visually-hidden">unread messages</span>
                    </span>
                    Pending <span class="badge ms-1" ng-show="sum_work > 0">{{ sum_work | number }}</span>
                </div>
                <div class="btn btn-link border-0 text-nowrap {{ iStatus == 'Complete' ? 'active' : '' }}" ng-click="SelectStatus('Complete')">
                    <span ng-show="alert_complete > 0" class="ms-1 badge rounded-circle bg-danger p-1">
                        <span class="visually-hidden">unread messages</span>
                    </span>
                    Complete <span class="badge ms-1" ng-show="sum_complete > 0">{{ sum_complete | number }}</span>
                </div>
            </div>
        </div>
        <div class="d-none d-sm-block">
            <a class="btn btn-sm btn-primary" href="@Url.Page("New")">
                <i class="fas fa-plus me-2"></i> New Request
            </a>
        </div>
    </div>
    <div class="rounded-4 p-3 bg-white shadow-sm border">
        <partial name="Service/_PartialNavBar" />
        <div class="bg-white rounded p-1">
            <partial name="_PartialRequestDataList"></partial>
        </div>
    </div>
</div>
<script>
    app.controller('ServiceCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.is_not_read = 99;
        $scope.createBy = '';
        $scope.iStatus = '';

        $scope.row = 10;
        $scope.lData = [];
        
        $scope.lRead = [
            { key: 'ทั้งหมด', value: 99 }
            , { key: 'ยังไม่ได้อ่าน', value: 1 }
            , { key: 'อ่านแล้ว', value: 0 }
        ];

        $scope.LoadData = function(page = 1){
            $scope.page = page;
            var createDate = '';

            if($scope.createDate != null){
                createDate = $scope.createDate.format("DD/MM/YYYY");
            }

            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Service/RequestList',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    userBy: '@User.UserId()'
                    , page: $scope.page
                    , row: $scope.row
                    , sortBy: $scope.sortBy
                    , status: $scope.iStatus
                    , serviceNo: $scope.serviceNo
                    , categoryDesc: $scope.categoryDesc
                    , createName: $scope.createName
                    , createDate: createDate
                }),
                success: function (result) {
                    $timeout(function () {
                        $scope.lData = result.data;
                        $scope.total = result.total;
                    }, 0);
                },
                error: AjaxError
            });
            
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Service/RequestSummary', 
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    userBy: '@User.UserId()'
                    , serviceNo: $scope.serviceNo
                    , categoryDesc: $scope.categoryDesc
                    , createName: $scope.createName
                    , createDate: createDate
                }),
                success: function (result) {
                    $timeout(function () {
                        $scope.sum_approve = 0;
                        $scope.sum_reject = 0;
                        $scope.sum_work = 0;
                        $scope.sum_complete = 0;
                        
                        $scope.alert_approve = 0;
                        $scope.alert_reject = 0;
                        $scope.alert_work = 0;
                        $scope.alert_complete = 0;

                        var find = result.find(x => x.status == 'Approve');
                        if (find) { 
                            $scope.sum_approve = find.total; 
                            $scope.alert_approve = find.alert_total; 
                        }
                        find = result.find(x => x.status == 'Reject');
                        if (find) { 
                            $scope.sum_reject = find.total; 
                            $scope.alert_reject = find.alert_total; 
                        }
                        find = result.find(x => x.status == 'Work');
                        if (find) { 
                            $scope.sum_work = find.total; 
                            $scope.alert_work = find.alert_total; 
                        }
                        find = result.find(x => x.status == 'Complete');
                        if (find) { 
                            $scope.sum_complete = find.total; 
                            $scope.alert_complete = find.alert_total; 
                        }

                        $scope.sum_all = $scope.sum_approve
                            + $scope.sum_reject
                            + $scope.sum_work
                            + $scope.sum_complete;
                    }, 0);
                },
                error: AjaxError
            });
        }
        $scope.LoadData();

        $scope.SelectStatus = function (status) {
            $scope.iStatus = status;
            $scope.LoadData();
        }

        $scope.SetPage = function (page) {
            $scope.LoadData(page);
        }
        
        $scope.SetSort = function(sortBy){
            if ($scope.sortBy != null && $scope.sortBy.indexOf(sortBy) > -1) {
                if ($scope.sortBy.indexOf("-") > -1) {
                    $scope.sortBy = sortBy;
                }else{
                    $scope.sortBy = '-' + sortBy;
                }
            }else{
                $scope.sortBy = sortBy;
            }
            $scope.LoadData();
        }

        $scope.ShowDetail = function(x){
            x.is_not_read = 0;
            window.open('@Url.Page("Detail")/' + x.id, '_blank');
        }
        
        window.parent.ReloadRequest = function () {
            $scope.LoadData();
        }
        
        $scope.Download = function(){
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Service/RequestList',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    createBy: $scope.createBy
                    , userBy: '@User.UserId()'
                    , page: 1
                    , row: $scope.total
                    , sortBy: $scope.sortBy
                    , status: $scope.iStatus
                }),
                success: function (result) {
                    $timeout(function () {
                        var lData = result.data;
                        
                        if (lData.length > 0) {
                            var JSData = [[
                                { 'text': 'Service No' }
                                , { 'text': 'Category' }
                                , { 'text': 'Status' }
                                , { 'text': 'Request By' }
                                , { 'text': 'Request Date' }
                                , { 'text': 'Action Date' }
                            ]];

                            for (var i = 0; i < lData.length; i++) {
                                var iData = lData[i];

                                JSData.splice(JSData.length, 0, [
                                    { 'text': iData.serviceNo }
                                    , { 'text': iData.categoryDesc }
                                    , { 'text': iData.statusDesc }
                                    , { 'text': iData.createName }
                                    , { 'text': iData.createDate }
                                    , { 'text': iData.actionDate }
                                ]);
                            }

                            var dt = new Date().toISOString().slice(0, 10).replace(/-/g, "");
                            ExportFile(JSData, 'รายการคำขอ_' + dt);
                        }
                    }, 0);
                },
                error: AjaxError
            });
        }
    })
</Script>