@page
@model EmpHub.Pages.Service.FormRequestTrainingModel
@{
    var token = User.AccessToken(HttpContext);
}
<style>
    .main-content {
        min-height: calc(100vh - 150px) !important;
    }

    .input-error {
        color: red;
        border-color: red;
    }
</style>
<div ng-controller="FormCtrl" id="tab_education">
    @* Header *@
    <partial name="_PartialFormHeader" />
    @* View *@
    <div class="d-flex justify-content-center">
        <div class="rounded-4 mb-3 bg-white shadow-sm p-4" style="width:600px;">
            <div class="text-center fs-4 fw-bolder mb-4 text-dark">
                ขออนุมัติเข้ารับการฝึกอบรม
            </div>
            <div class="fw-bolder text-dark mb-3 fs-5">
                1. รายละเอียดผู้เข้ารับการฝึกอบรม / สัมมนา
            </div>
            <div class="mb-3">
                <div class="text-dark fw-bolder">ชื่อ-สกุล</div>
                <input ng-model="iForm.fullname" class="form-control" readonly />
            </div>
            <div class="mb-3">
                <div class="text-dark fw-bolder">ตาแหน่ง</div>
                <input ng-model="iForm.position" class="form-control" readonly />
            </div>
            <div class="mb-3">
                <div class="text-dark fw-bolder">แผนก/ส่วน</div>
                <input ng-model="iForm.part" class="form-control" readonly />
            </div>
            <div class="mb-3">
                <div class="text-dark fw-bolder">ฝ่าย</div>
                <input ng-model="iForm.department" class="form-control" readonly />
            </div>
            <div class="mb-4">
                <div class="text-dark fw-bolder">สายงาน</div>
                <input ng-model="iForm.division" class="form-control" readonly />
            </div>
            <div class="fw-bolder text-dark mb-3 fs-5">
                2. รายละเอียดหลักสูตรการฝึกอบรม / สัมมนา (แนบเอกสาร Course Outline)
            </div>
            <div class="mb-3">
                <div class="text-dark fw-bolder">ชื่อหลักสูตร</div>
                <input ng-model="iForm.license" class="form-control license" maxlength="200" />
            </div>
            <div class="mb-3">
                <div class="text-dark fw-bolder">วัตถุประสงค์การเข้ารับการฝึกอบรม / สัมมนา</div>
                <textarea ng-model="iForm.objectives" class="form-control objectives" rows=5 maxlength="4000"></textarea>
            </div>
            <div class="mb-3">
                <div class="text-dark fw-bolder">จัดโดย</div>
                <input ng-model="iForm.organization" class="form-control organization" maxlength="200" />
            </div>
            <div class="mb-3">
                <div class="text-dark fw-bolder">วัน-เวลา</div>
                <input ng-model="iForm.dt" class="form-control dt" maxlength="200" />
            </div>
            <div class="mb-3">
                <div class="text-dark fw-bolder">สถานที่</div>
                <input ng-model="iForm.location" class="form-control location" maxlength="200" />
            </div>
            <div class="row">
                <div class="col-sm-6 mb-3">
                    <div class="text-dark fw-bolder">ค่าใช้จ่ายต่อคน</div>
                    <input ng-model="iForm.price" amount="iForm.price" class="form-control price" format-to-currency />
                </div>
                <div class="col-sm-6 mb-3">
                    <div class="text-dark fw-bolder">รวมทั้งสิ้น</div>
                    <input ng-model="iForm.net" amount="iForm.net" class="form-control net" format-to-currency />
                </div>
            </div>
            <div class="fw-bolder text-dark mb-3 pt-1 fs-5">
                3. การปฏิบัติภายหลังเสร็จสิ้นการฝึกอบรม / สัมมนา
            </div>
            <div class="d-flex align-items-center">
                <input type="checkbox" ng-model="iForm.option1" class="me-2" id="option1" ng-true-value="1" ng-false-value="0" /> <label for="option1">ทารายงานเสนอผู้บังคับบัญชา</label>
            </div>
            <div class="d-flex align-items-center">
                <input type="checkbox" ng-model="iForm.option2" class="me-2" id="option2" ng-true-value="1" ng-false-value="0" /> <label for="option2">บรรยายสรุปเสนอผู้บังคับบัญชาโดยตรงรับทราบ</label>
            </div>
            <div class="d-flex align-items-center">
                <input type="checkbox" ng-model="iForm.option3" class="me-2" id="option3" ng-true-value="1" ng-false-value="0" /> <label for="option3">บรรยายสรุปให้ผู้เกี่ยวข้องที่ควรทราบได้รับทราบ</label>
            </div>
            <div class="d-flex align-items-center">
                <input type="checkbox" ng-model="iForm.option4" class="me-2" id="option4" ng-true-value="1" ng-false-value="0" />
                <label for="option4">อื่น ๆ ( โปรดระบุ )</label>
            </div>
            <div ng-show="iForm.option4 == 1">
                <input ng-model="iForm.option4_desc" class="form-control option4_desc" />
            </div>
            <div class="d-flex justify-content-end pt-4">
                <div class="btn btn-primary" ng-click="Save()">
                    <i class="far fa-paper-plane me-2"></i> Send Request
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    app.controller('FormCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.mode = '@Model.mode';
        $scope.iData = {};
        $scope.iForm = {
            userId: ''
            , license: ''
            , objectives: ''
            , organization: ''
            , location: ''
            , dt: ''
            , price: 0
            , net: 0
            , option1: 0
            , option2: 0
            , option3: 0
            , option4: 0
            , option4_desc: ''
        };

        $scope.Validate = function () {
            var flag = true;
            JS_Reset($(".license"));
            JS_Reset($(".objectives"));
            JS_Reset($(".organization"));
            JS_Reset($(".location"));
            JS_Reset($(".dt"));
            JS_Reset($(".price"));
            JS_Reset($(".net"));
            JS_Reset($(".option4_desc"));

            console.log($scope.iForm);

            if ($scope.iForm.license == '') {
                flag = false;
                JS_Require($(".license"));
            }
            if ($scope.iForm.objectives == '') {
                flag = false;
                JS_Require($(".objectives"));
            }
            if ($scope.iForm.organization == '') {
                flag = false;
                JS_Require($(".organization"));
            }
            if ($scope.iForm.location == '') {
                flag = false;
                JS_Require($(".location"));
            }
            if ($scope.iForm.dt == '') {
                flag = false;
                JS_Require($(".dt"));
            }
            if ($scope.iForm.price == 0) {
                flag = false;
                JS_Require($(".price"));
            }
            if ($scope.iForm.net == 0) {
                flag = false;
                JS_Require($(".net"));
            }
            if ($scope.iForm.option4 == 1 && $scope.iForm.option4_desc == '') {
                flag = false;
                JS_Require($(".option4_desc"));
            }

            return flag;
        }

        $scope.Save = async function () {
            if ($scope.Validate()) {
                alertConfirm("ยืนยันการทำรายการ", "ท่านต้องการส่งใบคำขอ", async function () {
                    var id = await $scope.CreateService();

                    if (id) {
                        $scope.iData.id = id;
                        $scope.iForm.refId = id;

                        var flag = await $scope.CreateForm();

                        if (flag) {
                            var serviceNo = await $scope.ServiceRequest();

                            if (serviceNo) {
                                alertSuccess("ทำรายการสำเร็จ", "ระบบบันทึกใบคำขอของท่านเรียบร้อย", function () {
                                    location.href = '@Url.Page("/Service/Index")';
                                });
                            } else {
                                $scope.CancelService();
                            }
                        } else {
                            $scope.CancelService();
                        }
                    }
                });
            } else {
                alertWarning("แจ้งเตือน", "กรุณากรอกข้อมูลให้ครบ");
            }
        }

        $scope.CreateForm = function () {
            return new Promise((resolve) => {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/Form/FormRequestTrainingCreate',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    cache: false,
                    data: JSON.stringify($scope.iForm),
                    success: function () {
                        $timeout(async function () {
                            resolve(true);
                        }, 0);
                    }, error: function (jqXHR, error, errorThrown) {
                        resolve(null);
                        Swal.fire({
                            title: "ระบบเกิดข้อผิดพลาด",
                            text: jqXHR.responseText,
                            icon: "error",
                            confirmButtonColor: '#1e3b92',
                        });
                    }
                });
            });
        }
    });
</script>