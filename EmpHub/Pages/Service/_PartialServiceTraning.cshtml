@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
<div ng-controller="ServiceTraningCtrl" class="mb-4">
    @* View *@
    <div class="row">
        <div class="col-sm-6">
            <div class="fw-bolder text-orange">ข้อมูลที่ต้องการปรับปรุง</div>
            <div class="p-3 bg-gray rounded-4 h-100">
                <div class="list-group list-group-flush">
                    <div class="list-group-item bg-gray px-0" ng-repeat="x in lData">
                        <div class="row ">
                            <div class="col-sm-6 mb-3">
                                <div class="text-gray">
                                    ชื่อใบอนุญาติ
                                </div>
                                <div class="fw-bolder">{{ x.license }}</div>
                            </div>
                            <div class="col-sm-3 mb-3">
                                <div class="text-gray">
                                    วันที่ออกเอกสาร
                                </div>
                                <div class="fw-bolder">{{ x.issueDate }}</div>
                            </div>
                            <div class="col-sm-3 mb-3">
                                <div class="text-gray">
                                    วันหมดอายุ
                                </div>
                                <div class="fw-bolder">{{ x.expireDate }}</div>
                            </div>
                            <div class="col-sm-12 mb-3">
                                <div class="text-gray">
                                    องค์กรที่ออกเอกสาร
                                </div>
                                <div class="fw-bolder">{{ x.organization }}</div>
                            </div>
                            <div class="col-sm-12 mb-3">
                                <div class="text-gray">
                                    รายละเอียด
                                </div>
                                <div class="fw-bolder">{{ x.description }}</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6" ng-show="status == 'Pending'">
            <div class="fw-bolder text-orange">ข้อมูลในระบบ</div>
            <div class="p-3 bg-gray rounded-4 h-100">
                <div class="list-group list-group-flush">
                    <div class="list-group-item bg-gray px-0" ng-repeat="x in lUser">
                        <div class="row ">
                            <div class="col-sm-6 mb-3">
                                <div class="text-gray">
                                    ชื่อใบอนุญาติ
                                </div>
                                <div class="fw-bolder text-decoration-line-through">{{ x.license }}</div>
                            </div>
                            <div class="col-sm-3 mb-3">
                                <div class="text-gray">
                                    วันที่ออกเอกสาร
                                </div>
                                <div class="fw-bolder text-decoration-line-through">{{ x.issueDate }}</div>
                            </div>
                            <div class="col-sm-3 mb-3">
                                <div class="text-gray">
                                    วันหมดอายุ
                                </div>
                                <div class="fw-bolder text-decoration-line-through">{{ x.expireDate }}</div>
                            </div>
                            <div class="col-sm-12 mb-3">
                                <div class="text-gray">
                                    องค์กรที่ออกเอกสาร
                                </div>
                                <div class="fw-bolder text-decoration-line-through">{{ x.organization }}</div>
                            </div>
                            <div class="col-sm-12 mb-3">
                                <div class="text-gray">
                                    รายละเอียด
                                </div>
                                <div class="fw-bolder text-decoration-line-through">{{ x.description }}</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    app.controller('ServiceTraningCtrl', function ($scope, $http, $timeout, $filter) {

        $scope.LoadData = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/ServiceTraning/DetailByRef',
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    refId: $scope.refId
                }),
                success: function (result) {
                    $timeout(async function () {
                        $scope.lData = result;
                    }, 0);
                }, error: AjaxError
            });
        }

        $scope.LoadUser = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/UserTraning',
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    userId: $scope.userId
                    , create_by: '@User.UserId()'
                }),
                success: function (result) {
                    $timeout(async function () {
                        $scope.lUser = result;
                    }, 0);
                }, error: AjaxError
            });
        }

        $scope.$parent.LoadTraning = function (x) {
            $scope.refId = x.id;
            $scope.userId = x.userId;
            $scope.status = x.status;
            $scope.LoadData();
            $scope.LoadUser();
        }
        });
</script>