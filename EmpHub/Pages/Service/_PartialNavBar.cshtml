@{
    var token = User.AccessToken(Context);
}
<div class="d-flex mb-1">
    <div class="flex-fill">
        <div class="d-flex align-items-end">
            <div class="me-2">
                <small>Service No</small>
                <div class="d-flex">
                    <input class="form-control form-control-sm" ng-model="serviceNo" my-enter="LoadData()" />
                </div>
            </div>
            <div class="me-2">
                <small>Category</small>
                <div class="d-flex">
                    <input class="form-control form-control-sm" ng-model="categoryDesc" my-enter="LoadData()" />
                </div>
            </div>
            <div class="me-2">
                <small>Request By</small>
                <div class="d-flex">
                    <input class="form-control form-control-sm" ng-model="createName" my-enter="LoadData()" />
                </div>
            </div>
            <div class="me-2">
                <small>Request Date</small>
                <div class="d-flex">
                    <input class="form-control form-control-sm icon-calendar date"
                           ng-model="createDate"
                           ng-model-options="{ updateon: 'blur' }"
                           moment-picker="createDate"
                           locale="th"
                           format="DD/MM/YYYY"
                           min-view="month"
                           max-view="month"
                           start-view="month"
                           my-enter="LoadData()" />
                </div>
            </div>
            <div class="me-2">
                <button ng-click="LoadData()" class="btn btn-circle" title="Search">
                    <i class="fas fa-search"></i>
                </button>
            </div>
            <div class="me-2">
                <button ng-click="Download()" class="btn btn-circle" title="Download" ng-disabled="total == 0">
                    <i class="fas fa-arrow-down"></i>
                </button>
            </div>
            <div class="flex-fill">

            </div>
        </div>
    </div>
</div>