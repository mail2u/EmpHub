@{
    var token = User.AccessToken(Context);
}
<div class="d-flex mb-1">
    <div class="flex-fill">
        <div class="d-flex align-items-end">
            <div class="me-2">
                <small>เลขบริการ</small>
                <div class="d-flex">
                    <input class="form-control" ng-model="serviceNo" my-enter="LoadData()" />
                </div>
            </div>
            <div class="me-2">
                <small>ความประสงค์</small>
                <div class="d-flex">
                    <input class="form-control" ng-model="categoryDesc" my-enter="LoadData()" />
                </div>
            </div>
            <div class="me-2">
                <small>คำขอโดย</small>
                <div class="d-flex">
                    <input class="form-control" ng-model="createName" my-enter="LoadData()" />
                </div>
            </div>
            <div class="me-2">
                <small>วันที่ขอรับบริการ</small>
                <div class="d-flex">
                    <input class="form-control icon-calendar date"
                           ng-model="createDate"
                           ng-model-options="{ updateon: 'blur' }"
                           moment-picker="createDate"
                           locale="th"
                           format="DD/MM/YYYY"
                           min-view="month"
                           max-view="month"
                           start-view="month"
                           my-enter="LoadData()" />
                </div>
            </div>
            <div>
                <button ng-click="LoadData()" class="btn btn-light me-4">
                    <i class="fas fa-search"></i>
                </button>
            </div>
            <div class="flex-fill">

            </div>
        </div>
    </div>
    <div class="text-end d-flex flex-nowrap align-items-center">
        <span class="d-none d-md-block">
            {{ (total > 0 ? ((page - 1) * row) + 1 : 0) | number }} - {{ (page * row < total ? page * row : total) | number }} of {{ total | number }}
        </span>
        <button class="btn btn-circle" ng-click="SetPage(page - 1)" ng-disabled="page <= 1">
            <i class="fas fa-chevron-left"></i>
        </button>
        <button class="btn btn-circle" ng-click="SetPage(page + 1)" ng-disabled="page * row >= total">
            <i class="fas fa-chevron-right"></i>
        </button>
    </div>
</div>