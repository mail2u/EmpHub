@{
    var token = User.AccessToken(Context);
}
<div class="d-flex mb-1">
    <div class="flex-fill">
        <div class="d-flex align-items-end">
            <div class="me-2">
                <small>เลขบริการ</small>
                <div class="d-flex">
                    <input class="form-control form-control-sm" ng-model="serviceNo" my-enter="LoadData()" />
                </div>
            </div>
            <div class="me-2">
                <small>ประเภทใบงาน</small>
                <div class="d-flex">
                    <input class="form-control form-control-sm" ng-model="categoryDesc" my-enter="LoadData()" />
                </div>
            </div>
            <div class="me-2">
                <small>คำขอโดย</small>
                <div class="d-flex">
                    <input class="form-control form-control-sm" ng-model="createName" my-enter="LoadData()" />
                </div>
            </div>
            <div class="me-2">
                <small>วันที่เขียน</small>
                <div class="d-flex">
                    <input class="form-control form-control-sm icon-calendar date"
                           ng-model="createDate"
                           ng-model-options="{ updateOn: 'blur' }"
                           moment-picker="createDate"
                           locale="th"
                           format="DD/MM/YYYY"
                           min-view="month"
                           max-view="month"
                           max-date="now"
                           my-enter="LoadData()" />
                </div>
            </div>
            <div class="me-2">
                <button ng-click="LoadData()" class="btn btn-light shadow-sm" title="Search">
                    <i class="fas fa-search"></i>
                </button>
            </div>
            <div class="me-2">
                <button ng-click="Download()" class="btn btn-light shadow-sm" title="Download" ng-disabled="total == 0">
                    <i class="fas fa-arrow-down"></i>
                </button>
            </div>
            <div class="flex-fill">

            </div>
        </div>
    </div>
</div>
<script>
    $(".date").mask("00/00/0000");
</script>