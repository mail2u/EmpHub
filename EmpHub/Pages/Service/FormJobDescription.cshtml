@page
@model EmpHub.Pages.Service.FormJobDescriptionModel
@{
    var token = User.AccessToken(HttpContext);
}
<style>
    .main-content{
        min-height:calc(100vh - 150px) !important;
    }

</style>
<div ng-controller="ServiceEducationCtrl" id="tab_education">
    @* View *@
    <div class="rounded-4 mb-3 bg-white shadow-sm p-4">
        <div class="text-center fs-4 fw-bolder mb-4 text-dark">
            คำบรรยายลักษณะงาน (JOB DESCRIPTION)
        </div>
        <div class="fs-5 text-warning mb-2">1. ข้อมูลตำแหน่งงาน (Position Identification)</div>
        <div class="d-flex mb-2">
            <div class="me-3">
                <div class="text-dark text-nowrap fw-bolder">ชื่อตำแหน่งงาน</div>
                <div class="text-dark text-nowrap">Position Name</div>
            </div>
            <input ng-model="iData.positionName" class="form-control form-control-input" maxlength="100" ng-readonly="can_edit != 1" />
        </div>
        <div class="d-flex mb-2">
            <div class="me-3">
                <div class="text-dark text-nowrap fw-bolder">สายงาน</div>
                <div class="text-dark text-nowrap">Job Function</div>
            </div>
            <input ng-model="iData.jobFunction" class="form-control form-control-input" maxlength="100" ng-readonly="can_edit != 1" />
        </div>
        <div class="d-flex mb-2">
            <div class="me-3">
                <div class="text-dark text-nowrap fw-bolder">ฝ่ายงาน</div>
                <div class="text-dark text-nowrap">Department Name</div>
            </div>
            <input ng-model="iData.departmentName" class="form-control form-control-input" maxlength="100" ng-readonly="can_edit != 1" />
        </div>
        <div class="d-flex mb-2">
            <div class="me-3">
                <div class="text-dark text-nowrap fw-bolder">ส่วนงาน</div>
                <div class="text-dark text-nowrap">Section Name</div>
            </div>
            <input ng-model="iData.sectionName" class="form-control form-control-input" maxlength="100" ng-readonly="can_edit != 1" />
        </div>
        <div class="mb-3">
            <div class="text-dark text-nowrap fw-bolder">ความรับผิดชอบโดยสังเขป (Position Summary)</div>
            <textarea ng-model="iData.position_description" class="form-control form-control-input" maxlength="2000" rows="5" ng-readonly="can_edit != 1"></textarea>
        </div>
        @* part 2 *@
        <div class="fs-5 text-warning mb-2">2. บทบาทหน้าที่ความรับผิดชอบหลัก (Major Role Responsibilities)</div>
        <div class="mb-3">
            <div class="text-dark text-nowrap fw-bolder">บทบาทหน้าที่ความรับผิดชอบ</div>
            <textarea ng-model="iData.major_description" class="form-control form-control-input" maxlength="2000" rows="5" ng-readonly="can_edit != 1"></textarea>
        </div>
        @* part 3 *@
        <div class="fs-5 text-warning">3. ทักษะและประสบการณ์ (Experience and Skills)</div>
        <div class="mb-2">ระบุประสบการณ์และทักษะในระดับขั้นต่ำที่ผู้ดำรงตำแหน่งต้องมีเพื่อให้ปฏิบัติงานได้สำเร็จ</div>
        <div class="mb-3">
            <div class="text-dark text-nowrap fw-bolder">การศึกษา (Education)</div>
            <textarea ng-model="iData.education" class="form-control form-control-input" maxlength="2000" rows="5" ng-readonly="can_edit != 1"></textarea>
        </div>
        <div class="mb-3">
            <div class="text-dark text-nowrap fw-bolder">ประสบการณ์ (Experience)</div>
            <textarea ng-model="iData.experience" class="form-control form-control-input" maxlength="2000" rows="5" ng-readonly="can_edit != 1"></textarea>
        </div>
        <div class="mb-3">
            <div class="text-dark text-nowrap fw-bolder">สมรรถนะเชิงสายงาน (Functional Competencies)</div>
            <textarea ng-model="iData.functional_competencies" class="form-control form-control-input" maxlength="2000" rows="5" ng-readonly="can_edit != 1"></textarea>
        </div>
        <div class="mb-3">
            <div class="text-dark text-nowrap fw-bolder">สมรรถนะผู้นำ (Leadership Competencies)</div>
            <textarea ng-model="iData.leadership_competencies" class="form-control form-control-input" maxlength="2000" rows="5" ng-readonly="can_edit != 1"></textarea>
        </div>
        @* part 4 *@
        <div class="fs-5 text-warning mb-2">4. ผลงานที่คาดหวัง (Key Result Areas)</div>

        <div class="mb-3">
            <div class="text-dark text-nowrap fw-bolder">ด้านการเงิน (Financial)</div>
            <textarea ng-model="iData.financial" class="form-control form-control-input" maxlength="2000" rows="5" ng-readonly="can_edit != 1"></textarea>
        </div>
        <div class="mb-3">
            <div class="text-dark text-nowrap fw-bolder">ด้านลูกค้าและตลาด (Customer and Market)</div>
            <textarea ng-model="iData.customer_and_market" class="form-control form-control-input" maxlength="2000" rows="5" ng-readonly="can_edit != 1"></textarea>
        </div>
        <div class="mb-3">
            <div class="text-dark text-nowrap fw-bolder">ด้านกระบวนการ (Process)</div>
            <textarea ng-model="iData.process" class="form-control form-control-input" maxlength="2000" rows="5" ng-readonly="can_edit != 1"></textarea>
        </div>
        <div class="mb-3">
            <div class="text-dark text-nowrap fw-bolder">ด้านการพัฒนาศักยภาพบุคลากร (People Development)</div>
            <textarea ng-model="iData.people_development" class="form-control form-control-input" maxlength="2000" rows="5" ng-readonly="can_edit != 1"></textarea>
        </div>
        @* part 5 *@
        <div class="fs-5 text-warning mb-2">5. การติดต่อสื่อสาร (Contacts and Purpose of Contact)</div>
        <div class="row">
            <div class="col-sm-6 mb-3">
                <div class="text-dark text-nowrap fw-bolder">หน่วยงานภายใน</div>
                <textarea ng-model="iData.internal_description" class="form-control form-control-input" maxlength="2000" rows="5" ng-readonly="can_edit != 1"></textarea>
            </div>
            <div class="col-sm-6 mb-3">
                <div class="text-dark text-nowrap fw-bolder">วัตถุประสงค์ในการติดต่อสื่อสาร</div>
                <textarea ng-model="iData.internal_contact_description" class="form-control form-control-input" maxlength="2000" rows="5" ng-readonly="can_edit != 1"></textarea>
            </div>
            <div class="col-sm-6 mb-3">
                <div class="text-dark text-nowrap fw-bolder">หน่วยงานภายนอก</div>
                <textarea ng-model="iData.external_description" class="form-control form-control-input" maxlength="2000" rows="5" ng-readonly="can_edit != 1"></textarea>
            </div>
            <div class="col-sm-6 mb-3">
                <div class="text-dark text-nowrap fw-bolder">วัตถุประสงค์ในกรต่ิดต่อสื่อสาร</div>
                <textarea ng-model="iData.external_contact_description" class="form-control form-control-input" maxlength="2000" rows="5" ng-readonly="can_edit != 1"></textarea>
            </div>
        </div>
    </div>
    <div class="d-flex justify-content-end" ng-show="can_edit == 1">
        <div class="btn btn-primary" ng-click="Save()">
            <i class="far fa-save me-2"></i> Save
        </div>
    </div>
</div>
<script>
    app.controller('ServiceEducationCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.refId = '@Model.id';

        $scope.Init = function(){
            if($scope.refId == ''){
                alertWarning("แจ้งเตือน","ไม่พบเลขอ้างอิง", function(){
                    location.href = '@Url.Page("/Service/Index")';
                });
            }

            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/ServiceJobDescription/Detail',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    refId: $scope.refId
                    , userId: '@User.UserId()'
                }),
                success: function (result) {
                    $timeout(async function () {
                        $scope.iData = result.data;
                        $scope.can_edit = result.can_edit;
                    }, 0);
                }, error: AjaxError
            });
        }
        $scope.Init();

        $scope.Validate = function(){
            var flag = true;
            // JS_Reset($(".firstname_th"));
            // JS_Reset($(".lastname_th"));

            // if($scope.iData.firstname_th == ''){
            //     flag = false;
            //     JS_Require($(".firstname_th"));
            // }
            // if($scope.iData.lastname_th == ''){
            //     flag = false;
            //     JS_Require($(".lastname_th"));
            // }

            return flag;
        }

        $scope.Save = async function () {
            if($scope.Validate()){
                $scope.iData.refId = $scope.refId;
                var flag = await $scope.CreateJobDescription();

                if(flag){
                    alertSuccess("บันทึกรายการ","ระบบบันทึกข้อมูลเรียบร้อย");
                }else{
                    alertWarning("บันทึกรายการ","ทำรายการไม่สำเร็จ");
                }
            }else{
                alertWarning("แจ้งเตือน","กรุณากรอกข้อมูลให้ครบ");
            }
        }

        $scope.CreateJobDescription = function () {
            return new Promise((resolve)=>{
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/ServiceJobDescription/Save',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    cache: false,
                    data: JSON.stringify($scope.iData),
                    success: function () {
                        $timeout(async function () {
                           resolve(true);
                        }, 0);
                    }, error: function(jqXHR, error, errorThrown) {
                        resolve(null);
                        Swal.fire({
                            title: "ระบบเกิดข้อผิดพลาด",
                            text: jqXHR.responseText,
                            icon: "error",
                            confirmButtonColor: '#1e3b92',
                        });
                    }
                });
            });
        }
    });
</script>