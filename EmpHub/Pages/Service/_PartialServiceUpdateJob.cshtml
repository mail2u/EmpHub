@{
    var token = User.AccessToken(Context);
}
<style>
    input[type="radio"]:disabled {
        background-color: #0d6efd !important;
        border-color: #0d6efd !important;
        background-image: none !important;
        opacity: 1 !important;
    }
</style>
<div ng-controller="ServiceUpdateJobCtrl">
    <div class="bg-white rounded-4 border mb-4 overflow-hidden p-4">
        <div class="px-4 py-3 border-bottom d-flex align-items-center">
            <div class="fs-5 fw-bolder text-dark flex-fill">
                ปรับปรุงข้อมูลประวัติการทำงาน
            </div>
        </div>
        <div class="p-4 fs-6 text-dark">
            <div class="list-group list-group-flush">
                <div class="list-group-item px-0" ng-repeat="x in lJobExperience">
                    <div class="d-flex mb-3">
                        <div class="flex-fill me-3">
                            <div class="text-dark fw-bolder">
                                บริษัท
                            </div>
                            <div class="text-gray">{{ x.company != '' ? x.company : '-' }}</div>
                        </div>
                        <div class="flex-fill me-3">
                            <div class="text-dark fw-bolder">
                                ตำแหน่ง
                            </div>
                            <div class="text-gray">{{ x.position != '' ? x.position : '-' }}</div>
                        </div>
                        <div class="me-3">
                            <div class="text-dark fw-bolder">
                                วันที่เริ่ม
                            </div>
                            <div class="text-gray">{{ x.fromDate | date:'MMM yyyy' }}</div>
                        </div>
                        <div class="">
                            <div class="text-dark fw-bolder">
                                วันที่สิ้นสุด
                            </div>
                            <div class="text-gray">{{ x.endDate | date:'MMM yyyy' }}</div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="text-dark fw-bolder">
                            รายละเอียดการทำงาน
                        </div>
                        <div class="text-gray">{{ x.description != '' ? x.description : '-' }}</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    app.controller('ServiceUpdateJobCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.LoadDetail = function () {
            return new Promise((resolve) => {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/ServiceJobExperience/Detail',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    dataType: 'json',
                    cache: false,
                    data: JSON.stringify({
                        refId: $scope.refId
                    }),
                    success: function (result) {
                        $timeout(async function () {
                            $scope.lJobExperience = result;
                            resolve(true);
                        }, 0);
                    }, error: function () {
                        resolve(false);
                    }
                });
            });
        }

        $scope.$parent.LoadFormUpdateJob = async function (x) {
            $scope.refId = x.id;
            $scope.userId = x.userId;
            $scope.status = x.status;

            await $scope.LoadDetail();
        }
    });
</script>