                        </td>
                        <td class="align-middle">
                            ปี
                        </td>
                        <td class="align-middle">
                            เกี่ยวข้องเป็น
                        </td>
                        <td class="text-blue" width="150">
                            {{ iForm.benefitrelation2 }}
                        </td>
                        <td class="align-middle">
                            จำนวน
                        </td>
                        <td class="text-blue" width="100">
                            {{ iForm.benefitpercent2 }}
                        </td>
                        <td class="align-middle">
                            %
                        </td>
                    </tr>
                    @* Benefit 3 *@
                    <tr ng-show="iForm.benefitname3 != ''">
                        <td class="align-middle">
                            3
                        </td>
                        <td class="text-blue">
                            {{ iForm.benefitname3 }}
                        </td>
                        <td class="align-middle">
                            อายุ
                        </td>
                        <td class="text-blue" width="100">
                            {{ iForm.benefitage3 }}
                        </td>
                        <td class="align-middle">
                            ปี
                        </td>
                        <td class="align-middle">
                            เกี่ยวข้องเป็น
                        </td>
                        <td class="text-blue" width="150">
                            {{ iForm.benefitrelation3 }}
                        </td>
                        <td class="align-middle">
                            จำนวน
                        </td>
                        <td class="text-blue" width="100">
                            {{ iForm.benefitpercent3 }}
                        </td>
                        <td class="align-middle">
                            %
                        </td>
                    </tr>
                    @* Benefit 4 *@
                    <tr ng-show="iForm.benefitname4 != ''">
                        <td class="align-middle">
                            4
                        </td>
                        <td class="text-blue">
                            {{ iForm.benefitname4 }}
                        </td>
                        <td class="align-middle">
                            อายุ
                        </td>
                        <td class="text-blue" width="100">
                            {{ iForm.benefitage4 }}
                        </td>
                        <td class="align-middle">
