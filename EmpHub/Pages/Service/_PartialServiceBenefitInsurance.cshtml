                    </div>
                    <div class="text-blue">{{ iForm.policyNo }}</div>
                </div>
                <div class="col-sm-4 mb-3 d-flex align-items-center">
                    <div class="me-3">
                        <div class="text-dark text-nowrap fw-bolder">รหัสพนักงาน</div>
                        <div class="text-dark text-nowrap">(Employee no.)</div>
                    </div>
                    <div class="text-blue">{{ iForm.employeeCode }}</div>
                </div>
                <div class="col-sm-8 mb-3 d-flex align-items-center">
                    <div class="me-3">
                        <div class="text-dark text-nowrap fw-bolder">ชื่อ – นามสกุล ผู้สมัครเอาประกัน (นาย / นาง / นางสาว )</div>
                        <div class="text-dark text-nowrap">(Name of Employee Mr. , Mrs, , Ms.)</div>
                    </div>
                    <div class="text-blue">{{ iForm.fullname }}</div>
                </div>
                <div class="col-sm-4 mb-3 d-flex align-items-center">
