@{
    var token = User.AccessToken(Context);
}
<div ng-controller="ServiceRequestTrainingCtrl">
    <div class="bg-white rounded-4 border mb-4 overflow-hidden">
        <div class="px-4 py-3 border-bottom d-flex align-items-center">
            <div class="fs-5 fw-bolder text-dark flex-fill">Request Training</div>
        </div>
        <div class="p-4">
            <div class="fw-bolder text-dark fs-5 mb-2">
                1. รายละเอียดผู้เข้ารับการฝึกอบรม / สัมมนา
            </div>
            <div class="row">
                <div class="col-sm-8 mb-3">
                    <div class="text-dark fw-bolder">ชื่อ-สกุล</div>
                    {{ iForm.fullname }}
                </div>
                <div class="col-sm-4 mb-3">
                    <div class="text-dark fw-bolder">ตาแหน่ง</div>
                    {{ iForm.position }}
                </div>
                <div class="col-sm-4 mb-3">
                    <div class="text-dark fw-bolder">แผนก/ส่วน</div>
                    {{ iForm.part }}
                </div>
                <div class="col-sm-4 mb-3">
                    <div class="text-dark fw-bolder">ฝ่าย</div>
                    {{ iForm.department }}
                </div>
                <div class="col-sm-4 mb-3">
                    <div class="text-dark fw-bolder">สายงาน</div>
                    {{ iForm.division }}
                </div>
                <div class="col-sm-4 mb-3">
                </div>
            </div>
            <div class="fw-bolder text-dark fs-5 mb-2">
                2. รายละเอียดหลักสูตรการฝึกอบรม / สัมมนา (แนบเอกสาร Course Outline)
            </div>
            <div class="row">
                <div class="col-sm-8 mb-3">
                    <div class="text-dark fw-bolder">ชื่อหลักสูตร</div>
                    {{ iForm.license }}
                </div>
                <div class="col-sm-4 mb-3">
                    <div class="text-dark fw-bolder">จัดโดย</div>
                    {{ iForm.organization }}
                </div>
                <div class="col-sm-12 mb-3">
                    <div class="text-dark fw-bolder">วัตถุประสงค์การเข้ารับการฝึกอบรม / สัมมนา</div>
                    {{ iForm.objectives }}
                </div>
                <div class="col-sm-4 mb-3">
                    <div class="text-dark fw-bolder">วัน-เวลา</div>
                    {{ iForm.dt }}
                </div>
                <div class="col-sm-8 mb-3">
                    <div class="text-dark fw-bolder">สถานที่</div>
                    {{ iForm.location }}
                </div>
                <div class="col-sm-4 mb-3">
                    <div class="text-dark fw-bolder">ค่าใช้จ่ายต่อคน</div>
                    {{ iForm.price | currency : '' }}
                </div>
                <div class="col-sm-4 mb-3">
                    <div class="text-dark fw-bolder">รวมทั้งสิ้น</div>
                    {{ iForm.net | currency : '' }}
                </div>
            </div>
            <div class="fw-bolder text-dark pt-1 fs-5 mb-2">
                3. การปฏิบัติภายหลังเสร็จสิ้นการฝึกอบรม / สัมมนา
            </div>
            <ul>
                <li ng-show="iForm.option1 == 1">
                    ทารายงานเสนอผู้บังคับบัญชา
                </li>
                <li ng-show="iForm.option2 == 1">
                    บรรยายสรุปเสนอผู้บังคับบัญชาโดยตรงรับทราบ
                </li>
                <li ng-show="iForm.option3 == 1">
                    บรรยายสรุปให้ผู้เกี่ยวข้องที่ควรทราบได้รับทราบ
                </li>
                <li ng-show="iForm.option4 == 1">
                    {{ iForm.option4_desc }}
                </li>
            </ul>
        </div>
    </div>
</div>
<script>
    app.controller('ServiceRequestTrainingCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.LoadDetail = function () {
            return new Promise((resolve) => {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/Form/FormRequestTrainingDetail',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    dataType: 'json',
                    cache: false,
                    data: JSON.stringify({
                        refId: $scope.refId
                    }),
                    success: function (result) {
                        $timeout(async function () {
                            $scope.iForm = result;
                            resolve(true);
                        }, 0);
                    }, error: function () {
                        resolve(false);
                    }
                });
            });
        }

        $scope.$parent.LoadFormRequestTraining = async function (x) {
            $scope.refId = x.id;
            $scope.userId = x.userId;
            $scope.status = x.status;

            await $scope.LoadDetail();
        }
    });
</script>