    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    var token = User.AccessToken(Context);
}
<div ng-controller="ServicePersonalCtrl">
    <div class="bg-white rounded-4 border mb-4 overflow-hidden" ng-show="iPersonal.refId">
        <div class="px-4 py-3 border-bottom d-flex align-items-center">
            <div class="fs-5 fw-bolder text-dark flex-fill">Personal Infomation</div>
            <div>
                <div class="badge bg-light-blue px-2">
                    {{ total_modify }} Modification
                </div>
            </div>
        </div>
        <div class="">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th class="bg-light ps-4">FIELD</th>
                        <th class="bg-light">CURRENT VALUE</th>
                        <th class="bg-light">PROPOSED VALUE / ACTION</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="ps-4">FULLNAME (TH)</td>
                        <td>{{ iUserPersonal.firstname_th }} {{ iUserPersonal.lastname_th }}</td>
                        <td class="{{ iUserPersonal.firstname_th != iPersonal.firstname_th
                            || iUserPersonal.lastname_th != iPersonal.lastname_th ? 'text-blue fw-bolder' : '' }}">
                            {{ iPersonal.firstname_th }} {{ iPersonal.lastname_th }}
                        </td>
                    </tr>
                    <tr>
                        <td class="ps-4">FULLNAME (EN)</td>
                        <td>{{ iUserPersonal.firstname_en }} {{ iUserPersonal.lastname_en }}</td>
                        <td class="{{ iUserPersonal.firstname_en != iPersonal.firstname_en
                            || iUserPersonal.lastname_en != iPersonal.lastname_en ? 'text-blue fw-bolder' : '' }}">
                            {{ iPersonal.firstname_en }} {{ iPersonal.lastname_en }}
                        </td>
                    </tr>
                    <tr>
                        <td class="ps-4">NICKNAME</td>
                        <td>{{ iUserPersonal.nickname }}</td>
                        <td class="{{ iUserPersonal.nickname != iPersonal.nickname ? 'text-blue fw-bolder' : '' }}">
                            {{ iPersonal.nickname }}
                        </td>
                    </tr>
                    <tr>
                        <td class="ps-4">BIRTH DATE</td>
                        <td>{{ iUserPersonal.birth_date }}</td>
                        <td class="{{ iUserPersonal.birth_date != iPersonal.birth_date ? 'text-blue fw-bolder' : '' }}">
                            {{ iPersonal.birth_date }}
                        </td>
                    </tr>
                    <tr>
                        <td class="ps-4">SEX</td>
                        <td>{{ iUserPersonal.sex }}</td>
                        <td class="{{ iUserPersonal.sex != iPersonal.sex ? 'text-blue fw-bolder' : '' }}">
                            {{ iPersonal.sex }}
                        </td>
                    </tr>
                    <tr>
                        <td class="ps-4">PHONE NO</td>
                        <td>{{ iUserPersonal.phoneNo }}</td>
                        <td class="{{ iUserPersonal.phoneNo != iPersonal.phoneNo ? 'text-blue fw-bolder' : '' }}">
                            {{ iPersonal.phoneNo }}
                        </td>
                    </tr>
                    <tr>
                        <td class="ps-4">EMAIL</td>
                        <td>{{ iUserPersonal.email }}</td>
                        <td class="{{ iUserPersonal.email != iPersonal.email ? 'text-blue fw-bolder' : '' }}">
                            {{ iPersonal.email }}
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
<script>
    app.controller('ServicePersonalCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.LoadModify = function () {
            return new Promise((resolve) => {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/ServicePersonal/Detail',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    dataType: 'json',
                    cache: false,
                    data: JSON.stringify({
                        refId: $scope.refId
                    }),
                    success: function (result) {
                        $timeout(async function () {
                            $scope.iPersonal = result;
                            resolve(true);
                        }, 0);
                    }, error: function () {
                        resolve(false);
                    }
                });
            });
        }

        $scope.LoadCurrent = function () {
            return new Promise((resolve) => {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/User/UserPersonal',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    dataType: 'json',
                    cache: false,
                    data: JSON.stringify({
                        userId: $scope.userId
                    }),
                    success: function (result) {
                        $timeout(async function () {
                            $scope.iUserPersonal = result.data;
                            resolve(true);
                        }, 0);
                    }, error: function () {
                        resolve(false);
                    }
                });
            });
        }


        $scope.$parent.LoadPersonal = async function (x) {
            $scope.refId = x.id;
            $scope.userId = x.userId;
            $scope.status = x.status;

            await $scope.LoadCurrent();
            await $scope.LoadModify();

            $timeout(function () {
                $scope.total_modify = 0;

                if ($scope.iUserPersonal.firstname_th != $scope.iPersonal.firstname_th
                    || $scope.iUserPersonal.lastname_th != $scope.iPersonal.lastname_th) {
                    $scope.total_modify++;
                }
                if ($scope.iUserPersonal.firstname_en != $scope.iPersonal.firstname_en
                    || $scope.iUserPersonal.lastname_en != $scope.iPersonal.lastname_en) {
                    $scope.total_modify++;
                }
                if ($scope.iUserPersonal.nickname != $scope.iPersonal.nickname) {
                    $scope.total_modify++;
                }
                if ($scope.iUserPersonal.birth_date != $scope.iPersonal.birth_date) {
                    $scope.total_modify++;
                }
                if ($scope.iUserPersonal.sex != $scope.iPersonal.sex) {
                    $scope.total_modify++;
                }
                if ($scope.iUserPersonal.phoneNo != $scope.iPersonal.phoneNo) {
                    $scope.total_modify++;
                }
                if ($scope.iUserPersonal.email != $scope.iPersonal.email) {
                    $scope.total_modify++;
                }
            }, 0);
        }
    });
</script>