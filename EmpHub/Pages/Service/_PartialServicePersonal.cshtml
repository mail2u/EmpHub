@{
    var token = User.AccessToken(Context);
}
<div ng-controller="ServicePersonalCtrl" class="mb-4 text-dark">
    <div class="row">
        <div class="col-sm-5 mb-3">
            <small class="text-decoration-underline">
                ชื่อ-สกุล (ภาษาไทย)
            </small>
            <div class="fw-bolder">{{ iData.firstname_th != '' ? iData.firstname_th : '-' }} {{ iData.lastname_th }}</div>
        </div>
        <div class="col-sm-2 mb-3">
            <small class="text-decoration-underline">
                ชื่อเล่น
            </small>
            <div class="fw-bolder">{{ iData.nickname != '' ? iData.nickname : '-' }}</div>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-5 mb-3">
            <small class="text-decoration-underline">
                ชื่อ-สกุล (ภาษาอังกฤษ)
            </small>
            <div class="fw-bolder">{{ iData.firstname_en != '' ? iData.firstname_en : '-' }} {{ iData.lastname_en }}</div>
        </div>
        <div class="col-sm-5 mb-3">
            <small class="text-decoration-underline">
                วันเกิด
            </small>
            <div class="fw-bolder">{{ iData.birth_date != '' ? iData.birth_date : '-' }}</div>
        </div>
        <div class="col-sm-2 mb-3">
            <small class="text-decoration-underline">
                เพศ
            </small>
            <div class="fw-bolder">{{ iData.sex == 'Male' ? 'ชาย' : iData.sex == 'Female' ? 'หญิง' : '-'  }}</div>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-5 mb-3">
            <small class="text-decoration-underline">
                เบอร์ติดต่อ
            </small>
            <div class="fw-bolder">{{ iData.phoneNo != '' ? iData.phoneNo : '-' }}</div>
        </div>
        <div class="col-sm-5 mb-3">
            <small class="text-decoration-underline">
                อีเมล์
            </small>
            <div class="fw-bolder">{{ iData.email != '' ? iData.email : '-' }}</div>
        </div>
    </div>
</div>
<script>
    app.controller('ServicePersonalCtrl', function ($scope, $http, $timeout, $filter) {

        $scope.LoadData = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/ServicePersonal/Detail',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    refId: $scope.refId
                }),
                success: function (result) {
                    $timeout(async function () {
                        $scope.iData = result;
                    }, 0);
                }, error: AjaxError
            });
        }

        $scope.$parent.LoadPersonal = function (x) {
            $scope.refId = x.id;
            $scope.userId = x.userId;
            $scope.status = x.status;
            $scope.LoadData();
        }
        });
</script>