@{
    var token = User.AccessToken(Context);
}
<style>
    input[type="radio"]:disabled {
        background-color: #0d6efd !important;
        border-color: #0d6efd !important;
        background-image: none !important;
        opacity: 1 !important;
    }
</style>
<div ng-controller="ServicePdpaEmployeeCtrl">
    <div class="bg-white rounded-4 border mb-4 overflow-hidden p-4">
        <div class="px-4 py-3 border-bottom d-flex align-items-center">
            <div class="fs-5 fw-bolder text-dark flex-fill">หนังสือให้ความยินยอมในการเก็บรวบรวม ใช้ หรือเปิดเผยข้อมูลส่วนบุคคล (สำหรับพนักงาน)</div>
        </div>
        <div class="p-4 fs-6 text-dark">
            <div class="fs-5 mb-3">
                <span style="padding-left:100px"></span>
                หนังสือให้ความยินยอมนึ้จัดทำขึ้นโดยบริษัท ทิพยประกันชีวิต จำกัด (มหาชน) <b>"บริษัท"</b> เพื่อให้เป็นไปตามพระราชบัญญัติคุ้มครองข้อมูล
                ส่วนบุคคล พ.ศ. 2562 และเพื่อใช้กับบุคคลที่เข้าทำงานหรือจะเข้าทำสัญญาจ้างงานกับบริษัท หรือในฐานะนักศึกษาฝึกงานเรียกรวมกันว่า <b>"พนักงาน"</b>
                ข้อมูลส่วนบุคคลที่บริษัทเก็บรวบรวม ใช้ หรือเปิดเผย เพื่อการสรรหาและหรือการว่าจ้างพนักงานนี้ รวมทั้งปรเภทของข้อมูล วัตถุประสงค์ ระยะเวลาใน
                การจัดเก็บข้อมูลส่วนบุคคล การประมวลผลดังกล่าว บุคคลภายนอกที่บริษัทจะทำการเปิดเผยข้อมูลส่วนบุคคล และสิทธิต่าง ๆ ของผู้เป็นเจ้าของข้อมูล
                ส่วนบุคคล รวมถึงสิทธิในการถอนความยินยอม เป็นไปตามนโยบายคุ้มครองข้อมูลส่วนบุคคล (Privacy Policy) ของบริษัทรายละเอียดปรากฏตาม Link
                และ QR Code ด้านล่างโดยบริษัทประสงค์จะได้รับความยินยอมจากท่านเพื่อนำข้อมูลส่วนบุคคลไปดำเนินการประมวลผล หากท่านยินยอมให้ข้อมูล
                ส่วนบุคคลของท่านกับทางบริษัทโปรดกรอกรายละเอียดตามด้านล่างนี้
            </div>
            <div class="fs-5 mb-3">
                <span style="padding-left:100px"></span>
                เมื่อท่านลงลายมือชื่อในหนังสือนี้ บริษัทถือว่าท่านยินยอมให้บริษัทประมวลผลข้อมูลส่วนบุคคลของท่านตามวัตถุประสงค์หรือเพื่อใช้
                กิจกรรมดังต่อไปนี้ (โปรดทำเครื่องหมาย ✓ ในช่อง ☐ ในการให้ความยินยอม หรือไม่ให้ความยินยอมแก่บริษัทในการเก็บรวมบรวม ใช้ หรือเปิดเผย
                ข้อมูลส่วนบุคคลของท่านตามวัตถุประสงค์ นั้น ๆ)
            </div>
            <div class="fs-5 mb-3 d-flex flex-wrap">
                <span style="padding-left:100px"></span>
                <div class="text-nowrap me-2">ข้าพเจ้า นาย/นาง/นางสาว </div>
                <input ng-model="iForm.firstname" class="form-text firstname text-blue" style="width:300px" readonly />
                <div class="mx-2">นามสกุล</div>
                <input ng-model="iForm.lastname" class="form-text lastname text-blue" style="width:300px" readonly />
                <div class="mx-2 text-nowrap">หมายเลขบัตรประชาชน/หนังสือเดินทาง</div>
                <input ng-model="iForm.idcard" class="form-text idcard text-blue" style="width:300px" maxlength="13" readonly />
                <div class="ms-2">ยินยอมให้ข้อมูลส่วนบุคคลกับบริษัท ดังต่อไปนี้</div>
            </div>
            <div class="fs-5 mb-3 answer1 box-group">
                <span style="padding-left:100px"></span>
                <input type="radio" name="answer1" ng-model="iForm.answer1" value="Yes" ng-disabled="iForm.answer1 != 'Yes'" /> <b>ยินยอม</b>
                <input type="radio" name="answer1" ng-model="iForm.answer1" value="No" ng-disabled="iForm.answer1 != 'No'" disabled /> <b>ไม่ยินยอม</b>
                ให้บริษัทเก็บรวบรวมใช้ และเปิดเผยข้อมูลส่วนบุคคลและข้อมูลส่วนบุคคลที่มีความอ่อนไหวของข้าพเจ้า
                และหรือบุตร ได้แก่ ศาสนา เชื้อชาติ ข้อมูลสุขภาพ ผลตรวจสุขภาพประจำปี ประวัติการรักษา ข้อมูลตามใบรับรองแพทย์ เป็นต้น เพื่อเป็นข้อมูลการจัด
                สวัสดิการที่เกี่ยวข้องกับสุขภาพ ค่ารักษาพยาบาล และหรือเงื่อนไขการทำงานอันอาจเกี่ยวข้องกับศาสนาหรือเชื้อชาติสำหรับท่านที่เป็นพนักงาน (หากไม่ยินยอม ข้อมูลที่ให้อาจไม่เพียงพอต่อการจัดทำเงินเดือน การพิจารณาสวัสดิการและผลประโยชน์ต่าง ๆ สำหรับพนักงาน)
            </div>
            <div class="fs-5 mb-3 answer2 box-group">
                <span style="padding-left:100px"></span>
                <input type="radio" name="answer2" ng-model="iForm.answer2" value="Yes" ng-disabled="iForm.answer2 != 'Yes'" /> <b>ยินยอม</b>
                <input type="radio" name="answer2" ng-model="iForm.answer2" value="No" ng-disabled="iForm.answer2 != 'No'" /> <b>ไม่ยินยอม</b>
                ให้บริษัทเก็บรวบรวมใช้ และเปิดเผยข้อมูลส่วนบุคคลและข้อมูลส่วนบุคคลที่มีความอ่อนไหวของข้าพเจ้า
                ได้แก่ ภาพลายนิ้วมือ (Finger Scan) ภาพใบหน้า (Face Scan) คลิป VDO วงจรปิด รูปภายกิจกรรมต่าง ๆ ของบริษัท เป็นต้น เพื่อใช้ในการตรวจสอบ
                ข้อมูลและระบุตัวตนในการเข้าและออกพื้นที่ทำงานของบริษัท และเพื่อรักษาความปลอดภัยของพนักงานและบริษัท (หากไม่ยินยอม ข้อมูลที่ให้อาจไม่
                เพียงพอต่อการยืนยันตัวตนและการเข้าออกพื้นที่)
            </div>
            <div class="fs-5 mb-3 answer3 box-group">
                <span style="padding-left:100px"></span>
                <input type="radio" name="answer3" ng-model="iForm.answer3" value="Yes" ng-disabled="iForm.answer3 != 'Yes'" /> <b>ยินยอม</b>
                <input type="radio" name="answer3" ng-model="iForm.answer3" value="No" ng-disabled="iForm.answer3 != 'No'" /> <b>ไม่ยินยอม</b>
                ให้บริษัทเก็บรวบรวมใช้ และเปิดเผยข้อมูลส่วนบุคคลและข้อมูลส่วนบุคคลที่มีความอ่อนไหวของข้าพเจ้า
                ได้แก่ ข้อมูลประวัติอาชญากรรม ประวัติการทำงาน ข้อมูลเงินเดือน/รายได้ เป็นต้น เพื่อพิสูจน์และระบุตัวตน เพื่อตรวจสอบประวัติอาชญากรรม
                ตรวจสอบบุคคลล้มละลาย ตรวจสอบการฉ้อฉล ระยะเวลาการจัดเก็บตลอดระยะเวลาสัญญาจ้าง และเก็บไว้อีก 10 ปีนับแต่วันที่สัญญาจ้างสิ้นสุดลง ตาม
                สิทธิเรียกร้องตามกฏหมาย และเก็บไว้อีก 1 ปีเพื่อใช้เป็นหลักฐานในการพิจารณาคดี (หากไม่ยินยอม ข้อมูลที่ให้อาจไม่เพียงพอต่อการพิสูจน์และระบุ
                ตัวตน)
            </div>
            <div class="fs-5 mb-4">
                <span style="padding-left:100px"></span>
                ข้าพเจ้าได้อ่านและรับทราบเนื้อหาของนโยบายคุ้มครองข้อมูลส่วนบุคคลของบริษัทแล้ว และข้าพเจ้ารับทราบว่า ข้าพเจ้ามีสิทธิถอนความ
                ยินยอมในการเก็บรวบรวม ใช้ หรือเปิดเผยข้อมูลส่วนบุคคลของข้าพเจ้าเพื่อวัตถุประสงค์ตามที่ระบุไว้ในหนังสือฉบับนี้ได้ตลอดเวลา โดยแจ้งให้กับบริษัท
                ทราบเป็นลายลักษณ์อักษรถึงการถอนความยินยอมเช่นว่านั้นได้ จึงได้ลงลายมือชื่อไว้เป็นสำคัญ
            </div>
            <div class="py-4">
                <img src="~/Images/qr-code-tiplife-policy.png" width="120" />
                <div class="fs-6">
                    สแกนเพื่ออ่านนโยบายคุ้มครองข้อมูลส่วนบุคคล (Privacy Policy) ของบริษัท หรือ <a class="text-blue" href="https://www.tiplife.com/about/policies" target="_blank">https://www.tiplife.com/about/policies</a>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    app.controller('ServicePdpaEmployeeCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.LoadDetail = function () {
            return new Promise((resolve) => {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/Form/FormPdpaEmployeeDetail',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    dataType: 'json',
                    cache: false,
                    data: JSON.stringify({
                        refId: $scope.refId
                    }),
                    success: function (result) {
                        $timeout(async function () {
                            $scope.iForm = result;
                            resolve(true);
                        }, 0);
                    }, error: function () {
                        resolve(false);
                    }
                });
            });
        }

        $scope.DownloadPDF = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Form/FormPdpaEmployeePDF',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                xhrFields: {
                    responseType: 'blob'
                },
                cache: false,
                data: JSON.stringify({
                    refId: $scope.refId
                }),
                success: function (response, status, xhr) {

                    var blob = new Blob(
                        [response],
                        { type: 'application/pdf' }
                    );

                    // ดึง filename จาก header
                    var disposition = xhr.getResponseHeader('Content-Disposition');

                    var fileName = 'FormPdpaEmployee.pdf';

                    if (disposition && disposition.indexOf('filename=') !== -1) {

                        fileName = disposition
                            .split('filename=')[1]
                            .replace(/"/g, '');
                    }

                    // create link download
                    var link = document.createElement('a');

                    link.href = window.URL.createObjectURL(blob);

                    link.download = fileName;

                    document.body.appendChild(link);

                    link.click();

                    document.body.removeChild(link);

                }, error: AjaxError
            });
        }

        $scope.init = async function (x) {
            $scope.refId = x.id;
            $scope.userId = x.userId;
            $scope.status = x.status;

            await $scope.LoadDetail();

            // register ไป parent
            $scope.formAction.DownloadPDF = $scope.DownloadPDF;
            $scope.formAction.can_download = 1;
        }

        $scope.$on('FORM_PDPA_EMPLOYEE_LOAD', function (e, data) {
            $scope.init(data);
        });
    });
</script>