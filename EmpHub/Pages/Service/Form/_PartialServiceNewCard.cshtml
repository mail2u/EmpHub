@{
    var token = User.AccessToken(Context);
}
<div ng-controller="ServiceNewCardCtrl">
    <div class="bg-white rounded-4 border mb-4 overflow-hidden">
        <div class="px-4 py-3 border-bottom d-flex align-items-center">
            <div class="fs-5 fw-bolder text-dark flex-fill">Request Employee Card</div>
        </div>
        <div class="p-4">
            <table class="table table-borderless">
                <tbody>
                    <tr>
                        <td width="200">
                            <div class="text-dark text-nowrap fw-bolder">สาเหตุ</div>
                            <div class="text-dark text-nowrap">Cause</div>
                        </td>
                        <td class="text-blue">
                            {{ iForm.cause }}
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <div class="text-dark text-nowrap fw-bolder">หมายเหตุ</div>
                            <div class="text-dark text-nowrap">description</div>
                        </td>
                        <td class="text-blue">
                            {{ iForm.description }}
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <div class="text-dark text-nowrap fw-bolder">แนบรูปภาพ</div>
                            <div class="text-dark text-nowrap">attach image</div>
                        </td>
                        <td>
                            <div class="d-flex" ng-show="iFile != null">
                                <a class="select d-flex align-items-center rounded-3 bg-light-gray shadow-sm p-2" href="@webAPI.CurrentValue.APIEmpHub/api/File/DownloadFile?refId={{ iFile.refId }}&id={{ iFile.id }}" target="_blank" title="Download">
                                    <div class="me-2">
                                        <img width="40" src="data:image/png;base64,{{iFile.imageBase64}}">
                                    </div>
                                    <div>
                                        <div class="fw-bolder">{{ iFile.outputname }}</div>
                                        <div class="small">{{ iFile.filetype }}</div>
                                    </div>
                                    <div>
                                        <i class="bi bi-download ms-2"></i>
                                    </div>
                                </a>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
<script>
    app.controller('ServiceNewCardCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.LoadDetail = function () {
            return new Promise((resolve) => {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/Form/FormNewCardDetail',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    dataType: 'json',
                    cache: false,
                    data: JSON.stringify({
                        refId: $scope.refId
                    }),
                    success: function (result) {
                        $timeout(async function () {
                            $scope.iForm = result;
                            resolve(true);
                        }, 0);
                    }, error: function () {
                        resolve(false);
                    }
                });
            });
        }

        $scope.LoadAttach = function () {
            return new Promise((resolve) => {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/File/DataList',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    dataType: 'json',
                    cache: false,
                    data: JSON.stringify({
                        refId: $scope.refId
                    }),
                    success: function (result) {
                        $timeout(async function () {
                            var lFile = result;

                            if (lFile.length > 0) {
                                $scope.iFile = lFile[0];
                            }
                            resolve(true);
                        }, 0);
                    }, error: function () {
                        resolve(false);
                    }
                });
            });
        }

        $scope.init = async function (x) {
            $scope.refId = x.id;
            $scope.userId = x.userId;
            $scope.status = x.status;

            await $scope.LoadDetail();
            await $scope.LoadAttach();
        }

        $scope.$on('FORM_NEED_NEW_CARD_LOAD', function (e, data) {
            $scope.init(data);
        });
    });
</script>