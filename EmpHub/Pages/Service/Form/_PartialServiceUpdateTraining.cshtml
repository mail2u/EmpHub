@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    var token = User.AccessToken(Context);
}
<style>
    input[type="radio"]:disabled {
        background-color: #0d6efd !important;
        border-color: #0d6efd !important;
        background-image: none !important;
        opacity: 1 !important;
    }
</style>
<div ng-controller="ServiceUpdateTrainingCtrl">
    <div class="bg-white rounded-4 border mb-4 overflow-hidden p-4">
        <div class="px-4 py-3 border-bottom d-flex align-items-center">
            <div class="fs-5 fw-bolder text-dark flex-fill">
                ปรับปรุงข้อมูลการฝึกอบรม
            </div>
        </div>
        <div class="p-4 fs-6 text-dark">
            <div class="list-group list-group-flush">
                <div class="list-group-item px-0" ng-repeat="x in lTraining">
                    <div class="d-flex mb-3">
                        <div class="flex-fill me-3">
                            <div class="text-dark fw-bolder">
                                ชื่อใบอนุญาต
                            </div>
                            <div class="text-gray">{{ x.license != '' ? x.license : '-' }}</div>
                        </div>
                        <div class="flex-fill me-3">
                            <div class="text-dark fw-bolder">
                                องค์กรที่ออกเอกสาร
                            </div>
                            <div class="text-gray">{{ x.organization != '' ? x.organization : '-' }}</div>
                        </div>
                        <div class="me-3">
                            <div class="text-dark fw-bolder">
                                เลขที่ใบรับรอง
                            </div>
                            <div class="text-gray">{{ x.certificateNo ? x.certificateNo : '-' }}</div>
                        </div>
                        <div class="me-3">
                            <div class="text-dark fw-bolder">
                                วันที่ออกเอกสาร
                            </div>
                            <div class="text-gray">{{ x.issueDate != '' ? x.issueDate : '-' }}</div>
                        </div>
                        <div class="">
                            <div class="text-dark fw-bolder">
                                วันหมดอายุ
                            </div>
                            <div class="text-gray">{{ x.expireDate != '' ? x.expireDate : '-' }}</div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="text-dark fw-bolder">
                            รายละเอียด
                        </div>
                        <div class="text-gray">{{ x.description != '' ? x.description : '-' }}</div>
                    </div>
                    <div class="mb-3">
                        <div class="text-dark fw-bolder">
                            เอกสารหลักฐาน
                        </div>
                        <div class="text-gray" ng-show="x.lAttachFile.length == 0">
                            ไม่มีเอกสารแนบ
                        </div>
                        <div class="d-flex flex-wrap">
                            <div class="bg-gray rounded-3 me-2 mb-2" ng-repeat="a in x.lAttachFile" title="{{ a.filename }}">
                                <a class="btn btn-link" href="@webAPI.CurrentValue.APIEmpHub/api/File/DownloadFile?refId={{ a.refId }}&id={{ a.id }}" target="_blank" title="Download">
                                    <div class="d-flex align-items-center w-100">
                                        <img width="20" src="data:image/png;base64,{{ a.imageBase64 }}">
                                        <span class="text-truncate mx-2 flex-grow-1 w-100" style="min-width: 0;">
                                            {{ a.outputname }}
                                        </span>
                                        <i class="bi bi-download"></i>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            @* ไฟล์ที่จับคู่กับรายการฝึกอบรมไม่ได้ ต้องแสดงให้ผู้อนุมัติเห็น ไม่ปล่อยให้หาย *@
            <div class="mt-3 pt-3 border-top" ng-show="lAttachOther.length > 0">
                <div class="fw-bolder mb-2">
                    เอกสารแนบเพิ่มเติม
                </div>
                <div class="d-flex flex-wrap">
                    <div class="bg-gray rounded-3 me-2 mb-2" ng-repeat="a in lAttachOther" title="{{ a.filename }}">
                        <a class="btn btn-link" href="@webAPI.CurrentValue.APIEmpHub/api/File/DownloadFile?refId={{ a.refId }}&id={{ a.id }}" target="_blank" title="Download">
                            <div class="d-flex align-items-center w-100">
                                <img width="20" src="data:image/png;base64,{{ a.imageBase64 }}">
                                <span class="text-truncate mx-2 flex-grow-1 w-100" style="min-width: 0;">
                                    {{ a.outputname }}
                                </span>
                                <i class="bi bi-download"></i>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    app.controller('ServiceUpdateTrainingCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.LoadDetail = function () {
            return new Promise((resolve) => {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/ServiceTraining/Detail',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    dataType: 'json',
                    cache: false,
                    data: JSON.stringify({
                        refId: $scope.refId
                    }),
                    success: function (result) {
                        $timeout(async function () {
                            $scope.lTraining = (result || []).map(function (item) {
                                item.lAttachFile = [];

                                return item;
                            });
                            resolve(true);
                        }, 0);
                    }, error: function () {
                        resolve(false);
                    }
                });
            });
        }

        $scope.LoadFile = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/File/DataList',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    refId: $scope.refId
                }),
                success: function (result) {
                    $timeout(function () {
                        $scope.BuildAttachFile(result || []);
                    }, 0);
                }, error: function () {
                    console.log('Load File Error');
                }
            });
        }

        // ผูกไฟล์เข้ากับรายการฝึกอบรมผ่าน attachCode = trainingId
        // ไฟล์ที่จับคู่ไม่ได้จะไปอยู่ lAttachOther เพื่อไม่ให้เอกสารหายไปจากสายตาผู้อนุมัติ
        $scope.BuildAttachFile = function (lFile) {
            var matched = {};

            ($scope.lTraining || []).forEach(function (x) {
                x.lAttachFile = lFile.filter(function (a) {
                    return a.attachCode && a.attachCode == x.trainingId;
                });

                x.lAttachFile.forEach(function (a) {
                    matched[a.id] = true;
                });
            });

            $scope.lAttachOther = lFile.filter(function (a) {
                return !matched[a.id];
            });
        }

        $scope.init = async function (x) {
            $scope.refId = x.id;
            $scope.userId = x.userId;
            $scope.status = x.status;
            $scope.lAttachOther = [];

            await $scope.LoadDetail();

            $scope.LoadFile();
        }

        $scope.$on('EDIT_TRAINING_LOAD', function (e, data) {
            $scope.init(data);
        });
    });
</script>
