@{
    var token = User.AccessToken(Context);
}
<div ng-controller="ServiceTrainingCtrl">
    <div class="bg-white rounded-4 border mb-4 overflow-hidden" ng-show="lTraining.length > 0">
        <div class="px-4 py-3 border-bottom d-flex align-items-center">
            <div class="fs-5 fw-bolder text-dark flex-fill">Training</div>
            <div>
                <div class="badge bg-light-green px-2 me-2" ng-show="total_add > 0">
                    {{ total_add }} Addition
                </div>
                <div class="badge bg-light-blue px-2 me-2" ng-show="total_modify > 0">
                    {{ total_modify }} Modification
                </div>
                <div class="badge bg-light-red px-2 me-2" ng-show="total_delete > 0">
                    {{ total_delete }} Deletion
                </div>
            </div>
        </div>
        <div class="">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th class="bg-light ps-4">COURSE NAME</th>
                        <th class="bg-light">PROVIDER</th>
                        <th class="bg-light">ISSUE</th>
                        <th class="bg-light">ACTION</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="x in lTraining">
                        <td class="ps-4 text-{{ x.mode }}">{{ x.license }}</td>
                        <td class="text-{{ x.mode }}">{{ x.organization }}</td>
                        <td class="text-{{ x.mode }}">{{ x.issueDate }}</td>
                        <td>
                            <div class="badge bg-light-green px-2 me-2" ng-show="x.mode == 'add'">
                                Addition
                            </div>
                            <div class="badge bg-light-blue px-2 me-2" ng-show="x.mode == 'modify'">
                                Modification
                            </div>
                            <div class="badge bg-light-red px-2 me-2" ng-show="x.mode == 'delete'">
                                Deletion
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
<script>
    app.controller('ServiceTrainingCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.LoadModify = function () {
            return new Promise((resolve) => {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/ServiceTraining/Detail',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    dataType: 'json',
                    cache: false,
                    data: JSON.stringify({
                        refId: $scope.refId
                    }),
                    success: function (result) {
                        $timeout(async function () {
                            $scope.lTraining = result;
                            resolve(true);
                        }, 0);
                    }, error: function () {
                        resolve(false);
                    }
                });
            });
        }

        $scope.$parent.LoadTraining = async function (x) {
            $scope.refId = x.id;
            $scope.userId = x.userId;
            $scope.status = x.status;

            await $scope.LoadModify();

            $timeout(function () {
                $scope.total_add = ($scope.lTraining.filter(item => item.mode == "add")).length;
                $scope.total_modify = ($scope.lTraining.filter(item => item.mode == "modify")).length;
                $scope.total_delete = ($scope.lTraining.filter(item => item.mode == "delete")).length;
            }, 0);
        }
    });
</script>