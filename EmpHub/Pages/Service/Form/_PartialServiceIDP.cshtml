@{
    var token = User.AccessToken(Context);
}
<style>
    input[type="radio"]:disabled {
        background-color: #0d6efd !important;
        border-color: #0d6efd !important;
        background-image: none !important;
        opacity: 1 !important;
    }
</style>
<div ng-controller="ServiceIDPCtrl">
    <div class="bg-white rounded-4 border mb-4 overflow-hidden p-4">
        <div class="px-4 py-3 border-bottom d-flex align-items-center">
            <div class="fs-5 fw-bolder text-dark flex-fill">
                Individual Development Plan
            </div>
        </div>
        <div class="p-4 fs-6 text-dark">

            <div class="row fs-5">
                <div class="col-sm-4 mb-3 d-flex">
                    <div class="text-nowrap me-2">Name</div><input ng-model="iForm.fullname" class="form-text text-blue fullname" maxlength="100" readonly />
                </div>
                <div class="col-sm-4 mb-3 d-flex">
                    <div class="text-nowrap me-2">Department</div><input ng-model="iForm.department" class="form-text text-blue department" maxlength="50" readonly />
                </div>
                <div class="col-sm-4 mb-3 d-flex">
                    <div class="text-nowrap me-2">Date</div><input ng-model="iForm.join_date" class="form-text text-blue department" maxlength="50" readonly />
                </div>
            </div>
            <table class="table table-bolder border">
                <tbody>
                    <tr>
                        <td colspan="2" class="fs-5 text-white" style="background-color:#c00000;">
                            Assess:
                        </td>
                    </tr>
                    <tr>
                        <td style="width:300px;">
                            <div class="fw-bolder mb-2">Development Objective:</div>
                            <div>
                                <input type="radio" id="objective_strength" name="objective" ng-model="iForm.objective" value="Strength" ng-disabled="iForm.objective != 'Strength'" />
                                <label for="objective_strength">Strength</label>
                            </div>
                            <div>
                                <input type="radio" id="objective_growth" name="objective" ng-model="iForm.objective" value="Growth Opportunity" ng-disabled="iForm.objective != 'Growth Opportunity'" />
                                <label for="objective_growth">Growth Opportunity</label>
                            </div>
                            @*    * ใส่เครืองหมาย X เพื่อระบุว่าเป็น Strength หรือ
                            Growth Opportunity *@
                        </td>
                        <td>
                            <div class=" text-blue" style="min-height:150px;">{{ iForm.answer1_desc }}</div>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="2" class="fs-5 text-dark" style="background-color:#ffc000">
                            Acquire:
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <span class="fw-bolder fs-6">Formal Learning:</span> การเพิ่มพูนความรู้หรือทักษะด้วยการเรียนรู้อย่างเป็นทางการ เช่น การอบรม การอ่านหนังสือ หรือการเรียนรู้จาก web-based /           E-Learning เป็นต้น
                        </td>
                        <td>
                            <div class=" text-blue mb-3" style="min-height:150px;">{{ iForm.answer2_desc }}</div>
                            <input ng-model="iForm.answer2_date" class="form-text text-blue" style="width:150px;" readonly />
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <span class="fw-bolder fs-6">Learning from others:</span> การเรียนรู้จากผู้ที่เชี่ยวชาญในเรื่องนี้ อาจจะเป็นบุคคลภายในหรือภายนอกหน่วยงาน/บริษัท ก็ได้
                        </td>
                        <td>
                            <div class=" text-blue mb-3" style="min-height:150px;">{{ iForm.answer3_desc }}</div>
                            <input ng-model="iForm.answer3_date" class="form-text text-blue" style="width:150px;" readonly />
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <span class="fw-bolder fs-6">Measurement:</span>  หมายถึงวิธีวัดที่ทำให้ตนเองและผู้อื่นทราบว่ามีความรู้ในเรื่องที่ต้องการพัฒนาแล้ว
                        </td>
                        <td>
                            <div class=" text-blue mb-3" style="min-height:150px;">{{ iForm.answer4_desc }}</div>
                            <input ng-model="iForm.answer4_date" class="form-text text-blue" style="width:150px;" readonly />
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <span class="fw-bolder fs-6">Support needed:</span> หากมีอุปสรรคในการศึกษาเรียนรู้ทักษะใหม่ ท่านต้องการการสนับสนุนจากใคร ในเรื่องใด
                        </td>
                        <td>
                            <div class=" text-blue" style="min-height:150px;">{{ iForm.answer5_desc }}</div>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="2" class="fs-5 text-dark" style="background-color:#ffff00;">
                            Apply:
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <span class="fw-bolder fs-6">1st Application:</span> หมายถึงการนำทักษะหรือความรู้ที่ได้เรียนรู้แล้วไปใช้ในการทำงานจริง ในช่องนี้ให้เลือกเวทีที่ง่ายต่อการประยุกต์ใช้ครั้งแรกก่อน
                        </td>
                        <td>
                            <div class=" text-blue mb-3" style="min-height:150px;">{{ iForm.answer6_desc }}</div>
                            <input ng-model="iForm.answer6_date" class="form-text text-blue" style="width:150px;" readonly />
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <span class="fw-bolder fs-6">1st Measurement:</span> วิธีวัดความสำเร็จหลังจากที่ได้นำทักษะใหม่ไปใช้จริงแล้ว
                        </td>
                        <td>
                            <div class=" text-blue mb-3" style="min-height:150px;">{{ iForm.answer7_a_desc }}</div>
                            <div class=" text-blue" style="min-height:150px;">{{ iForm.answer7_b_desc }}</div>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <span class="fw-bolder fs-6">1st Support Needed:</span> หากมีอุปสรรคในการนำทักษะใหม่ไปใช้ในการทำงานจริง ท่านต้องการ         การสนับสนุนจากใคร ในเรื่องใด
                        </td>
                        <td>
                            <div class=" text-blue" style="min-height:150px;">{{ iForm.answer8_desc }}</div>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <span class="fw-bolder fs-6">2nd Application:</span> หมายถึงการนำทักษะหรือความรู้ที่ได้เรียนรู้แล้วไปประยุกต์ใช้ในการทำงานจริง ในช่องนี้ให้เลือกเวทีที่ท้าทายกว่าเวทีแรก (ถ้าเป็นไปได้)
                        </td>
                        <td>
                            <div class=" text-blue mb-3" style="min-height:150px;">{{ iForm.answer9_desc }}</div>
                            <input ng-model="iForm.answer9_date" class="form-text text-blue" style="width:150px;" readonly />
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <span class="fw-bolder fs-6">2nd Measurement:</span> วิธีวัดความสำเร็จหลังจากที่ได้นำทักษะใหม่ไปใช้จริงแล้ว
                        </td>
                        <td>
                            <div class=" text-blue mb-3" style="min-height:150px;">{{ iForm.answer10_a_desc }}</div>
                            <div class=" text-blue" style="min-height:150px;">{{ iForm.answer10_b_desc }}</div>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <span class="fw-bolder fs-6">2nd Support Needed:</span> หากมีอุปสรรคในการนำทักษะใหม่ไปใช้ในการทำงานจริง ท่านต้องการ         การสนับสนุนจากใคร ในเรื่องใด
                        </td>
                        <td>
                            <div class=" text-blue" style="min-height:150px;">{{ iForm.answer11_desc }}</div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
<script>
    app.controller('ServiceIDPCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.LoadDetail = function () {
            return new Promise((resolve) => {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/Form/FormIDPDetail',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    dataType: 'json',
                    cache: false,
                    data: JSON.stringify({
                        refId: $scope.refId
                    }),
                    success: function (result) {
                        $timeout(async function () {
                            $scope.iForm = result;
                            resolve(true);
                        }, 0);
                    }, error: function () {
                        resolve(false);
                    }
                });
            });
        }

        $scope.init = async function (x) {
            $scope.refId = x.id;
            $scope.userId = x.userId;
            $scope.status = x.status;

            await $scope.LoadDetail();
        }

        $scope.$on('FORM_IDP_LOAD', function (e, data) {
            $scope.init(data);
        });
    });
</script>