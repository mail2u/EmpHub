@{
    var token = User.AccessToken(Context);
}
<div ng-controller="ServiceBenefitFundCtrl">
    <div class="bg-white rounded-4 border mb-4 overflow-hidden text-dark">
        <div class="px-4 py-3 border-bottom d-flex align-items-center">
            <div class="fs-5 fw-bolder text-dark flex-fill">แบบแสดงเจตนาระบุผู้รับประโยชน์</div>
        </div>
        <div class="p-4">
            <div class="mb-4">
                กองทุนสำรองเลี้ยงชีพ <b>เอ็มเอฟซี  มาสเตอร์ฟันด์</b> ซึ่งจดทะเบียนแล้ว
                <b>บริษัท ทิพยประกันชีวิต จำกัด (มหาชน)</b>
            </div>
            <div class="row">
                <div class="col-sm-6 mb-3">
                    ข้าพเจ้า <span class="text-blue ms-3">{{ iForm.fullname }}</span>
                </div>
                <div class="col-sm-6 mb-3">
                    บัตรประจำตัวประชาชนเลขที่ <span class="text-blue ms-3">{{ iForm.idcard }}</span>
                </div>
            </div>
            <div style="padding-left:50px;" class="mode box-group mb-3">
                <div class="mb-1">
                    <input ng-model="iForm.mode" type="radio" value="new" ng-disabled="iForm.mode != 'new'" /> ขอแสดงเจตนาระบุตัวผู้รับประโยชน์จากกองทุน
                </div>
                <div>
                    <input ng-model="iForm.mode" type="radio" value="change" ng-disabled="iForm.mode != 'change'" /> ขอเปลี่ยนแปลงผู้รับประโยชน์จากกองทุน  โดยยกเลิกหนังสือแสดงเจตนาฉบับเดิม
                </div>
            </div>
            <div class="mb-3 d-flex align-items-center">
                เมื่อข้าพเจ้าถึงแก่ความตาย  ข้าพเจ้าประสงค์ให้จ่ายเงินกองทุนแก่บุคคลจำนวน <span class="text-center mx-3 text-blue" style="width:80px;">{{ iForm.total }}</span> คนดังมีรายชื่อดังต่อไปนี้
            </div>
            <table class="table table-borderless">
                <tbody>
                    <tr>
                        <td class="align-middle" width="20">
                            1
                        </td>
                        <td class="text-blue">
                            {{ iForm.benefitname1 }}
                        </td>
                        <td class="align-middle">
                            เกี่ยวข้องเป็น
                        </td>
                        <td class="text-blue" width="200">
                            {{ iForm.benefitrelation1 }}
                        </td>
                        <td class="align-middle">
                            จำนวน
                        </td>
                        <td class="text-blue" width="100">
                            {{ iForm.benefitpercent1 }}
                        </td>
                        <td class="align-middle">
                            %
                        </td>
                    </tr>
                    <tr ng-show="iForm.total > 1">
                        <td class="align-middle" width="20">
                            2
                        </td>
                        <td class="text-blue">
                            {{ iForm.benefitname2 }}
                        </td>
                        <td class="align-middle">
                            เกี่ยวข้องเป็น
                        </td>
                        <td class="text-blue" width="200">
                            {{ iForm.benefitrelation2 }}
                        </td>
                        <td class="align-middle">
                            จำนวน
                        </td>
                        <td class="text-blue" width="100">
                            {{ iForm.benefitpercent2 }}
                        </td>
                        <td class="align-middle">
                            %
                        </td>
                    </tr>
                    <tr ng-show="iForm.total > 2">
                        <td class="align-middle" width="20">
                            3
                        </td>
                        <td class="text-blue">
                            {{ iForm.benefitname3 }}
                        </td>
                        <td class="align-middle">
                            เกี่ยวข้องเป็น
                        </td>
                        <td class="text-blue" width="200">
                            {{ iForm.benefitrelation3 }}
                        </td>
                        <td class="align-middle">
                            จำนวน
                        </td>
                        <td class="text-blue" width="100">
                            {{ iForm.benefitpercent3 }}
                        </td>
                        <td class="align-middle">
                            %
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
<script>
    app.controller('ServiceBenefitFundCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.LoadDetail = function () {
            return new Promise((resolve) => {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/Form/FormBenefitFundDetail',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    dataType: 'json',
                    cache: false,
                    data: JSON.stringify({
                        refId: $scope.refId
                    }),
                    success: function (result) {
                        $timeout(async function () {
                            $scope.iForm = result;
                            resolve(true);
                        }, 0);
                    }, error: function () {
                        resolve(false);
                    }
                });
            });
        }

        $scope.DownloadPDF = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Form/FormBenefitFundPDF',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                xhrFields: {
                    responseType: 'blob'
                },
                cache: false,
                data: JSON.stringify({
                    refId: $scope.refId
                }),
                success: function (response, status, xhr) {

                    var blob = new Blob(
                        [response],
                        { type: 'application/pdf' }
                    );

                    // ดึง filename จาก header
                    var disposition = xhr.getResponseHeader('Content-Disposition');

                    var fileName = 'FormBenefitFund.pdf';

                    if (disposition && disposition.indexOf('filename=') !== -1) {

                        fileName = disposition
                            .split('filename=')[1]
                            .replace(/"/g, '');
                    }

                    // create link download
                    var link = document.createElement('a');

                    link.href = window.URL.createObjectURL(blob);

                    link.download = fileName;

                    document.body.appendChild(link);

                    link.click();

                    document.body.removeChild(link);

                }, error: AjaxError
            });
        }

        $scope.init = async function (x) {
            $scope.refId = x.id;
            $scope.userId = x.userId;
            $scope.status = x.status;

            await $scope.LoadDetail();

            // register ไป parent
            $scope.formAction.DownloadPDF = $scope.DownloadPDF;
        }

        $scope.$on('FORM_BENEFIT_FUND_LOAD', function (e, data) {
            $scope.init(data);
        });
    });
</script>