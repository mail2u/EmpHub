@{
    var token = User.AccessToken(Context);
}
<style>
</style>
<div ng-controller="ServicePrepareEmployeeCtrl">
    <div class="bg-white rounded-4 border mb-4 overflow-hidden p-4">
        <div class="px-4 py-3 border-bottom d-flex align-items-center">
            <div class="fs-5 fw-bolder text-dark flex-fill">
                แบบฟอร์มการจัดเตรียมความพร้อมสำหรับพนักงานใหม่
            </div>
        </div>
        <div class="p-4 fs-6 text-dark">
            @* section 1 *@
            <div class="fs-5 fw-bolder bg-gray mb-3 p-1">
                ข้อมูลทั่วไปของพนักงาน
            </div>
            <div class="fs-5 mb-4">
                <div class="d-flex mb-1">
                    <div class="text-nowrap fw-bolder">คำนำหน้านาม: นาย / นาง / นางสาว / อื่นๆ </div>
                    <input ng-model="iForm.prefix" class="form-text prefix mx-2 text-blue" maxlength="100" style="width:200px;" readonly />
                    <div class="text-nowrap fw-bolder">ชื่อ-นามสกุล</div>
                    <input ng-model="iForm.fullname" class="form-text fullname ms-2 text-blue" maxlength="100" readonly />
                </div>
                <div class="d-flex mb-1">
                    <div class="text-nowrap fw-bolder">ชื่อตำแหน่ง</div>
                    <input ng-model="iForm.position" class="form-text position mx-2 text-blue" maxlength="100" readonly />
                    <div class="text-nowrap fw-bolder">วันเริ่มงาน</div>
                    <input ng-model="iForm.join_date" class="form-text mx-2 text-blue" readonly />
                    <div class="text-nowrap fw-bolder">หมายเลขโทรศัพท์</div>
                    <input ng-model="iForm.phoneNo" class="form-text phoneNo ms-2 text-blue" maxlength="10" required style="width:250px;" readonly />
                </div>
                <div class="d-flex mb-1 answer1 box-group">
                    <div class="text-nowrap fw-bolder">ต้องการให้จัดเตรียมนามบัตรหรือไม่</div>
                    <div class="ms-3">
                        <input type="radio" id="answer1_no" name="answer1" ng-model="iForm.answer1" value="No" ng-disabled="iForm.answer1 != 'No'" /> <label for="answer1_no">ไม่ต้องการ</label>
                    </div>
                    <div class="ms-2">
                        <input type="radio" id="answer1_yes" name="answer1" ng-model="iForm.answer1" value="Yes" ng-disabled="iForm.answer1 != 'Yes'" /> <label for="answer1_yes">ต้องการ</label>
                    </div>
                </div>
            </div>
            @* section 2 *@
            <div class="fs-5 fw-bolder bg-gray mb-3 p-1">
                ข้อมูลเกี่ยวกับการใช้อุปกรณ์คอมพิวเตอร์
            </div>
            <div class="fs-5 mb-3">
                <div class="d-flex mb-1">
                    <div class="text-nowrap fw-bolder">ชื่อผู้ใช้ / User Name</div>
                    <input ng-model="iForm.username" class="form-text username mx-2 text-blue" maxlength="50" readonly />
                    <div class="text-nowrap fw-bolder">ชื่ออีเมล์ / Email Address</div>
                    <input ng-model="iForm.email" class="form-text email ms-2 text-blue" maxlength="50" readonly />
                </div>
                <div class="d-flex mb-1">
                    <div class="text-nowrap fw-bolder">อนุญาตให้ผ่านเข้าถึงข้อมูลใน Server/Share Drive โปรดระบุ </div>
                    <input ng-model="iForm.sharedrive" class="form-text mx-2 text-blue" maxlength="400" readonly />
                </div>
                <div class="d-flex mb-1 answer2 box-group">
                    <div class="text-nowrap fw-bolder">ต้องการอุปกรณ์คอมพิวเตอร์แบบใด</div>
                    <div class="ms-3">
                        <input type="radio" id="answer2_laptop" name="answer2" ng-model="iForm.answer2" value="Laptop" ng-disabled="iForm.answer2 != 'Laptop'" /> <label for="answer2_laptop">Laptop</label>
                    </div>
                    <div class="ms-2">
                        <input type="radio" id="answer2_pc" name="answer2" ng-model="iForm.answer2" value="PC" ng-disabled="iForm.answer2 != 'PC'" /> <label for="answer2_pc">Desktop PC</label>
                    </div>
                </div>
                <div class="d-flex mb-1">
                    <div class="text-nowrap fw-bolder">โปรดระบุ Specifications ของคอมพิวเตอร์ที่ต้องการ </div>
                    <input ng-model="iForm.speccomputer" class="form-text mx-2 text-blue" maxlength="400" readonly />
                </div>
                <div class="d-flex mb-1 answer3 box-group">
                    <div class="text-nowrap fw-bolder">ต้องการโปรแกรม Software พิเศษหรือไม่</div>
                    <div class="ms-3 text-nowrap">
                        <input type="radio" id="answer3_no" name="answer3" ng-model="iForm.answer3" value="No" ng-disabled="iForm.answer3 != 'No'" /> <label for="answer3_no">ไม่ต้องการ</label>
                    </div>
                    <div class="ms-2 text-nowrap">
                        <input type="radio" id="answer3_yes" name="answer3" ng-model="iForm.answer3" value="Yes" ng-disabled="iForm.answer3 != 'Yes'" /> <label for="answer3_yes">ต้องการ โปรดระบุ</label>
                    </div>
                    <input ng-model="iForm.software_desc" class="form-text mx-2" maxlength="400" readonly />
                </div>
                <div class="mb-1">
                    <div class=" fw-bolder">โปรดระบุระบบที่ต้องการใช้งาน</div>
                    <div class="row">
                        <div class="col-sm-6 mb-1">
                            <div class="d-flex">
                                <input type="checkbox" ng-model="iForm.gls_system" ng-true-value="'Yes'" disabled />
                                <label class="text-nowrap mx-2">GLS ให้สิทธิการเข้าใช้ระบบเหมือนกับ</label>
                                <input ng-model="iForm.gls_desc" class="form-text text-blue" readonly />
                            </div>
                        </div>
                        <div class="col-sm-6 mb-1">
                            <div class="d-flex">
                                <input type="checkbox" id="ls_system" ng-model="iForm.ls_system" ng-true-value="'Yes'" disabled />
                                <label for="ls_system" class="text-nowrap mx-2">LS ให้สิทธิการเข้าใช้ระบบเหมือนกับ</label>
                                <input ng-model="iForm.ls_desc" class="form-text text-blue" readonly />
                            </div>
                        </div>
                        <div class="col-sm-6 mb-1">
                            <div class="d-flex">
                                <input type="checkbox" id="linet_system" ng-model="iForm.linet_system" ng-true-value="'Yes'" disabled />
                                <label for="linet_system" class="text-nowrap mx-2">Linet ให้สิทธิการเข้าใช้ระบบเหมือนกับ</label>
                                <input ng-model="iForm.linet_desc" class="form-text text-blue" readonly />
                            </div>
                        </div>
                        <div class="col-sm-6 mb-1">
                            <div class="d-flex">
                                <input type="checkbox" id="sun_system" ng-model="iForm.sun_system" ng-true-value="'Yes'" disabled />
                                <label for="sun_system" class="text-nowrap mx-2">SUN ให้สิทธิการเข้าใช้ระบบเหมือนกับ</label>
                                <input ng-model="iForm.sun_desc" class="form-text text-blue" readonly />
                            </div>
                        </div>
                        <div class="col-sm-6 mb-1">
                            <div class="d-flex">
                                <input type="checkbox" id="prophet_system" ng-model="iForm.prophet_system" ng-true-value="'Yes'" disabled />
                                <label for="prophet_system" class="text-nowrap mx-2">Prophet ให้สิทธิการเข้าใช้ระบบเหมือนกับ</label>
                                <input ng-model="iForm.prophet_desc" class="form-text text-blue" readonly />
                            </div>
                        </div>
                        <div class="col-sm-6 mb-1">
                            <div class="d-flex">
                                <input type="checkbox" id="bonunza_system" ng-model="iForm.bonunza_system" ng-true-value="'Yes'" disabled />
                                <label for="bonunza_system" class="text-nowrap mx-2">Bonunza ให้สิทธิการเข้าใช้ระบบเหมือนกับ</label>
                                <input ng-model="iForm.bonunza_desc" class="form-text text-blue" readonly />
                            </div>
                        </div>
                        <div class="col-sm-12 mb-1">
                            <div class="d-flex">
                                <input type="checkbox" id="other_system" ng-model="iForm.other_system" ng-true-value="'Yes'" disabled />
                                <label for="other_system" class="text-nowrap mx-2">ระบบอื่น ๆ โปรดระบุเพิ่มเติม</label>
                                <input ng-model="iForm.other_desc" class="form-text text-blue" readonly />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            @* section 3 *@
            <div class="fs-5 fw-bolder bg-gray mb-3 p-1">
                โต๊ะทำงานและอุปกรณ์อื่น ๆ
            </div>
            <table class="table table-borderless fs-5">
                <tbody>
                    <tr class="answer4 box-group">
                        <td width="400">
                            ต้องการใช้โต๊ะทำงานหรือไม่
                        </td>
                        <td width="100">
                            <input type="radio" id="answer4_no" name="answer4" ng-model="iForm.answer4" value="No" ng-disabled="iForm.answer4 != 'No'" /> <label for="answer4_no">ไม่ใช้</label>
                        </td>
                        <td width="240">
                            <input type="radio" id="answer4_yes" name="answer4" ng-model="iForm.answer4" value="Yes" ng-disabled="iForm.answer4 != 'Yes'" /> <label for="answer4_yes">ใช้ โปรดระบุบริเวณ</label>
                        </td>
                        <td>
                            <input ng-model="iForm.answer4_desc" class="form-text text-blue" maxlength="400" readonly />
                        </td>
                    </tr>
                    <tr class="answer5 box-group">
                        <td>
                            ต้องการเครื่องโทรศัพท์หรือไม่
                        </td>
                        <td>
                            <input type="radio" id="answer5_no" name="answer5" ng-model="iForm.answer5" value="No" ng-disabled="iForm.answer5 != 'No'" /> <label for="answer5_no">ไม่ใช้</label>
                        </td>
                        <td>
                            <input type="radio" id="answer5_yes" name="answer5" ng-model="iForm.answer5" value="Yes" ng-disabled="iForm.answer5 != 'Yes'" /> <label for="answer5_yes">ใช้ โปรดระบุหมายเลข</label>
                        </td>
                        <td>
                            <input ng-model="iForm.answer5_desc" class="form-text text-blue" maxlength="400" readonly />
                        </td>
                    </tr>
                </tbody>
            </table>
            @* section 4 *@
            <div class="fs-5 fw-bolder bg-gray mb-3 p-1">
                อุปกรณ์โทรศัพท์มือถือ
            </div>
            <table class="table table-borderless fs-5">
                <tbody>
                    <tr class="answer6 box-group">
                        <td width="400">
                            ต้องการเครื่องโทรศัพท์มือถือของบริษัท
                        </td>
                        <td width="140">
                            <input type="radio" id="answer6_no" name="answer6" ng-model="iForm.answer6" value="No" ng-disabled="iForm.answer6 != 'No'" /> <label for="answer6_no">ไม่ต้องการ</label>
                        </td>
                        <td width="300">
                            <input type="radio" id="answer6_yes" name="answer6" ng-model="iForm.answer6" value="Yes" ng-disabled="iForm.answer6 != 'Yes'" /> <label for="answer6_yes">ต้องการ โปรดระบุรุ่น</label>
                        </td>
                        <td>
                            <input ng-model="iForm.answer6_desc" class="form-text text-blue" maxlength="400" readonly />
                        </td>
                    </tr>
                    <tr class="answer7 box-group">
                        <td>
                            ต้องการ Sim โทรศัพท์มือถือของบริษัท
                        </td>
                        <td>
                            <input type="radio" id="answer7_no" name="answer7" ng-model="iForm.answer7" value="No" ng-disabled="iForm.answer7 != 'No'" /> <label for="answer7_no">ไม่ต้องการ</label>
                        </td>
                        <td>
                            <input type="radio" id="answer7_yes" name="answer7" ng-model="iForm.answer7" value="Yes" ng-disabled="iForm.answer7 != 'Yes'" /> <label for="answer7_yes">ต้องการ โปรดระบุ package @@</label>
                        </td>
                        <td class="text-nowrap d-flex">
                            <input ng-model="iForm.answer7_desc" class="form-text text-blue" maxlength="400" readonly /> / เดือน
                        </td>
                    </tr>
                </tbody>
            </table>
            @* section 5 *@
            <div class="fs-5 fw-bolder bg-gray mb-3 p-1">
                การเดินทาง
            </div>
            <table class="table table-borderless fs-5 mb-0">
                <tbody>
                    <tr class="answer8 box-group">
                        <td width="400">
                            ต้องการให้จัดหารถยนต์ของบริษัท
                        </td>
                        <td width="140">
                            <input type="radio" id="answer8_no" name="answer8" ng-model="iForm.answer8" value="No" ng-disabled="iForm.answer8 != 'No'" /> <label for="answer8_no">ไม่ต้องการ</label>
                        </td>
                        <td width="270">
                            <input type="radio" id="answer8_yes" name="answer8" ng-model="iForm.answer8" value="Yes" ng-disabled="iForm.answer8 != 'Yes'" /> <label for="answer8_yes">ต้องการ โปรดระบุรุ่น</label>
                        </td>
                        <td>
                            <input ng-model="iForm.answer8_desc" class="form-text text-blue" maxlength="400" readonly />
                        </td>
                    </tr>
                    <tr class="answer9 box-group">
                        <td>
                            ต้องการบัตรเติมน้ำมันรถยนต์
                        </td>
                        <td>
                            <input type="radio" id="answer9_no" name="answer9" ng-model="iForm.answer9" value="No" ng-disabled="iForm.answer9 != 'No'" /> <label for="answer9_no">ไม่ต้องการ</label>
                        </td>
                        <td>
                            <input type="radio" id="answer9_yes" name="answer9" ng-model="iForm.answer9" value="Yes" ng-disabled="iForm.answer9 != 'Yes'" /> <label for="answer9_yes">ต้องการ โปรดระบุ</label>
                        </td>
                        <td class="text-nowrap d-flex">
                            <input ng-model="iForm.answer9_desc" class="form-text text-blue" maxlength="400" readonly /> บาทหรือลิตร / เดือน
                        </td>
                    </tr>
                </tbody>
            </table>
            <div class="text-danger p-2 fs-5">หมายเหตุ: โปรดแนบเอกสารประจำรถยนต์มาให้ด้วย หากต้องการบัตรเติมน้ำมัน </div>
            @* section 6 *@
            <div class="fs-5 fw-bolder bg-gray mb-3 p-1">
                เรื่องอื่นๆ (หากมี)
            </div>
            <div class="text-blue" style="min-height:100px;">
                {{ iForm.description }}
            </div>
        </div>
    </div>
</div>
<script>
    app.controller('ServicePrepareEmployeeCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.iForm = {
            gls_system: ''
        };
        $scope.LoadDetail = function () {
            return new Promise((resolve) => {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/Form/FormPrepareEmployeeDetail',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    dataType: 'json',
                    cache: false,
                    data: JSON.stringify({
                        refId: $scope.refId
                    }),
                    success: function (result) {
                        $timeout(async function () {
                            $scope.iForm = result;
                            resolve(true);
                        }, 0);
                    }, error: function () {
                        resolve(false);
                    }
                });
            });
        }

        $scope.DownloadPDF = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Form/FormPrepareEmployeePDF',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                xhrFields: {
                    responseType: 'blob'
                },
                cache: false,
                data: JSON.stringify({
                    refId: $scope.refId
                }),
                success: function (response, status, xhr) {

                    var blob = new Blob(
                        [response],
                        { type: 'application/pdf' }
                    );

                    // ดึง filename จาก header
                    var disposition = xhr.getResponseHeader('Content-Disposition');

                    var fileName = 'FormPrepareEmployee.pdf';

                    if (disposition && disposition.indexOf('filename=') !== -1) {

                        fileName = disposition
                            .split('filename=')[1]
                            .replace(/"/g, '');
                    }

                    // create link download
                    var link = document.createElement('a');

                    link.href = window.URL.createObjectURL(blob);

                    link.download = fileName;

                    document.body.appendChild(link);

                    link.click();

                    document.body.removeChild(link);

                }, error: AjaxError
            });
        }

        $scope.init = async function (x) {
            $scope.refId = x.id;
            $scope.userId = x.userId;
            $scope.status = x.status;

            await $scope.LoadDetail();

            // register ไป parent
            $scope.formAction.DownloadPDF = $scope.DownloadPDF;
            $scope.formAction.can_download = 1;
        }

        $scope.$on('FORM_PREPARE_EMPLOYEE_LOAD', function (e, data) {
            $scope.init(data);
        });
    });
</script>