@{
    var token = User.AccessToken(Context);
}
<div ng-controller="ServiceNeedEmployeeCtrl" class="mb-4 text-dark">
    <div class="list-group-item px-0 d-flex" ng-repeat="x in lData">
        <div style="width:20px" class="me-2 fw-bolder">
            #{{ $index + 1 }}.
        </div>
        <div class="flex-fill">
            <div class="row">
                <div class="col-sm-8 mb-3">
                    <small class="text-decoration-underline">
                        บริษัท
                    </small>
                    <div class="fw-bolder">{{ x.company != '' ? x.company : '-' }}</div>
                </div>
                <div class="col-sm-2 mb-3">
                    <small class="text-decoration-underline">
                        วันที่เริ่ม
                    </small>
                    <div class="fw-bolder">{{ x.fromDate != '' ? x.fromDate : '-' }}</div>
                </div>
                <div class="col-sm-2 mb-3">
                    <small class="text-decoration-underline">
                        วันที่สิ้นสุด
                    </small>
                    <div class="fw-bolder">{{ x.endDate != '' ? x.endDate : '-' }}</div>
                </div>
                <div class="col-sm-8 mb-3">
                    <small class="text-decoration-underline">
                        ตำแหน่ง
                    </small>
                    <div class="fw-bolder">{{ x.position != '' ? x.position : '-' }}</div>
                </div>
                <div class="col-sm-12 mb-3">
                    <small class="text-decoration-underline">
                        รายละเอียดการทำงาน
                    </small>
                    <div class="fw-bolder">{{ x.description != '' ? x.description : '-' }}</div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    app.controller('ServiceNeedEmployeeCtrl', function ($scope, $http, $timeout, $filter) {

        $scope.LoadData = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/ServiceJobExperience/Detail',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    refId: $scope.refId
                }),
                success: function (result) {
                    $timeout(async function () {
                        $scope.lData = result;
                    }, 0);
                }, error: AjaxError
            });
        }

        $scope.$parent.LoadJobExperience = function (x) {
            $scope.refId = x.id;
            $scope.userId = x.userId;
            $scope.status = x.status;
            $scope.LoadData();
        }
    });
</script>