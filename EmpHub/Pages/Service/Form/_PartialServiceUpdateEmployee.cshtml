@{
    var token = User.AccessToken(Context);
}
<style>
    input[type="radio"]:disabled {
        background-color: #0d6efd !important;
        border-color: #0d6efd !important;
        background-image: none !important;
        opacity: 1 !important;
    }
</style>
<div ng-controller="ServiceUpdateEmployeeCtrl">
    <div class="bg-white rounded-4 border mb-4 overflow-hidden p-4">
        <div class="pb-3 mb-3 border-bottom d-flex align-items-center">
            <div class="fs-5 fw-bolder text-dark flex-fill">
                ปรับปรุงข้อมูลพนักงาน
            </div>
        </div>
        <div class="row">
            <div class="col-sm-4 mb-3">
                <div class="text-dark fw-bolder">วันเข้างาน</div>
                <div class="text-blue">{{ iForm.join_date == '' ? '-' : iForm.join_date }}</div>
            </div>
            <div class="col-sm-4 mb-3">
                <div class="text-dark fw-bolder">วันบรรจุงาน</div>
                <div class="text-blue">{{ iForm.probation_end_date == '' ? '-' : iForm.probation_end_date }}</div>
            </div>
            @* <div class="col-sm-4 mb-3">
                <div class="text-dark fw-bolder">สถานะ</div>
                <div>{{ iForm.employeeStatus == '' ? '-' : iForm.employeeStatus }}</div>
            </div> *@
            <div class="col-sm-4 mb-3">
                <div class="text-dark fw-bolder">อายุงาน</div>
                <div class="text-blue">{{ iForm.work_day == '' ? '-' : iForm.work_day }}</div>
            </div>
            <div class="col-sm-4 mb-3">
                <div class="text-dark fw-bolder">ฝ่าย</div>
                <div class="text-blue">{{ iForm.sectionCode == '' ? '-' : iForm.sectionCode }}</div>
            </div>
            <div class="col-sm-4 mb-3">
                <div class="text-dark fw-bolder">สายงาน</div>
                <div class="text-blue">{{ iForm.departmentCode == '' ? '-' : iForm.departmentCode }}</div>
            </div>
            <div class="col-sm-4 mb-3">
                <div class="text-dark fw-bolder">ด้าน</div>
                <div class="text-blue">{{ iForm.divisionCode == '' ? '-' : iForm.divisionCode }}</div>
            </div>
            <div class="col-sm-4 mb-3">
                <div class="text-dark fw-bolder">ระดับพนักงาน</div>
                <div class="text-blue">{{ iForm.levelCode == '' ? '-' : iForm.levelCode }}</div>
            </div>
            <div class="col-sm-4 mb-3">
                <div class="text-dark fw-bolder">ตำแหน่งงาน</div>
                <div class="text-blue">{{ iForm.positionCode == '' ? '-' : iForm.positionCode }}</div>
            </div>
            <div class="col-sm-4 mb-3">
                <div class="text-dark fw-bolder">เกรด</div>
                <div class="text-blue">{{ iForm.grade == '' ? '-' : iForm.grade }}</div>
            </div>
            <div class="col-sm-4 mb-3">
                <div class="text-dark fw-bolder">ประเภทพนักงาน</div>
                <div class="text-blue">{{ iForm.employeeType == '' ? '-' : iForm.employeeType }}</div>
            </div>
            <div class="col-sm-4 mb-3">
                <div class="text-dark fw-bolder">หัวหน้างาน</div>
                <div class="text-blue">{{ iForm.supervisorId == '' ? '-' : iForm.supervisorId }}</div>
            </div>
        </div>
    </div>
</div>
<script>
    app.controller('ServiceUpdateEmployeeCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.LoadDetail = function () {
            return new Promise((resolve) => {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/Form/FormUpdateEmployeeDetail',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    dataType: 'json',
                    cache: false,
                    data: JSON.stringify({
                        refId: $scope.refId
                    }),
                    success: function (result) {
                        $timeout(async function () {
                            $scope.iForm = result;
                            $scope.CalcWorkDay();

                            resolve(true);
                        }, 0);
                    }, error: function () {
                        resolve(false);
                    }
                });
            });
        }

        $scope.CalcWorkDay = function () {
            $scope.iForm.work_day = '';

            if ($scope.iForm.join_date != '') {
                const b = ConvertToDate($scope.iForm.join_date);
                const c = new Date();

                let years = c.getFullYear() - b.getFullYear();
                let months = c.getMonth() - b.getMonth();
                let days = c.getDate() - b.getDate();

                // ถ้าวันติดลบ → ยืมเดือน
                if (days < 0) {
                    months--;

                    // เอาจำนวนวันของเดือนก่อนหน้า
                    const prevMonth = new Date(c.getFullYear(), c.getMonth(), 0);
                    days += prevMonth.getDate();
                }

                // ถ้าเดือนติดลบ → ยืมปี
                if (months < 0) {
                    years--;
                    months += 12;
                }

                if (years > 0) {
                    $scope.iForm.work_day = years + ' ปี ';
                }
                if (months > 0) {
                    $scope.iForm.work_day += months + ' เดือน ';
                }
                if (days > 0) {
                    $scope.iForm.work_day += days + ' วัน';
                }
            }
        }

        $scope.init = async function (x) {
            $scope.refId = x.id;
            $scope.userId = x.userId;
            $scope.status = x.status;

            await $scope.LoadDetail();
        }

        $scope.$on('EDIT_EMPLOYEE_LOAD', function (e, data) {
            $scope.init(data);
        });
    });
</script>