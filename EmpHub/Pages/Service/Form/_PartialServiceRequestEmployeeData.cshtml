    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    var token = User.AccessToken(Context);
}
<div ng-controller="ServiceEmployeeDataCtrl">
    <div class="bg-white rounded-4 border mb-4 overflow-hidden">
        <div class="px-4 py-3 border-bottom d-flex align-items-center">
            <div class="fs-5 fw-bolder text-dark flex-fill">ขอข้อมูลพนักงาน</div>
        </div>
        <div class="p-4">
            <table class="table table-borderless">
                <tbody>
                    <tr>
                        <td>
                            <div class="text-dark text-nowrap fw-bolder">ข้อมูลที่ต้องการ</div>
                            <div class="text-dark text-nowrap">Require Field</div>
                        </td>
                        <td>
                            <div>
                                <input ng-model="iForm.is_username" name="is_username" type="checkbox" ng-true-value="1" ng-false-value="0" disabled />
                                <label>ชื่อผู้ใช้งาน</label>
                            </div>
                            <div>
                                <input ng-model="iForm.is_fullname_th" name="is_fullname_th" type="checkbox" ng-true-value="1" ng-false-value="0" disabled />
                                <label>ชื่อ-สกุล ภาษาไทย</label>
                            </div>
                            <div>
                                <input ng-model="iForm.is_fullname_en" name="is_fullname_en" type="checkbox" ng-true-value="1" ng-false-value="0" disabled />
                                <label>ชื่อ-สกุล ภาษาอังกฤษ</label>
                            </div>
                            <div>
                                <input ng-model="iForm.is_position" name="is_position" type="checkbox" ng-true-value="1" ng-false-value="0" disabled />
                                <label for="is_position">ตำแหน่ง</label>
                            </div>
                            <div>
                                <input ng-model="iForm.is_department" name="is_department" type="checkbox" ng-true-value="1" ng-false-value="0" disabled />
                                <label for="is_department">ฝ่ายงาน</label>
                            </div>
                            <div>
                                <input ng-model="iForm.is_email" name="is_email" type="checkbox" ng-true-value="1" ng-false-value="0" disabled />
                                <label for="is_email">อีเมล์</label>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <div class="text-dark text-nowrap fw-bolder">หมายเหตุ</div>
                            <div class="text-dark text-nowrap">Description</div>
                        </td>
                        <td>
                            <textarea ng-model="iForm.description" class="form-control description" rows=5 maxlength="2000"></textarea>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
<script>
    app.controller('ServiceEmployeeDataCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.LoadDetail = function () {
            return new Promise((resolve) => {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/Form/FormEmployeeDataDetail',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    dataType: 'json',
                    cache: false,
                    data: JSON.stringify({
                        refId: $scope.refId
                    }),
                    success: function (result) {
                        $timeout(async function () {
                            $scope.iForm = result;
                            resolve(true);
                        }, 0);
                    }, error: function () {
                        resolve(false);
                    }
                });
            });
        }

        $scope.init = async function (x) {
            $scope.refId = x.id;
            $scope.userId = x.userId;
            $scope.status = x.status;

            await $scope.LoadDetail();
        }

        $scope.$on('FORM_EMPLOYEE_DATA', function (e, data) {
            $scope.init(data);
        });
    });
</script>