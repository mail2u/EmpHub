@{
    var token = User.AccessToken(Context);
}
<style>
    input[type="radio"]:disabled {
        background-color: #0d6efd !important;
        border-color: #0d6efd !important;
        background-image: none !important;
        opacity: 1 !important;
    }
</style>
<div ng-controller="ServiceProbationReportCtrl">
    <div class="bg-white rounded-4 border mb-4 overflow-hidden p-4">
        <div class="px-4 py-3 border-bottom d-flex align-items-center">
            <div class="fs-5 fw-bolder text-dark flex-fill">
                แบบรายงานผลการปฏิบัติงานช่วงระยะเวลาทดลองงาน
            </div>
        </div>
        <div class="p-4 fs-6 text-dark">
            <div class="fs-5 mb-4">
                <span style="padding-left:100px"></span>
                ข้าพเจ้า (นาย/นาง/นางสาว) <input ng-model="iForm.fullname" class="form-text fullname text-blue" style="width:400px" maxlength="100" readonly /> ได้รับอนุมัติจากบริษัทฯ ให้ดำเนินการ
                ปฏิบัติงานเป็นเวลา <input ng-model="iForm.period" class="form-text period text-blue" style="width:100px" maxlength="50" readonly /> เดือน/ วัน
                โดยเริ่มเข้าปฏิบัติงานตั้งแต่วันที่ <input ng-model="iForm.join_date" class="form-text join_date date text-blue" style="width:100px" maxlength="50" readonly />
                ในตำแหน่ง <input ng-model="iForm.position" class="form-text position text-blue" style="width:300px" maxlength="50" readonly />
                สังกัดสายงาน/ฝ่าย <input ng-model="iForm.department" class="form-text department text-blue" style="width:400px" maxlength="50" readonly />
            </div>
            <div class="fs-5 my-3 bg-light p-3">
                โปรดบันทึกรายงานการปฏิบัติงานของท่านในช่วงระหว่างทดลองงานโดยละเอียดตามข้อเท็จจริง เพื่อนำไปประกอบการประเมินผลการปฏิบัติงานในช่วงระยะเวลาทดลองงาน เพื่อพิจารณาบรรจุเป็นพนักงานประจำต่อไป
            </div>
            <div class="fs-5 mb-3">
                1.	ลักษณะหน้าที่ที่ได้รับมอบหมาย
                <div class="text-blue" style="min-height:200px">
                    {{ iForm.answer1 }}
                </div>
            </div>
            <div class="fs-5 mb-3">
                2.	ผู้บังคับบัญชาโดยตรงของท่าน คือ
                <div class="text-blue">
                    {{ iForm.answer2 }}
                </div>
            </div>
            <div class="fs-5 mb-3">
                3.	หน้าที่และความรับผิดชอบหลักที่ปฏิบัติจริง
                <div class="text-blue" style="min-height:200px">
                    {{ iForm.answer3 }}
                </div>
            </div>
            <div class="fs-5 mb-3">
                4.	หน้าที่และความรับผิดชอบพิเศษ ที่ท่านได้รับมอบหมายและได้ปฏิบัติจริง
                <div class="text-blue" style="min-height:200px">
                    {{ iForm.answer4 }}
                </div>
            </div>
            <div class="fs-5 mb-3">
                5.	ปัญหาและอุปสรรคในการปฏิบัติงานช่วงระหว่างการทดลองงาน
                <div class="text-blue" style="min-height:200px">
                    {{ iForm.answer5 }}
                </div>
            </div>
            <div class="fs-5 mb-3">
                การแก้ไข
                <div class="text-blue" style="min-height:200px">
                    {{ iForm.answer5_fixed }}
                </div>
            </div>
            <div class="fs-5 mb-3">
                6.	ปัญหาและอุปสรรคระหว่างเพื่อนร่วมงาน
                <div class="text-blue" style="min-height:200px">
                    {{ iForm.answer6 }}
                </div>
            </div>
            <div class="fs-5 mb-3">
                การแก้ไข
                <div class="text-blue" style="min-height:200px">
                    {{ iForm.answer6_fixed }}
                </div>
            </div>
            <div class="fs-5 mb-3">
                7.	ความคิดเห็นโดยทั่วไป ในการปฏิบัติงานช่วงระยะเวลาทดลองงานของท่านที่เกี่ยวข้องกับทางบริษัทฯ เพื่อใช้ประกอบการพิจารณาบรรจุเข้าเป็นพนักงานประจำ
                <div class="text-blue" style="min-height:200px">
                    {{ iForm.answer7 }}
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    app.controller('ServiceProbationReportCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.LoadDetail = function () {
            return new Promise((resolve) => {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/Form/FormProbationReportDetail',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    dataType: 'json',
                    cache: false,
                    data: JSON.stringify({
                        refId: $scope.refId
                    }),
                    success: function (result) {
                        $timeout(async function () {
                            $scope.iForm = result;
                            resolve(true);
                        }, 0);
                    }, error: function () {
                        resolve(false);
                    }
                });
            });
        }

        $scope.DownloadPDF = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Form/FormProbationReportPDF',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                xhrFields: {
                    responseType: 'blob'
                },
                cache: false,
                data: JSON.stringify({
                    refId: $scope.refId
                }),
                success: function (response, status, xhr) {

                    var blob = new Blob(
                        [response],
                        { type: 'application/pdf' }
                    );

                    // ดึง filename จาก header
                    var disposition = xhr.getResponseHeader('Content-Disposition');

                    var fileName = 'FormProbationReport.pdf';

                    if (disposition && disposition.indexOf('filename=') !== -1) {

                        fileName = disposition
                            .split('filename=')[1]
                            .replace(/"/g, '');
                    }

                    // create link download
                    var link = document.createElement('a');

                    link.href = window.URL.createObjectURL(blob);

                    link.download = fileName;

                    document.body.appendChild(link);

                    link.click();

                    document.body.removeChild(link);

                }, error: AjaxError
            });
        }

        $scope.init = async function (x) {
            $scope.refId = x.id;
            $scope.userId = x.userId;
            $scope.status = x.status;

            await $scope.LoadDetail();

            // register ไป parent
            $scope.formAction.DownloadPDF = $scope.DownloadPDF;
            $scope.formAction.can_download = 1;
        }

        $scope.$on('FORM_PROBATION_REPORT_LOAD', function (e, data) {
            $scope.init(data);
        });
    });
</script>