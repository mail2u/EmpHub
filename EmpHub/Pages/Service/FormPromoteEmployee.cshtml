@page
@model EmpHub.Pages.Service.FormPromoteEmployeeModel
@{
    var token = User.AccessToken(HttpContext);
}
<style>
    .main-content {
        min-height: calc(100vh - 150px) !important;
    }

    .box-group {
        padding: 15px;
        border: 1px solid white;
        border-radius: 15px;
    }

        .box-group.input-error {
            border: 1px solid red;
        }
</style>
<div ng-controller="FormCtrl" id="tab_education">
    @* Header *@
    <partial name="_PartialFormHeader" />
    @* View *@
    <div class="rounded-4 mb-3 bg-white shadow-sm text-dark" style="padding:25px 120px;">
        <div class="text-center fs-4 fw-bolder mb-4 text-dark">
            แบบเสนอขอปรับเลื่อนตาแหน่งงานบุคลากร
        </div>
        <div class="fs-5 fw-bolder mb-4 bg-light p-2">
            ข้อมูลบุคลากรที่ขอเสนอปรับเลื่อนตาแหน่งงาน
        </div>
        <div class="row fs-5">
            <div class="col-sm-6 mb-3 d-flex">
                <div class="text-nowrap me-2">ชื่อ-สกุล</div><input ng-model="iForm.fullname" class="form-text fullname" maxlength="100" />
            </div>
            <div class="col-sm-6 mb-3 d-flex">
                <div class="text-nowrap me-2">ตำแหน่ง</div><input ng-model="iForm.position" class="form-text position" maxlength="50" />
            </div>
            <div class="col-sm-6 mb-3 d-flex">
                <div class="text-nowrap me-2">ส่วน</div><input ng-model="iForm.section" class="form-text section" maxlength="50" />
            </div>
            <div class="col-sm-6 mb-3 d-flex">
                <div class="text-nowrap me-2">ฝ่าย</div><input ng-model="iForm.department" class="form-text department" maxlength="50" />
            </div>
            <div class="col-sm-6 mb-3 d-flex">
                <div class="text-nowrap me-2">วันที่เริ่มงาน</div>
                <input class="form-text icon-calendar join_date date mx-2"
                       ng-model="iForm.join_date_select"
                       ng-model-options="{ updateOn: 'blur' }"
                       moment-picker="iForm.join_date_select"
                       locale="th"
                       format="DD/MM/YYYY"
                       min-view="month"
                       max-view="month" required change="CalcAge()" />
            </div>
            <div class="col-sm-6 mb-3 d-flex">
                <div class="text-nowrap me-2">อายุงาน (ปี)</div><div class="text-blue">{{ iForm.year }}</div>
            </div>
            <div class="col-sm-12 mb-3 d-flex text-nowrap">
                <div class="text-nowrap me-2">ผลการปฏิบัติงานของบุคลากร 2 ปี ย้อนหลัง :</div> 
                <div class="fw-bolder text-decoration-underline text-nowrap me-2">ย้อนหลัง 1 ปี</div> ได้เกรด <input ng-model="iForm.grade1" class="form-text text-center grade1 mx-2" style="width:50px" maxlength="2" />
                <div class="fw-bolder text-decoration-underline text-nowrap me-2">ย้อนหลัง 2 ปี</div> ได้เกรด <input ng-model="iForm.grade2" class="form-text text-center grade2 mx-2" style="width:50px" maxlength="2" />
            </div>
        </div>
        <div class="fs-5 mb-4">
            เห็นสมควรเรียนเสนอ เพื่อพิจารณา <b>ปรับเลื่อนตาแหน่งงาน</b> บุคลากร ดังนี้
        </div>
        <div class="fs-5 mb-4">
            <table class="table table-bolder">
                <thead>
                    <tr class="">
                        <td class="fw-bolder bg-light" width="200">เปลี่ยนแปลงจาก</td>
                        <td class="fw-bolder bg-light text-center">ตำแหน่งงาน</td>
                        <td class="fw-bolder bg-light text-center">ฝ่าย</td>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="align-middle">ปัจจุบัน</td>
                        <td>
                            <input ng-model="iForm.position_current" class="form-control position_current" />
                        </td>
                        <td>
                            <input ng-model="iForm.department_current" class="form-control department_current" />
                        </td>
                    </tr>
                    <tr>
                        <td class="align-middle">ใหม่</td>
                        <td>
                            <input ng-model="iForm.position_new" class="form-control position_new" />
                        </td>
                        <td>
                            <input ng-model="iForm.department_new" class="form-control department_new" />
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="fs-5 fw-bolder mb-3">
            เหตุผลที่เสนอปรับเลื่อนตาแหน่งงาน
        </div>
        <textarea ng-model="iForm.description" class="form-control description" rows="5" maxlength="4000"></textarea>
    </div>
    <div class="d-flex justify-content-end">
        <div class="btn btn-primary" ng-click="Save()">
            <i class="far fa-paper-plane me-2"></i> Send Request
        </div>
    </div>
</div>
