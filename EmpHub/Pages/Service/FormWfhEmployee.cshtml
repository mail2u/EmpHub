@page
@model EmpHub.Pages.Service.FormWfhEmployeeModel
@{
    var token = User.AccessToken(HttpContext);
}
<style>
    .main-content {
        min-height: calc(100vh - 150px) !important;
    }

    .box-group {
        padding: 15px;
        border: 1px solid white;
        border-radius: 15px;
    }

        .box-group.input-error {
            border: 1px solid red;
        }
</style>
<div ng-controller="FormCtrl" id="tab_education">
    @* Header *@
    <partial name="_PartialFormHeader" />
    @* View *@
    <div class="rounded-4 mb-3 bg-white shadow-sm text-dark" style="padding:25px 120px;">
        <div class="text-center fs-4 fw-bolder mb-4 text-dark">
            ข้อตกลงทำงานนอกสถานประกอบกิจการ<br />
            หรือนอกสำนักงานของนายจ้างหรือทำงานผ่านการใช้เทคโนโลยีสารสนเทศในสถานที่ใด ๆ
        </div>
        <div class="fs-5 mb-3">
            <span style="padding-left:100px"></span>
            ข้อตกลงนี้ ทำขึ้นเพื่อการปฏิบัติงานนอกสถานประกอบกิจการหรือนอกสำนักงานของนายจ้าง/ทำงานผ่านการใช้เทคโนโลยีสารสนเทศในสถานที่ใด ๆ
            ระหว่าง <b>บริษัท ทิพยประกันชีวิต จำกัด (มหาชน)</b> โดย นายนพพร บุญลาโภ ผู้รับมอบอำนาจกระทำการแทนนายจ้าง สำนักงานตั้งอยู่เลขที่ 63/2 อาคาร
            บมจ.ทิพยประกันภัย ชั้น 1, 3, 4, 5 และ 6 ถนนพระราม 9 แขวงห้วยขวาง เขตห้วยขวาง กรุงเทพมหานคร 10310 ซึ่งต่อไปในข้อตกลงนี้เรียกว่า <b>“นายจ้าง”</b> 
            ฝ่ายหนึ่ง กับ นาย/นาง/นางสาว  <input ng-model="iForm.fullname" class="form-text fullname" style="width:400px" maxlength="100" /> ซึ่งต่อไปในข้อตกลงนี้เรียกว่า <b>“ลูกจ้าง”</b> อีกฝ่ายหนึ่ง
        </div>
        <div class="fs-5 mb-3">
            <span style="padding-left:100px"></span>
            นายจ้างและลูกจ้างได้ตกลงกันมีข้อความดังต่อไปนี้
        </div>
        <div class="fs-5 answer1 box-group">
            <span style="padding-left:100px"></span>
            ข้อ 1 นายจ้างและลูกจ้างตกลงทำงาน
            <div>
                <span style="padding-left:150px"></span>
                <input type="radio" name="answer1" ng-model="iForm.answer1" value="home"/>
                ที่บ้านหรือที่พักอาศัยของลูกจ้าง ตั้งอยู่เลขที่
                <input ng-model="iForm.address" class="form-text address ms-2" style="width:500px" maxlength="200" />
            </div>
            <div>
                <span style="padding-left:150px"></span>
                <input type="radio" name="answer1" ng-model="iForm.answer1" value="other" />
                ใช้เทคโนโลยีสารสนเทศในสถานที่ใด ๆ
            </div>
        </div>
        <div class="fs-5">
            <span style="padding-left:100px"></span>
            ข้อ 2 ระยะเวลาการทำงานที่ตกลงกัน ให้เป็นไปตามระเบียบว่าด้วยการปฏิบัติงานจากที่พักอาศัยฯ พ.ศ. 2567 โดยเริ่มตั้งแต่วันที่ 
            <input class="form-text icon-calendar start_date date"
                ng-model="iForm.start_date_select"
                ng-model-options="{ updateOn: 'blur' }"
                moment-picker="iForm.start_date_select"
                locale="th"
                format="DD/MM/YYYY"
                min-view="month"
                max-view="month" required style="width:150px;" /> เป็นต้นไป
            ทั้งนี้ รายละเอียดระยะเวลาการทำงานอาจมีการเปลี่ยนแปลงได้ในอนาคต โดยนายจ้างจะแจ้งให้ลูกจ้างทราบเมื่อมีการเปลี่ยนแปลง และหากมีการยกเลิกระเบียบว่าด้วยการ
            ปฏิบัติงานจากที่พักอาศัย ให้ถือว่าเป็นการยกเลิกข้อตกลงนี้โดยปริยาย
        </div>
        <div class="fs-5">
            <span style="padding-left:100px"></span>
            ข้อ 3 วันเวลาทำงาน เวลาพัก ณ แผนก/ฝ่ายงานที่ลูกจ้างทำงานอยู่ก่อนทำข้อตกลงนี้ถือเป็นวันทำงานปกติ เวลาทำงานปกติ เวลาพัก ของลูกจ้างขณะ
            ทำงาน ณ ที่บ้านหรือที่พักอาศัยของลูกจ้าง ในกรณีลูกจ้างไม่สามารถทำงานได้ในวันและเวลาใด ให้ลูกจ้างแจ้งให้นายจ้างทราบทุกครั้ง โดยแจ้งผ่านระบบ HUMATRIX
            ให้ทราบโดยเร็ว ทั้งนี้ ตามระเบียบข้อบังคับเกี่ยวกับการทำงานของนายจ้าง หรือตามที่นายจ้างและลูกจ้างตกลงกัน
        </div>
        <div class="fs-5">
            <span style="padding-left:100px"></span>
            ข้อ 4 การลงเวลาเข้าทำงานและลงเวลาออกทำงานในแต่ละวัน ลูกจ้างจะต้องลงเวลาทำงานตามหลักเกณฑ์ที่กำหนดไว้ในระเบียบ ว่าด้วยการปฏิบัติงานจากที่พักอาศัยฯ พ.ศ. 2567
        </div>
        <div class="fs-5">
            <span style="padding-left:100px"></span>
            ข้อ 5 กรณีการทำงานล่วงเวลาและการทำงานในวันหยุดจะต้องได้รับความยินยอมจากลูกจ้างก่อนเป็นคราว ๆ ไป
        </div>
        <div class="fs-5">
            <span style="padding-left:100px"></span>
            ข้อ 6 วิธีการลาและการอนุญาตการลาประเภทต่าง ๆ ให้เป็นไปตามกฎ ระเบียบ ข้อบังคับ เกี่ยวกับการทำงานของนายจ้าง เหมือนลูกจ้าง
            ปฏิบัติงานในสถานประกอบกิจการหรือในสำนักงานของนายจ้าง
        </div>
        <div class="fs-5">
            <span style="padding-left:100px"></span>
            ข้อ 7 ขอบเขตหน้าที่การทำงานของลูกจ้าง
            <div>
                <span style="padding-left:150px"></span>
                7.1 ระหว่างลูกจ้างทำงาน ณ สถานที่ตกลง ให้ลูกจ้างปฏิบัติงานตามที่ได้รับมอบหมายให้เป็นไปตามที่นายจ้างกำหนด
            </div>
            <div>
                <span style="padding-left:150px"></span>
                7.2 ในระหว่างที่ลูกจ้างทำงานตามข้อตกลงนี้ ให้ผู้บังคับบัญชาสูงสุดของหน่วยงานเป็นหัวหน้างานผู้ควบคุมงาน หรือตรวจงาน การทำงานของลูกจ้าง
            </div>
        </div>
        <div class="fs-5">
            <span style="padding-left:100px"></span>
            ข้อ 8 การจัดหาเครื่องมือหรืออุปกรณ์การทำงานรวมทั้งค่าใช้จ่ายต่าง ๆ ที่จำเป็น อันเนื่องจากการทำงาน ให้เป็นไปตามที่กำหนดไว้ในระเบียบ
            ว่าด้วย การปฏิบัติงานจากที่พักอาศัยฯ พ.ศ. 2567
        </div>
        <div class="fs-5 mb-3 answer2 box-group p-0">
            <span style="padding-left:100px"></span>
            ข้อ 9 การยินยอมในการติดต่อสื่อสารนอกเวลาการทำงาน
            <input type="radio" name="answer2" ng-model="iForm.answer2" value="Yes" /> <b>ยินยอม</b>
            <input type="radio" name="answer2" ng-model="iForm.answer2" value="No" /> <b>ไม่ยินยอม</b>
            <div>
                <span style="padding-left:150px"></span>
                ทั้งนี้ ไม่ใช่การทำงานล่วงเวลาและการทำงานในวันหยุดตามข้อ 5
            </div>
        </div>
        <div class="fs-5">
            <span style="padding-left:100px"></span>
            ข้อ 10 บรรดาสิทธิใด ๆ ที่ลูกจ้างมีสิทธิได้รับอยู่ก่อนทำข้อตกลงนี้ ลูกจ้างยังคงมีสิทธิได้รับเช่นเดิม
        </div>
        <div class="fs-5">
            <span style="padding-left:100px"></span>
            ข้อ 11 นอกจากข้อตกลงนี้ ลูกจ้างจะต้องปฏิบัติตามกฎ ระเบียบ ข้อบังคับเกี่ยวกับการทำงานของนายจ้าง และคำสั่งอันชอบด้วยกฎหมายของ
            นายจ้างเช่นเดียวกับที่ลูกจ้างทำงานในสถานประกอบกิจการหรือในสำนักงานของนายจ้างโดยเคร่งครัด หากลูกจ้างฝ่าฝืนหรือไม่ปฏิบัติตาม นายจ้าง
            จะพิจารณาตามกฎ ระเบียบ ข้อบังคับเกี่ยวกับการทำงานของนายจ้าง
        </div>
        <div class="fs-5 mb-3">
            <span style="padding-left:100px"></span>
            ข้อ 12 ข้อตกลงฉบับนี้สิ้นสุดลง เมื่อครบระยะเวลาตามที่กำหนดหรือนายจ้างและลูกจ้างตกลงกัน
        </div>
        <div class="fs-5">
            <span style="padding-left:100px"></span>
            นายจ้างและลูกจ้างได้อ่านข้อตกลงฉบับนี้โดยละเอียดตลอดแล้ว เข้าใจถูกต้องตรงประสงค์ และขอรับรองว่าเป็นความจริงทุกประการจึงได้ลงลายมือชื่อ พร้อมทั้งประทับตรา (ถ้ามี) ไว้เป็นสำคัญต่อหน้าพยาน
        </div>
    </div>
    <div class="d-flex justify-content-end">
        <div class="btn btn-primary" ng-click="Save()">
            <i class="far fa-paper-plane me-2"></i> Send Request
        </div>
    </div>
</div>
<script>
    $(".day").mask("00");
    $(".score").mask("00");
    $(".date").mask("00/00/0000");
    app.controller('FormCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.mode = '@Model.mode';
        $scope.iData = {};
        $scope.iForm = {
            fullname:''
            , address:''
            , start_date:''
            , answer1: ''
            , answer2: ''
            , create_by:'@User.UserId()'
        }

        $scope.Validate = function () {
            var flag = true;
            JS_Reset($(".fullname"));
            JS_Reset($(".address"));
            JS_Reset($(".start_date"));
            JS_Reset($(".answer1"));
            JS_Reset($(".answer2"));


            if($scope.iForm.start_date_select){
                $scope.iForm.start_date = $scope.iForm.start_date_select.format("DD/MM/YYYY");
            }else{
                $scope.iForm.start_date = '';
            }

            if ($scope.iForm.fullname == '') {
                flag = false;
                JS_Require($(".fullname"));
            }
            if ($scope.iForm.address == '' && $scope.iForm.answer1 == 'home') {
                flag = false;
                JS_Require($(".address"));
            }
            if ($scope.iForm.start_date == '') {
                flag = false;
                JS_Require($(".start_date"));
            }
            if ($scope.iForm.answer1 == '') {
                flag = false;
                JS_Require($(".answer1"));
            }
            if ($scope.iForm.answer2 == '') {
                flag = false;
                JS_Require($(".answer2"));
            }

            return flag;
        }

        $scope.Save = async function () {
            if ($scope.Validate()) {
                alertConfirm("ยืนยันการทำรายการ", "ท่านต้องการส่งใบคำขอ", async function () {
                    var id = await $scope.CreateService();

                    if (id) {
                        $scope.iData.id = id;
                        $scope.iForm.refId = id;

                        var flag = await $scope.CreateForm();

                        if (flag) {
                            var serviceNo = await $scope.ServiceRequest();

                            if (serviceNo) {
                                alertSuccess("ทำรายการสำเร็จ", "ระบบบันทึกใบคำขอของท่านเรียบร้อย", function () {
                                    location.href = '@Url.Page("/Service/Index")';
                                });
                            } else {
                                $scope.CancelService();
                            }
                        } else {
                            $scope.CancelService();
                        }
                    }
                });
            } else {
                alertWarning("แจ้งเตือน", "กรุณากรอกข้อมูลให้ครบ");
            }
        }

        $scope.CreateForm = function () {
            return new Promise((resolve) => {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/Form/FormWfhEmployeeCreate',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    cache: false,
                    data: JSON.stringify($scope.iForm),
                    success: function () {
                        $timeout(async function () {
                            resolve(true);
                        }, 0);
                    }, error: function (jqXHR, error, errorThrown) {
                        resolve(null);
                        Swal.fire({
                            title: "ระบบเกิดข้อผิดพลาด",
                            text: jqXHR.responseText,
                            icon: "error",
                            confirmButtonColor: '#1e3b92',
                        });
                    }
                });
            });
        }
    });
</script>