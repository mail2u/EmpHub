@page
@model EmpHub.Pages.Service.DetailModel
@{
    var token = User.AccessToken(HttpContext);
}
<div ng-controller="ServiceCtrl">
    <div class="container-fluid">
        <div class="bg-white p-4 rounded-4 border border-secondary">
            <div class="row">
                <div class="col-sm-3 mb-3">
                    <div class="text-center p-3">
                        <img src="~/Images/icon-user.png" class="rounded-pill mb-3" width="70%" />
                    </div>
                    <div class="mb-3">
                        <small class="text-gray">
                            ชื่อ-สกุล
                        </small>
                        <div class="fw-bolder text-secondary">
                            {{ iData.userName }}
                        </div>
                    </div>
                    <div class="mb-3">
                        <small class="text-gray">
                            ตำแหน่ง
                        </small>
                        <div class="fw-bolder text-secondary">
                            {{ iData.userPosition }}
                        </div>
                    </div>
                    <div class="mb-3">
                        <small class="text-gray">
                            ฝ่าย/ส่วนงาน
                        </small>
                        <div class="fw-bolder text-secondary">
                            {{ iData.userDepartment }}
                        </div>
                    </div>
                </div>
                <div class="col-sm-9">
                    <div class="mb-3 d-flex">
                        <div class="me-4">
                            <small class="text-gray">
                                เลขบริการ
                            </small>
                            <div class="fw-bolder fs-4 text-secondary">
                                {{ iData.serviceNo }}
                            </div>
                        </div>
                        <div class="me-4 flex-fill">
                            <small class="text-gray">
                                ความประสงค์
                            </small>
                            <div class="fw-bolder fs-4 text-secondary">
                                {{ iData.categoryDesc }}
                            </div>
                        </div>
                        <div class="me-4">
                            <small class="text-gray">
                                สถานะ
                            </small>
                            <div class="fw-bolder fs-4 text-secondary">
                                <i class="bi bi-check2-circle text-green" ng-show="iData.status == 'Approve'"></i> 
                                <i class="bi bi-x-circle text-danger" ng-show="iData.status == 'Reject'"></i>
                                <i class="bi bi-record-circle text-blue" ng-show="iData.status == 'Pending'"></i>
                                {{ iData.statusDesc }}
                            </div>
                            <div ng-show="iData.status == 'Approve'" class="text-secondary">
                                <div class="fw-bolder">
                                    <i class="bi bi-person-circle"></i> {{ iData.approveName }}
                                </div>
                                <i class="bi bi-clock"></i> {{ iData.approveDate }}
                            </div>
                            <div ng-show="iData.status == 'Reject'" class="text-secondary">
                                <div class="fw-bolder">
                                    <i class="bi bi-person-circle"></i> {{ iData.rejectName }}
                                </div>
                                <i class="bi bi-clock"></i> {{ iData.rejectDate }}
                                <div>
                                    หมายเหตุ : {{ iData.rejectDesc != '' ? iData.rejectDesc : '-' }}
                                </div>
                            </div>
                        </div>
                    </div>
                    <div ng-show="iData.categoryCode == 'changeAddress'">
                        <partial name="_PartialServiceAddress" />
                    </div>
                    <div ng-show="iData.categoryCode == 'changeEducation'">
                        <partial name="_PartialServiceEducation" />
                    </div>
                    <div ng-show="iData.categoryCode == 'changeEmployee'">
                        <partial name="_PartialServiceEmployee" />
                    </div>
                    <div ng-show="iData.categoryCode == 'changeJobExperience'">
                        <partial name="_PartialServiceJobExperience" />
                    </div>
                    <div ng-show="iData.categoryCode == 'changePersonal'">
                        <partial name="_PartialServicePersonal" />
                    </div>
                    <div ng-show="iData.categoryCode == 'changeTraning'">
                        <partial name="_PartialServiceTraning" />
                    </div>
                    <div class="d-flex pt-4">
                        <div ng-show="iData.can_approve == 1" class="btn btn-success me-2" ng-click="Approve()" style="width:120px;">
                            <i class="bi bi-check2-circle"></i> อนุมัติ
                        </div>
                        <div ng-show="iData.can_approve == 1" class="btn btn-danger-invert me-2" ng-click="Reject()" style="width:120px;">
                            ไม่อนุมัติ
                        </div>
                        <div ng-show="iData.can_cancel == 1" class="btn btn-warning-invert me-2" ng-click="Cancel()" style="width:120px;">
                            ยกเลิก
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    app.controller('ServiceCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.id = '@Model.id';

        $scope.LoadData = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Service/Detail',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    id: $scope.id
                    , userBy: '@User.UserId()'
                }),
                success: function (result) {
                    $timeout(function () {
                        $scope.iData = result;

                        if ($scope.iData.categoryCode == 'changeAddress') {
                            $scope.LoadAddress($scope.iData);
                        }
                        else if ($scope.iData.categoryCode == 'changeEducation') {
                            $scope.LoadEducation($scope.iData);
                        }
                        else if ($scope.iData.categoryCode == 'changeEmployee') {
                            $scope.LoadEmployee($scope.iData);
                        }
                        else if ($scope.iData.categoryCode == 'changeJobExperience') {
                            $scope.LoadJobExperience($scope.iData);
                        }
                        else if ($scope.iData.categoryCode == 'changePersonal') {
                            $scope.LoadPersonal($scope.iData);
                        }
                        else if ($scope.iData.categoryCode == 'changeTraning') {
                            $scope.LoadTraning($scope.iData);
                        }
                    }, 0);
                },
                error: AjaxError
            });
        }
        $scope.LoadData();


        $scope.Approve = function () {
            alertConfirm("อนุมัติ", "ยืนยันการอนุมัติรายการ", function () {
                showPreloader();
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/Service/Approve',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    cache: false,
                    data: JSON.stringify({
                        id: $scope.id
                        , userBy: '@User.UserId()'
                    }),
                    success: function (result) {
                        $timeout(function () {
                            hidePreloader();

                            alertSuccess("อนุมัติรายการสำเร็จ", "บันทึกการทำรายการเรียบร้อยแล้ว", () => {
                                if (window.opener && typeof window.opener.ReloadApprove === 'function') {
                                    if (!window.opener.ReloadApprove()) { window.opener.ReloadApprove(); }
                                }
                                window.close();
                                $scope.LoadData();
                            });
                        }, 0);
                    },
                    error: AjaxError
                });
            });
        }

        $scope.Reject = async function () {
            const result = await Swal.fire({
                title: "ยืนยันปฏิเสธรายการ",
                input: "textarea",
                inputPlaceholder: "กรุณาระบุเหตุผล",
                confirmButtonText: "ยืนยัน",
                cancelButtonText: "ปิด",
                showCancelButton: true
            });

            if (result.isConfirmed) {
                if (result.value) {
                    showPreloader();

                    $.ajax({
                        url: '@webAPI.CurrentValue.APIEmpHub/api/Service/Reject',
                        headers: { 'authorization': 'Bearer @token' },
                        type: "POST",
                        contentType: 'application/json',
                        cache: false,
                        data: JSON.stringify({
                            id: $scope.id
                            , userBy: '@User.UserId()'
                            , description : result.value
                        }),
                        success: function () {
                            $timeout(function () {
                                hidePreloader();

                                alertSuccess("ปฏิเสธรายการสำเร็จ", "บันทึกการทำรายการเรียบร้อยแล้ว", () => {
                                    if (window.opener && typeof window.opener.ReloadApprove === 'function') {
                                        if (!window.opener.ReloadApprove()) { window.opener.ReloadApprove(); }
                                    }
                                    window.close();
                                    $scope.LoadData();
                                });
                            }, 0);
                        },
                        error: AjaxError
                    });
                }
            }
        }

        $scope.Cancel = function () {
            alertConfirm("ยกเลิก", "ยืนยันการยกเลิกรายการ", function () {
                showPreloader();

                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/Service/Cancel',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    cache: false,
                    data: JSON.stringify({
                        id: $scope.id
                        , userBy: '@User.UserId()'
                    }),
                    success: function (result) {
                        $timeout(function () {
                            hidePreloader();

                            alertSuccess("ยกเลิกรายการสำเร็จ", "บันทึกการทำรายการเรียบร้อยแล้ว", () => {
                                if (window.opener && typeof window.opener.ReloadRequest === 'function') {
                                    if (!window.opener.ReloadRequest()) { window.opener.ReloadRequest(); }
                                }
                                window.close();
                                $scope.LoadData();
                            });
                        }, 0);
                    },
                    error: AjaxError
                });
            });
        }
    });
</script>