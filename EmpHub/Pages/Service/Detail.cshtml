@page
@model EmpHub.Pages.Service.DetailModel
@{
    var token = User.AccessToken(HttpContext);
}
<style>
    .nxl-container .nxl-content .main-content {
        padding:0px;
    }
    
</style>


<div ng-controller="ServiceCtrl">
    <div class="page-header">
        <div class="page-header-left d-flex align-items-center w-100">
            <div class="px-4 py-2 flex-fill">
                <ul class="breadcrumb mb-2">
                    <li class="breadcrumb-item"><a href="@Url.Page("Index")">Requests</a></li>
                    <li class="breadcrumb-item">{{ iData.serviceNo }}</li>
                </ul>
                <div class="fs-5 fw-bolder text-dark">{{ iData.categoryDesc }} #{{ iData.serviceNo }}</div>
                <div class="d-flex">
                    <div class="badge badge-{{iData.status}}">{{ iData.statusDesc }}</div><i class="bi bi-dot"></i><div class="small">Submitted {{ iData.createDate }}</div>
                </div>
            </div>
            <div class="btn btn-light me-2">
                <i class="bi bi-clock-history me-2"></i> View History
            </div>
            <div class="btn btn-light">
                <i class="bi bi-printer-fill"></i>
            </div>
        </div>
    </div>
    <div class="p-4 m-2">
        <div class="d-flex">
            <div class="flex-fill me-4">
                <div ng-show="iData.subCategoryCode == 'EDIT_PROFILE'">
                    <partial name="_PartialServiceProfile" />
                </div>
                <div ng-show="iData.subCategoryCode == 'FORM_NEED_NEW_CARD'">
                    <partial name="_PartialServiceNewCard" />
                </div>
                <div ng-show="iData.subCategoryCode == 'FORM_PARKING_STICKER'">
                    <partial name="_PartialServiceParkingSticker" />
                </div>
                <div ng-show="iData.subCategoryCode == 'FORM_BUY_UNIFORM'">
                    <partial name="_PartialServiceBuyUniform" />
                </div>
                <div ng-show="iData.subCategoryCode == 'FORM_RESET_PASSWORD'">
                    <partial name="_PartialServiceResetPassword" />
                </div>
                <div ng-show="iData.subCategoryCode == 'FORM_SALARY_CERTIFICATE'">
                    <partial name="_PartialServiceSalaryCertificate" />
                </div>
                <div ng-show="iData.subCategoryCode == 'FORM_EMPLOYEE_CERTIFICATE'">
                    <partial name="_PartialServiceEmployeeCertificate" />
                </div>
                <div ng-show="iData.subCategoryCode == 'FORM_REQUEST_TRAINING'">
                    <partial name="_PartialServiceRequestTraining" />
                </div>
                <div ng-show="iData.subCategoryCode == 'FORM_REQUEST_MANPOWER'">
                    <partial name="_PartialServiceManPower" />
                </div>
                <div ng-show="iData.subCategoryCode == 'FORM_BENEFIT_FUND'">
                    <partial name="_PartialServiceBenefitFund" />
                </div>
                <div ng-show="iData.subCategoryCode == 'FORM_BENEFIT_INSURANCE'">
                    <partial name="_PartialServiceBenefitInsurance" />
                </div>
                <div ng-show="iData.subCategoryCode == 'FORM_PERFORMANCE_LV1'">
                    <partial name="_PartialServicePerformanceLv1" />
                </div>
                <div ng-show="iData.subCategoryCode == 'FORM_PERFORMANCE_LV2'">
                    <partial name="_PartialServicePerformanceLv2" />
                </div>
                <div ng-show="iData.subCategoryCode == 'FORM_MOVE_EMPLOYEE'">
                    <partial name="_PartialServiceMoveEmployee" />
                </div>
                <div ng-show="iData.subCategoryCode == 'FORM_HIRING_EMPLOYEE'">
                    <partial name="_PartialServiceHiringEmployee" />
                </div>
                <div ng-show="iData.subCategoryCode == 'FORM_PDPA_EMPLOYEE'">
                    <partial name="_PartialServicePdpaEmployee" />
                </div>
                <div ng-show="iData.subCategoryCode == 'FORM_WFH_EMPLOYEE'">
                    <partial name="_PartialServiceWfhEmployee" />
                </div>
                <div ng-show="iData.subCategoryCode == 'FORM_AGREEMENT_EMPLOYEE'">
                    <partial name="_PartialServiceAgreementEmployee" />
                </div>
                <div ng-show="iData.subCategoryCode == 'FORM_PREPARE_EMPLOYEE'">
                    <partial name="_PartialServicePrepareEmployee" />
                </div>
                <div ng-show="iData.subCategoryCode == 'FORM_PROBATION_REPORT'">
                    <partial name="_PartialServiceProbationReport" />
                </div>
                <div ng-show="iData.subCategoryCode == 'FORM_PROMOTE_EMPLOYEE'">
                    <partial name="_PartialServicePromoteEmployee" />
                </div>
                <div ng-show="iData.subCategoryCode == 'FORM_IDP'">
                    <partial name="_PartialServiceIDP" />
                </div>
                <div ng-show="iData.subCategoryCode == 'EDIT_PERSONAL'">
                    <partial name="_PartialServiceUpdatePersonal" />
                </div>
                <div ng-show="iData.subCategoryCode == 'EDIT_EMPLOYEE'">
                    <partial name="_PartialServiceUpdateEmployee" />
                </div>
                <div ng-show="iData.subCategoryCode == 'EDIT_CARD'">
                    <partial name="_PartialServiceUpdateCard" />
                </div>
                <div ng-show="iData.subCategoryCode == 'EDIT_CONTACT'">
                    <partial name="_PartialServiceUpdateContact" />
                </div>
                <div ng-show="iData.subCategoryCode == 'EDIT_JOB'">
                    <partial name="_PartialServiceUpdateJob" />
                </div>
                <div ng-show="iData.subCategoryCode == 'EDIT_EDUCATION'">
                    <partial name="_PartialServiceUpdateEducation" />
                </div>
                <div ng-show="iData.subCategoryCode == 'EDIT_TRAINING'">
                    <partial name="_PartialServiceUpdateTraining" />
                </div>
                @* Feedback *@
                <div class="bg-white rounded-4 border mb-4">
                    <div class="px-4 py-3 border-bottom">
                        <div class="fs-5 fw-bolder text-dark">Comment</div>
                    </div>
                    <div class="p-4">
                        <partial name="Shared/_PartialComment" />
                    </div>
                </div>
            </div>
            <div class="" style="width:300px; min-width:300px;">
                @* Review Action *@
                <div class="bg-white rounded-4 border mb-4 p-4" ng-show="iData.can_cancel == 1 || iData.can_approve == 1 || iData.can_work == 1">
                    <div class="fw-bolder text-gray mb-4">REVIEW ACTIONS</div>
                    <div class="d-grid gap-2">
                        <button ng-show="iData.can_approve == 1" class="btn btn-primary" ng-click="Approve()">
                            <i class="bi bi-check-circle-fill me-2"></i> Approve
                        </button>
                        <button ng-show="iData.can_work == 1" class="btn btn-success" ng-click="Work()">
                            <i class="bi bi-arrow-right-circle me-2"></i> Process
                        </button>
                        <button ng-show="iData.can_approve == 1 || iData.can_work == 1" class="btn btn-danger-secondary" ng-click="Reject()">
                            <i class="bi bi-x-circle-fill me-2"></i> Reject Request
                        </button>
                        <button ng-show="iData.can_cancel == 1" class="btn btn-warning-secondary" ng-click="Cancel()">
                            Cancel
                        </button>
                    </div>
                </div>
                @* Request Info *@
                <div class="bg-white rounded-4 border mb-4 p-4">
                    <div class="fw-bolder text-gray mb-4">REQUEST INFO</div>
                    <div class="d-flex mb-3">
                        <div class="overflow-hidden me-2" style="width:40px; min-width:40px;">
                            <img src="~/Images/icon-user.png" class="rounded-pill" width="40px" />
                        </div>
                        <div class="flex-fill">
                            <div class="text-dark fw-bolder">{{ iData.createName }}</div>
                            <div class="text-gray">{{ iData.createPosition }} {{ iData.createDepartment }}</div>
                        </div>
                    </div>
                    <div class="d-flex">
                        <div class="flex-fill">Submitted</div>
                        <div class="text-dark">{{ iData.createDate }}</div>
                    </div>
                  @*   <div class="d-flex">
                        <div class="flex-fill">Priority</div>
                        <div class="text-blue">High</div>
                    </div> *@
                </div>
                @* Approval Workflow *@
                <partial name="Shared/_PartialTrack" />
            </div>
        </div>
    </div>
</div>
<script>
    app.controller('ServiceCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.id = '@Model.id';

        $scope.LoadData = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Service/Detail',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    id: $scope.id
                    , userBy: '@User.UserId()'
                }),
                success: function (result) {
                    $timeout(function () {
                        $scope.iData = result;

                        $("#serviceNo").html($scope.iData.serviceNo);

                        $scope.LoadTrack($scope.id);
                        $scope.LoadComment($scope.id);

                        switch ($scope.iData.subCategoryCode) {
                            case 'EDIT_PROFILE':
                                $scope.LoadProfile($scope.iData);
                                break;
                            case 'FORM_NEED_NEW_CARD':
                                $scope.LoadFormNeedNewCard($scope.iData);
                                break;
                            case 'FORM_PARKING_STICKER':
                                $scope.LoadFormParkingSticker($scope.iData);
                                break;
                            case 'FORM_BUY_UNIFORM':
                                $scope.LoadFormBuyUniform($scope.iData);
                                break;
                            case 'FORM_RESET_PASSWORD':
                                $scope.LoadFormResetPassword($scope.iData);
                                break;
                            case 'FORM_SALARY_CERTIFICATE':
                                $scope.LoadFormSalaryCertificate($scope.iData);
                                break;
                            case 'FORM_EMPLOYEE_CERTIFICATE':
                                $scope.LoadFormEmployeeCertificate($scope.iData);
                                break;
                            case 'FORM_REQUEST_TRAINING':
                                $scope.LoadFormRequestTraining($scope.iData);
                                break;
                            case 'FORM_REQUEST_MANPOWER':
                                $scope.LoadFormRequestManpower($scope.iData);
                                break;
                            case 'FORM_BENEFIT_FUND':
                                $scope.LoadFormBenefitFund($scope.iData);
                                break;
                            case 'FORM_BENEFIT_INSURANCE':
                                $scope.LoadFormBenefitInsurance($scope.iData);
                                break;
                            case 'FORM_PERFORMANCE_LV1':
                                $scope.LoadFormPerformanceLv1($scope.iData);
                                break;
                            case 'FORM_PERFORMANCE_LV2':
                                $scope.LoadFormPerformanceLv2($scope.iData);
                                break;
                            case 'FORM_MOVE_EMPLOYEE':
                                $scope.LoadFormMoveEmployee($scope.iData);
                                break;
                            case 'FORM_HIRING_EMPLOYEE':
                                $scope.LoadFormHiringEmployee($scope.iData);
                                break;
                            case 'FORM_PDPA_EMPLOYEE':
                                $scope.LoadFormPdpaEmployee($scope.iData);
                                break;
                            case 'FORM_WFH_EMPLOYEE':
                                $scope.LoadFormWfhEmployee($scope.iData);
                                break;
                            case 'FORM_AGREEMENT_EMPLOYEE':
                                $scope.LoadFormAgreementEmployee($scope.iData);
                                break;
                            case 'FORM_PREPARE_EMPLOYEE':
                                $scope.LoadFormPrepareEmployee($scope.iData);
                                break;
                            case 'FORM_PROBATION_REPORT':
                                $scope.LoadFormProbationReport($scope.iData);
                                break;
                            case 'FORM_PROMOTE_EMPLOYEE':
                                $scope.LoadFormPromoteEmployee($scope.iData);
                                break;
                            case 'FORM_IDP':
                                $scope.LoadFormIDP($scope.iData);
                                break;
                            case 'EDIT_PERSONAL':
                                $scope.LoadFormUpdatePersonal($scope.iData);
                                break;
                            case 'EDIT_EMPLOYEE':
                                $scope.LoadFormUpdateEmployee($scope.iData);
                                break;
                            case 'EDIT_CARD':
                                $scope.LoadFormUpdateCard($scope.iData);
                                break;
                            case 'EDIT_CONTACT':
                                $scope.LoadFormUpdateContact($scope.iData);
                                break;
                            case 'EDIT_JOB':
                                $scope.LoadFormUpdateJob($scope.iData);
                                break;
                            case 'EDIT_EDUCATION':
                                $scope.LoadFormUpdateEducation($scope.iData);
                                break;
                            case 'EDIT_TRAINING':
                                $scope.LoadFormUpdateTraining($scope.iData);
                                break;
                            default:
                        }
                    }, 0);
                },
                error: function (jqXHR, error, errorThrown) {
                    alertWarning("ระบบเกิดข้อผิดพลาด", jqXHR.responseText, function () {
                        location.href = '@Url.Page("Index")';
                    });
                }
            });
        }
        $scope.LoadData();

        $scope.Approve = function () {
            alertConfirm("Approval Confirmed", "Do you want to approve this request?", function () {
                showPreloader();
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/Service/Approve',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    cache: false,
                    data: JSON.stringify({
                        id: $scope.id
                        , userBy: '@User.UserId()'
                    }),
                    success: function (result) {
                        $timeout(function () {
                            hidePreloader();

                            alertSuccess("Approval Successful", "The request has been approved successfully.", () => {
                                if (window.opener && typeof window.opener.ReloadApprove === 'function') {
                                    if (!window.opener.ReloadApprove()) { window.opener.ReloadApprove(); }
                                }
                                window.close();
                                $scope.LoadData();
                            });
                        }, 0);
                    },
                    error: AjaxError
                });
            });
        }

        $scope.Reject = async function () {
            await Swal.fire({
                title: "Rejection Confirmed",
                input: "textarea",
                inputPlaceholder: "กรุณาระบุเหตุผล",
                confirmButtonText: "ยืนยัน",
                cancelButtonText: "ปิด",
                showCancelButton: true
            }).then((result) => {

                if (result.value) {
                    showPreloader();

                    $.ajax({
                        url: '@webAPI.CurrentValue.APIEmpHub/api/Service/Reject',
                        headers: { 'authorization': 'Bearer @token' },
                        type: "POST",
                        contentType: 'application/json',
                        cache: false,
                        data: JSON.stringify({
                            id: $scope.id
                            , userBy: '@User.UserId()'
                            , description: result.value
                        }),
                        success: function () {
                            $timeout(function () {
                                hidePreloader();
                                $scope.LoadData();

                                alertSuccess("Rejection Completed", "The request has been rejected.", () => {
                                    if (window.opener && typeof window.opener.ReloadApprove === 'function') {
                                        if (!window.opener.ReloadApprove()) { window.opener.ReloadApprove(); }
                                    }
                                });
                            }, 0);
                        },
                        error: AjaxError
                    });
                }
            });
        }

        $scope.Cancel = function () {
            alertConfirm("Cancellation Confirmed", "Do you want to cancel this request?", function () {
                showPreloader();

                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/Service/Cancel',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    cache: false,
                    data: JSON.stringify({
                        id: $scope.id
                        , userBy: '@User.UserId()'
                    }),
                    success: function (result) {
                        $timeout(function () {
                            hidePreloader();
                            $scope.LoadData();

                            alertSuccess("Cancellation Successful", "The request has been cancelled successfully.", () => {
                                if (window.opener && typeof window.opener.ReloadRequest === 'function') {
                                    if (!window.opener.ReloadRequest()) { window.opener.ReloadRequest(); }
                                }
                            });
                        }, 0);
                    },
                    error: AjaxError
                });
            });
        }

        $scope.Work = function () {
            alertConfirm("Process Confirmed", "Do you want to process this request?", function () {
                showPreloader();
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/Service/Work',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    cache: false,
                    data: JSON.stringify({
                        id: $scope.id
                        , userBy: '@User.UserId()'
                    }),
                    success: function (result) {
                        $timeout(function () {
                            hidePreloader();
                            $scope.LoadData();

                            alertSuccess("Processed Successful", "The request has been processed successfully.", () => {
                                if (window.opener && typeof window.opener.ReloadApprove === 'function') {
                                    if (!window.opener.ReloadWork()) { window.opener.ReloadWork(); }
                                }
                            });
                        }, 0);
                    },
                    error: AjaxError
                });
            });
        }

    });
</script>