@page
@model EmpHub.Pages.Service.DetailModel
@{
    var token = User.AccessToken(HttpContext);
}

@section PageHeader {
    <!-- [ page-header ] start -->
    <div class="page-header">
        <div class="page-header-left d-flex align-items-center">
            <div class="page-header-title">
                <h5 class="m-b-10">HR Service</h5>
            </div>
            <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Page("/Index")">Home</a></li>
                <li class="breadcrumb-item" id="serviceNo"></li>
            </ul>
        </div>
    </div>
}

<div ng-controller="ServiceCtrl">
    <div class="container-fluid">
        <div class="bg-white p-4 rounded-4 border shadow-sm">
            <div class="d-flex">
                <div class="" style="width:250px; min-width:250px;">
                    <div class="mb-2">
                        <small class="text-gray">
                            เลขบริการ
                        </small>
                        <div class="fw-bolder text-secondary">
                            {{ iData.serviceNo }}
                        </div>
                    </div>
                    <div class="mb-2">
                        <small class="text-gray">
                            สถาน
                        </small>
                        <div class="fw-bolder text-secondary">
                            {{ iData.statusDesc }}
                        </div>
                    </div>
                    <div class="mb-3">
                        <small class="text-gray">
                            ผู้ขอรับบริการ
                        </small>
                        <div class="fw-bolder text-secondary">
                            {{ iData.userName }}
                        </div>
                        <div class="text-secondary">
                            {{ iData.userPosition }} {{ iData.userDepartment }}
                        </div>
                    </div>
                    <div class="mb-2">
                        <small class="text-gray">
                            วันที่ขอรับบริการ
                        </small>
                        <div class="fw-bolder text-secondary">
                            {{ iData.createDate }}
                        </div>
                    </div>
                </div>
                <div class="flex-fill px-2">
                    @* Detail *@
                    <div class="mb-2">
                        <small class="text-gray">
                            ความประสงค์
                        </small>
                        <div class="fw-bolder text-secondary fs-5">
                            {{ iData.categoryDesc }} / {{ iData.subCategoryDesc }}
                        </div>
                    </div>
                    <div class="bg-light rounded-4 p-3 mb-3">
                        <div ng-show="iData.subCategoryCode == 'EDIT_ADDRESS'">
                            <partial name="_PartialServiceAddress" />
                        </div>
                        <div ng-show="iData.subCategoryCode == 'EDIT_EDUCATION'">
                            <partial name="_PartialServiceEducation" />
                        </div>
                        <div ng-show="iData.subCategoryCode == 'EDIT_EMPLOYEE'">
                            <partial name="_PartialServiceEmployee" />
                        </div>
                        <div ng-show="iData.subCategoryCode == 'EDIT_JOB'">
                            <partial name="_PartialServiceJobExperience" />
                        </div>
                        <div ng-show="iData.subCategoryCode == 'EDIT_PERSONAL'">
                            <partial name="_PartialServicePersonal" />
                        </div>
                        <div ng-show="iData.subCategoryCode == 'EDIT_TRAINING'">
                            <partial name="_PartialServiceTraining" />
                        </div>
                        <div ng-show="iData.subCategoryCode == 'NEED_MANPOWER'">
                            <partial name="_PartialServiceManPower" />
                        </div>
                    </div>
                    @* Action *@
                    <div class="d-flex mb-3">
                        <div ng-show="iData.can_approve == 1" class="btn btn-success me-2" ng-click="Approve()" style="width:120px;">
                            <i class="bi bi-check2-circle me-1"></i> อนุมัติ
                        </div>
                        <div ng-show="iData.can_approve == 1" class="btn btn-danger-invert me-2" ng-click="Reject()" style="width:120px;">
                            ไม่อนุมัติ
                        </div>
                        <div ng-show="iData.can_cancel == 1" class="btn btn-warning-invert me-2" ng-click="Cancel()" style="width:120px;">
                            ยกเลิก
                        </div>
                    </div>
                    @* Comment *@
                    <div>
                        <div class="">ความคิดเห็น</div>
                        <partial name="Shared/_PartialComment" />
                    </div>
                </div>
                <div class="" style="width:250px;min-width:250px;">
                    <partial name="Shared/_PartialTrack" />
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    app.controller('ServiceCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.id = '@Model.id';

        $scope.LoadData = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Service/Detail',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    id: $scope.id
                    , userBy: '@User.UserId()'
                }),
                success: function (result) {
                    $timeout(function () {
                        $scope.iData = result;

                        $("#serviceNo").html($scope.iData.serviceNo);

                        $scope.LoadTrack($scope.id);
                        $scope.LoadComment($scope.id);

                        if ($scope.iData.subCategoryCode == 'EDIT_ADDRESS') {
                            $scope.LoadAddress($scope.iData);
                        }
                        else if ($scope.iData.subCategoryCode == 'EDIT_EDUCATION') {
                            $scope.LoadEducation($scope.iData);
                        }
                        else if ($scope.iData.subCategoryCode == 'EDIT_EMPLOYEE') {
                            $scope.LoadEmployee($scope.iData);
                        }
                        else if ($scope.iData.subCategoryCode == 'EDIT_JOB') {
                            $scope.LoadJobExperience($scope.iData);
                        }
                        else if ($scope.iData.subCategoryCode == 'EDIT_PERSONAL') {
                            $scope.LoadPersonal($scope.iData);
                        }
                        else if ($scope.iData.subCategoryCode == 'EDIT_TRAINING') {
                            $scope.LoadTraining($scope.iData);
                        }
                        else if ($scope.iData.subCategoryCode == 'NEED_MANPOWER') {
                            $scope.LoadManPower($scope.iData);
                        }
                    }, 0);
                },
                error: function (jqXHR, error, errorThrown) {
                    alertWarning("ระบบเกิดข้อผิดพลาด", jqXHR.responseText, function () {
                        location.href = '@Url.Page("Index")';
                    });
                }
            });
        }
        $scope.LoadData();


        $scope.Approve = function () {
            alertConfirm("อนุมัติ", "ยืนยันการอนุมัติรายการ", function () {
                showPreloader();
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/Service/Approve',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    cache: false,
                    data: JSON.stringify({
                        id: $scope.id
                        , userBy: '@User.UserId()'
                    }),
                    success: function (result) {
                        $timeout(function () {
                            hidePreloader();

                            alertSuccess("อนุมัติรายการสำเร็จ", "บันทึกการทำรายการเรียบร้อยแล้ว", () => {
                                if (window.opener && typeof window.opener.ReloadApprove === 'function') {
                                    if (!window.opener.ReloadApprove()) { window.opener.ReloadApprove(); }
                                }
                                window.close();
                                $scope.LoadData();
                            });
                        }, 0);
                    },
                    error: AjaxError
                });
            });
        }

        $scope.Reject = async function () {
            const result = await Swal.fire({
                title: "ยืนยันปฏิเสธรายการ",
                input: "textarea",
                inputPlaceholder: "กรุณาระบุเหตุผล",
                confirmButtonText: "ยืนยัน",
                cancelButtonText: "ปิด",
                showCancelButton: true
            });

            if (result.isConfirmed) {
                if (result.value) {
                    showPreloader();

                    $.ajax({
                        url: '@webAPI.CurrentValue.APIEmpHub/api/Service/Reject',
                        headers: { 'authorization': 'Bearer @token' },
                        type: "POST",
                        contentType: 'application/json',
                        cache: false,
                        data: JSON.stringify({
                            id: $scope.id
                            , userBy: '@User.UserId()'
                            , description : result.value
                        }),
                        success: function () {
                            $timeout(function () {
                                hidePreloader();

                                alertSuccess("ปฏิเสธรายการสำเร็จ", "บันทึกการทำรายการเรียบร้อยแล้ว", () => {
                                    if (window.opener && typeof window.opener.ReloadApprove === 'function') {
                                        if (!window.opener.ReloadApprove()) { window.opener.ReloadApprove(); }
                                    }
                                    window.close();
                                    $scope.LoadData();
                                });
                            }, 0);
                        },
                        error: AjaxError
                    });
                }
            }
        }

        $scope.Cancel = function () {
            alertConfirm("ยกเลิก", "ยืนยันการยกเลิกรายการ", function () {
                showPreloader();

                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/Service/Cancel',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    cache: false,
                    data: JSON.stringify({
                        id: $scope.id
                        , userBy: '@User.UserId()'
                    }),
                    success: function (result) {
                        $timeout(function () {
                            hidePreloader();

                            alertSuccess("ยกเลิกรายการสำเร็จ", "บันทึกการทำรายการเรียบร้อยแล้ว", () => {
                                if (window.opener && typeof window.opener.ReloadRequest === 'function') {
                                    if (!window.opener.ReloadRequest()) { window.opener.ReloadRequest(); }
                                }
                                window.close();
                                $scope.LoadData();
                            });
                        }, 0);
                    },
                    error: AjaxError
                });
            });
        }
    });
</script>