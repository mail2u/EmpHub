@page
@model EmpHub.Pages.Service.DetailModel
@{
    var token = User.AccessToken(HttpContext);
}
<style>
    .nxl-container .nxl-content .main-content {
        padding:0px;
    }
    
</style>


<div ng-controller="ServiceCtrl">
    <div class="page-header">
        <div class="page-header-left d-flex align-items-center w-100">
            <div class="px-4 py-2 flex-fill">
                <ul class="breadcrumb mb-2">
                    <li class="breadcrumb-item"><a href="@Url.Page("Index")">Requests</a></li>
                    <li class="breadcrumb-item">{{ iData.serviceNo }}</li>
                </ul>
                <div class="fs-5 fw-bolder text-dark">{{ iData.categoryDesc }} #{{ iData.serviceNo }}</div>
                <div class="d-flex">
                    <div class="badge badge-{{iData.status}}">{{ iData.statusDesc }}</div><i class="bi bi-dot"></i><div class="small">Submitted {{ iData.createDate }}</div>
                </div>
            </div>
            <div class="btn btn-light me-2">
                <i class="bi bi-clock-history me-2"></i> View History
            </div>
            <div class="btn btn-light" ng-click="formAction.DownloadPDF()">
                <i class="bi bi-printer-fill"></i>
            </div>
        </div>
    </div>
    <div class="p-4 m-2">
        <div class="d-flex">
            <div class="flex-fill me-4">
                <div ng-if="iData.subCategoryCode == 'EDIT_PROFILE'">
                    <partial name="Form/_PartialServiceProfile" />
                </div>
                <div ng-if="iData.subCategoryCode == 'FORM_NEED_NEW_CARD'">
                    <partial name="Form/_PartialServiceNewCard" />
                </div>
                <div ng-if="iData.subCategoryCode == 'FORM_PARKING_STICKER'">
                    <partial name="Form/_PartialServiceParkingSticker" />
                </div>
                <div ng-if="iData.subCategoryCode == 'FORM_BUY_UNIFORM'">
                    <partial name="Form/_PartialServiceBuyUniform" />
                </div>
                <div ng-if="iData.subCategoryCode == 'FORM_RESET_PASSWORD'">
                    <partial name="Form/_PartialServiceResetPassword" />
                </div>
                <div ng-if="iData.subCategoryCode == 'FORM_SALARY_CERTIFICATE'">
                    <partial name="Form/_PartialServiceSalaryCertificate" />
                </div>
                <div ng-if="iData.subCategoryCode == 'FORM_EMPLOYEE_CERTIFICATE'">
                    <partial name="Form/_PartialServiceEmployeeCertificate" />
                </div>
                <div ng-if="iData.subCategoryCode == 'FORM_REQUEST_TRAINING'">
                    <partial name="Form/_PartialServiceRequestTraining" />
                </div>
                <div ng-if="iData.subCategoryCode == 'FORM_REQUEST_MANPOWER'">
                    <partial name="Form/_PartialServiceManPower" />
                </div>
                <div ng-if="iData.subCategoryCode == 'FORM_BENEFIT_FUND'">
                    <partial name="Form/_PartialServiceBenefitFund" />
                </div>
                <div ng-if="iData.subCategoryCode == 'FORM_BENEFIT_INSURANCE'">
                    <partial name="Form/_PartialServiceBenefitInsurance" />
                </div>
                <div ng-if="iData.subCategoryCode == 'FORM_PERFORMANCE_LV1'">
                    <partial name="Form/_PartialServicePerformanceLv1" />
                </div>
                <div ng-if="iData.subCategoryCode == 'FORM_PERFORMANCE_LV2'">
                    <partial name="Form/_PartialServicePerformanceLv2" />
                </div>
                <div ng-if="iData.subCategoryCode == 'FORM_MOVE_EMPLOYEE'">
                    <partial name="Form/_PartialServiceMoveEmployee" />
                </div>
                <div ng-if="iData.subCategoryCode == 'FORM_HIRING_EMPLOYEE'">
                    <partial name="Form/_PartialServiceHiringEmployee" />
                </div>
                <div ng-if="iData.subCategoryCode == 'FORM_PDPA_EMPLOYEE'">
                    <partial name="Form/_PartialServicePdpaEmployee" />
                </div>
                <div ng-if="iData.subCategoryCode == 'FORM_WFH_EMPLOYEE'">
                    <partial name="Form/_PartialServiceWfhEmployee" />
                </div>
                <div ng-if="iData.subCategoryCode == 'FORM_AGREEMENT_EMPLOYEE'">
                    <partial name="Form/_PartialServiceAgreementEmployee" />
                </div>
                <div ng-if="iData.subCategoryCode == 'FORM_PREPARE_EMPLOYEE'">
                    <partial name="Form/_PartialServicePrepareEmployee" />
                </div>
                <div ng-if="iData.subCategoryCode == 'FORM_PROBATION_REPORT'">
                    <partial name="Form/_PartialServiceProbationReport" />
                </div>
                <div ng-if="iData.subCategoryCode == 'FORM_PROMOTE_EMPLOYEE'">
                    <partial name="Form/_PartialServicePromoteEmployee" />
                </div>
                <div ng-if="iData.subCategoryCode == 'FORM_IDP'">
                    <partial name="Form/_PartialServiceIDP" />
                </div>
                <div ng-show="iData.subCategoryCode == 'EDIT_PERSONAL'">
                    <partial name="Form/_PartialServiceUpdatePersonal" />
                </div>
                <div ng-if="iData.subCategoryCode == 'EDIT_EMPLOYEE'">
                    <partial name="Form/_PartialServiceUpdateEmployee" />
                </div>
                <div ng-if="iData.subCategoryCode == 'EDIT_CARD'">
                    <partial name="Form/_PartialServiceUpdateCard" />
                </div>
                <div ng-if="iData.subCategoryCode == 'EDIT_CONTACT'">
                    <partial name="Form/_PartialServiceUpdateContact" />
                </div>
                <div ng-if="iData.subCategoryCode == 'EDIT_JOB'">
                    <partial name="Form/_PartialServiceUpdateJob" />
                </div>
                <div ng-if="iData.subCategoryCode == 'EDIT_EDUCATION'">
                    <partial name="Form/_PartialServiceUpdateEducation" />
                </div>
                <div ng-if="iData.subCategoryCode == 'EDIT_TRAINING'">
                    <partial name="Form/_PartialServiceUpdateTraining" />
                </div>
                <div ng-if="iData.subCategoryCode == 'EDIT_TALENT'">
                    <partial name="Form/_PartialServiceUpdateTalent" />
                </div>
                <div ng-if="iData.subCategoryCode == 'EDIT_DOCUMENT'">
                    <partial name="Form/_PartialServiceUpdateDocument" />
                </div>
                @* Feedback *@
                <div class="bg-white rounded-4 border mb-4">
                    <div class="px-4 py-3 border-bottom">
                        <div class="fs-5 fw-bolder text-dark">Comment</div>
                    </div>
                    <div class="p-4">
                        <partial name="Shared/_PartialComment" />
                    </div>
                </div>
            </div>
            <div class="" style="width:300px; min-width:300px;">
                @* Review Action *@
                <div class="bg-white rounded-4 border mb-4 p-4" ng-if="iData.can_cancel == 1 || iData.can_approve == 1 || iData.can_work == 1 || iData.can_edit == 1 || iData.can_previous == 1">
                    <div class="fw-bolder text-gray mb-4">REVIEW ACTIONS</div>
                    <div class="d-grid gap-2">
                        <button ng-if="iData.can_approve == 1" class="btn btn-primary d-flex" ng-click="Approve()">
                            <i class="bi bi-check-circle-fill me-2"></i> 
                            <span class="flex-fill">Approve</span>
                        </button>
                        <button ng-if="iData.can_work == 1" class="btn btn-success d-flex" ng-click="Work()">
                            <i class="bi bi-arrow-right-circle me-2"></i>
                            <span class="flex-fill">Process</span>
                        </button>
                        <button ng-if="iData.can_approve == 1 || iData.can_work == 1" class="btn btn-danger-invert d-flex" ng-click="Reject()">
                            <i class="bi bi-x-circle-fill me-2"></i>
                            <span class="flex-fill">Reject</span>
                        </button>
                        <button ng-if="iData.can_cancel == 1" class="btn btn-warning-invert d-flex bg-light-orange" ng-click="Cancel()">
                            <i class="bi bi-x-square me-2"></i>
                            <span class="flex-fill">Cancel</span>
                        </button>
                        <button ng-if="iData.can_edit == 1" class="btn btn-light d-flex" ng-click="Edit()">
                            <i class="bi bi-pen me-2"></i>
                            <span class="flex-fill">Edit</span>
                        </button>
                        <button ng-if="iData.can_previous == 1" class="btn btn-light d-flex" ng-click="Previous()">
                            <i class="bi bi-backspace me-2"></i>
                            <span class="flex-fill">Send Back</span>
                        </button>
                    </div>
                </div>
                @* Request Info *@
                <div class="bg-white rounded-4 border mb-4 p-4">
                    <div class="fw-bolder text-gray mb-4">REQUEST INFO</div>
                    <div class="d-flex mb-3">
                        <div class="overflow-hidden me-2" style="width:40px; min-width:40px;">
                            <img src="~/Images/icon-user.png" class="rounded-pill" width="40px" />
                        </div>
                        <div class="flex-fill">
                            <div class="text-dark fw-bolder">{{ iData.createName }}</div>
                            <div class="text-gray">{{ iData.createPosition }} {{ iData.createDepartment }}</div>
                        </div>
                    </div>
                    <div class="d-flex">
                        <div class="flex-fill">Submitted</div>
                        <div class="text-dark">{{ iData.createDate }}</div>
                    </div>
                  @*   <div class="d-flex">
                        <div class="flex-fill">Priority</div>
                        <div class="text-blue">High</div>
                    </div> *@
                </div>
                @* Approval Workflow *@
                <partial name="Shared/_PartialTrack" />
            </div>
        </div>
    </div>
</div>
<script>
    app.controller('ServiceCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.id = '@Model.id';

        $scope.LoadData = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Service/Detail',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    id: $scope.id
                    , userBy: '@User.UserId()'
                }),
                success: function (result) {
                    $timeout(function () {
                        $scope.iData = result;

                        $("#serviceNo").html($scope.iData.serviceNo);

                        $scope.LoadTrack($scope.id);
                        $scope.LoadComment($scope.id);

                    }, 0);
                },
                error: function (jqXHR, error, errorThrown) {
                    alertWarning("ระบบเกิดข้อผิดพลาด", jqXHR.responseText, function () {
                        location.href = '@Url.Page("Index")';
                    });
                }
            });
        }
        $scope.LoadData();

        $scope.formAction = {
            DownloadPDF: angular.noop
        };

        $scope.$watch('iData.subCategoryCode', function (val) {
            switch (val) {
                case 'EDIT_PROFILE':
                    $timeout(function () {
                        $scope.$broadcast('EDIT_PROFILE_LOAD', $scope.iData);
                    });
                    break;
                case 'FORM_NEED_NEW_CARD':
                    $timeout(function () {
                        $scope.$broadcast('FORM_NEED_NEW_CARD_LOAD', $scope.iData);
                    });
                    break;
                case 'FORM_PARKING_STICKER':
                    $timeout(function () {
                        $scope.$broadcast('FORM_PARKING_STICKER_LOAD', $scope.iData);
                    });
                    break;
                case 'FORM_BUY_UNIFORM':
                    $timeout(function () {
                        $scope.$broadcast('FORM_BUY_UNIFORM_LOAD', $scope.iData);
                    });
                    break;
                case 'FORM_RESET_PASSWORD':
                    $timeout(function () {
                        $scope.$broadcast('FORM_RESET_PASSWORD_LOAD', $scope.iData);
                    });
                    break;
                case 'FORM_SALARY_CERTIFICATE':
                    $timeout(function () {
                        $scope.$broadcast('FORM_SALARY_CERTIFICATE_LOAD', $scope.iData);
                    });
                    break;
                case 'FORM_EMPLOYEE_CERTIFICATE':
                    $timeout(function () {
                        $scope.$broadcast('FORM_EMPLOYEE_CERTIFICATE_LOAD', $scope.iData);
                    });
                    break;
                case 'FORM_REQUEST_TRAINING':
                    $timeout(function () {
                        $scope.$broadcast('FORM_REQUEST_TRAINING_LOAD', $scope.iData);
                    });
                    break;
                case 'FORM_REQUEST_MANPOWER':
                    $timeout(function () {
                        $scope.$broadcast('FORM_REQUEST_MANPOWER_LOAD', $scope.iData);
                    });
                    break;
                case 'FORM_BENEFIT_FUND':
                    $timeout(function () {
                        $scope.$broadcast('FORM_BENEFIT_FUND_LOAD', $scope.iData);
                    });
                    break;
                case 'FORM_BENEFIT_INSURANCE':
                    $timeout(function () {
                        $scope.$broadcast('FORM_BENEFIT_INSURANCE_LOAD', $scope.iData);
                    });
                    break;
                case 'FORM_PERFORMANCE_LV1':
                    $timeout(function () {
                        $scope.$broadcast('FORM_PERFORMANCE_LV1_LOAD', $scope.iData);
                    });
                    break;
                case 'FORM_PERFORMANCE_LV2':
                    $timeout(function () {
                        $scope.$broadcast('FORM_PERFORMANCE_LV2_LOAD', $scope.iData);
                    });
                    break;
                case 'FORM_MOVE_EMPLOYEE':
                    $timeout(function () {
                        $scope.$broadcast('FORM_MOVE_EMPLOYEE_LOAD', $scope.iData);
                    });
                    break;
                case 'FORM_HIRING_EMPLOYEE':
                    $timeout(function () {
                        $scope.$broadcast('FORM_HIRING_EMPLOYEE_LOAD', $scope.iData);
                    });
                    break;
                case 'FORM_PDPA_EMPLOYEE':
                    $timeout(function () {
                        $scope.$broadcast('FORM_PDPA_EMPLOYEE_LOAD', $scope.iData);
                    });
                    break;
                case 'FORM_WFH_EMPLOYEE':
                    $timeout(function () {
                        $scope.$broadcast('FORM_WFH_EMPLOYEE_LOAD', $scope.iData);
                    });
                    break;
                case 'FORM_AGREEMENT_EMPLOYEE':
                    $timeout(function () {
                        $scope.$broadcast('FORM_AGREEMENT_EMPLOYEE_LOAD', $scope.iData);
                    });
                    break;
                case 'FORM_PREPARE_EMPLOYEE':
                    $timeout(function () {
                        $scope.$broadcast('FORM_PREPARE_EMPLOYEE_LOAD', $scope.iData);
                    });
                    break;
                case 'FORM_PROBATION_REPORT':
                    $timeout(function () {
                        $scope.$broadcast('FORM_PROBATION_REPORT_LOAD', $scope.iData);
                    });
                    break;
                case 'FORM_PROMOTE_EMPLOYEE':
                    $timeout(function () {
                        $scope.$broadcast('FORM_PROMOTE_EMPLOYEE_LOAD', $scope.iData);
                    });
                    break;
                case 'FORM_IDP':
                    $timeout(function () {
                        $scope.$broadcast('FORM_IDP_LOAD', $scope.iData);
                    });
                    break;
                case 'EDIT_PERSONAL':
                    $timeout(function () {
                        $scope.$broadcast('EDIT_PERSONAL_LOAD', $scope.iData);
                    });
                    break;
                case 'EDIT_EMPLOYEE':
                    $timeout(function () {
                        $scope.$broadcast('EDIT_EMPLOYEE_LOAD', $scope.iData);
                    });
                    break;
                case 'EDIT_CARD':
                    $timeout(function () {
                        $scope.$broadcast('EDIT_CARD_LOAD', $scope.iData);
                    });
                    break;
                case 'EDIT_CONTACT':
                    $timeout(function () {
                        $scope.$broadcast('EDIT_CONTACT_LOAD', $scope.iData);
                    });
                    break;
                case 'EDIT_JOB':
                    $timeout(function () {
                        $scope.$broadcast('EDIT_JOB_LOAD', $scope.iData);
                    });
                    break;
                case 'EDIT_EDUCATION':
                    $timeout(function () {
                        $scope.$broadcast('EDIT_EDUCATION_LOAD', $scope.iData);
                    });
                    break;
                case 'EDIT_TRAINING':
                    $timeout(function () {
                        $scope.$broadcast('EDIT_TRAINING_LOAD', $scope.iData);
                    });
                    break;
                case 'EDIT_TALENT':
                    $timeout(function () {
                        $scope.$broadcast('EDIT_TALENT_LOAD', $scope.iData);
                    });
                    break;
                case 'EDIT_DOCUMENT':
                    $timeout(function () {
                        $scope.$broadcast('EDIT_DOCUMENT_LOAD', $scope.iData);
                    });
                    break;
                default:
            }
        })

        $scope.Approve = function () {
            alertConfirm("Approval Confirmed", "Do you want to approve this request?", function () {
                showPreloader();
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/Service/Approve',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    cache: false,
                    data: JSON.stringify({
                        id: $scope.id
                        , userBy: '@User.UserId()'
                    }),
                    success: function (result) {
                        $timeout(function () {
                            hidePreloader();

                            alertSuccess("Approval Successful", "The request has been approved successfully.", () => {
                                if (window.opener && typeof window.opener.ReloadApprove === 'function') {
                                    if (!window.opener.ReloadApprove()) { window.opener.ReloadApprove(); }
                                }
                                window.close();
                                $scope.LoadData();
                            });
                        }, 0);
                    },
                    error: AjaxError
                });
            });
        }

        $scope.Reject = async function () {
            await Swal.fire({
                title: "Rejection Confirmed",
                input: "textarea",
                inputPlaceholder: "กรุณาระบุเหตุผล",
                confirmButtonText: "ยืนยัน",
                cancelButtonText: "ปิด",
                showCancelButton: true
            }).then((result) => {

                if (result.value) {
                    showPreloader();

                    $.ajax({
                        url: '@webAPI.CurrentValue.APIEmpHub/api/Service/Reject',
                        headers: { 'authorization': 'Bearer @token' },
                        type: "POST",
                        contentType: 'application/json',
                        cache: false,
                        data: JSON.stringify({
                            id: $scope.id
                            , userBy: '@User.UserId()'
                            , description: result.value
                        }),
                        success: function () {
                            $timeout(function () {
                                hidePreloader();
                                $scope.LoadData();

                                alertSuccess("Rejection Completed", "The request has been rejected.", () => {
                                    if (window.opener && typeof window.opener.ReloadApprove === 'function') {
                                        if (!window.opener.ReloadApprove()) { window.opener.ReloadApprove(); }
                                    }
                                });
                            }, 0);
                        },
                        error: AjaxError
                    });
                }
            });
        }

        $scope.Cancel = function () {
            alertConfirm("Cancellation Confirmed", "Do you want to cancel this request?", function () {
                showPreloader();

                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/Service/Cancel',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    cache: false,
                    data: JSON.stringify({
                        id: $scope.id
                        , userBy: '@User.UserId()'
                    }),
                    success: function (result) {
                        $timeout(function () {
                            hidePreloader();

                            alertSuccess("Cancellation Successful", "The request has been cancelled successfully.", () => {
                                if (window.opener && typeof window.opener.ReloadRequest === 'function') {
                                    if (!window.opener.ReloadRequest()) { window.opener.ReloadRequest(); }
                                }

                                location.href = '@Url.Page("Index")';
                            });
                        }, 0);
                    },
                    error: AjaxError
                });
            });
        }

        $scope.Work = function () {
            alertConfirm("Process Confirmed", "Do you want to process this request?", function () {
                showPreloader();
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/Service/Work',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    cache: false,
                    data: JSON.stringify({
                        id: $scope.id
                        , userBy: '@User.UserId()'
                    }),
                    success: function (result) {
                        $timeout(function () {
                            hidePreloader();
                            $scope.LoadData();

                            alertSuccess("Processed Successful", "The request has been processed successfully.", () => {
                                if (window.opener && typeof window.opener.ReloadApprove === 'function') {
                                    if (!window.opener.ReloadWork()) { window.opener.ReloadWork(); }
                                }
                            });
                        }, 0);
                    },
                    error: AjaxError
                });
            });
        }

        $scope.Edit = function(){
            console.log($scope.iData);
            if ($scope.iData.subCategoryCode == "FORM_REQUEST_MANPOWER") {
                location.href = '@Url.Page("/Service/FormUpdate/FormManpower")?refId=' + $scope.id;
            } else if ($scope.iData.subCategoryCode == "FORM_NEED_NEW_CARD") {
                location.href = '@Url.Page("/Service/FormUpdate/FormNewCard")?refId=' + $scope.id;
            } else if ($scope.iData.subCategoryCode == "FORM_PARKING_STICKER") {
                location.href = '@Url.Page("/Service/FormUpdate/FormParkingSticker")?refId=' + $scope.id;
            } else if ($scope.iData.subCategoryCode == "FORM_BUY_UNIFORM") {
                location.href = '@Url.Page("/Service/FormUpdate/FormBuyUniform")?refId=' + $scope.id;
            } else if ($scope.iData.subCategoryCode == "FORM_RESET_PASSWORD") {
                location.href = '@Url.Page("/Service/FormUpdate/FormResetPassword")?refId=' + $scope.id;
            } else if ($scope.iData.subCategoryCode == "FORM_SALARY_CERTIFICATE") {
                location.href = '@Url.Page("/Service/FormUpdate/FormSalaryCertificate")?refId=' + $scope.id;
            } else if ($scope.iData.subCategoryCode == "FORM_EMPLOYEE_CERTIFICATE") {
                location.href = '@Url.Page("/Service/FormUpdate/FormEmployeeCertificate")?refId=' + $scope.id;
            } else if ($scope.iData.subCategoryCode == "FORM_REQUEST_TRAINING") {
                location.href = '@Url.Page("/Service/FormUpdate/FormRequestTraining")?refId=' + $scope.id;
            } else if ($scope.iData.subCategoryCode == "FORM_BENEFIT_FUND") {
                location.href = '@Url.Page("/Service/FormUpdate/FormBenefitFund")?refId=' + $scope.id;
            } else if ($scope.iData.subCategoryCode == "FORM_BENEFIT_INSURANCE") {
                location.href = '@Url.Page("/Service/FormUpdate/FormBenefitInsurance")?refId=' + $scope.id;
            } else if ($scope.iData.subCategoryCode == "FORM_PERFORMANCE_LV1") {
                location.href = '@Url.Page("/Service/FormUpdate/FormPerformanceLv1")?refId=' + $scope.id;
            } else if ($scope.iData.subCategoryCode == "FORM_PERFORMANCE_LV2") {
                location.href = '@Url.Page("/Service/FormUpdate/FormPerformanceLv2")?refId=' + $scope.id;
            } else if ($scope.iData.subCategoryCode == "FORM_MOVE_EMPLOYEE") {
                location.href = '@Url.Page("/Service/FormUpdate/FormMoveEmployee")?refId=' + $scope.id;
            } else if ($scope.iData.subCategoryCode == "FORM_HIRING_EMPLOYEE") {
                location.href = '@Url.Page("/Service/FormUpdate/FormHiringEmployee")?refId=' + $scope.id;
            } else if ($scope.iData.subCategoryCode == "FORM_PDPA_EMPLOYEE") {
                location.href = '@Url.Page("/Service/FormUpdate/FormPdpaEmployee")?refId=' + $scope.id;
            } else if ($scope.iData.subCategoryCode == "FORM_WFH_EMPLOYEE") {
                location.href = '@Url.Page("/Service/FormUpdate/FormWfhEmployee")?refId=' + $scope.id;
            } else if ($scope.iData.subCategoryCode == "FORM_AGREEMENT_EMPLOYEE") {
                location.href = '@Url.Page("/Service/FormUpdate/FormAgreementEmployee")?refId=' + $scope.id;
            } else if ($scope.iData.subCategoryCode == "FORM_PREPARE_EMPLOYEE") {
                location.href = '@Url.Page("/Service/FormUpdate/FormPrepareEmployee")?refId=' + $scope.id;
            } else if ($scope.iData.subCategoryCode == "FORM_PROBATION_REPORT") {
                location.href = '@Url.Page("/Service/FormUpdate/FormProbationReport")?refId=' + $scope.id;
            } else if ($scope.iData.subCategoryCode == "FORM_REGISTER") {
                location.href = '@Url.Page("/Service/FormUpdate/FormRegister")?refId=' + $scope.id;
            } else if ($scope.iData.subCategoryCode == "FORM_PROMOTE_EMPLOYEE") {
                location.href = '@Url.Page("/Service/FormUpdate/FormPromoteEmployee")?refId=' + $scope.id;
            } else if ($scope.iData.subCategoryCode == "FORM_IDP") {
                location.href = '@Url.Page("/Service/FormUpdate/FormIDP")?refId=' + $scope.id;
            }
        }

        $scope.Previous = function () {
            alertConfirm("Process Confirmed", "Do you want to send this item back to the requester to revise the details?", function () {
                showPreloader();
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/Service/Previous',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    cache: false,
                    data: JSON.stringify({
                        id: $scope.id
                        , userBy: '@User.UserId()'
                    }),
                    success: function (result) {
                        $timeout(function () {
                            hidePreloader();
                            $scope.LoadData();

                            alertSuccess("Processed Successful", "The request has been processed successfully.", () => {
                                if (window.opener && typeof window.opener.ReloadApprove === 'function') {
                                    if (!window.opener.ReloadWork()) { window.opener.ReloadWork(); }
                                }
                            });
                        }, 0);
                    },
                    error: AjaxError
                });
            });
        }
    });
</script>