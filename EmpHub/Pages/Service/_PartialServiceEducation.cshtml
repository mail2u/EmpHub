@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
<div ng-controller="ServiceEducationCtrl" class="mb-4">
    @* View *@
    <div class="row">
        <div class="col-sm-6">
            <div class="fw-bolder text-orange">ข้อมูลที่ต้องการปรับปรุง</div>
            <div class="p-3 bg-gray rounded-4 h-100">
                <div ng-show="lData.length > 0">
                    <div class="list-group list-group-flush">
                        <div class="list-group-item bg-gray px-0" ng-repeat="x in lData">
                            <div class="row ">
                                <div class="col-sm-8 mb-3">
                                    <div class="text-gray">
                                        หลักสูตรหรือวุฒิการศึกษา
                                    </div>
                                    <div class="fw-bolder">{{ x.levelName }}</div>
                                </div>
                                <div class="col-sm-4 mb-3">
                                    <div class="text-gray">
                                        ปีที่สำเร็จการศึกษา
                                    </div>
                                    <div class="fw-bolder">{{ x.year }}</div>
                                </div>
                                <div class="col-sm-12 mb-3">
                                    <div class="text-gray">
                                        สถาบันการศึกษา
                                    </div>
                                    <div class="fw-bolder">{{ x.institution }}</div>
                                </div>
                                <div class="col-sm-12 mb-3">
                                    <div class="text-gray">
                                        เพิ่มกิจกรรม เกียรตินิยม รางวัล หรือโครงการพิเศษที่ประสบความสำเร็จระหว่างการศึกษา
                                    </div>
                                    <div class="fw-bolder">{{ x.description }}</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6" ng-show="status == 'Pending'">
            <div class="fw-bolder text-orange">ข้อมูลในระบบ</div>
            <div class="p-3 bg-gray rounded-4 h-100">
                <div ng-show="lData.length > 0">
                    <div class="list-group list-group-flush">
                        <div class="list-group-item bg-gray px-0" ng-repeat="x in lUser">
                            <div class="row ">
                                <div class="col-sm-8 mb-3">
                                    <div class="text-gray">
                                        หลักสูตรหรือวุฒิการศึกษา
                                    </div>
                                    <div class="fw-bolder text-decoration-line-through">{{ x.levelName }}</div>
                                </div>
                                <div class="col-sm-4 mb-3">
                                    <div class="text-gray">
                                        ปีที่สำเร็จการศึกษา
                                    </div>
                                    <div class="fw-bolder text-decoration-line-through">{{ x.year }}</div>
                                </div>
                                <div class="col-sm-12 mb-3">
                                    <div class="text-gray">
                                        สถาบันการศึกษา
                                    </div>
                                    <div class="fw-bolder text-decoration-line-through">{{ x.institution }}</div>
                                </div>
                                <div class="col-sm-12 mb-3">
                                    <div class="text-gray">
                                        เพิ่มกิจกรรม เกียรตินิยม รางวัล หรือโครงการพิเศษที่ประสบความสำเร็จระหว่างการศึกษา
                                    </div>
                                    <div class="fw-bolder text-decoration-line-through">{{ x.description }}</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    app.controller('ServiceEducationCtrl', function ($scope, $http, $timeout, $filter) {

        $scope.LoadData = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/ServiceEducation/DetailByRef',
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    refId: $scope.refId
                }),
                success: function (result) {
                    $timeout(async function () {
                        $scope.lData = result;
                    }, 0);
                }, error: AjaxError
            });
        }

        $scope.LoadUser = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/UserEducation',
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    userId: $scope.userId
                    , create_by: '@User.UserId()'
                }),
                success: function (result) {
                    $timeout(async function () {
                        $scope.lUser = result;
                    }, 0);
                }, error: AjaxError
            });
        }

        $scope.$parent.LoadEducation = function (x) {
            $scope.refId = x.id;
            $scope.userId = x.userId;
            $scope.status = x.status;
            $scope.LoadData();
            $scope.LoadUser();
        }
    });
</script>