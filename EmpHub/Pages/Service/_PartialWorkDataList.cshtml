<style>
    tr.cancel > td {
        color: var(--bs-gray);
    }

    tr.reject > td {
        color: var(--bs-danger);
    }

    tr.complete > td {
        color: var(--bs-green);
    }

    tr.alert > td {
        background-color: var(--light-blue);
        font-weight: bolder;
        color: var(--tip-blue);
    }

    .box-list.cancel {
        color: var(--bs-gray);
    }

    .box-list.reject {
        color: var(--bs-danger);
        background-color: var(--light-red);
    }

    .box-list.complete {
        color: var(--bs-green);
        background-color: var(--light-green);
    }

    .box-list.alert {
        background-color: var(--light-blue);
        font-weight: bolder;
        color: var(--tip-blue);
    }

    .box-list.request {
        background-color: var(--light-gray);
    }
</style>
@* Web View *@
<div class="mb-4">
    <div style="min-height:calc(100vh - 410px);" class="position-relative">
        <table class="table table-tip border shadow-sm">
            <thead>
                <tr>
                    <th width="50"></th>
                    <th class="select" width="120" ng-click="SetSort('serviceNo')">
                        Service No
                        <i ng-show="sortBy.indexOf('serviceNo') > -1" ng-class="sortBy.indexOf('-') > - 1 ? 'bi bi-arrow-up-short' : 'bi bi-arrow-down-short'"></i>
                    </th>
                    <th class="select" ng-click="SetSort('categoryDesc')">
                        Category
                        <i ng-show="sortBy.indexOf('categoryDesc') > -1" ng-class="sortBy.indexOf('-') > - 1 ? 'bi bi-arrow-up-short' : 'bi bi-arrow-down-short'"></i>
                    </th>
                    <th class="select" ng-click="SetSort('status')">
                        Status
                        <i ng-show="sortBy.indexOf('status') > -1" ng-class="sortBy.indexOf('-') > - 1 ? 'bi bi-arrow-up-short' : 'bi bi-arrow-down-short'"></i>
                    </th>
                    <th class="select" ng-click="SetSort('createBy')">
                        Request By
                        <i ng-show="sortBy.indexOf('createBy') > -1" ng-class="sortBy.indexOf('-') > - 1 ? 'bi bi-arrow-up-short' : 'bi bi-arrow-down-short'"></i>
                    </th>
                    <th class="select" ng-click="SetSort('orderDate1')">
                        Request Date
                        <i ng-show="sortBy.indexOf('orderDate1') > -1" ng-class="sortBy.indexOf('-') > - 1 ? 'bi bi-arrow-up-short' : 'bi bi-arrow-down-short'"></i>
                    </th>
                    <th class="select text-nowrap" ng-click="SetSort('orderDate2')">
                        Action Date
                        <i ng-show="sortBy.indexOf('orderDate2') > -1" ng-class="sortBy.indexOf('-') > - 1 ? 'bi bi-arrow-up-short' : 'bi bi-arrow-down-short'"></i>
                    </th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="x in lData" class="{{ x.statusCss }} {{ x.is_not_read == 1 ? 'fw-bolder' : '' }}">
                    <td class="text-center">
                        <span ng-show="x.status == 'Work'" class="text-danger" title="ปฏิเสธ">
                            <i class="bi bi-person-workspace"></i>
                        </span>
                        <span ng-show="x.status == 'Complete'" class="text-green" title="อนุมัติ">
                            <i class="bi bi-check2-circle"></i>
                        </span>
                    </td>
                    <td class="select text-nowrap position-relative" ng-click="ShowDetail(x)">
                        <span ng-show="x.is_alert > 0" class="positionposition-absolute top-50 start-0 translate-middle badge rounded-circle bg-danger p-1">
                            <span class="visually-hidden">unread messages</span>
                        </span>
                        {{ x.serviceNo != '' ? x.serviceNo : 'แบบร่าง' }}
                    </td>
                    <td class="select text-nowrap" ng-click="ShowDetail(x)">
                        {{ x.categoryDesc }} / {{ x.subCategoryDesc }}
                    </td>
                    <td class="select text-nowrap" ng-click="ShowDetail(x)">
                        {{ x.statusDesc }}
                    </td>
                    <td class="select text-nowrap" ng-click="ShowDetail(x)">
                        {{ x.createName }}
                    </td>
                    <td class="select text-nowrap" ng-click="ShowDetail(x)">
                        {{ x.createDate }}
                    </td>
                    <td class="select text-nowrap" ng-click="ShowDetail(x)">
                        {{ x.actionDate }}
                    </td>
                </tr>
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="3">
                        <div class="text-light-gray">Showing {{ ((page - 1) * row) + 1 }} to {{ (page * row) > total ? total : page * row }} of {{ total }} requests</div>
                    </td>
                    <td colspan="4">
                        <div class="d-flex">
                            <div class="flex-fill"></div>
                            <button class="btn btn-circle me-2" ng-click="LoadData(page - 1)" ng-disabled="page <= 1">
                                <i class="fas fa-chevron-left"></i>
                            </button>
                            <button class="btn btn-circle" ng-click="LoadData(page + 1)" ng-disabled="page * row >= total">
                                <i class="fas fa-chevron-right"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
