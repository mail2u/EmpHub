@{
    var token = User.AccessToken(Context);
}
<div ng-controller="ServiceHiringEmployeeCtrl">
    <div class="bg-white rounded-4 border mb-4 overflow-hidden p-4">
        <div class="px-4 py-3 border-bottom d-flex align-items-center">
            <div class="fs-5 fw-bolder text-dark flex-fill">ใบขออนุมัติจ้าง</div>
        </div>
        <div class="p-4 fs-6">
            <div class="text-dark fs-6">
                <div class="row">
                    <div class="col-sm-2 mb-3 text-dark fw-bolder">
                        ชื่อ-นามสกุล
                    </div>
                    <div class="col-sm-4 mb-3 text-blue">
                        {{ iForm.fullname }}
                    </div>
                    <div class="col-sm-2 mb-3 text-dark fw-bolder">
                        ตำแหน่ง
                    </div>
                    <div class="col-sm-4 mb-3 text-blue">
                        {{ iForm.position }}
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-2 mb-3 text-dark fw-bolder">
                        สังกัดฝ่ายงาน
                    </div>
                    <div class="col-sm-4 mb-3 text-blue">
                        {{ iForm.department }}
                    </div>
                    <div class="col-sm-2 mb-3 text-dark fw-bolder">
                        สายงาน
                    </div>
                    <div class="col-sm-4 mb-3 text-blue">
                        {{ iForm.section }}
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-2 mb-3 text-dark fw-bolder">
                        วันที่จ้าง
                    </div>
                    <div class="col-sm-4 mb-3 text-blue">
                        {{ iForm.join_date }}
                    </div>
                    <div class="col-sm-2 mb-3 text-dark fw-bolder">
                        อัตราเงินเดือนเริ่มต้น
                    </div>
                    <div class="col-sm-4 mb-3 text-blue">
                        {{ iForm.probation_salary }}
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-2 mb-3 text-dark fw-bolder">
                        ระยะเวลาทดลองงาน
                    </div>
                    <div class="col-sm-4 mb-3 text-blue">
                        {{ iForm.probation_period }}
                    </div>
                    <div class="col-sm-2 mb-3 text-dark fw-bolder">
                        ปรับเงินเดือนหลังผ่านทดลองงาน
                    </div>
                    <div class="col-sm-4 mb-3 text-blue">
                        {{ iForm.salary }}
                    </div>
                </div>
                <div class="mb-3">
                    <div class="fw-bolder text-dark">เงื่อนไขอื่นๆ</div>
                    <div class=" text-blue">{{ iForm.description }}</div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    app.controller('ServiceHiringEmployeeCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.LoadDetail = function () {
            return new Promise((resolve) => {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/Form/FormHiringEmployeeDetail',
                    headers: { 'authorization': 'Bearer @token' },
                    type: "POST",
                    contentType: 'application/json',
                    dataType: 'json',
                    cache: false,
                    data: JSON.stringify({
                        refId: $scope.refId
                    }),
                    success: function (result) {
                        $timeout(async function () {
                            $scope.iForm = result;
                            resolve(true);
                        }, 0);
                    }, error: function () {
                        resolve(false);
                    }
                });
            });
        }

        $scope.$parent.LoadFormHiringEmployee = async function (x) {
            $scope.refId = x.id;
            $scope.userId = x.userId;
            $scope.status = x.status;

            await $scope.LoadDetail();
        }
    });
</script>