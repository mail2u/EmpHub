<div ng-controller="ChartCtrl" class="">
    <div class="d-flex align-items-center mb-3">
        <div class="flex-fill">
            <div class="fs-4 text-dark fw-bolder">
               Organization Company
            </div>
            <div class="text-gray">
                Total {{ total | number }} charts
            </div>
        </div>
    </div>
    <div class="rounded-3 p-3 bg-white border shadow-sm d-flex mb-3 align-items-center" ng-repeat="x in lData | filter : title">
        <div class="flex-fill">
            <div class="fs-5 fw-bolder text-dark">{{ x.title }}</div>
            <div class="">{{ x.description }}</div>
        </div>
        <div>
            <a href="@Url.Page("Detail")?id={{ x.chartId }}" class="btn text-blue" target="_blank">
                <i class="bi bi-arrow-right fs-5"></i>
            </a>
        </div>
    </div>
</div>
<script>
    app.controller('ChartCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.page = 1
        $scope.row = 10;

        $scope.LoadData = function (page = 1) {
            $scope.page = page;

            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Chart/DataList'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    status: 'publish'
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lData = result;
                        $scope.total = $scope.lData.length;
                    }, 0);
                }
                , error: AjaxError
            });
        }
        $scope.LoadData();
    });
</script>