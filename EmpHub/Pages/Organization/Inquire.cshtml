<div ng-controller="ChartCtrl" class="">
    <div class="d-flex align-items-center mb-3">
        <div class="flex-fill">
            <div class="fs-4 text-dark fw-bolder">
                Chart List
            </div>
            <div class="text-gray">
                Total {{ total | number }} charts
            </div>
        </div>
        <div>
            <div class="btn btn-primary" ng-click="New()">
                <i class="bi bi-plus-square me-2"></i> Add Chart
            </div>
        </div>
    </div>
    <div class="rounded-3 p-3 bg-white border d-flex mb-4 align-items-center shadow-sm">
        <div class="flex-fill me-2 position-relative">
            <input class="form-control rounded-3 p-2" ng-model="title" my-enter="LoadData()" placeholder="Search..." />
        </div>
    </div>
    <div class="rounded-3 p-3 bg-white border d-flex mb-3 align-items-center shadow-sm" ng-repeat="x in lData | filter : title">
        <div class="flex-fill">
            <div class="fs-5 fw-bolder text-dark">
                {{ x.title }}
                <span class="badge badge-{{ x.status }}">{{ x.status }}</span>
            </div>
            <div class="">{{ x.description }}</div>
        </div>
        <div>
            <div class="btn text-blue" ng-click="Edit(x)">
                <i class="bi bi-pencil-square"></i>
            </div>
        </div>
        <div>
            <a href="@Url.Page("Manage")?id={{ x.chartId }}" class="btn text-blue" target="_blank">
                <i class="bi bi-arrow-right fs-5"></i>
            </a>
        </div>
    </div>
    @* Modal *@
    <div id="charModal" class="modal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header fs-5">
                    New Chart
                </div>
                <div class="modal-body">
                    <div>
                        <div class="mb-3">
                            Title
                            <input ng-model="iData.title" class="form-control" maxlength="200" />
                        </div>
                        <div class="mb-3">
                            Detail
                            <textarea ng-model="iData.description" class="form-control" rows="5" maxlength="500"></textarea>
                        </div>
                        <div class="d-flex justify-content-end">
                            <button ng-disabled="iData.title == ''" class="btn btn-primary" ng-click="Create()">
                                Create
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div id="editModal" class="modal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header fs-5">
                    Chart Information
                </div>
                <div class="modal-body">
                    <div>
                        <div class="mb-3">
                            Title
                            <input ng-model="iData.title" class="form-control" maxlength="200" />
                        </div>
                        <div class="mb-3">
                            Detail
                            <textarea ng-model="iData.description" class="form-control" rows="5" maxlength="500"></textarea>
                        </div>
                        <div class="mb-3">
                            Status
                            <select ng-model="iData.status" class="form-control form-select" ng-options="s for s in lStatus"></select>
                        </div>
                        <div class="d-flex justify-content-end">
                            <button ng-disabled="iData.title == ''" class="btn btn-primary" ng-click="Update()">
                                Save Change
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    app.controller('ChartCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.page = 1
        $scope.row = 10;

        $scope.lStatus = ['Private','Publish'];

        $scope.LoadData = function (page = 1) {
            $scope.page = page;

            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Chart/DataList'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    page: $scope.page
                    , row: $scope.row
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lData = result;
                        $scope.total = $scope.lData.length;
                    }, 0);
                }
                , error: AjaxError
            });
        }
        $scope.LoadData();

        $scope.New = function(){
            $scope.iData = {title:'', description:'',create_by: '@User.UserId()'};
            $("#charModal").modal('show');
        }

        $scope.Create = function () {
            $("#charModal").modal('hide');

            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Chart/Create'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify($scope.iData)
                , success: function (result) {
                    $timeout(function () {
                        location.href = '@Url.Page("Manage")?id=' + result.chartId;
                    }, 0);
                }
                , error: AjaxError
            });
        }

        $scope.Edit = function(x){
            $scope.iData = x;
            $("#editModal").modal('show');
        }

        $scope.Update = function () {
            $("#editModal").modal('hide');

            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Chart/Update'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , cache: false
                , data: JSON.stringify($scope.iData)
                , success: function () {
                    $timeout(function () {
                        alertSuccess("Saved successfully", "Changes have been saved successfully.");
                    }, 0);
                }
                , error: AjaxError
            });
        }
    });
</script>