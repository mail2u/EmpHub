        min-height : calc(100vh - 150px);
    }

    .badge-Publish{
        background-color: var(--light-green);
        color: var(--bs-green);
    }
    
    .badge-Private{
        background-color: var(--light-orange);
        color: var(--bs-orange);
    }
</style>
@section PageHeader {
    <!-- [ page-header ] start -->
