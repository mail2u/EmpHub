@page
@model EmpHub.Pages.EmpManage.IndexModel
@{
    ViewData["Title"] = "Employee Management";
    var token = User.AccessToken(HttpContext);
}


@section PageHeader {
    <!-- [ page-header ] start -->
  @*   <div class="page-header">
        <div class="page-header-left d-flex align-items-center">
            <div class="page-header-title">
                <h5 class="m-b-10">Employee Management</h5>
            </div>
            <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Page("/Index")">Home</a></li>
                <li class="breadcrumb-item">Employee Management</li>
            </ul>
        </div>
    </div> *@
}

<div ng-controller="ManageCtrl" class="p-2">
    <div class="d-flex align-items-center mb-3">
        <div class="flex-fill">
            <div class="fs-4 text-dark fw-bolder">
                Employee Management
            </div>
            <div class="text-gray">
                Manage {{ total | number }} organization members across {{ lDepartment.length }} departments
            </div>
        </div>
       @*  <div>
            <div class="btn btn-primary">
                <i class="bi bi-person-plus-fill me-2"></i> Add New Employee
            </div>
        </div> *@
    </div>
    <div class="rounded-3 p-3 bg-white shadow-sm border d-flex mb-4 aling-items-center">
        <div class="flex-fill me-2 position-relative">
            <input class="form-control rounded-3 p-2" ng-model="firstname_th" my-enter="LoadData()" placeholder="Search..." />
            <span class="position-absolute top-50 end-0 translate-middle badge bg-gray" ng-show="firstname_th != ''">
                enter
            </span>
        </div>
        <div class="dropdown me-2">
            <button class="btn btn-light dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-buildings me-2"></i> {{ departmentName != '' ? departmentName : 'Department' }}
            </button>
            <ul class="dropdown-menu">
                <li ng-repeat="d in lDepartment"><a class="dropdown-item" href="#" ng-click="SelectDepartment(d)">{{ d.desc_th }}</a></li>
            </ul>
        </div>
        <div class="dropdown me-2">
            <button class="btn btn-light dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-briefcase-fill me-2"></i> {{ positionName != '' ? positionName : 'Position' }}
            </button>
            <ul class="dropdown-menu">
                <li ng-repeat="d in lPosition"><a class="dropdown-item" href="#" ng-click="SelectPosition(d)">{{ d.desc_th }}</a></li>
            </ul>
        </div>
        <div class="dropdown me-2">
            <button class="btn btn-light dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-briefcase-fill me-2"></i> {{ typeName != '' ? typeName : 'Employee Type' }}
            </button>
            <ul class="dropdown-menu">
                <li ng-repeat="d in lType"><a class="dropdown-item" href="#" ng-click="SelectType(d)">{{ d.desc_th }}</a></li>
            </ul>
        </div>
        <div class="btn btn-warning" ng-click="Clear()" ng-show="firstname_th != '' || departmentName != '' || positionName != '' || typeName != ''">
            Clear
        </div>
    </div>
    <div class="mb-4">
        <table class="table table-tip">
            <thead>
                <tr>
                    <th>EMPLOYEE</th>
                    <th>ROLE & DEPARTMENT</th>
                    <th>CONTACT</th>
                    <th width="40"></th>
                    <th width="40"></th>
                    <th width="40"></th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="x in lData">
                    <td>
                        <div class="d-flex align-items-center">
                            <div class="me-3" style="width:35px;">
                                <img src="~/Images/icon-user.png" class="rounded-circle" width="100%" />
                            </div>
                            <div>
                                <div class="text-dark">{{ x.firstname_th + ' ' + x.lastname_th }}</div>
                                <div class="text-gray">{{ x.firstname_en + ' ' + x.lastname_en }}</div>
                            </div>
                        </div>
                    </td>
                    <td>
                        <div class="text-dark">{{ x.positionDesc }}</div>
                        <div class="text-gray">{{ x.departmentDesc }}</div>
                    </td>
                    <td>
                        <div class="text-gray">{{ x.email }}</div>
                        <div class="text-light-gray">{{ x.phoneNo }}</div>
                    </td>
                    <td class="align-middle text-end">
                        <a href="@Url.Page("/Employee/Detail")/{{ x.userId }}" class="btn btn-circle" target="_blank">
                            <i class="bi bi-file-earmark-text"></i>
                        </a>
                    </td>
                    <td class="align-middle text-end">
                        <div class="btn btn-circle" ng-click="ShowEdit(x)">
                            <i class="bi bi-pencil-square"></i>
                        </div>
                    </td>
                    <td class="align-middle text-end">
                        <div class="btn btn-circle" ng-click="Delete(x)">
                            <i class="bi bi-trash"></i>
                        </div>
                    </td>
                </tr>
            </tbody>
            <tfoot>
                <tr>
                    <td>
                        <div class="text-light-gray">Showing {{ ((page - 1) * row) + 1 }} to {{ (page * row) > total ? total : page * row }} of {{ total }} employees</div>
                    </td>
                    <td colspan="5">
                        <div class="d-flex">
                            <div class="flex-fill"></div>
                            <button class="btn btn-circle me-2" ng-click="LoadData(page - 1)" ng-disabled="page <= 1">
                                <i class="fas fa-chevron-left"></i>
                            </button>
                            <button class="btn btn-circle" ng-click="LoadData(page + 1)" ng-disabled="page * row > total">
                                <i class="fas fa-chevron-right"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
<script>
    app.controller('ManageCtrl', function ($scope, $http, $timeout, $filter) {
        $scope.page = 1
        $scope.row = 10;

        $scope.LoadInit = function(){
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/MasterCode/DataList'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    groupName: 'departmentCode'
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lDepartment = result;
                    }, 0);
                }
                , error: AjaxError
            });
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/MasterCode/DataList'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    groupName: 'positionCode'
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lPosition = result;
                    }, 0);
                }
                , error: AjaxError
            });
        }
        $scope.LoadInit();

        $scope.LoadData = function (page = 1) {
            $scope.page = page;

            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/FullList'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , dataType: 'json'
                , cache: false
                , data: JSON.stringify({
                    page: $scope.page
                    , row: $scope.row
                    , firstname: $scope.subject
                })
                , success: function (result) {
                    $timeout(function () {
                        $scope.lData = result.data;
                        $scope.total = result.total;
                    }, 0);
                }
                , error: AjaxError
            });
        }

        $scope.Clear = function(){
            $scope.firstname_th = '';
            $scope.departmentCode = '';
            $scope.departmentName = '';
            $scope.positionCode = '';
            $scope.positionName = '';
            $scope.typeCode = '';
            $scope.typeName = '';
            $scope.LoadData();
        }
        $scope.Clear();


        $scope.New = function (x) {
            $scope.iData = { username: '', password: '', firstname: '', lastname: '' };
            $("#CreateModal").modal('show');
        }

        $scope.Create = function () {
            $scope.iData.create_by = '@User.UserId()';
            $("#CreateModal").modal('hide');

            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/Create'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , cache: false
                , data: JSON.stringify($scope.iData)
                , success: function () {
                    $timeout(function () {
                        $scope.LoadData($scope.page);
                    }, 0);
                }
                , error: AjaxError
            });
        }

        $scope.ShowEdit = function (x) {
            $scope.iData = x;
            $("#DetailModal").modal('show');
        }

        $scope.Update = function () {
            $scope.iData.update_by = '@User.UserId()';
            $("#DetailModal").modal('hide');

            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/Update'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , cache: false
                , data: JSON.stringify($scope.iData)
                , success: function () {
                    $timeout(function () {
                        $scope.LoadData($scope.page);
                    }, 0);
                }
                , error: AjaxError
            });
        }

        $scope.Delete = function(x){
            alertConfirm('ยืนยันการทำรายการ', 'ท่านต้องการลบข้อมูลผู้ใช้งานนี้', function () {
                x.update_by = '@User.UserId()';
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/User/Delete'
                    , headers: { 'authorization': 'Bearer @token' }
                    , type: 'post'
                    , contentType: 'application/json'
                    , cache: false
                    , data: JSON.stringify(x)
                    , success: function () {
                        $timeout(function () {
                            $scope.LoadData($scope.page);
                        }, 0);
                    }
                    , error: AjaxError
                });
            });
        }

        $scope.ShowChangePass = function (x) {
            $scope.iData = x;
            $("#ChangePassModal").modal('show');
        }

        $scope.ChangePass = function () {
            $scope.iData.update_by = '@User.UserId()';
            $("#ChangePassModal").modal('hide');

            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/ChangePassword'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , cache: false
                , data: JSON.stringify($scope.iData)
                , success: function () {
                    $timeout(function () {
                        $scope.LoadData($scope.page);
                    }, 0);
                }
                , error: AjaxError
            });
        }

        $scope.Resend = function (x) {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/Mail/Resend'
                , headers: { 'authorization': 'Bearer @token' }
                , type: 'post'
                , contentType: 'application/json'
                , cache: false
                , data: JSON.stringify({
                    id: x.id
                })
                , success: function () {
                    $timeout(function () {
                        alertSuccess("ส่งเมล์สำเร็จ", "ดำเนินการส่งเมล์เรียบร้อยแล้ว");
                        $scope.LoadData($scope.page);
                    }, 0);
                }
                , error: AjaxError
            });
        }

        $scope.UpdateSync = function (x) {
            return new Promise((resolve) => {
                $.ajax({
                    url: '@webAPI.CurrentValue.APIEmpHub/api/User/SyncData'
                    , headers: { 'authorization': 'Bearer @token' }
                    , type: 'post'
                    , contentType: 'application/json'
                    , cache: false
                    , data: JSON.stringify(x)
                    , success: function (data) {
                        resolve(true);
                    }
                    , error: function(){
                        resolve(false);
                    }
                });
            });
        }

        $scope.Download = function () {
            $.ajax({
                url: '@webAPI.CurrentValue.APIEmpHub/api/User/FullList',
                headers: { 'authorization': 'Bearer @token' },
                type: "POST",
                contentType: 'application/json',
                dataType: 'json',
                cache: false,
                data: JSON.stringify({
                    page: $scope.page
                    , row: 2000
                    , firstname: $scope.subject
                }),
                success: function (result) {
                    $timeout(function () {
                        var lData = result.data;

                        if (lData.length > 0) {
                            var JSData = [[
                                { 'text': 'Username' }
                                , { 'text': 'Fullname' }
                                , { 'text': 'ชื่อ - สกุล' }
                                , { 'text': 'E-mail' }
                                , { 'text': 'ประเภท' }
                                , { 'text': 'วันที่สร้าง' }
                            ]];

                            for (var i = 0; i < lData.length; i++) {
                                var iData = lData[i];

                                JSData.splice(JSData.length, 0, [
                                    { 'text': iData.serviceNo }
                                    , { 'text': iData.categoryDesc }
                                    , { 'text': iData.subCategoryDesc }
                                    , { 'text': iData.title }
                                    , { 'text': iData.status }
                                    , { 'text': iData.createName }
                                    , { 'text': iData.createDate }
                                ]);
                            }

                            var dt = new Date().toISOString().slice(0, 10).replace(/-/g, "");
                            ExportFile(JSData, 'รายงานฝ่าย_' + dt);
                        }
                    }, 0);
                },
                error: AjaxError
            });
        }
    });
</script>